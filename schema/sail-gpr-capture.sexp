;; Prospective process provenance, not execution attestation or qualification.
;; Failed processes and empty output files remain representable. Semantic matching
;; against canonical run/input records belongs to the forthcoming evaluator.
(schema (id "sail-gpr-capture"))
(construct (name capture)
  (field (name format_version) (type string) (pattern "^sail-gpr-capture-v1\\Z"))
  (field (name run_id) (type string) (min-length 1))
  (field (name run_kind) (type string) (pattern "^(baseline|repeat|control)\\Z"))
  (field (name argv) (type string) (repeat yes) (min 1))
  (field (name process_exit) (type integer))
  (field (name reference_candidate_id) (type string) (min-length 1))
  (field (name reference_binary_sha256) (type string) (pattern "^[0-9a-f]{64}\\Z"))
  (field (name collector_input_id) (type string) (min-length 1))
  (field (name input) (type form) (head input) (repeat yes) (min 1))
  (field (name observation) (type form) (head observation) (repeat yes) (min 3))
  (field (name host) (type form) (head host))
  (field (name tool) (type form) (head tool) (repeat yes) (min 1)))
(construct (name input)
  (field (name id) (type string) (min-length 1))
  (field (name sha256) (type string) (pattern "^[0-9a-f]{64}\\Z")))
(construct (name observation)
  (field (name id) (type string) (min-length 1))
  (field (name role) (type string) (pattern "^(raw-gpr|process-stdout|process-stderr)\\Z"))
  (field (name path) (type string) (min-length 1))
  (field (name byte_size) (type integer))
  (field (name sha256) (type string) (pattern "^[0-9a-f]{64}\\Z")))
(construct (name host)
  (field (name os) (type string) (min-length 1))
  (field (name kernel) (type string) (min-length 1))
  (field (name arch) (type string) (min-length 1)))
(construct (name tool)
  (field (name id) (type string) (min-length 1))
  (field (name version) (type string) (min-length 1)))
