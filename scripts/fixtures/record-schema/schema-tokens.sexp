;; schema-tokens.sexp - frozen for RECORD-SCHEMA's controls (XTASK.13 slice i): one anchored field per token language, each pattern as a real schema declares it.
;; Frozen copy: a real schema's damage fails by its own name, in the real run's step, not here.

(schema (id "tokens"))

(construct (name tokens)
  (field (name f00) (type string) (optional yes) (pattern "^[A-Z][A-Za-z]*-[a-z0-9.]+-[0-9]+\\.S\\Z"))
  (field (name f01) (type string) (optional yes) (pattern "^[0-9a-f]{64}\\Z"))
  (field (name f02) (type string) (optional yes) (pattern "^0x[0-9a-f]{1,4}(_[0-9a-f]{4})*\\Z"))
  (field (name f03) (type string) (optional yes) (pattern "^OB-[A-Z0-9-]+\\Z"))
  (field (name f04) (type string) (optional yes) (pattern "^D-[A-Z0-9-]+\\Z"))
  (field (name f05) (type string) (optional yes) (pattern "^(C|D)[0-9]{2}\\Z"))
  (field (name f06) (type string) (optional yes) (pattern "^[A-Za-z][A-Za-z0-9._:/-]*\\Z"))
  (field (name f07) (type string) (optional yes) (pattern "^[a-z0-9][a-z0-9-]*-v[0-9]+\\Z"))
  (field (name f08) (type string) (optional yes) (pattern "^[a-z0-9-]+-v[0-9]+\\Z"))
  (field (name f09) (type string) (optional yes) (pattern "^[0-9]+\\Z"))
  (field (name f10) (type string) (optional yes) (pattern "^crates/[A-Za-z0-9_/-]+\\.rs\\Z"))
  (field (name f11) (type string) (optional yes) (pattern "^20[0-9]{2}-[0-9]{2}-[0-9]{2}\\Z"))
  (field (name f12) (type string) (optional yes) (pattern "^decision_[a-z0-9-]+\\.md\\Z"))
  (field (name f13) (type string) (optional yes) (pattern "^DS-[A-Z0-9-]+\\Z"))
  (field (name f14) (type string) (optional yes) (pattern "^[A-Z][A-Z0-9-]*\\Z"))
  (field (name f15) (type string) (optional yes) (pattern "^[A-Za-z0-9_./-]+\\Z"))
  (field (name f16) (type string) (optional yes) (pattern "^[a-z_][a-z0-9_]*\\Z"))
  (field (name f17) (type string) (optional yes) (pattern "^[A-Z][A-Z0-9-]*\\.[0-9]+\\Z"))
  (field (name f18) (type string) (optional yes) (pattern "^[a-z0-9][a-z0-9-]*\\.s\\Z"))
  (field (name f19) (type string) (optional yes) (pattern "^[a-z0-9][a-z0-9-]*\\Z"))
  (field (name f20) (type string) (optional yes) (pattern "^(independent-exact-expectation|bounded-exhaustive-check|source-grounded-invariant-check|qualified-hardware-observation)\\Z"))
  (field (name f21) (type string) (optional yes) (pattern "^(guest-image|reference-config|expectation)\\Z"))
  (field (name f22) (type string) (optional yes) (pattern "^[A-Za-z0-9][A-Za-z0-9._-]*\\Z"))
  (field (name f23) (type string) (optional yes) (pattern "^(form|table1):[A-Za-z0-9._-]+\\Z"))
  (field (name f24) (type string) (optional yes) (pattern "^x([1-9]|[12][0-9]|3[01])\\Z"))
  (field (name f25) (type string) (optional yes) (pattern "^matched-gpr-dependencies-v1\\Z"))
  (field (name f26) (type string) (optional yes) (pattern "^[a-z0-9_]+\\Z"))
  (field (name f27) (type string) (optional yes) (pattern "^matched-gpr-v1\\Z"))
  (field (name f28) (type string) (optional yes) (pattern "^(gpr-change|witnessed-delivery)\\Z"))
  (field (name f29) (type string) (optional yes) (pattern "^(reference|expected)\\Z"))
  (field (name f30) (type string) (optional yes) (pattern "^(baseline|repeat|control)\\Z"))
  (field (name f31) (type string) (optional yes) (pattern "^(AGREE|DIVERGE|REFUSED)\\Z"))
  (field (name f32) (type string) (optional yes) (pattern "^(DIVERGE|REFUSED)\\Z"))
  (field (name f33) (type string) (optional yes) (pattern "^(shared|not-shared|no-evidence-of-sharing|not-examined)\\Z"))
  (field (name f34) (type string) (optional yes) (pattern "^[a-z0-9._]+\\Z"))
  (field (name f35) (type string) (optional yes) (pattern "^sail-gpr-capture-v1\\Z"))
  (field (name f36) (type string) (optional yes) (pattern "^(raw-gpr|process-stdout|process-stderr)\\Z"))
  (field (name f37) (type string) (optional yes) (pattern "^wl-[a-z]+\\.c\\Z")))
