;; contract.sexp — frozen for CONTRACT-FREEZE's controls (XTASK.13 slice h): rv64gc-lab-v0's four versions, cut to six members and one supersession.
(contract (id "rv64gc-lab-env-v0") (version "0") (profile_ids "rv64gc-lab-v0") (status frozen) (statement "Version 0, recorded as it stood when versioning began (P4-SYSTEM.9 slice a, 2026-10-06): the 46 obligations P4-SYSTEM.1 through .8 declared under contract_version 0 - every one a cpu-guarantee, the 13 rv64i base mirrors among them. Frozen: a statement later work made wrong is superseded by a later version, never rewritten.") (member (id "OB-SV39") (sha256 "32eb0731916acb8ac0ae407f4596f86769e8c61c4d2bb7e69acf5618bb521c92")) (member (id "OB-SVADE") (sha256 "3fb1699a901927738435b1baacac77a87b7ab5a7282b3b253004713b58541cd5")) (member (id "OB-ENDIAN") (sha256 "c7bd612f4398557103fdfbd1265a53c3e73d3fd17ab6c529572c21783a269759")))
(contract (id "rv64gc-lab-env-v1") (version "1") (profile_ids "rv64gc-lab-v0") (extends "rv64gc-lab-env-v0") (status frozen) (statement "Version 1 (P4-SYSTEM.9): v0 plus the four ENVIRONMENT ASSUMPTIONS the Linux-capable profile introduced - translation inputs, interrupt sources, counter progress, reservation invalidation - the first environment assumptions this unit states, each with a positive and a negative fixture that the check registry runs. Frozen at P4-SYSTEM.9's close (2026-10-06).") (member (id "OB-GC-ENV-VIRTUAL-TIME") (sha256 "52b37b9d5bbd1b2ca9746e8e404ade73d89570cd945f54d8376910dada57bdee")))
(contract (id "rv64gc-lab-env-v2") (version "2") (profile_ids "rv64gc-lab-v0") (extends "rv64gc-lab-env-v1") (status frozen) (statement "Version 2, frozen at P4-SYSTEM.13 c36 (2026-10-10) after every effective check ran: fourteen byte-pinned members add M, C, exact parcel supply, qualified FP, the current definition route, fault priority, physical byte addresses, data access, event positioning, one-hart ordering, cold reset, STCE-selected interrupt sources, qualified reservations and deterministic completed SC. Inherits v1 with seven explicit supersessions; 57 effective obligations and 114 realized checks. Later corrections require a new version, never edits to frozen records.") (member (id "OB-GC-DEFINITION-V2") (sha256 "d28967a0044841982bb0fa3b18876c2b0177c5bbb7f78aea7ad6d63f656662cf")))
(contract (id "rv64gc-lab-env-v3") (version "3") (profile_ids "rv64gc-lab-v0") (extends "rv64gc-lab-env-v2") (status frozen) (statement "Version 3 (P4-SYSTEM.14 a43e-2, 2026-11-05): no new guarantee. Four successors carry their requirement's id and state what that requirement now states, so REQ-D-FP-DEFER, REQ-D-ROUTE-FLIP, REQ-D-ECALL-EBREAK and REQ-GC-PRIV-INSNS could be corrected while the frozen records they once mirrored stay as they are. Each check keeps its evidence; 57 effective obligations and 114 realized checks, as before.") (member (id "OB-GC-DEFINITION-V3") (sha256 "9b42739aa8ad2c39732cf60b50af0e52796d1749191ff8e97a509ac676f8185e")) (supersede (record "OB-GC-DEFINITION-V2") (by "OB-GC-DEFINITION-V3") (why "the record's successor states the same guarantee as the requirement's own mirror, so the requirement can be restated and credited")))
(registry (path "crates/semulith-verify/src/contract_checks_rv64gc.rs") (statement "The checks this unit's contract declares, realized: each entry binds one check id, under its obligation, to tracked guests, a named typed-boundary fixture or a scope predicate. The registry tests run every guest under the corpus comparison rule, every direct fixture with its typed violation controls, and every scope check through its tracked predicate/violating copies (P4-SYSTEM.13 b2); scope evidence validates declarations, never instruction execution."))
