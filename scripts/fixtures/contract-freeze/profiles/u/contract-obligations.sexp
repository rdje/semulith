;; contract-obligations.sexp — frozen for CONTRACT-FREEZE's controls (XTASK.13 slice h): six records verbatim from rv64gc-lab-v0, whose pins below still match them.
;; Nothing reads this but those controls, and a damaged real contract fails the real check by its own name.
(obligation (id "OB-SV39") (contract_id "rv64gc-lab-env-v0") (contract_version "0") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "Translation is Sv39: of the three paged virtual-memory schemes defined for SXLEN=64 (Sv39, Sv48, Sv57), the profile selects the minimal Linux-capable one — also the one the pinned SoC precedent implements (the FU540-C000's U54 supports Bare and Sv39). The U54's A/D behaviour (page faults instead of setting PTE A/D bits) is recorded as P4-SYSTEM.3's policy input, not as this profile's rule.") (authority laboratory) (source_refs (source_id "RVP-SUPERVISOR") (locator "§11.1.3–§11.1.4")) (source_refs (source_id "SIFIVE-FU540-C000") (locator "§4.7")) (parameters (param (name requirement_id) (value (str "REQ-D-SV39"))) (param (name decision_id) (value (str "D-SV39"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-SV39") (required_checks "CHK-SV39-POS") (required_checks "CHK-SV39-NEG"))
(obligation (id "OB-SVADE") (contract_id "rv64gc-lab-env-v0") (contract_version "0") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "The profile implements Svade: when a translation needs an A or D PTE update, the hart raises a page fault instead of performing the hardware update. Three evidence legs: (i) the pinned revision defines exactly two A/D schemes and names the page-fault one Svade (RVP-SUPERVISOR §11.1.3.1, §11.1.10); (ii) the profile's own translation precedent — the U54 MMU the Sv39 choice already cites — implements exactly that scheme ('does not automatically set the A and D bits … Instead, the U54 MMU will raise a page fault', FU540 §4.7); (iii) the laboratory's observe-through-the-ISA discipline (P4-SYSTEM.2 decision 6) can evidence a page fault (scause/stval via csrr) but cannot evidence an implicit PTE write, so the hardware-update default would price a new observation vocabulary to test a side effect the laboratory need not produce. Svadu is NOT selected: menvcfg's ADUE stays WPRI (the state document's wpri_62_0 field).") (authority laboratory) (source_refs (source_id "RVP-SUPERVISOR") (locator "§11.1.3.1")) (source_refs (source_id "RVP-SUPERVISOR") (locator "§11.1.10")) (source_refs (source_id "SIFIVE-FU540-C000") (locator "§4.7")) (parameters (param (name requirement_id) (value (str "REQ-D-SVADE"))) (param (name decision_id) (value (str "D-SVADE"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-SVADE") (required_checks "CHK-SVADE-POS") (required_checks "CHK-SVADE-NEG"))
(obligation (id "OB-ENDIAN") (contract_id "rv64gc-lab-env-v0") (contract_version "0") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "Little-endian. The specification delegates this to the EEI; endianness in RISC-V is byte-address invariant.") (authority implementation-profile) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (parameters (param (name requirement_id) (value (str "REQ-D-ENDIAN"))) (param (name decision_id) (value (str "D-ENDIAN"))) (param (name source_semantics) (value (str "implementation-defined"))) (param (name mirrored_from) (value (str "rv64i-lab-v0")))) (dependencies "REQ-D-ENDIAN") (required_checks "CHK-ENDIAN-POS") (required_checks "CHK-ENDIAN-NEG"))
(obligation (id "OB-GC-ENV-VIRTUAL-TIME") (contract_id "rv64gc-lab-env-v1") (contract_version "1") (profile_ids "rv64gc-lab-v0") (direction environment-assumption) (statement "The environment's time supply IS the hart's virtual-time domain: time and mcycle advance by exactly one at every step boundary - a step that retired an instruction, one that delivered a trap, and one that found the hart waiting alike - while instret advances only on retirement; a waiting hart's time keeps advancing, so a timer wake reaches it WITHOUT retirement. No wall clock and no host time reaches the guest. False if time stood still while the hart waited, moved with host time, or instret counted a trap or a halted step.") (authority laboratory) (source_refs (source_id "RVI-ZICNTR") (locator "6.1")) (source_refs (source_id "RVP-MACHINE") (locator "§2.1.3.3")) (parameters (param (name ticks_per_step_boundary) (value (int 1))) (param (name host_time_visible) (value (false)))) (required_checks "CHK-GC-ENV-VIRTUAL-TIME-POS") (required_checks "CHK-GC-ENV-VIRTUAL-TIME-NEG"))
(obligation (id "OB-GC-DEFINITION-V2") (contract_id "rv64gc-lab-env-v2") (contract_version "2") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "This unit uses the generated-definition vehicle. Its encoding composition is complete for the declared profile scope, with no unbound slots; the canonical state, encoding/semantics and guest corpus own the generated state_rv64gc.rs, definition_rv64gc.rs and guests_rv64gc.rs mirrors. The owner generators and their drift gates govern those mirrors. This replaces both the original profile-resolution stage and the later partial-composition checkpoint, without fixing the current contract to obsolete slot or guest counts. Selection and generated-route consistency are scope evidence; instruction behavior is established separately by executable checks.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (parameters (param (name supersedes) (value (strs "OB-RESOLUTION-ROUTE" "OB-ROUTE-FLIP"))) (param (name vehicle) (value (str "generated-definition"))) (param (name composition) (value (str "complete")))) (dependencies "OB-GC-COMPOSITION") (dependencies "OB-SCOPE-CENSUS") (required_checks "CHK-GC-DEFINITION-V2-POS") (required_checks "CHK-GC-DEFINITION-V2-NEG"))
(obligation (id "OB-GC-DEFINITION-V3") (contract_id "rv64gc-lab-env-v3") (contract_version "3") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "This unit uses the generated-definition vehicle. Its encoding composition is complete for the declared profile scope, with no unbound slots; the canonical state, encoding/semantics and guest corpus own the generated state_rv64gc.rs, definition_rv64gc.rs and guests_rv64gc.rs mirrors. The owner generators and their drift gates govern those mirrors. Selection and generated-route consistency are scope evidence; instruction behavior is established separately by executable checks.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (parameters (param (name supersedes) (value (str "OB-GC-DEFINITION-V2"))) (param (name requirement_id) (value (str "REQ-D-ROUTE-FLIP"))) (param (name decision_id) (value (str "D-ROUTE-FLIP"))) (param (name vehicle) (value (str "generated-definition"))) (param (name composition) (value (str "complete")))) (dependencies "OB-GC-COMPOSITION") (dependencies "OB-SCOPE-CENSUS") (required_checks "CHK-GC-DEFINITION-V3-POS") (required_checks "CHK-GC-DEFINITION-V3-NEG"))
