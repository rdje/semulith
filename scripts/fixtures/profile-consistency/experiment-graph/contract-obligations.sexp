;; contract-obligations.sexp — a frozen subset of profiles/rv64gc-lab-v0/contract-obligations.sexp at commit 1fa19741, copied verbatim (XTASK.13 slice k):
;; probe_experiment_graph.py judges the effective-contract scope on these records, so a damaged live dossier fails
;; PROFILE-CONSISTENCY's real check by name instead of refusing its self-test.

(obligation (id "OB-FP-DEFER") (contract_id "rv64gc-lab-env-v0") (contract_version "0") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "F and D are in the profile because the standard RV64G userspace ABI is LP64D, which requires the D extension; the model implements no floating point until the floating-point backend passes qualification (P4-SYSTEM.7), the CPU-SYSTEM gate verdict reads incomplete until then, and a Sail-versus-Spike floating-point comparison is one implementation twice (the SoftFloat shared ancestry), never independent numeric evidence.") (authority laboratory) (source_refs (source_id "RVI-PSABI") (locator "§2.4–§2.5")) (parameters (param (name requirement_id) (value (str "REQ-D-FP-DEFER"))) (param (name decision_id) (value (str "D-FP-DEFER"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-FP-DEFER") (required_checks "CHK-FP-DEFER-POS") (required_checks "CHK-FP-DEFER-NEG"))
(obligation (id "OB-GC-FP-QUALIFIED-V2") (contract_id "rv64gc-lab-env-v2") (contract_version "2") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "The selected floating-point backend is the qualified rustc_apfloat 0.2.3+llvm-462a31f5a5ab, required as =0.2.3 and artifact-pinned by Cargo.lock, behind the RISC-V model layer crates/semulith-core/src/fp.rs. The qualification decision and closing measurement record finite evidence, including the model layer's corrections to overflow and underflow flags. F and D are implemented; their numeric and instruction guarantees retain their own checks. Sail and Spike share SoftFloat numeric ancestry, so their agreement is encoding/state evidence and never two independent numeric implementations. Supersedes the pre-qualification condition in OB-FP-DEFER; CPU acceptance still depends on every remaining gate.") (authority laboratory) (source_refs (source_id "RVI-F") (locator "20.1.4")) (source_refs (source_id "RVI-D") (locator "21.1.1")) (source_refs (source_id "RVI-PSABI") (locator "§2.4–§2.5")) (parameters (param (name supersedes) (value (str "OB-FP-DEFER"))) (param (name backend) (value (str "rustc_apfloat"))) (param (name backend_requirement) (value (str "=0.2.3"))) (param (name backend_artifact) (value (str "0.2.3+llvm-462a31f5a5ab"))) (param (name model_layer) (value (str "crates/semulith-core/src/fp.rs"))) (param (name qualification_record) (value (str "docs/decisions/decision_fp-backend-qualification.md"))) (param (name closing_record) (value (str "docs/decisions/reference_fp-model-layer-acceptance.md"))) (param (name sail_spike_numeric_independent) (value (false)))) (required_checks "CHK-GC-FP-QUALIFIED-V2-POS") (required_checks "CHK-GC-FP-QUALIFIED-V2-NEG"))
(obligation (id "OB-GC-FP-QUALIFIED-V3") (contract_id "rv64gc-lab-env-v3") (contract_version "3") (profile_ids "rv64gc-lab-v0") (direction cpu-guarantee) (statement "F and D are in the profile because the standard RV64G userspace ABI is LP64D, which requires the D extension, and both are implemented. The selected floating-point backend is the qualified rustc_apfloat 0.2.3+llvm-462a31f5a5ab, required as =0.2.3 and artifact-pinned by Cargo.lock, behind the RISC-V model layer crates/semulith-core/src/fp.rs. The qualification decision and closing measurement record finite evidence, including the model layer's corrections to overflow and underflow flags; the numeric and instruction guarantees retain their own checks. Sail and Spike share SoftFloat numeric ancestry, so their agreement is encoding/state evidence and never two independent numeric implementations.") (authority laboratory) (source_refs (source_id "RVI-F") (locator "20.1.4")) (source_refs (source_id "RVI-D") (locator "21.1.1")) (source_refs (source_id "RVI-PSABI") (locator "§2.4–§2.5")) (parameters (param (name supersedes) (value (str "OB-GC-FP-QUALIFIED-V2"))) (param (name requirement_id) (value (str "REQ-D-FP-DEFER"))) (param (name decision_id) (value (str "D-FP-DEFER"))) (param (name backend) (value (str "rustc_apfloat"))) (param (name backend_requirement) (value (str "=0.2.3"))) (param (name backend_artifact) (value (str "0.2.3+llvm-462a31f5a5ab"))) (param (name model_layer) (value (str "crates/semulith-core/src/fp.rs"))) (param (name qualification_record) (value (str "docs/decisions/decision_fp-backend-qualification.md"))) (param (name closing_record) (value (str "docs/decisions/reference_fp-model-layer-acceptance.md"))) (param (name sail_spike_numeric_independent) (value (false)))) (required_checks "CHK-GC-FP-QUALIFIED-V3-POS") (required_checks "CHK-GC-FP-QUALIFIED-V3-NEG"))
