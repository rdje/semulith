;; requirements.sexp — a frozen subset (REQ-D-FP-DEFER and REQ-D-ABI, its one dependency) of profiles/rv64gc-lab-v0/requirements.sexp at commit 1fa19741, copied verbatim (XTASK.13 slice k):
;; probe_experiment_graph.py judges the effective-contract scope on these records, so a damaged live dossier fails
;; PROFILE-CONSISTENCY's real check by name instead of refusing its self-test.

(requirement (id "REQ-D-FP-DEFER") (profile_ids "rv64gc-lab-v0") (kind configuration) (statement "F and D are in the profile because the standard RV64G userspace ABI is LP64D, which requires the D extension, and both are implemented. The selected floating-point backend is the qualified rustc_apfloat 0.2.3+llvm-462a31f5a5ab, required as =0.2.3 and artifact-pinned by Cargo.lock, behind the RISC-V model layer crates/semulith-core/src/fp.rs. The qualification decision and closing measurement record finite evidence, including the model layer's corrections to overflow and underflow flags; the numeric and instruction guarantees retain their own checks. Sail and Spike share SoftFloat numeric ancestry, so their agreement is encoding/state evidence and never two independent numeric implementations.") (source_refs (source_id "RVI-F") (locator "20.1.4")) (source_refs (source_id "RVI-D") (locator "21.1.1")) (source_refs (source_id "RVI-PSABI") (locator "§2.4–§2.5")) (applicability included) (research_status resolved) (implementation_status implemented) (source_semantics (category implementation-defined) (detail "The specification defines the options; the profile's selection among them is recorded here — a reference that selects otherwise is a smaller or different profile, not a defect in either.")) (risk high) (obligation_ids "OB-GC-FP-QUALIFIED-V3") (dependencies "REQ-D-ABI"))
(requirement (id "REQ-D-ABI") (profile_ids "rv64gc-lab-v0") (kind environment) (statement "The toolchain ABI is LP64D — the standard RV64G ABI (ELFCLASS64 with EF_RISCV_FLOAT_ABI_DOUBLE, the hardware floating-point calling convention with ABI_FLEN=64); the toolchain is the host's clang/lld 21.1.8 with an rv64gc target (the existing guest-toolchain decision).") (source_refs (source_id "RVI-PSABI") (locator "§2.4–§2.5")) (applicability included) (research_status resolved) (implementation_status implemented) (source_semantics (category implementation-defined) (detail "The specification defines the options; the profile's selection among them is recorded here — a reference that selects otherwise is a smaller or different profile, not a defect in either.")) (risk medium) (obligation_ids "OB-ABI"))
