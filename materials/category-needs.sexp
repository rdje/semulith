(category-need (category "C20") (layer board) (kind "abi-spec") (unit "sifive-uart-lab-v0") (disposition out-of-scope))
(category-need (category "C21") (layer board) (kind "datasheet") (unit "sifive-uart-lab-v0") (disposition out-of-scope) (reason "The serial wire is the environment's: RX recorded input and TX host console are the board's declared backend (board.sexp), not a material this unit acquires."))
(category-need (category "C22") (layer device) (kind "datasheet") (unit "sifive-uart-lab-v0") (disposition covered) (material "SIFIVE-FU540-C000"))
