(category-need (category "C04") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope) (reason "No instruction execution; the MMIO access semantics are C11's row."))
(category-need (category "C05") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope))
(category-need (category "C06") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope) (reason "No architectural arithmetic at the MMIO boundary; the baud divisor is a register value (REQ-D-UART-DIV), wire-rate numerics are unobservable with byte-granularity backends."))
(category-need (category "C07") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope))
(category-need (category "C08") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope))
(category-need (category "C09") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope) (reason "No issue groups; the register-level ordering rules (read-before-write after reset is not the UART's — that discipline is the NIC's REQ-D-NIC-FIRST-READ) — nothing of the category applies."))
(category-need (category "C10") (layer device) (kind "datasheet") (unit "sifive-uart-lab-v0") (disposition covered) (material "SIFIVE-FU540-C000"))
(category-need (category "C11") (layer device) (kind "datasheet") (unit "sifive-uart-lab-v0") (disposition covered) (material "SIFIVE-FU540-C000"))
(category-need (category "C12") (layer system) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope))
(category-need (category "C13") (layer device) (kind "isa-manual") (unit "sifive-uart-lab-v0") (disposition out-of-scope) (reason "No cache or instruction-visibility surface on a device; the board declares MMIO non-executable."))
(category-need (category "C14") (layer device) (kind "datasheet") (unit "sifive-uart-lab-v0") (disposition covered) (material "SIFIVE-FU540-C000"))
