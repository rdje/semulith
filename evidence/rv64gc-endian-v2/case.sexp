  (property (id "byte-0") (cell "form:lbu") (step_n 19) (register "x6") (expected 136)
    (statement "Little-endian: byte 0 is the least significant, so this reads 0x88 (RVI-RV32I §1.1.6)."))
  (property (id "byte-7") (cell "form:lbu") (step_n 21) (register "x6") (expected 17)
    (statement "Little-endian: byte 7 is the most significant, so this reads 0x11 (RVI-RV32I §1.1.6)."))
  (property (id "half-0") (cell "form:lhu") (step_n 23) (register "x6") (expected 0x7788)
    (statement "Little-endian: the low halfword, its low byte first, so this reads 0x7788 (RVI-RV32I §1.1.6)."))
  (property (id "word-4") (cell "form:lwu") (step_n 25) (register "x6") (expected 0x11223344)
    (statement "Little-endian: the high word, at offset 4, so this reads 0x11223344 (RVI-RV32I §1.1.6)."))
  (property (id "invariant-byte") (cell "form:lbu") (step_n 29) (register "x8") (expected 171)
    (statement "Byte-address invariant: a byte stored at an address reads back at that address (RVI-RV32I §1.1.6)."))
  (property (id "invariant-word") (cell "form:ld") (step_n 31) (register "x9") (expected 0x11223344ab667788)
    (statement "And it lands at byte 3 of the doubleword, counting from the least significant (RVI-RV32I §1.1.6)."))
  (property (id "no-big-endian-bits") (cell "form:csrrs") (step_n 38) (register "x12") (expected 0xa00000000)
    (statement "MBE, SBE and UBE read 0 after M tried to set them: no mode can select big-endian (RVP-MACHINE §2.1.1.6)."))
  (property (id "still-little") (cell "form:lbu") (step_n 40) (register "x13") (expected 136)
    (statement "So byte 0 still reads the least significant byte (RVI-RV32I §1.1.6)."))
