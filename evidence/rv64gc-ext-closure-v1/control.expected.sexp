(comment "Deliberately incorrect negative control: only boundary 60 x11 changes from 1234605616436508552 to 77. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "ext-closure-forms.s") (entry "0x0000000080000000") (instructions 64) (fetches 123) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "the base for the handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 16") (writes (write (reg "x1") (value "0x0000000080000010"))) (derivation "the handler, a few rows on: 0x0000000080000010.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "csrrw x0, mtvec, x1") (writes) (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7")) (step (n 3) (insn "jal x0, 20") (writes) (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1")) (step (n 4) (insn "lui x2, 6") (writes (write (reg "x2") (value "0x0000000000006000"))) (derivation "mstatus.FS's two bits: 0x0000000000006000.") (source "RVI-RV64I §3.1.2.1")) (step (n 5) (insn "csrrs x0, mstatus, x2") (writes) (derivation "FS = Dirty, so the floating-point forms may run; no GPR written.") (source "RVP-MACHINE §2.1.1.6.5")) (step (n 6) (insn "addi x5, x0, 1023") (writes (write (reg "x5") (value "0x00000000000003ff"))) (derivation "double-precision 1.0: 0x00000000000003ff.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "slli x5, x5, 52") (writes (write (reg "x5") (value "0x3ff0000000000000"))) (derivation "double-precision 1.0: 0x3ff0000000000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 8) (insn "fmv.d.x f1, x5") (writes) (derivation "into f1.") (source "RVI-D §21.1")) (step (n 9) (insn "fcvt.s.d f2, f1, 0") (writes) (derivation "D reaches F: the same value, narrowed.") (source "RVI-D §21.1")) (step (n 10) (insn "fmv.x.w x6, f2") (writes (write (reg "x6") (value "0x000000003f800000"))) (derivation "its single-precision bits: 0x000000003f800000.") (source "RVI-F §20.1 (boundary: D depends on F)")) (step (n 11) (insn "addi x7, x0, 127") (writes (write (reg "x7") (value "0x000000000000007f"))) (derivation "single-precision 1.