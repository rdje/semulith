tes (write (reg "x16") (value "0x0000000000000021"))) (derivation "fcsr composes both: 0x0000000000000021.") (source "RVI-F §20.1; RVI-ZICSR §5.1.1")) (step (n 36) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4")) (step (n 37) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "0x80000000: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 38) (insn "lui x1, 7") (writes (write (reg "x1") (value "0x0000000000007000"))) (derivation "0x7000: 0x0000000000007000.") (source "RVI-RV64I §3.1.2.1")) (step (n 39) (insn "add x1, x1, x10") (writes (write (reg "x1") (value "0x0000000080007000"))) (derivation "the data cell, on a page of its own, past this program: 0x0000000080007000.") (source "RVI-RV32I §1.1.4")) (step (n 40) (insn "c.mv x8, x1") (writes (write (reg "x8") (value "0x0000000080007000"))) (derivation "x8 = the data cell, a compact register: Zca is here.") (source "RVI-ZC §28.1.2 (boundary: Zca, always)")) (step (n 41) (insn "addi x17, x0, 1097") (writes (write (reg "x17") (value "0x0000000000000449"))) (derivation "a doubleword whose halves differ: 0x0000000000000449.") (source "RVI-RV32I §1.1.4")) (step (n 42) (insn "slli x17, x17, 12") (writes (write (reg "x17") (value "0x0000000000449000"))) (derivation "a doubleword whose halves differ: 0x0000000000449000.") (source "RVI-RV64I §3.1.2.1")) (step (n 43) (insn "addi x17, x17, -1843") (writes (write (reg "x17") (value "0x00000000004488cd"))) (derivation "a doubleword whose halves differ: 0x00000000004488cd.") (source "RVI-RV32I §1.1.4")) (step (n 44) (insn "slli x17, x17, 14") (writes (write (reg "x17") (value "0x0000001122334000"))) (derivation "a doubleword whose halves differ: 0x0000001122334000.") (source "RVI-RV64I §3.1.2.1")) (step (n 45) (insn "addi x17, x17, 1109") (writes (write (reg "x17") (value "0x0000001122334455"))) (derivation "a doub