(case (id "rv64gc-ext-closure-v1") (profile_id "rv64gc-lab-v0")
  (program "ext-closure-forms.s") (instructions 64) (source_size 6291)
  (source_sha256 "1369122b72702d8829f3623cda1189b365c6c75c8418dd91420c7ad8ca7e24ff")
  (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE")
  (contract_id "rv64gc-lab-env-v3") (contract_version "3")
  (control (property_id "zcf-absent-rd") (value 77) (reason "Only boundary 60 x11 expectation stays at its sentinel, what C.FLW would leave at RV32.") (id "zcf-present")
    (statement "Predeclared target: a hart reading this encoding as Zcf must diverge."))
  (limitation "12 finite predeclared witnesses. that nothing is inferred from the letter G is how the catalogue is written, not behaviour a run can witness")
  (source_id "RVI-ZC") (source_locator "§28.1.2") (category "defined") (risk "medium")
  (coverage "12 witnesses: D reaching F through the registers they share and F's boxing, F reaching its status and rounding through Zicsr, Zca, Zcd, and the encoding Zcf would own reading as C.LD")
  (authority (requirement_semantic_sha256 "0a8fd7512852e83daf74aaf6f72810f819e46170270c12c1612ab73bab7450a3") (obligation_id "OB-EXT-CLOSURE")
    (obligation_semantic_sha256 "11cd3756d276dec6795b913028f0959da90ef36281b22278a1273a0ae488f27c") (source_sha256 "3bc5a6f600995f96df57ea895f7db1f7fdba5967e7f084ae0be0e7a0d53924b6"))
  (required_input (role "normative-source") (id "RVI-ZC-STATEMENTS") (path "profiles/rv64gc-lab-v0/retained/rvi-zc-statements.html") (sha256 "2f46aedf9377ba698ab297187b84703f3b5d978d1a09ed71aa311b9bb32a810e"))
  (prepared (role "guest-image") (id "guest-image") (name "guest.elf") (byte_size 4568) (sha256 "8232f09dc24845b12ef813cc3dad9b9529914d43c631bdfc55d31614398d98e0"))
  (prepared (role "reference-config") (id "reference-config") (name "reference-config.json") (byte_size 7609) (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2"))
  (prepared (role "expectation") (id "expectation") (name "baseline.expected.sexp") (byte_size 12096) (sha256 "4360f8c24040774f653af535b1f8d0b2bbd52c11263aa061b0aa89aee62b168a"))
  (prepared (role "expectation") (id "mutant-expectation") (name "control.expected.sexp") (byte_size 11400) (sha256 "94c918e65f53eae709b91669334562b9d76dfeb600526eb1a15889085c8bb84b"))
  (property (id "d-narrows-to-f") (cell "form:fmv.x.w") (step_n 10) (register "x6") (expected 0x3f800000)
    (statement "D depends on F: FCVT.S.D writes a single into the registers both share, and FMV.X.W reads 1.0 (RVI-D §21.1)."))
  (property (id "f-boxed-in-d") (cell "form:fmv.x.d") (step_n 14) (register "x8") (expected 0xffffffff3f800000)
    (statement "The registers are D's width and F's values live in them NaN-boxed: the upper 32 bits read all ones (RVI-D §21.1)."))
  (property (id "f-reads-unboxed-as-nan") (cell "form:fmv.x.w") (step_n 17) (register "x9") (expected 0x7fc00000)
    (statement "And F depends on that boxing: an operand not boxed reads as the canonical NaN (RVI-D §21.1)."))
  (property (id "fcsr-holds-flags") (cell "form:csrrs") (step_n 19) (register "x10") (expected 0)
    (statement "The canonical NaN from an unboxed operand signals nothing, so fcsr still reads 0: F reaches its status through Zicsr (RVI-F §20.1; RVI-ZICSR §5.1.1)."))
  (property (id "fflags-through-zicsr") (cell "form:csrrs") (step_n 29) (register "x13") (expected 1)
    (statement "F depends on Zicsr for status: the inexact sum sets NX, which csrrs reads from fflags (RVI-F §20.1; RVI-ZICSR §5.1.1)."))
  (property (id "frm-through-zicsr") (cell "form:csrrs") (step_n 33) (register "x15") (expected 1)
    (statement "And for control: frm reads back the mode written through Zicsr (RVI-F §20.1; RVI-ZICSR §5.1.1)."))
  (property (id "fcsr-composes") (cell "form:csrrs") (step_n 35) (register "x16") (expected 33)
    (statement "fcsr composes the two, frm at bit 5 over fflags: 33 (RVI-F §20.1; RVI-ZICSR §5.1.1)."))
  (property (id "zca-present") (cell "form:c.mv") (step_n 40) (register "x8") (expected 0x80007000)
    (statement "C decomposes as Zca always: C.MV moves the data cell's address (RVI-ZC §28.1.2)."))
  (property (id "zcd-stores") (cell "form:ld") (step_n 55) (register "x19") (expected 0x4000000000000000)
    (statement "Zcd when D is present: C.FSD stores all 64 bits (RVI-ZC §28.1.2)."))
  (property (id "zcd-loads") (cell "form:fmv.x.d") (step_n 57) (register "x20") (expected 0x4000000000000000)
    (statement "And C.FLD loads them (RVI-ZC §28.1.2)."))
  (property (id "zcf-absent-rd") (cell "form:c.ld") (step_n 60) (register "x11") (expected 0x1122334455667788)
    (statement "Zcf exists only at RV32: this encoding loads all 64 bits into x11, as C.LD (RVI-ZC §28.1.2)."))
  (property (id "zcf-absent-fd") (cell "form:fmv.x.d") (step_n 62) (register "x21") (expected 0)
    (statement "And no float register took a word: f11 is still 0 (RVI-ZC §28.1.2)."))
