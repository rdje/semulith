(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-sv39-v2") (program "sv39-modes.s") (instructions 135) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a hart with Sv48 must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "11 finite predeclared witnesses. that the SoC precedent implements it is the selection's reasoning: no FU540 is run; the U54's A and D behaviour is REQ-D-SVADE's, and this case takes no position on it; S is the only mode translated here, and ASIDs are not exercised") (property (id "bare-at-reset") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "satp reads 0 at reset, MODE Bare: no translation until software chooses it (RVP-SUPERVISOR §11.1.1.11).") (gpr_witness (step_n 9) (register "x5"))) (property (id "sv48-from-bare") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "Of the three schemes defined for SXLEN=64 the profile selects Sv39, so a write naming Sv48 has no effect: satp still reads 0 (RVP-SUPERVISOR §11.1.3–§11.1.4).") (gpr_witness (step_n 17) (register "x5"))) (property (id "sv57-from-bare") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "Of the three schemes defined for SXLEN=64 the profile selects Sv39, so a write naming Sv57 has no effect: satp still reads 0 (RVP-SUPERVISOR §11.1.3–§11.1.4).") (gpr_witness (step_n 25) (register "x5"))) (property (id "sv39-taken") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "A write naming Sv39 takes: satp reads 0x8000000000080003, MODE 8 and the root's page number (RVP-SUPERVISOR §11.1.3–§11.1.4).") (gpr_witness (step_n 68) (register "x5"))) (property (id "sv48-over-sv39") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "And over Sv39 the same write leaves MODE and root as they were (RVP-SUPERVISOR §11.1.3–§11.1.4).") (gpr_witness (step_n 76) (register "x5"))) (property (id "walk-4k") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "A 4 KiB page, three levels down: VPN[2], VPN[1] and VPN[0] each index a table, and the load reads 66 (RVP-SUPERVISOR §11.1.4.1).") (gpr_witness (step_n 101) (register "x6"))) (property (id "walk-2m") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "A 2 MiB leaf at level 1: the load reads 66 through it (RVP-SUPERVISOR §11.1.4.1).") (gpr_witness (step_n 104) (register "x6"))) (property (id "walk-1g") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "A 1 GiB leaf at the root, reached by a canonical address at the top of the space: the load reads 66 (RVP-SUPERVISOR §11.1.4.1).") (gpr_witness (step_n 110) (register "x6"))) (property (id "not-canonical-cause") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "Virtual addresses are 39 bits: with bits 63 to 39 not all equal to bit 38 the load raises the page fault, 13 (RVP-SUPERVISOR §11.1.4.1).") (gpr_witness (step_n 120) (register "x22"))) (property (id "not-canonical-tval") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "And stval holds that address (RVP-SUPERVISOR §11.1.1.9).") (gpr_witness (step_n 121) (register "x23"))) (property (id "misaligned-superpage-cause") (requirement_id "REQ-D-SV39") (obligation_ids "OB-SV39") (observation_kinds "gpr-change") (statement "A superpage's low page-number bits must be zero: a leaf at level 1 with PPN[0] nonzero raises the page fault, 13 (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 130) (register "x22"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/sv39-modes.s") (sha256 "4a4f59b1035f96201ccda87a46ca9ffea8519e806ef050a249bf65d5dee3fb19")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-sv39-v2/guest.elf") (sha256 "ee1ee892a452ed0dbaf0f4d80446c5876df7e1c7220c61a5e89966b107d8cbf2")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-sv39-v2/reference-config.json") (sha256 "795320f7a2c79910683818942c0ce6d0422f04a5f7550dd136db5800fe951472")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-sv39-v2/baseline.expected.sexp") (sha256 "7bf44f6a8674ebef780613278e006fd3dcf0909e36290d57917339db93cb7a8d")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-sv39-v2/control.expected.sexp") (sha256 "10a209260c197205acbe7f577af1b78e1acaaa6485223346be80473230fca110")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-sv39-v2/dependencies.sexp") (sha256 "032496820162e542493184ab5da2d24b27981b54973664f9e1d0005dd1746b0d")) (producer (id "reference") (role "reference") (version "sha256:16de42a86e4ea7a300385092632cd95d153cb3f6c119d31eaa9384953990b7bf") (candidate_id "sail-riscv") (input_ids "guest-source") (input_ids "guest-image") (input_ids "reference-config") (input_ids "reference-identity") (input_ids "collector") (input_ids "adapter") (input_ids "dependency-manif