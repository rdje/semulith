EI") (observation_kinds "gpr-change") (statement "A store to a later instruction is visible to its fetch with no FENCE.I, the laboratory's declared choice, D-CODE-VISIBILITY: the patched instruction writes 8 to x3 (RVI-ZIFENCEI §4.1).") (gpr_witness (step_n 17) (register "x3"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/fencei-forms.s") (sha256 "5cd28bb535bcce66191d4fbb6efdbf34e8a13c025cdd873d66d73fdca4e7e727")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-fencei-v2/guest.elf") (sha256 "645e77468a89229cbc88e049725da326be3c525cc9244aded970817d53e1b4fa")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-fencei-v2/reference-config.json") (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-fencei-v2/baseline.expected.sexp") (sha256 "64b542a9a3c7bbd339cfea786b4b4066f2247884126f3ed2e1c49e0acf703bf2")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-fencei-v2/control.expected.sexp") (sha256 "605794b243ae788245069b45f3ccfebca1b0dd7085649be638b5a1ae91ad44f5")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-fencei-v2/dependencies.sexp") (sha256 "ff9ad1d73c322425c7f6ef77c4fe53b3921ec1ab55e62df2a0f4b5d212295c13")) (producer (id "reference") (role "reference") (version "sha256:16de42a86e4ea7a300385092632cd95d153cb