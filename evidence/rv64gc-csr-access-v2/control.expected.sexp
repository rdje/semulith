ed access reads cause 2)")) (step (n 40) (insn "csrrs x29, mepc, x0") (writes (write (reg "x29") (value "0x0000000080000098"))) (derivation "the refused instruction's own address: 0x0000000080000098.") (source "RVP-MACHINE §2.1.1.14")) (step (n 41) (insn "addi x29, x29, 4") (writes (write (reg "x29") (value "0x000000008000009c"))) (derivation "the instruction after it: 0x000000008000009c.") (source "RVI-RV32I §1.1.4")) (step (n 42) (insn "csrrw x0, mepc, x29") (writes) (derivation "resume there; no GPR written.") (source "RVP-MACHINE §2.1.1.14")) (step (n 43) (insn "mret") (writes) (derivation "back in the mode it came from.") (source "RVP-MACHINE §2.1.3.2")) (step (n 44) (insn "addi x26, x24, 0") (writes (write (reg "x26") (value "0x0000000000000029"))) (derivation "copied: 0x0000000000000029, nothing committed.") (source "RVP-CSR §1.1.1; RVI-ZICSR §5.1.1 (boundary: a refused CSRRS keeps rd)")) (step (n 45) (insn "addi x30, x0, 77") (writes (write (reg "x30") (value "0x000000000000004d"))) (derivation "a sentinel for the cause.") (source "RVI-RV32I §1.1.4")) (step (n 46) (insn "csrrsi x24, mhartid, 1") (writes) (derivation "uimm is not zero, so this attempts a write: illegal.") (source "RVP-CSR §1.1.1; RVI-ZICSR §5.1.1")) (step (n 47) (insn "csrrs x30, mcause, x0") (writes (write (reg "x30") (value "0x0000000000000002"))) (derivation "the handler reads mcause, replacing a sentinel: 0x0000000000000002.") (source "RVP-CSR §1.1.1; RVP-MACHINE §2.1.1.15 (boundary: a refused access reads cause 2)")) (step (n 48) (insn "csrrs x29, mepc, x0") (writes (write (reg "x29") (value "0x00000000800000a4"))) (derivation "the refused instruction's own address: 0x00000000800000a4.") (source "RVP-MACHINE §2.1.1.14")) (step (n 49) (insn "addi x29, x29, 4") (writes (write (reg "x29") (value "0x00000000800000a8"))) (derivation "the instruction after it: 0x00000000800000a8.") (source "RVI-RV32I §1.1.4")) (step (n 50) (insn "csrrw x0, mepc, x29") (writes) (derivation "resume there; no GPR