(comment "Deliberately incorrect negative control: only boundary 15 x15 changes from 31 to -1. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "csr-access.s") (entry "0x0000000080000000") (instructions 81) (fetches 162) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "the base for the handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 16") (writes (write (reg "x1") (value "0x0000000080000010"))) (derivation "the handler, at its offset from the start: 0x0000000080000010.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "csrrw x0, mtvec, x1") (writes) (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7")) (step (n 3) (insn "jal x0, 24") (writes) (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1")) (step (n 4) (insn "addi x5, x0, 85") (writes (write (reg "x5") (value "0x0000000000000055"))) (derivation "0x55, the first value.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "addi x6, x0, 77") (writes (write (reg "x6") (value "0x000000000000004d"))) (derivation "a sentinel, so reading the old 0 is a change.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "csrrw x6, mscratch, x5") (writes (write (reg "x6") (value "0x0000000000000000"))) (derivation "CSRRW swaps: x6 <- the old 0, mscratch <- 0x55.") (source "RVI-ZICSR §5.1.1 (boundary: CSRRW reads the old value)")) (step (n 7) (insn "csrrs x7, mscratch, x0") (writes (write (reg "x7") (value "0x0000000000000055"))) (derivation "with rs1 = x0 CSRRS only reads: 0x0000000000000055.") (source "RVI-ZICSR §5.1.1 (boundary: CSRRW wrote the new one)")) (step (n 8) (insn "addi x8, x0, 15") (writes (write (reg "x8") (value "0x000000000000000f"))) (derivation "0x0f, the bits to set.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "csrrs x9, mscratch, x8") (writes (write (reg "x9") (value "0x0000000000000055"))) (derivation "CSRRS reads the old value, 0x55, and sets rs1's bits.") (source "RVI-ZICSR §5.1.1")) (step (n 10) (insn "csrrs x10, mscratch, x0") (writes (write (reg "x10") (value "0x000000000000005f"))) (derivation "0x55") (source "0x0f: 0x000000000000005f. | RVI-ZICSR §5.1.1 (boundary: CSRRS sets only rs1's bits)")) (step (n 11) (insn "addi x11, x0, 80") (writes (write (reg "x11") (value "0x0000000000000050"))) (derivation "0x50, the bits to clear.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "csrrc x12, mscratch, x11") (writes (write (reg "x12") (value "0x000000000000005f"))) (derivation "CSRRC reads the old value, 0x5f, and clears rs1's bits.") (source "RVI-ZICSR §5.1.1")) (step (n 13) (insn "csrrs x13, mscratch, x0") (writes (write (reg "x13") (value "0x000000000000000f"))) (derivation "0x5f & ~0x50: 0x000000000000000f.") (source "RVI-ZICSR §5.1.1 (boundary: CSRRC clears only rs1's bits)")) (step (n 14) (insn "csrrwi x14, mscratch, 31") (writes (write (reg "x14") (value "0x000000000000000f"))) (derivation "CSRRWI reads the old value, 0x0f, and writes the immediate.") (source "RVI-ZICSR §5.1.1")) (step (n 15) (insn "csrrs x15, mscratch, x0") (writes (write (reg "x15") (value "0xffffffffffffffff"))) (derivation "the zero-extended 5-bit immediate: 0x000000000000001f.") (source "RVI-ZICSR §5.1.1 (boundary: CSRRWI's immediate is zero-extended)")) (step (n 16) (insn "csrrci x16, mscratch, 1") (writes (write (reg "x16") (value "0x000000000000001f"))) (derivation "CSRRCI reads the old value, 31, and clears bit 0.") (source "RVI-ZICSR §5.1.1")) (step (n 17) (insn "csrrs x17, mscratch, x0") (writes (write (reg "x17") (value "0x000000000000001e"))) (derivation "31 & ~1: 0x000000000000001e.") (source "RVI-ZICSR §5.1.1")) (step (n 18) (insn "csrrsi x18, mscratch, 1") (writes (write (reg "x18") (value "0x000000000000001e"))) (derivation "CSRRSI reads the old value, 30, and sets bit 0.") (source "RVI-ZICSR §5.1.1")) (step (n 19) (insn "csrrs x19, mscratch, x0") (writes (write (reg "x19") (value "0x000000000000001f"))) (derivation "30") (source "1: 0x000000000000001f. | RVI-ZICSR §5.1.1")) (step (n 20) (insn "addi x20, x0, 77") (writes (write (reg "x20") (value "0x000000000000004d"))) (derivation "a sentinel, so reading mhartid's 0 is a change.") (source "RVI-RV32I §1.1.4")) (step (n 21) (insn "csrrs x20, mhartid, x0") (writes (write (reg "x20") (value "0x0000000000000000"))) (derivation "mhartid is read-only, but rs1 = x0 attempts no write, so no trap: 0x0000000000000000.") (source "RVI-ZICSR §5.1.1; RVP-MACHINE §2.1.1.5 (boundary: CSRRS with rs1 = x0 on a read-only CSR)")) (step (n 22) (insn "addi x21, x0, 77") (writes (write (reg "x21") (value "0x000000000000004d"))) (derivation "a sentinel, so reading mhartid's 0 is a change.") (source "RVI-RV32I §1.1.4")) (step (n 23) (insn "csrrsi x21, mhartid, 0") (writes (write (reg "x21") (value "0x0000000000000000"))) (derivation "uimm = 0 attempts no write, so no trap: 0x0000000000000000.") (source "RVI-ZICSR §5.1.1; RVP-MACHINE §2.1.1.5 (boundary: CSRRSI with zero on a read-only CSR)")) (step (n 24) (insn "addi x22, x0, 77") (writes (write (reg "x22") (value "0x000000000000004d"))) (derivation "a sentinel, so reading mhartid's 0 is a change.") (source "RVI-RV32I §1.1.4")) (step (n 25) (insn "csrrc x22, mhartid, x0") (writes (write (reg "x22") (value "0x0000000000000000"))) (derivation "rs1 = x0 attempts no write, so no trap here either: 0x0000000000000000.") (source "RVI-ZICSR §5.1.1; RVP-MACHINE §2.1.1.4")) (step (n 26) (insn "addi x19, x0, 77") (writes (write (reg "x19") (value "0x000000000000004d"))) (derivation "a sentinel, so reading mhartid's 0 is a change.") (source "RVI-RV32I §1.1.4")) (step (n 27) (insn "csrrci x19, mhartid, 0") (writes (write (reg "x19") (value "0x0000000000000000"))) (derivation "uimm = 0 attempts no write: 0x0000000000000000.") (source "RVI-ZICSR §5.1.1; RVP-MACHINE §2.1.1.4")) (step (n 28) (insn "addi x24, x0, 41") (writes (write (reg "x24") (value "0x0000000000000029"))) (derivation "a sentinel: a refused access must leave it.") (source "RVI-RV32I §1.1.4")) (step (n 29) (insn "addi x30, x0, 77") (writes (write (reg "x30") (value "0x0000000