(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-csr-access-v2") (program "csr-access.s") (instructions 81) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a CSR immediate sign-extended must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "25 finite predeclared witnesses of the six Zicsr forms on mscratch, sscratch, mhartid and satp: swap, set and clear, the zero-extended immediate, the no-write cases on a read-only CSR, refused writes in M, a refused access in S and S's satp with TVM set, each keeping rd; that CSRRW with rd = x0 does not read has no side effect here to observe, and the counter and Sstc gates are REQ-GC-COUNTERS' and REQ-D-SSTC's; full source/risk/feature policy remains pending.") (property (id "csrrw-reads-old") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRW swaps: the old 0 replaces a sentinel in x6 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 6) (register "x6"))) (property (id "csrrw-writes-new") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRW wrote 0x55, and CSRRS with rs1 = x0 reads it into x7 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 7) (register "x7"))) (property (id "csrrs-reads-old") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRS reads the old value, 0x55, into x9 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 9) (register "x9"))) (property (id "csrrs-sets-bits") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRS sets only rs1's bits: 0x5f in x10 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 10) (register "x10"))) (property (id "csrrc-reads-old") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRC reads the old value, 0x5f, into x12 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 12) (register "x12"))) (property (id "csrrc-clears-bits") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRC clears only rs1's bits: 0x0f in x13 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 13) (register "x13"))) (property (id "csrrwi-reads-old") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRWI reads the old value, 0x0f, into x14 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 14) (register "x14"))) (property (id "csrrwi-zero-extended") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRWI's 5-bit immediate is zero-extended: 31 in x15 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 15) (register "x15"))) (property (id "csrrci-reads-old") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRCI reads the old value, 31, into x16 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 16) (register "x16"))) (property (id "csrrsi-reads-old") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRSI reads the old value, 30, into x18 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 18) (register "x18"))) (property (id "csrrs-x0-no-write") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRS with rs1 = x0 attempts no write, so a read-only CSR does not trap: its 0 replaces a sentinel in x20 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 21) (register "x20"))) (property (id "csrrsi-zero-no-write") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRSI with uimm = 0 attempts no write, so a read-only CSR does not trap: its 0 replaces a sentinel in x21 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 23) (register "x21"))) (property (id "refused-cause-0") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1).") (gpr_witness (step_n 31) (register "x30"))) (property (id "refused-csrrw-rd-kept") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "A write to a read-only CSR is refused, and rd keeps 41, copied to x25 (RVP-CSR §1.1.1).") (gpr_witness (step_n 36) (register "x25"))) (property (id "refused-cause-1") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1).") (gpr_witness (step_n 39) (register "x30"))) (property (id "refused-csrrs-rd-kept") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRS with rs1 not x0 attempts a write, so it is refused, and rd keeps 41, copied to x26 (RVP-CSR §1.1.1).") (gpr_witness (step_n 44) (register "x26"))) (property (id "refused-cause-2") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1).") (gpr_witness (step_n 47) (register "x30"))) (property (id "refused-csrrsi-rd-kept") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRSI with uimm not zero attempts a write, so it is refused, and rd keeps 41, copied to x27 (RVP-CSR §1.1.1).") (gpr_witness (step_n 52) (register "x27"))) (property (id "refused-cause-3") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1).") (gpr_witness (step_n 65) (register "x30"))) (property (id "s-refused-rd-kept") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "S is below mscratch's privilege, so its read is refused, and rd keeps 41, copied to x28 (RVP-CSR §1.1.1).") (gpr_witness (step_n 70) (register "x28"))) (property (id "s-reaches-own") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "S reaches sscratch: it reads back the 0x55 it wrote, in x31 (RVI-ZICSR §5.1.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 72) (register "x31"))) (property (id "csrrc-x0-no-write") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRC with rs1 = x0 attempts no write, so a read-only CSR does not trap: its 0 replaces a sentinel in x22 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 25) (register "x22"))) (property (id "csrrci-zero-no-write") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "CSRRCI with uimm = 0 attempts no write, so a read-only CSR does not trap: its 0 replaces a sentinel in x19 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 27) (register "x19"))) (property (id "satp-tvm-cause") (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS") (observation_kinds "gpr-change") (statement "With mstatus.TVM set, S's access to satp is illegal-instruction: mcause 2, replacing a sentinel in x30 (RVP-MACHINE §2.1.1.6.6).") (gpr_witness (step_n 75)