  (property (id "sltiu-sign-extended-first") (cell "form:sltiu") (step_n 12) (register "x16") (expected 1)
    (statement "SLTIU sign-extends its immediate first and then compares unsigned: 4096 < 2^64 - 1 writes 1 to x16 (RVI-RV32I §1.1.4.1)."))
  (property (id "sltiu-negative-operand") (cell "form:sltiu") (step_n 14) (register "x17") (expected 0)
    (statement "For SLTIU, 2^64 - 1 < 1 is false as unsigned numbers, replacing a sentinel in x17 with 0 (RVI-RV32I §1.1.4.1)."))
  (property (id "sltiu-below-one") (cell "form:sltiu") (step_n 15) (register "x18") (expected 1)
    (statement "SLTIU rd, rs1, 1 sets rd when rs1 is zero: 1 in x18 (RVI-RV32I §1.1.4.1)."))
  (property (id "xori-sign-extended") (cell "form:xori") (step_n 16) (register "x19") (expected 0xfffffffffffffffa)
    (statement "XORI with the sign-extended -1 is the bitwise NOT of 5 in x19 (RVI-RV32I §1.1.4.1)."))
  (property (id "ori-sign-extended") (cell "form:ori") (step_n 17) (register "x20") (expected 0xfffffffffffffff5)
