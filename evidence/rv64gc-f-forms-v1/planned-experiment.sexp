(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-f-forms-v1") (program "f-forms.s") (instructions 293) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a static rounding mode that is ignored must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "64 finite predeclared witnesses: all 30 forms at chosen values, static and dynamic rounding, the reserved modes writing nothing, each of the five flags and their accrual, tininess after rounding, the canonical NaN, payloads kept by the transfers and sign injection, NaN boxing and an improperly boxed input, conversions clipping and NaN inputs, FEQ quiet and FLT signaling, FS Off refusing and Dirty following an f-register or a flag alone; numeric results stand at these values, with no claim of exhaustiveness, and not witnessed are FMIN with two NaNs, a fused multiply of infinity by zero, FCLASS's other eight classes and FS Off on every form; full source/risk/feature policy remains pending.") (property (id "fs-off-cause") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "With FS Off every F instruction is illegal-instruction: mcause 2, replacing a sentinel (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 15) (register "x30"))) (property (id "fs-off-keeps-rd") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "And the refused move kept rd: 41, copied to x26 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 20) (register "x26"))) (property (id "fs-dirty") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "An f-register write makes the state Dirty: FS reads 3 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 32) (register "x19"))) (property (id "fmv-x-w-moves-bits") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMV.X.W moves -1.0's bits, the sign filling the upper word: 0xffffffffbf800000 in x7 (RVI-F §20.1.7).") (gpr_witness (step_n 43) (register "x7"))) (property (id "flw-loads") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FLW loads what FSW stored: 0x41100000, read back in x6 (RVI-F §20.1.5).") (gpr_witness (step_n 47) (register "x6"))) (property (id "fsw-stores") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FSW stored the bits, read back as an integer (RVI-F §20.1.5).") (gpr_witness (step_n 49) (register "x6"))) (property (id "transfers-keep-payload") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FLW, FSW and the moves keep a non-canonical NaN's payload (RVI-F §20.1.5; RVI-F §20.1.7).") (gpr_witness (step_n 59) (register "x6"))) (property (id "fadd-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FADD: 1.0 + 3.0 is exact: 0x40800000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 62) (register "x6"))) (property (id "fsub-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FSUB: 1.0 - 3.0 is exact: 0xc0000000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 65) (register "x6"))) (property (id "fmul-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMUL: 3.0 * 3.0 is exact: 0x41100000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 68) (register "x6"))) (property (id "fsqrt-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FSQRT of 9.0 is exact: 0x40400000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 74) (register "x6"))) (property (id "fmadd-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMADD: 3.0 * 3.0 + 1.0: 0x41200000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 77) (register "x6"))) (property (id "fmsub-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMSUB: 3.0 * 3.0 - 1.0: 0x41000000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 80) (register "x6"))) (property (id "fnmsub-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FNMSUB: -(3.0 * 3.0) + 1.0: 0xc1000000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 83) (register "x6"))) (property (id "fnmadd-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FNMADD: -(3.0 * 3.0) - 1.0: 0xc1200000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 86) (register "x6"))) (property (id "fsgnj-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FSGNJ takes rs2's sign: 0xbf800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 89) (register "x6"))) (property (id "fsgnjn-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FSGNJN takes the opposite of rs2's sign: 0x3f800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 92) (register "x6"))) (property (id "fsgnjx-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FSGNJX takes the XOR of the signs: 0x3f800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 95) (register "x6"))) (property (id "sgnj-keeps-payload") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "Sign injection does not canonicalize a NaN: 0x7f812345, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 98) (register "x6"))) (property (id "sgnj-sets-no-flag") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "And a signaling NaN sets no flag there: 0 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 100) (register "x20"))) (property (id "fmin-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMIN of 0.0 and -0.0, -0.0 counting as the smaller: 0x80000000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 109) (register "x6"))) (property (id "fmax-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMAX of 1.0 and 3.0: 0x40400000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 112) (register "x6"))) (property (id "fdiv-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FDIV: 1.0 / 3.0, to nearest, ties to even: 0x3eaaaaab, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 115) (register "x6"))) (property (id "inexact-flag") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "NX: an inexact result sets it: 1 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 117) (register "x20"))) (property (id "div-by-zero") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "1.0 / 0.0 is infinity: 0x7f800000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 120) (register "x6"))) (property (id "flags-accrue") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "DZ joins NX, which stays set: the flags are sticky: 9 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 122) (register "x20"))) (property (id "static-rounding") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "The same quotient under a static RDN: 0x3eaaaaaa, read back in x6 (RVI-F §20.1.6; RVI-F §20.1.2).") (gpr_witness (step_n 126) (register "x6"))) (property (id "dynamic-rounding") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "The same quotient under DYN, reading frm's RDN: 0x3eaaaaaa, read back in x6 (RVI-F §20.1.6; RVI-F §20.1.2).") (gpr_witness (step_n 130) (register "x6"))) (property (id "invalid-is-canonical") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "The square root of -1.0 is the canonical NaN: 0x7fc00000, read back in x6 (RVI-F §20.1.6; RVI-F §20.1.3).") (gpr_witness (step_n 135) (register "x6"))) (property (id "invalid-flag") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "NV: an invalid operation sets it: 16 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 137) (register "x20"))) (property (id "fmin-one-nan") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "With one NaN input FMIN returns the other, 1.0: 0x3f800000, read back in x6 (RVI-F §20.1.6).") (gpr_witness (step_n 141) (register "x6"))) (property (id "overflow-flag") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "OF and NX: an overflow sets both: 5 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 148) (register "x20"))) (property (id "underflow-flag") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "UF and NX: a tiny, inexact result sets both: 3 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 157) (register "x20"))) (property (id "tininess-after-rounding") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "Their product is below the least normal, and rounds up to it: 0x800000, read back in x6 (RVI-F §20.1.6; RVI-F §20.1.4).") (gpr_witness (step_n 169) (register "x6"))) (property (id "not-tiny-after-rounding") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "NX alone: tininess is detected after rounding, and this result is normal then: 1 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 171) (register "x20"))) (property (id "feq-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FEQ of equal values: 0x1 in x11 (RVI-F §20.1.8).") (gpr_witness (step_n 181) (register "x11"))) (property (id "flt-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FLT of 1.0 and 3.0: 0x1 in x12 (RVI-F §20.1.8).") (gpr_witness (step_n 183) (register "x12"))) (property (id "fle-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FLE of 3.0 and 1.0: 0x0 in x13 (RVI-F §20.1.8).") (gpr_witness (step_n 185) (register "x13"))) (property (id "feq-quiet") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FEQ on a quiet NaN sets no flag: 0 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 189) (register "x20"))) (property (id "fs-clean-stays") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FMV.X.W only reads the state, so it stays Clean: FS reads 2 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 200) (register "x19"))) (property (id "fs-flags-dirty") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "NV is new in fflags: that alone makes the state Dirty: FS reads 3 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 205) (register "x19"))) (property (id "flt-signaling") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FLT on a quiet NaN sets NV: 16 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 207) (register "x20"))) (property (id "fs-dirty-sd") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "And a Dirty FS sets mstatus.SD: 1 in x19 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 210) (register "x19"))) (property (id "fclass-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCLASS of 1.0 sets bit 6, a positive normal: 0x40 in x14 (RVI-F §20.1.9).") (gpr_witness (step_n 212) (register "x14"))) (property (id "fclass-signaling") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCLASS of a signaling NaN sets bit 8, 0x100 in x14 (RVI-F §20.1.9).") (gpr_witness (step_n 214) (register "x14"))) (property (id "fcvt-w-rounds") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.W of 1.5 rounds to nearest, ties to even: 0x2 in x15 (RVI-F §20.1.7).") (gpr_witness (step_n 218) (register "x15"))) (property (id "fcvt-w-rtz") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.W of 1.5 under a static RTZ: 1 in x15 (RVI-F §20.1.7; RVI-F §20.1.2).") (gpr_witness (step_n 220) (register "x15"))) (property (id "fcvt-wu-saturates") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.WU of -1.0 cannot be represented, and clips to: 0x0 in x16 (RVI-F §20.1.7).") (gpr_witness (step_n 223) (register "x16"))) (property (id "fcvt-invalid-flag") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "NV: an unrepresentable conversion sets it: 16 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 225) (register "x20"))) (property (id "fcvt-w-nan") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.W of a NaN clips to the largest word, 0x7fffffff in x15 (RVI-F §20.1.7).") (gpr_witness (step_n 228) (register "x15"))) (property (id "fcvt-wu-nan") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.WU of a NaN clips to the largest word, and RV64 sign-extends it: all ones in x16 (RVI-F §20.1.7).") (gpr_witness (step_n 230) (register "x16"))) (property (id "fcvt-l-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.L of -1.0: 0xffffffffffffffff in x17 (RVI-F §20.1.7).") (gpr_witness (step_n 232) (register "x17"))) (property (id "fcvt-l-nan") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.L of a NaN clips to the largest doubleword, in x17 (RVI-F §20.1.7).") (gpr_witness (step_n 234) (register "x17"))) (property (id "fcvt-lu-s") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "FCVT.LU of 3.0: 0x3 in x18 (RVI-F §20.1.7).") (gpr_witness (step_n 236) (register "x18"))) (property (id "fcvt-s-w") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "From the word -1: 0xbf800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 241) (register "x6"))) (property (id "fcvt-s-wu") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "From the unsigned word 2^32 - 1: 0x4f800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 244) (register "x6"))) (property (id "fcvt-s-l") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "From the doubleword -1: 0xbf800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 247) (register "x6"))) (property (id "fcvt-s-lu") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "From the unsigned doubleword 2^64 - 1: 0x5f800000, read back in x6 (RVI-F §20.1.7).") (gpr_witness (step_n 250) (register "x6"))) (property (id "improper-box-is-nan") (requirement_id "REQ-GC-F") (obligation_ids "OB-GC-F") (observation_kinds "gpr-change") (statement "An improperly boxed input reads as the canonical NaN, so the sum is