(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-load-ext-v2") (program "load-ext-forms.s") (instructions 32) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: an LW that does not sign-extend must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Twelve finite predeclared witnesses of the eleven load and store forms: each load's extension read at a value with its sign bit set, and each store read back, a store writing no GPR; byte offsets assume REQ-D-ENDIAN's little-endian order; alignment, faults and translation are not witnessed; full source/risk/feature policy remains pending.") (property (id "sd-ld-round-trip") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "SD stores 64 bits and LD loads them: the pattern back in x11 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 14) (register "x11"))) (property (id "ld-form") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LD loads a 64-bit value, and the first read moved nothing: the pattern in x22 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 15) (register "x22"))) (property (id "lw-sign-extends") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LW sign-extends: the word 0x88776655 has its sign bit set, in x12 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 16) (register "x12"))) (property (id "lwu-zero-extends") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LWU zero-extends the same word: x13 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 17) (register "x13"))) (property (id "lw-positive") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LW of a word with its sign bit clear: x14 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 18) (register "x14"))) (property (id "lh-sign-extends") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LH sign-extends the halfword 0x8877: x15 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 19) (register "x15"))) (property (id "lhu-zero-extends") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LHU zero-extends the same halfword: x16 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 20) (register "x16"))) (property (id "lb-sign-extends") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LB sign-extends the byte 0x88: x17 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 21) (register "x17"))) (property (id "lbu-zero-extends") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "LBU zero-extends the same byte: x18 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 22) (register "x18"))) (property (id "sb-low-byte-only") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "SB stores only the low 8 bits of rs2, read back over all ones: x19 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 25) (register "x19"))) (property (id "sh-low-half-only") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "SH stores only the low 16 bits of rs2, read back over all ones: x20 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 28) (register "x20"))) (property (id "sw-low-word-only") (requirement_id "REQ-D-LOAD-EXT") (obligation_ids "OB-LOAD-EXT") (observation_kinds "gpr-change") (statement "SW stores only the low 32 bits of rs2, read back over all ones: x21 (RVI-RV64I §3.1.3).") (gpr_witness (step_n 31) (register "x21"))) (input (id