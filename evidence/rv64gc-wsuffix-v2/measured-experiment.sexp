(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-wsuffix-v2") (program "wsuffix-forms.s") (instructions 17) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a word result not sign-extended must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Twelve finite predeclared witnesses of the nine *W forms: overflow ignored, the upper 32 bits of an input ignored, and each result sign-extended from bit 31; full source/risk/feature policy remains pending.") (property (id "addiw-overflow") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDIW's overflow is ignored and the word sign-extends: x10 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 5) (register "x10"))) (property (id "addiw-ignores-upper") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDIW ignores the upper 32 bits of its input: bit 32 is gone, 5 in x11 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 6) (register "x11"))) (property (id "slliw-sign-extends") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SLLIW's result sign-extends from bit 31 in x12 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 7) (register "x12"))) (property (id "srliw-by-zero") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRLIW by 0 still sign-extends the word: x13 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 8) (register "x13"))) (property (id "srliw-zero-fills") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRLIW shifts zeros into the word, clearing bit 31: x14 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 9) (register "x14"))) (property (id "sraiw-copies-bit-31") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRAIW copies bit 31 of the word: x15 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 10) (register "x15"))) (property (id "addw-overflow") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDW's overflow is ignored and the word sign-extends: x16 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 11) (register "x16"))) (property (id "addw-ignores-upper") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDW ignores the upper 32 bits of its input: bit 32 is gone, 1 in x17 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 12) (register "x17"))) (property (id "subw-underflow") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SUBW's underflow is ignored: 0x80000000 - 1 as a word is positive, in x18 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 13) (register "x18"))) (property (id "sllw-form") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SLLW: 0x7FFFFFFF << 1 as a word, sign-extended, -2 in x19 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 14) (register "x19"))) (property (id "srlw-ignores-upper") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRLW reads only the low word of all ones, so bit 31 clears: x20 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 15) (register "x20"))) (property (id "sraw-form") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRAW copies bit 3