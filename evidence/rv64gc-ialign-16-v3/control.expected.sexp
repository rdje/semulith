(comment "Deliberately incorrect negative control: only boundary 3 x3 changes from 2147483662 to 2147483660. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "ialign-16.s") (entry "0x0000000080000000") (instructions 11) (fetches 20) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "the base: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 14") (writes (write (reg "x1") (value "0x000000008000000e"))) (derivation "base + 14, on a halfword: 0x000000008000000e.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "jalr x2, x1, 0") (writes (write (reg "x2") (value "0x000000008000000c"))) (derivation "JALR to a halfword target raises no misaligned exception: the link is 0x000000008000000c.") (source "RVI-C §27.1 (boundary: JALR to a halfword)")) (step (n 3) (insn "auipc x3, 0") (writes (write (reg "x3") (value "0x000000008000000c"))) (derivation "a 32-bit instruction starting on a halfword: 0x000000008000000e.") (source "RVI-C §27.1 (boundary: a 32-bit instruction on a halfword)")) (step (n 4) (insn "c.li x4, 5") (writes (write (reg "x4") (value "0x0000000000000005"))) (derivation "a 16-bit instruction, two bytes on: 0x0000000000000005.") (source "RVI-C §27.1")) (step (n 5) (insn "beq x0, x0, 6") (writes) (derivation "BEQ to a halfword target raises no misaligned exception.") (source "RVI-C §27.1")) (step (n 6) (insn "auipc x5, 0") (writes (write (reg "x5") (value "0x000000008000001a"))) (derivation "landed on a halfword: 0x000000008000001a.") (source "RVI-C §27.1 (boundary: a branch to a halfword)")) (step (n 7) (insn "jal x6, 8") (writes (write (reg "x6") (value "0x0000000080000022"))) (derivation "JAL to a halfword target raises no misaligned exception: the link is 0x0000000080000022.") (source "RVI-C §27.1 (boundary: JAL to a halfword)")) (step (n 8) (insn "auipc x7, 0") (writes (write (reg "x7") (value "0x0000000080000026"))) (derivation "landed on a halfword: 0x0000000080000026.") (source "RVI-C §27.1 (boundary: the landing after JAL)")) (step (n 9) (insn "c.addi x4, 1") (writes (write (reg "x4") (value "0x0000000000000006"))) (derivation "16 bits again: 0x0000000000000006.") (source "RVI-C §27.1")) (step (n 10) (insn "auipc x8, 0") (writes (write (reg "x8") (value "0x000000008000002c"))) (derivation "two bytes on, on a word: 0x000000008000002c.") (source "RVI-C §27.1 (boundary: a 16-bit form advances the PC by two)")))
