(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-xlen-forms-v1") (program "xlen-forms.s") (instructions 25) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: wrong quotient must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Seventeen finite XLEN witnesses, predeclared: bit 63, 2^64 wrap, RV64 LUI, the *W family and the reported 64-bit address; full source/risk/feature policy remains pending.") (property (id "xlen-bit63") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SLLI with x5 = 1 and a shift amount of 63, the x5 change at boundary 1 is -2^63: bit 63 exists (RVI-RV64I §3.1.1, §3.1.2.1).") (gpr_witness (step_n 1) (register "x5"))) (property (id "xlen-srli63") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SRLI by 63 of -2^63 (x5), the x6 change at boundary 2 is 1: the top bit read back was bit 63 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 2) (register "x6"))) (property (id "xlen-srai63") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SRAI by 63 of -2^63 (x5), the x7 change at boundary 3 is -1: bit 63 copied into all 64 bits (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 3) (register "x7"))) (property (id "xlen-upper-word") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SLLI by 32 of -1 (x8), the x9 change at boundary 5 is 0xffffffff00000000: bits 32..63 are real register bits (RVI-RV64I §3.1.1).") (gpr_witness (step_n 5) (register "x9"))) (property (id "xlen-shamt-40") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SLLI by 40 of -1 (x8), the x10 change at boundary 6 is 0xffffff0000000000: a 6-bit shift amount above 31 is legal in RV64I (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 6) (register "x10"))) (property (id "xlen-max") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SRLI by 1 of -1 (x8), the x11 change at boundary 7 is 2^63 - 1, the largest positive XLEN value (RVI-RV64I §3.1.1, §3.1.2.1).") (gpr_witness (step_n 7) (register "x11"))) (property (id "xlen-wrap") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For ADDI of 1 to 2^63 - 1 (x11), the x12 change at boundary 8 is -2^63: the sum wraps modulo 2^64, no overflow trap (RVI-RV64I §3.1.1).") (gpr_witness (step_n 8) (register "x12"))) (property (id "xlen-carry") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For ADD of -1 (x8) to itself, the x13 change at boundary 9 is -2: the carry out of bit 63 is discarded (RVI-RV64I §3.1.1).") (gpr_witness (step_n 9) (register "x13"))) (property (id "rv64-lui") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For LUI 0x80000, the x14 change at boundary 10 is 0xffffffff80000000: the 32-bit result sign-extended to 64 bits (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 10) (register "x14"))) (property (id "rv64-addiw") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For ADDIW of 1 to 0xffffffff80000000 (x14), the x15 change at boundary 11 is 0xffffffff80000001: the 32-bit result sign-extended (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 11) (register "x15"))) (property (id "rv64-srliw") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SRLIW by 1 of the word 0x80000000 (x14), the x16 change at boundary 12 is 0x40000000: the word result sign-extended, bit 31 clear (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 12) (register "x16"))) (property (id "rv64-sraiw") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SRAIW by 1 of the word 0x80000000 (x14), the x17 change at boundary 13 is 0xffffffffc0000000: the word's sign copied, then sign-extended (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 13) (register "x17"))) (property (id "rv64-addw") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For ADDW of -1 (x8) and -2^63 (x5), the x18 change at boundary 14 is -1: bits 32..63 of the inputs are ignored and the word sign-extended (RVI-RV64I §3.1.2, §3.1.2.2).") (gpr_witness (step_n 14) (register "x18"))) (property (id "rv64-subw") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SUBW of 2^63 - 1 (x11) from 0, the x19 change at boundary 15 is 1: 0 - 0xffffffff as a word, sign-extended (RVI-RV64I §3.1.2.2).") (gpr_witness (step_n 15) (register "x19"))) (property (id "rv64-sllw") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SLLW of 1 (x6) by 2^63 - 1 (x11), the x20 change at boundary 16 is 0xffffffff80000000: the shift amount is rs2[4:0] = 31 and the word sign-extended (RVI-RV64I §3.1.2.2).") (gpr_witness (step_n 16) (register "x20"))) (property (id "xlen-address") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "For SLLI by 40 of 1, the x21 change at boundary 21 is 2^40: a 64-bit address outside every declared region (RVI-RV64I §3.1.1).") (gpr_witness (step_n 21) (register "x21"))) (property (id "xlen-address-reported") (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN") (observation_kinds "gpr-change") (statement "After a load at 2^40 faults, the handler's CSRRS of mtval changes x31 at boundary 24 to 2^40: the faulting address reported whole, all 64 bits (RVI-RV64I §3.1.1, the supported address space).") (gpr_witness (step_n 24) (register "x31"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/xlen-forms.s") (sha256 "83668ff2797349de578c5b9cc39278e2596f817810c6d1bb875bf06dc6ca4460")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "504bd637dca71d07b6dceed8a70576723ab3f4c1ae90f012868bf6e23bd0e2dd")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "4b7b16225c73d2123b9f177b7c484a6872fd4d106b9896223a12e340211db8da")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-xlen-forms-v1/guest.elf") (sha256 "89228f06141a273369da1607a3130b790b2ae722613f7e6b1edd48e92e57f5e0")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-xlen-forms-v1/reference-config.json") (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-xlen-forms-v1/baseline.expected.sexp") (sha256 "a932c58347bdda567520842f83e71b02213ba7333d2d802b8b7b7b30cf68d74c")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-xlen-forms-v1/control.expected.sexp") (sha256 "5f42512fef0fbc56483c64acec3bec6c00bb477d1111da9dacaa8e9e26dbde7b")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-xlen-forms-v1/dependencies.sexp") (sha256 "b42993ac9ad4f71729358c7c012b6cec676135f31c5297f978ea432fd7eb27fa")) (producer (id "reference") (role "reference") (version "sha256:16de42a86e4ea7a300385092632cd95d153cb3f6c119d31eaa9384953990b7bf") (candidate_id "sail-riscv") (input_ids "guest-source") (input_ids "guest-image") (input_ids "reference-config") (input_ids "reference-identit