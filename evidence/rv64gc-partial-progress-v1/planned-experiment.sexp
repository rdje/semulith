(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-partial-progress-v1") (program "partial-progress-forms.s") (instructions 163) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a faulting load committing rd must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "20 finite predeclared witnesses. the reads themselves are not observed in this vocabulary: a walk's are REQ-D-WALK-IMPLICIT's record, and a straddling fetch's first parcel and an AMO's completed load are the corpus's; that no suboperation is restartable is a claim over the whole engine, not one program; the fixtures the statement names are the corpus's: a fault injected at a chosen suboperation is past the reference; the negative evidence the statement names is the corpus's own") (property (id "hartid-before") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "The hart is hart 0 (RVP-MACHINE §2.1.1.5).") (gpr_witness (step_n 22) (register "x6"))) (property (id "csr-write-cause") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "The write to a read-only CSR raises illegal-instruction (RVI-INTRO Exceptions, Traps, and Interrupts).") (gpr_witness (step_n 31) (register "x30"))) (property (id "csr-rd-kept") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "No x-register write of the faulting instruction is committed: x10 still holds its sentinel (RVI-INTRO Exceptions, Traps, and Interrupts).") (gpr_witness (step_n 36) (register "x12"))) (property (id "load-cause") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "The load raises its page fault, 13 (RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 98) (register "x22"))) (property (id "load-tval") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "And the trap report carries the address (RVI-INTRO Exceptions, Traps, and Interrupts; RVP-SUPERVISOR §11.1.1.9).") (gpr_witness (step_n 99) (register "x23"))) (property (id "load-rd-kept") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "No x-register write of the faulting load: x6 still holds its sentinel (RVI-INTRO Exceptions, Traps, and Interrupts).") (gpr_witness (step_n 103) (register "x18"))) (property (id "f-before") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "f1 holds single-precision 1.0, boxed (RVI-F §20.1).") (gpr_witness (step_n 104) (register "x19"))) (property (id "fload-cause") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "The float load raises its page fault, 13 (RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 110) (register "x22"))) (property (id "f-kept") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "No f-register write of the faulting instruction: f1 reads as before (RVI-INTRO Exceptions, Traps, and Interrupts).") (gpr_witness (step_n 115) (register "x19"))) (property (id "fflags-kept") (requirement_id "REQ-GC-PARTIAL-PROGRESS") (obligation_ids "OB-GC-PARTIAL-PROGRESS") (observation_kinds "gpr-change") (statement "No fflags write of the faulting instruction: NX alone still reads (RVI-INTRO Exceptions, Traps, and Interrupts).") (gpr_witness (step_n 117) (register "x18"))) (property (id "fs-kept")