  (property (id "xor-form") (cell "form:xor") (step_n 15) (register "x18") (expected 0xfffffffffffffffc)
    (statement "XOR is bitwise: 5 ^ -7 in x18 (RVI-RV32I §1.1.4.2)."))
  (property (id "or-form") (cell "form:or") (step_n 16) (register "x19") (expected 0xfffffffffffffffd)
    (statement "OR is bitwise: 5 | -7 in x19 (RVI-RV32I §1.1.4.2)."))
  (property (id "and-form") (cell "form:and") (step_n 17) (register "x20") (expected 1)
    (statement "AND is bitwise: 5 & -7 in x20 (RVI-RV32I §1.1.4.2)."))
