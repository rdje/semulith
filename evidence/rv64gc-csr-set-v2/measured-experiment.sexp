(experiment (id "rv64gc-csr-set-v2") (program "csr-set.s") (instructions 157) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a refused CSR write that committed must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "All 33 CSRs of the committed set witnessed once each in fifty-three finite predeclared properties, with the aliases and the refused accesses in M, S and U; mip's value is compared only through sip because this case's reference configuration carries a CLINT device the laboratory does not declare, which holds mip.MTIP; per-CSR field semantics stay with P4-SYSTEM.2; full source, risk and feature policy remains pending.") (property (id "csr-mhartid") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "For CSRRS of mhartid with rs1 = x0, the x6 change at boundary 6 replaces a sentinel: mhartid is implemented and reads its reset value (RVP-MACHINE §2.1.1.5).") (gpr_witness (step_n 6) (register "x6"))) (property (id "csr-misa") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "For CSRRS of misa with rs1 = x0, the x7 change at boundary 8 replaces a sentinel: misa is implemented and reads its reset value (RVP-MACHINE §2.1.1.1).") (gpr_witness (step_n 8) (register "x7"))) (property (id "csr-mstatus") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "For CSRRS of mstatus with rs1 = x0, the x8 change at boundary 10 replaces a sentinel: mstatus is implemented and reads its reset value (RVP-MACHINE §2.1.1.6).") (gpr_witness (step_n 10) (register "x8"))) (property (id "csr-mtvec") (requirement_id "REQ-D-CSR-SET") (oblig