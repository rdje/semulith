(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-zicntr-v3") (program "zicntr.s") (instructions 292) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a refused counter read that committed must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Forty-four finite predeclared witnesses: the three base counters and the two machine views in M, their progress, five refused write attempts, and the read gates in S and U; a write through mcycle or minstret is not witnessed, because the spec-side deriver refuses it, nor is Zihpm's absence, because its vocabulary is the 33; this case's reference configuration carries a CLINT device the laboratory does not declare, at one tick per instruction, and the counters' rate and progress semantics stay the environment contract's; full source, risk and feature policy remains pending.") (property (id "m-reads-cycle") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "RDCYCLE in M replaces a sentinel in x5 with 6, one tick per boundary before it: no gate applies in M (RVI-ZICNTR §6.1.1).") (gpr_witness (step_n 6) (register "x5"))) (property (id "m-reads-time") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "RDTIME in M replaces a sentinel in x7 with 8: at one tick per boundary it reads the same count here (RVI-ZICNTR §6.1.1; the rate is the configuration's, the environment contract's to declare).") (gpr_witness (step_n 8) (register "x7"))) (property (id "m-reads-instret") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "RDINSTRET in M replaces a sentinel in x8 with 10, the instructions retired before it (RVI-ZICNTR §6.1.1).") (gpr_witness (step_n 10) (register "x8"))) (property (id "m-reads-mcycle") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcycle reads 12 into x9 in M, the machine view of the same count (RVP-MACHINE §2.1.1.10).") (gpr_witness (step_n 12) (register "x9"))) (property (id "m-reads-minstret") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "minstret reads 14 into x10 in M, the machine view of the same count (RVP-MACHINE §2.1.1.10).") (gpr_witness (step_n 14) (register "x10"))) (property (id "instret-progress") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "instret moved by 5 between its two reads, the five instructions retired there (RVI-ZICNTR §6.1.1).") (gpr_witness (step_n 22) (register "x16"))) (property (id "cycle-progress") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "cycle moved by 5 between its two reads, one tick per boundary (RVI-ZICNTR §6.1.1; the rate is the configuration's).") (gpr_witness (step_n 23) (register "x17"))) (property (id "ro-csrrw-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRW always writes on the read-only cycle: the handler reads mcause 2 into x30 (RVI-ZICNTR §6.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 27) (register "x30"))) (property (id "ro-csrrw-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRW always writes on the read-only cycle, and its rd x18 keeps the sentinel 7, copied to x19: nothing committed (RVI-ZICNTR §6.1).") (gpr_witness (step_n 33) (register "x19"))) (property (id "ro-csrrs-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRS with rs1 != x0 is a write attempt on the read-only instret: the handler reads mcause 2 into x30 (RVI-ZICNTR §6.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 37) (register "x30"))) (property (id "ro-csrrs-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRS with rs1 != x0 is a write attempt on the read-only instret, and its rd x18 keeps the sentinel 8, copied to x19: nothing committed (RVI-ZICNTR §6.1).") (gpr_witness (step_n 43) (register "x19"))) (property (id "ro-csrrsi-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRSI with uimm != 0 is a write attempt on the read-only instret: the handler reads mcause 2 into x30 (RVI-ZICNTR §6.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 47) (register "x30"))) (property (id "ro-csrrsi-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRSI with uimm != 0 is a write attempt on the read-only instret, and its rd x18 keeps the sentinel 9, copied to x19: nothing committed (RVI-ZICNTR §6.1).") (gpr_witness (step_n 53) (register "x19"))) (property (id "ro-csrrci-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRCI with uimm != 0 is a write attempt on the read-only time: the handler reads mcause 2 into x30 (RVI-ZICNTR §6.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 57) (register "x30"))) (property (id "ro-csrrci-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRCI with uimm != 0 is a write attempt on the read-only time, and its rd x18 keeps the sentinel 10, copied to x19: nothing committed (RVI-ZICNTR §6.1).") (gpr_witness (step_n 63) (register "x19"))) (property (id "ro-csrrwi-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRWI always writes on the read-only time: the handler reads mcause 2 into x30 (RVI-ZICNTR §6.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 67) (register "x30"))) (property (id "ro-csrrwi-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRWI always writes on the read-only time, and its rd x18 keeps the sentinel 11, copied to x19: nothing committed (RVI-ZICNTR §6.1).") (gpr_witness (step_n 73) (register "x19"))) (property (id "ro-read-rs1-x0") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRS of cycle with rs1 = x0 writes nothing, so the read is legal: 75 into x18 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 75) (register "x18"))) (property (id "ro-read-uimm-0") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CSRRSI of instret with uimm = 0 writes nothing, so the read is legal: 72 into x19 (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 77) (register "x19"))) (property (id "trap-retires-nothing") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "cycle minus instret grew by 1 across a refused instruction: its boundary ticked and retired nothing, and the handler's retired (RVI-ZICNTR §6.1.1).") (gpr_witness (step_n 92) (register "x16"))) (property (id "s-closed-cycle-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcounteren.CY is clear, so S's RDCYCLE is refused: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 103) (register "x30"))) (property (id "s-closed-cycle-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcounteren.CY is clear, so S's RDCYCLE is refused, and its rd x20 keeps the sentinel 21, copied to x21: nothing committed (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 109) (register "x21"))) (property (id "s-closed-time-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcounteren.TM is clear, so S's RDTIME is refused: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 113) (register "x30"))) (property (id "s-closed-time-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcounteren.TM is clear, so S's RDTIME is refused, and its rd x20 keeps the sentinel 22, copied to x21: nothing committed (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 119) (register "x21"))) (property (id "s-closed-instret-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcounteren.IR is clear, so S's RDINSTRET is refused: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 123) (register "x30"))) (property (id "s-closed-instret-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "mcounteren.IR is clear, so S's RDINSTRET is refused, and its rd x20 keeps the sentinel 23, copied to x21: nothing committed (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 129) (register "x21"))) (property (id "s-cy-time-cause") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CY alone is set, so S's RDTIME is still refused: each bit gates its own counter: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 153) (register "x30"))) (property (id "s-cy-time-rd-kept") (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR") (observation_kinds "gpr-change") (statement "CY alone is set, so S's RDTIME is still refused: each bit gates its own counter, and its rd x20 keeps the sentinel 24, copied to x21: nothing committed (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 159) (register "x21"))) (property (id "s-cy-instret-cause") (requirement_id