(experiment (id "rv64gc-priv-forms-v1") (program "priv-forms.s") (instructions 345) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a TSR that does not trap must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "24 finite predeclared witnesses. the stall's length and the fetches it withholds are not observed: each wfi here wakes at once, and no-op latitude is the catalogue's selection; TW is tested on an idle hart: with an interrupt pending under TW the reference completes the wfi and the laboratory refuses it, as the specification lets each do") (property (id "mret-sets-pc") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "mret in M executes and sets pc to mepc (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 16) (register "x7"))) (property (id "mret-pops") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "xRET pops the stack: MIE takes MPIE's 1, MPIE takes 1 and MPP takes U, which is 0 (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 18) (register "x8"))) (property (id "ecall-from-s") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "That mret reached S: the environment call from it raises 9 (RVP-MACHINE §2.1.3.1; RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 36) (register "x30"))) (property (id "mret-clears-mprv") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "xRET clears MPRV when the target is not M: bit 17 reads 0, with MPIE set and MPP recording S (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 41) (register "x8"))) (property (id "mret-in-s") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "mret below M raises illegal-instruction, 2: S is below it (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 54) (register "x30"))) (property (id "mret-in-u") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "And U is below it, 2 (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 69) (register "x30"))) (property (id "sret-in-u") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "sret below S raises illegal-instruction, 2 (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 84) (register "x30"))) (property (id "sret-sets-pc") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "sret in S executes and sets pc to sepc (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 100) (register "x7"))) (property (id "sret-pops") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "xRET pops the stack: SIE takes SPIE's 1, SPIE takes 1 and SPP takes U (RVP-MACHINE §2.1.3.2).") (gpr_witness (step_n 102) (register "x8"))) (property (id "sret-tsr") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "sret also raises in S when mstatus.TSR=1: 2 (RVP-MACHINE §2.1.1.6.6).") (gpr_witness (step_n 130) (register "x30"))) (property (id "sret-in-m") (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3") (observation_kinds "gpr-change") (statement "sret executes at its mode or higher: in M, even with TSR set, it reaches U at sepc (RVP-MACHINE §2.1.3.2; RVP-MACHINE §2.1.1.6.6).") (gpr_witness (step_n 138) (register "x7"))) (property (id "sret-reached-u") (requirement_id "REQ-GC-PRIV-INSNS") (o