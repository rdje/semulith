  (property (id "sret-reached-u") (cell "form:csrrs") (step_n 145) (register "x30") (expected 8)
    (statement "And it did reach U: the environment call raises 8 (RVP-MACHINE §2.1.3.1)."))
  (property (id "wfi-wakes-undelegated") (cell "form:wfi") (step_n 157) (register "x9") (expected 1)
    (statement "A locally-enabled pending interrupt wakes wfi regardless of the global enables and of mideleg: it retires and the next row runs (RVP-MACHINE §2.1.3.3)."))
  (property (id "wfi-wakes-delegated") (cell "form:addi") (step_n 160) (register "x9") (expected 2)
