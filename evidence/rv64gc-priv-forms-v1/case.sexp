(case (id "rv64gc-priv-forms-v1") (profile_id "rv64gc-lab-v0")
  (program "priv-forms.s") (instructions 345) (source_size 27269)
  (source_sha256 "2c52d7c8eecea07d4665cb013e3e7e587178ba923298ac405687f065c446f0cd")
  (requirement_id "REQ-GC-PRIV-INSNS") (obligation_ids "OB-GC-PRIV-INSNS-V3")
  (contract_id "rv64gc-lab-env-v3") (contract_version "3")
  (control (property_id "sret-tsr") (value 9) (reason "Only boundary 130 x30 expectation changes from 2 to 9, the record of the last trap, which a TSR that did not trap would leave standing.") (id "tsr-ignored")
    (statement "Predeclared target: a TSR that does not trap must diverge."))
  (limitation "24 finite predeclared witnesses. the stall's length and the fetches it withholds are not observed: each wfi here wakes at once, and no-op latitude is the catalogue's selection; TW is tested on an idle hart: with an interrupt pending under TW the reference completes the wfi and the laboratory refuses it, as the specification lets each do")
  (source_id "RVP-MACHINE") (source_locator "§2.1.3.2") (category "defined") (risk "high")
  (coverage "24 witnesses: mret and sret at and below their modes, TSR, what each pops and where each lands, MPRV, wfi waking in M and S, refused in U and under TW, sfence.vma refused in U and under TVM, and its four rs1 and rs2 cases")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
  (adversarial (property_ids "mret-in-s") (property_ids "mret-in-u") (property_ids "sret-in-u") (property_ids "sret-tsr") (property_ids "wfi-tw") (property_ids "wfi-in-u") (property_ids "sfence-in-u") (property_ids "sfence-tvm") (property_ids "sfence-va-asid")
    (failure_mode "a return or a fence executing below its mode, a trap bit ignored, or a mapping still visible after its fence"))
