(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-c-forms-v1") (program "c-forms.s") (instructions 223) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a C.JALR that links as a four-byte instruction must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "47 finite predeclared witnesses: all 37 forms over compact registers and scaled immediates, C.JALR's old source and its link at pc + 2, nine HINTs, C.EBREAK's cause and epc, the FS gate on compressed D memory, two reserved encodings and the all-zero parcel, the all-ones diagnostic, a C form between LR and SC, and sixteen-bit forms running from a page's last parcels; every reserved code point and immediate range is not enumerated, a constrained loop's eventual success is not exercised, the fetch width is witnessed by what ran, never by counting the environment's requests, and a second-parcel fetch fault is not witnessed here: a case's step fetches a word of a length or is a delivery boundary, and one that reads a parcel and retires nothing is neither, so the corpus guest c-page-straddle holds it until the next window; full source/risk/feature policy remains pending.") (property (id "c-fld-fs-off") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "With FS Off, C.FLD is illegal-instruction, and mtval keeps its sixteen bits, 0x2000 (RVI-C §27.1.3.2; RVP-MACHINE §2.1.1.6.7; RVP-MACHINE §2.1.1.16).") (gpr_witness (step_n 11) (register "x29"))) (property (id "c-fsdsp-fs-off") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "With FS Off, C.FSDSP is illegal-instruction, and mtval keeps its sixteen bits, 0xa426 (RVI-C §27.1.3.1; RVP-MACHINE §2.1.1.6.7; RVP-MACHINE §2.1.1.16).") (gpr_witness (step_n 21) (register "x29"))) (property (id "c-fld-off-writes-nothing") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "The refused C.FLD wrote nothing: f8 still reads 0, replacing a sentinel (RVI-C §27.1.3.2; RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 28) (register "x22"))) (property (id "c-li") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LI sign-extends its immediate: 0xffffffffffffffff in x8 (RVI-C §27.1.5.1).") (gpr_witness (step_n 29) (register "x8"))) (property (id "c-addi") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ADDI adds its immediate: 0x1 in x8 (RVI-C §27.1.5.2).") (gpr_witness (step_n 30) (register "x8"))) (property (id "c-mv") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.MV copies rs2: 0x1 in x9 (RVI-C §27.1.5.3).") (gpr_witness (step_n 31) (register "x9"))) (property (id "c-add") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ADD adds rs2: 0x2 in x9 (RVI-C §27.1.5.3).") (gpr_witness (step_n 32) (register "x9"))) (property (id "c-lui") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LUI sign-extends bit 17 up: 0xfffffffffffe0000 in x4 (RVI-C §27.1.5.1).") (gpr_witness (step_n 33) (register "x4"))) (property (id "c-slli") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.SLLI shifts left: 0x10 in x9 (RVI-C §27.1.5.2).") (gpr_witness (step_n 34) (register "x9"))) (property (id "c-srli") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.SRLI shifts in zeros: 0x8 in x9 (RVI-C §27.1.5.2).") (gpr_witness (step_n 35) (register "x9"))) (property (id "c-srai") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.SRAI copies the sign: -4 in x10 (RVI-C §27.1.5.2).") (gpr_witness (step_n 37) (register "x10"))) (property (id "c-andi") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ANDI sign-extends its immediate and ands: 4 in x10 (RVI-C §27.1.5.2).") (gpr_witness (step_n 38) (register "x10"))) (property (id "c-sub") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.SUB: 2 in x12 (RVI-C §27.1.5.3).") (gpr_witness (step_n 41) (register "x12"))) (property (id "c-xor") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.XOR: 2 in x13 (RVI-C §27.1.5.3).") (gpr_witness (step_n 43) (register "x13"))) (property (id "c-or") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.OR: 7 in x14 (RVI-C §27.1.5.3).") (gpr_witness (step_n 45) (register "x14"))) (property (id "c-and") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.AND: 4 in x15 (RVI-C §27.1.5.3).") (gpr_witness (step_n 47) (register "x15"))) (property (id "c-addiw") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ADDIW wraps at the word: 0x7fffffff in x8 (RVI-C §27.1.5.2).") (gpr_witness (step_n 49) (register "x8"))) (property (id "c-addw") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ADDW wraps at the word and sign-extends, in x8 (RVI-C §27.1.5.3).") (gpr_witness (step_n 51) (register "x8"))) (property (id "c-subw") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.SUBW wraps back: 0x7fffffff in x8 (RVI-C §27.1.5.3).") (gpr_witness (step_n 52) (register "x8"))) (property (id "c-addi16sp") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ADDI16SP sign-extends its immediate: sp + 64 - 32 (RVI-C §27.1.5.2).") (gpr_witness (step_n 58) (register "x2"))) (property (id "c-addi4spn") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.ADDI4SPN writes sp + 8 to x8, leaving sp (RVI-C §27.1.5.2).") (gpr_witness (step_n 59) (register "x8"))) (property (id "c-sw-lw") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LW reads back what C.SW stored, sign-extended: -3 in x10 (RVI-C §27.1.3.2).") (gpr_witness (step_n 62) (register "x10"))) (property (id "c-sd-ld") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LD reads back what C.SD stored: -3 in x11 (RVI-C §27.1.3.2).") (gpr_witness (step_n 64) (register "x11"))) (property (id "c-swsp-lwsp") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LWSP reads back what C.SWSP stored: -3 in x12 (RVI-C §27.1.3.1).") (gpr_witness (step_n 66) (register "x12"))) (property (id "c-sdsp-ldsp") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LDSP reads back what C.SDSP stored: -3 in x13 (RVI-C §27.1.3.1).") (gpr_witness (step_n 68) (register "x13"))) (property (id "c-fld-loads") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.FLD loads the 64 bits into f8, read back in x14 (RVI-C §27.1.3.2).") (gpr_witness (step_n 74) (register "x14"))) (property (id "c-fsd-stores") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.FSD stored the 64 bits, read back in x15 (RVI-C §27.1.3.2).") (gpr_witness (step_n 75) (register "x15"))) (property (id "c-fldsp-loads") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.FLDSP loads the 64 bits into f1, read back in x16 (RVI-C §27.1.3.1).") (gpr_witness (step_n 78) (register "x16"))) (property (id "c-fsdsp-stores") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.FSDSP stored the 64 bits, read back in x17 (RVI-C §27.1.3.1).") (gpr_witness (step_n 79) (register "x17"))) (property (id "c-nop-advances-two") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.NOP changes no visible state but the pc: AUIPC reads two bytes on, in x18 (RVI-C §27.1.5.5).") (gpr_witness (step_n 81) (register "x18"))) (property (id "hints-advance-only") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "Nine HINTs retire in sequence, each two bytes on: AUIPC reads the address that says so, in x19 (RVI-C §27.1.7).") (gpr_witness (step_n 91) (register "x19"))) (property (id "hints-keep-state") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "And none wrote its own destination: x8 still holds sp + 8, copied to x20 (RVI-C §27.1.7).") (gpr_witness (step_n 92) (register "x20"))) (property (id "c-beqz-taken") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.BEQZ is taken on zero, over one parcel: 9 in x9 at the landing (RVI-C §27.1.4).") (gpr_witness (step_n 95) (register "x9"))) (property (id "c-bnez-taken") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.BNEZ falls through on zero and is taken on nonzero: 11 in x11 at the landing (RVI-C §27.1.4).") (gpr_witness (step_n 99) (register "x11"))) (property (id "c-j-taken") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.J jumps over one parcel: 12 in x12 at the landing (RVI-C §27.1.4).") (gpr_witness (step_n 101) (register "x12"))) (property (id "c-jr-taken") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.JR jumps to rs1: 13 in x13 at the landing (RVI-C §27.1.4).") (gpr_witness (step_n 105) (register "x13"))) (property (id "c-jalr-links-next-parcel") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.JALR links pc + 2, the next parcel, not pc + 4, in x1 (RVI-C §27.1.4).") (gpr_witness (step_n 108) (register "x1"))) (property (id "c-jalr-takes-old-source") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "With rs1 and the link both x1, C.JALR takes the old source: 14 in x14 at the landing (RVI-C §27.1.4).") (gpr_witness (step_n 109) (register "x14"))) (property (id "c-keeps-reservation") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "A valid C form between LR.D and SC.D keeps the reservation: 0 in rd (RVI-C §27.1.6).") (gpr_witness (step_n 117) (register "x11"))) (property (id "c-ebreak-cause") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.EBREAK delivers the breakpoint, cause 3 (RVI-C §27.1.5.6; RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 124) (register "x30"))) (property (id "c-ebreak-epc") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "And mepc holds its own address (RVP-MACHINE §2.1.1.14).") (gpr_witness (step_n 126) (register "x28"))) (property (id "reserved-c-lwsp") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.LWSP with rd = x0 is reserved: illegal-instruction, with its sixteen bits, 0x4002, in mtval (RVI-C §27.1.3.1; RVP-MACHINE §2.1.1.16).") (gpr_witness (step_n 135) (register "x29"))) (property (id "reserved-c-jr") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.JR with rs1 = x0 is reserved: illegal-instruction, with its sixteen bits, 0x8002, in mtval (RVI-C §27.1.4; RVP-MACHINE §2.1.1.16).") (gpr_witness (step_n 145) (register "x29"))) (property (id "all-zero-parcel") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "A parcel of all zeros is permanently reserved: illegal-instruction (RVI-C §27.1.5.4; RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 154) (register "x30"))) (property (id "all-ones-keeps-ilen") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "The all-ones instruction is illegal, and mtval keeps all its 32 bits, ILEN (RVP-MACHINE §2.1.1.16).") (gpr_witness (step_n 165) (register "x29"))) (property (id "parcel-before-page-end") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "S runs a sixteen-bit form from the page's last word: 13 in x21 (RVI-C §27.1).") (gpr_witness (step_n 220) (register "x21"))) (property (id "one-parcel-at-page-end") (requirement_id "REQ-GC-C") (obligation_ids "OB-GC-C") (observation_kinds "gpr-change") (statement "C.JR in the page's very last parcel, before an invalid page, ran and landed here: 15 in x23. Fetch read no second parcel for it (RVI-C §27.1; RVI-C §27.1.4).") (gpr_witness (step_n 222) (register "x23"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/c-forms.s") (sha256 "6fe5d9be42d93c37ecfb578b9c58a6217c56d2a79a2073689144b64caabf6dca")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "504bd637dca71d07b6dceed8a70576723ab3f4c1ae90f012868bf6e23bd0e2dd")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "4b7b16225c73d2123b9f177b7c484a6872fd4d106b9896223a12e340211db8da")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-c-forms-v1/guest.elf") (sha256 "9d9ef85a7980808bbf3ab707f7c1f4758d7912703453bb6db70541d50a8abf89")) (input (id "reference-config") (role "r