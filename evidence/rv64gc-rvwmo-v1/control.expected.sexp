(comment "Deliberately incorrect negative control: only boundary 11 x6 changes from 41 to 0. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "rvwmo-forms.s") (entry "0x0000000080000000") (instructions 33) (fetches 65) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "the base for the handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 16") (writes (write (reg "x1") (value "0x0000000080000010"))) (derivation "the handler, a few rows on: 0x0000000080000010.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "csrrw x0, mtvec, x1") (writes) (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7")) (step (n 3) (insn "jal x0, 20") (writes) (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1")) (step (n 4) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "0x80000000: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 6) (insn "lui x1, 7") (writes (write (reg "x1") (value "0x0000000000007000"))) (derivation "0x7000: 0x0000000000007000.") (source "RVI-RV64I §3.1.2.1")) (step (n 7) (insn "add x1, x1, x10") (writes (write (reg "x1") (value "0x0000000080007000"))) (derivation "the data cell, on a page of its own, past this program: 0x0000000080007000.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "addi x5, x0, 41") (writes (write (reg "x5") (value "0x0000000000000029"))) (derivation "forty-one: 0x0000000000000029.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "sd x5, 0, x1") (writes) (derivation "the hart stores it.") (source "RVI-RV64I §3.1.3")) (step (n 10) (insn "addi x6, x0, 77") (writes (write (reg "x6") (value "0x000000000000004d"))) (derivation "a sentinel, so the next read changes it.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "ld x6, x1, 0") (writes (write (reg "x6") (value "0x0000000000000000"))