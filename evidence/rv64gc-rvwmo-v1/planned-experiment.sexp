(experiment (id "rv64gc-rvwmo-v1") (program "rvwmo-forms.s") (instructions 33) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a load missing its own hart's store must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "11 finite predeclared witnesses. a single hart cannot tell RVWMO from a stronger model: nothing here reorders, so this is what one hart sees of it; the multicore exposure is MC-MULTICORE's, and this claims nothing of it") (property (id "own-store") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "A hart's load sees its own earlier store, whatever the model lets another hart see (RVI-RVWMO §17.1).") (gpr_witness (step_n 11) (register "x6"))) (property (id "amo-plain") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "An AMO with no annotation returns the old value, 41 (RVI-A §12.1).") (gpr_witness (step_n 13) (register "x8"))) (property (id "amo-aq") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "With acquire, the same AMO returns the old value, 42: the annotation orders against other harts, and a single hart sees no difference (RVI-A §12.1; RVI-RVWMO §17.1).") (gpr_witness (step_n 14) (register "x8"))) (property (id "amo-rl") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "With release, the same AMO returns the old value, 43: the annotation orders against other harts, and a single hart sees no difference (RVI-A §12.1; RVI-RVWMO §17.1).") (gpr_witness (step_n 15) (register "x8"))) (property (id "amo-aqrl") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "With acquire and release, the same AMO returns the old value, 44: the annotation orders against other harts, and a single hart sees no difference (RVI-A §12.1; RVI-RVWMO §17.1).") (gpr_witness (step_n 16) (register "x8"))) (property (id "amo-all-stored") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "And all four stored their sums, 45 (RVI-A §12.1).") (gpr_witness (step_n 18) (register "x9"))) (property (id "lr-aq") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "LR with acquire reads the value, 45 (RVI-A §12.1).") (gpr_witness (step_n 19) (register "x10"))) (property (id "sc-rl") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "And SC with release pairs with it: rd = 0 (RVI-A §12.1).") (gpr_witness (step_n 22) (register "x12"))) (property (id "fence-all") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "FENCE IORW, IORW leaves a hart's own view as it was: 50 (RVI-RV32I §1.1.7; RVI-RVWMO §17.1).") (gpr_witness (step_n 25) (register "x13"))) (property (id "fence-rw") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "FENCE RW, RW leaves a hart's own view as it was: 50 (RVI-RV32I §1.1.7; RVI-RVWMO §17.1).") (gpr_witness (step_n 28) (register "x13"))) (property (id "fence-tso") (requirement_id "REQ-D-RVWMO") (obligation_ids "OB-RVWMO") (observation_kinds "gpr-change") (statement "FENCE.TSO leaves a hart's own view as it was: 50 (RVI-RV32I §1.1.7; RVI-RVWMO §17.1).") (gpr_witness (step_n 31) (register "x13"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/rvwmo-forms.s") (sha256 "16b02e73220479dee57db38398729dfedf61daeb80bc1aaeaba0db7e718ef7db")) (input (id "collector") (role "collector") (path "scripts/ma