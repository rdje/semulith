(case (id "rv64gc-zicntr-v2") (profile_id "rv64gc-lab-v0")
  (program "zicntr.s") (instructions 292) (source_size 16341)
  (source_sha256 "0b263d0bfc4e6392da0da7d3b9c3c4dae00a42a6d7934d70b569bf06d60f57fa")
  (requirement_id "REQ-D-ZICNTR") (obligation_ids "OB-ZICNTR")
  (contract_id "rv64gc-lab-env-v3") (contract_version "3")
  (control (property_id "s-closed-cycle-rd-kept") (value 102) (reason "Only boundary 109 x21 expectation changes from 21 to 102, the count S's refused read at boundary 102 would have committed.") (id "refused-read-committed")
    (statement "Predeclared target: a refused counter read that committed must diverge."))
  (limitation "Forty-four finite predeclared witnesses: the three base counters and the two machine views in M, their progress, five refused write attempts, and the read gates in S and U; a write through mcycle or minstret is not witnessed, because the spec-side deriver refuses it, nor is Zihpm's absence, because its vocabulary is the 33; this case's reference configuration carries a CLINT device the laboratory does not declare, at one tick per instruction, and the counters' rate and progress semantics stay the environment contract's; full source, risk and feature policy remains pending.")
  (source_id "RVI-ZICNTR") (source_locator "6.1") (category "implementation-defined") (risk "high")
  (coverage "forty-four ZICNTR witnesses: the base counters and machine views in M, their progress, refused writes, and the read gates in S and U")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters and the profile's recorded selection, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
  (adversarial (property_ids "ro-csrrw-rd-kept") (property_ids "ro-csrrs-rd-kept") (property_ids "ro-csrrsi-rd-kept") (property_ids "ro-csrrci-rd-kept") (property_ids "ro-csrrwi-rd-kept") (property_ids "s-closed-cycle-rd-kept") (property_ids "s-closed-time-rd-kept") (property_ids "s-closed-instret-rd-kept") (property_ids "s-cy-time-rd-kept") (property_ids "s-cy-instret-rd-kept") (property_ids "u-closed-cycle-rd-kept") (property_ids "u-ir-cycle-rd-kept") (property_ids "u-m-closed-instret-rd-kept")
    (failure_mode "a refused counter access commits its destination, or a gate lets a read through"))
