(comment "Deliberately incorrect negative control: only boundary 11 x16 changes from -2147483648 to 2147483648. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "wsuffix-forms.s") (entry "0x0000000080000000") (instructions 17) (fetches 34) (step (n 0) (insn "lui x5, 0x80000") (writes (write (reg "x5") (value "0xffffffff80000000"))) (derivation "a word with its sign bit set: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2")) (step (n 1) (insn "addi x6, x0, -1") (writes (write (reg "x6") (value "0xffffffffffffffff"))) (derivation "all 64 bits set: 0xffffffffffffffff.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "srli x7, x6, 33") (writes (write (reg "x7") (value "0x000000007fffffff"))) (derivation "0x7FFFFFFF, the largest positive word: 0x000000007fffffff.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2")) (step (n 3) (insn "addi x8, x0, 1") (writes (write (reg "x8") (value "0x0000000000000001"))) (derivation "1.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "slli x9, x8, 32") (writes (write (reg "x9") (value "0x0000000100000000"))) (derivation "bit 32 alone, above every word: 0x0000000100000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2")) (step (n 5) (insn "addiw x10, x7, 1") (writes (write (reg "x10") (value "0xffffffff80000000"))) (derivation "ADDIW: overflow is ignored and the word sign-extends: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: ADDIW overflow)")) (step (n 6) (insn "addiw x11, x9, 5") (writes (write (reg "x11") (value "0x0000000000000005"))) (derivation "ADDIW ignores bit 32 of its input: 0x0000000000000005.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: ADDIW ignores the upper bits)")) (step (n 7) (insn "slliw x12, x8, 31") (writes (write (reg "x12") (value "0xffffffff80000000"))) (derivation "SLLIW: bit 31 of the word, sign-extended: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: SLLIW's result sign-extends)")) (step (n 8) (insn "srliw x13, x5, 0") (writes (write (reg "x13") (value "0xffffffff80000000"))) (derivation "SRLIW by 0 still sign-extends the word: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: SRLIW by zero)")) (step (n 9) (insn "srliw x14, x5, 1") (writes (write (reg "x14") (value "0x0000000040000000"))) (derivation "SRLIW shifts zeros into the word, so bit 31 clears: 0x0000000040000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: SRLIW zero-fills the word)")) (step (n 10) (insn "sraiw x15, x5, 1") (writes (write (reg "x15") (value "0xffffffffc0000000"))) (derivation "SRAIW copies bit 31 of the word: 0xffffffffc0000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: SRAIW copies bit 31)")) (step (n 11) (insn "addw x16, x7, x8") (writes (write (reg "x16") (value "0x0000000080000000"))) (derivation "ADDW: overflow is ignored and the word sign-extends: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: ADDW overflow)")) (step (n 12) (insn "addw x17, x9, x8") (writes (write (reg "x17") (value "0x0000000000000001"))) (derivation "ADDW ignores bit 32 of its input: 0x0000000000000001.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: ADDW ignores the upper bits)")) (step (n 13) (insn "subw x18, x5, x8") (writes (write (reg "x18") (value "0x000000007fffffff"))) (derivation "SUBW: the word's underflow is ignored: 0x000000007fffffff.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: SUBW underflow)")) (step (n 14) (insn "sllw x19, x7, x8") (writes (write (reg "x19") (value "0xfffffffffffffffe"))) (derivation "SLLW: the word shifted, sign-extended: 0xfffffffffffffffe.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2")) (step (n 15) (insn "srlw x20, x6, x8") (writes (write (reg "x20") (value "0x000000007fffffff"))) (derivation "SRLW reads only the low word of all ones, so bit 31 clears: 0x000000007fffffff.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2 (boundary: SRLW ignores the upper bits)")) (step (n 16) (insn "sraw x21, x5, x8") (writes (write (reg "x21") (value "0xffffffffc0000000"))) (derivation "SRAW copies bit 31 of the word: 0xffffffffc0000000.") (source "RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2")))
