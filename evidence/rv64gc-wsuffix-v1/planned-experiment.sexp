(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-wsuffix-v1") (program "wsuffix-forms.s") (instructions 17) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a word result not sign-extended must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Twelve finite predeclared witnesses of the nine *W forms: overflow ignored, the upper 32 bits of an input ignored, and each result sign-extended from bit 31; full source/risk/feature policy remains pending.") (property (id "addiw-overflow") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDIW's overflow is ignored and the word sign-extends: x10 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 5) (register "x10"))) (property (id "addiw-ignores-upper") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDIW ignores the upper 32 bits of its input: bit 32 is gone, 5 in x11 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 6) (register "x11"))) (property (id "slliw-sign-extends") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SLLIW's result sign-extends from bit 31 in x12 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 7) (register "x12"))) (property (id "srliw-by-zero") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRLIW by 0 still sign-extends the word: x13 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 8) (register "x13"))) (property (id "srliw-zero-fills") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRLIW shifts zeros into the word, clearing bit 31: x14 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 9) (register "x14"))) (property (id "sraiw-copies-bit-31") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRAIW copies bit 31 of the word: x15 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 10) (register "x15"))) (property (id "addw-overflow") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDW's overflow is ignored and the word sign-extends: x16 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 11) (register "x16"))) (property (id "addw-ignores-upper") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "ADDW ignores the upper 32 bits of its input: bit 32 is gone, 1 in x17 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 12) (register "x17"))) (property (id "subw-underflow") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SUBW's underflow is ignored: 0x80000000 - 1 as a word is positive, in x18 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 13) (register "x18"))) (property (id "sllw-form") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SLLW: 0x7FFFFFFF << 1 as a word, sign-extended, -2 in x19 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 14) (register "x19"))) (property (id "srlw-ignores-upper") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRLW reads only the low word of all ones, so bit 31 clears: x20 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 15) (register "x20"))) (property (id "sraw-form") (requirement_id "REQ-D-WSUFFIX") (obligation_ids "OB-WSUFFIX") (observation_kinds "gpr-change") (statement "SRAW copies bit 31 of the word: x21 (RVI-RV64I §3.1.2, §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 16) (register "x21"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/wsuffix-forms.s") (sha256 "7c729650a07074c23d2adf9e4e2389606f6789dde2a2de90bbafc393d5ee7810")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "504bd637dca71d07b6dceed8a70576723ab3f4c1ae90f012868bf6e23bd0e2dd")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "4b7b16225c73d2123b9f177b7c484a6872fd4d106b9896223a12e340211db8da")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-wsuffix-v1/guest.elf") (sha256 "9988499616f9410bcc274f27252593d605578ecddad4b049239ab355643b5df7")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-wsuffix-v1/reference-config.json") (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-wsuffix-v1/baseline.expected.sexp") (sha256 "bf773362eb009abf337e54cb6bc2f350bae2b950caa19d6c272c833ed955cddb")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-wsuffix-v1/control.expected.sexp") (sha256 "e2ecc2831e600059031b9e7bc784e7916ce6ac72dc8bb8a9337dbdec120122eb")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-wsuffix-v1/dependencies.sexp") (sha256 "7e36f4416a30cdd90e37e9bf0a8f4e42e022a33739004cf59fb94634a9785750")) (producer (id "reference") (role "reference") (version "sha256:16de42a86e4ea7a300385092632cd95d153cb3f6c119d31eaa9384953990b7bf") (candidate_id "sail-riscv") (input_ids "guest-source") (input_ids "guest-image") (input_ids "reference-config") (input_ids "reference-ident