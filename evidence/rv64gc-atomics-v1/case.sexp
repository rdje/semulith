  (control (property_id "amoadd-w-old") (value 0xfffffffb) (reason "Only boundary 21 x5 expectation changes from -5 to 0xfffffffb, what a word AMO that did not sign-extend would read.") (id "word-not-sign-extended")
    (statement "Predeclared target: a word AMO that did not sign-extend must diverge."))
  (limitation "64 finite predeclared witnesses at one hart: each AMO's old and new value at both widths, word sign extension and the upper word kept and ignored, rd equal to rs2 and to rs1, the ordering bits decoding, LR and SC success, failure and a consumed reservation, an access fault keeping rd and registering nothing, and an AMO on an execute-only page raising the store page fault; a misaligned atomic is REQ-D-ATOMIC-MISALIGN's, physical aliases and width matching REQ-D-RESERVATION's and REQ-D-SC-DETERMINISTIC's, and one hart earns no multicore or weak-memory claim; full source/risk/feature policy remains pending.")
  (source_id "RVI-A") (source_locator "12.1.4") (category "defined") (risk "high")
  (coverage "64 witnesses: the 22 forms, aliases, reservation history, faults and one translated page each way")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
  (adversarial (property_ids "amo-fault-keeps-rd") (property_ids "lr-fault-keeps-rd") (property_ids "second-sc-fails") (property_ids "failed-sc-stores-nothing") (property_ids "lr-fault-reserves-nothing") (property_ids "rd-equals-rs2-sum") (property_ids "rd-equals-rs1-sum") (property_ids "amo-unreadable-cause")
