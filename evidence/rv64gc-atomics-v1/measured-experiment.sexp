(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-atomics-v1") (program "atomics-forms.s") (instructions 246) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a word AMO that did not sign-extend must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "64 finite predeclared witnesses at one hart: each AMO's old and new value at both widths, word sign extension and the upper word kept and ignored, rd equal to rs2 and to rs1, the ordering bits decoding, LR and SC success, failure and a consumed reservation, an access fault keeping rd and registering nothing, and an AMO on an execute-only page raising the store page fault; a misaligned atomic is REQ-D-ATOMIC-MISALIGN's, physical aliases and width matching REQ-D-RESERVATION's and REQ-D-SC-DETERMINISTIC's, and one hart earns no multicore or weak-memory claim; full source/risk/feature policy remains pending.") (property (id "amoswap-w-old") (requirement_id "REQ-GC-ATOMICS") (obligation_ids "OB-GC-ATOMICS") (observation_kinds "gpr-change") (statement "AMOSWAP.W reads the old -5 into rd, replacing a sentinel, sign-extended (RVI-A §12.1.4).") (gpr_witness (step_n 16) (register "x5"))) (property (id "amoswap-w-new") (requirement_id "REQ-GC-ATOMICS") (obligation_ids "OB-GC-ATOMICS") (observation_kinds "gpr-change") (statement "AMOSWAP.W of -5 and 7 leaves 0x7 in memory, read back (RVI-A §12.1.4).") (gpr_witness (step_n 18) (register "x8"))) (property (id "amoadd-w-old") (requirement_id "REQ-GC-ATOMICS") (obligation_ids "OB-GC-ATOMICS") (observation_kinds "gpr-change") (statement "AMOADD.W reads the old -5 into rd, replacing a sentinel, sign-extended (RVI-A §12.1.4).") (gpr_witness (step_n 21) (register "x5"))) (property (id "amoadd-w-new") (requirement_id "REQ-GC-ATOMICS") (o