 (step_n 70) (register "x15"))) (property (id "csr-mip") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "CSRRS of mip with rd = x0 at boundary 19 does not trap, so the marker runs and x13 changes to 1 at boundary 20: mip is implemented. Its value is compared only through sip, csr-sip-alias (RVP-MACHINE §2.1.1.9).") (gpr_witness (step_n 20) (register "x13"))) (property (id "alias-sie-mie") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "After CSRRSI of 2 through sie with SSI delegated, mie reads 2 into x11: one register, two names (RVP-SUPERVISOR §11.1.1.3).") (gpr_witness (step_n 74) (register "x11"))) (property (id "csr-sip-alias") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "After CSRRSI of 2 through mip with SSI delegated, sip reads 2 into x12: one register, two names (RVP-SUPERVISOR §11.1.1.3).") (gpr_witness (step_n 77) (register "x12"))) (property (id "alias-sip-clear") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "After CSRRCI of 2 through sip, sip reads 0 into x12, so nothing is pending when S is entered (RVP-SUPERVISOR §11.1.1.3).") (gpr_witness (step_n 80) (register "x12"))) (property (id "alias-sstatus-mstatus") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "After CSRRSI of 2 through sstatus, mstatus reads SIE set into x13 (RVP-SUPERVISOR §11.1.1.1).") (gpr_witness (step_n 83) (register "x13"))) (property (id "alias-fcsr") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "After 31 through fflags and 4 through frm, fcsr reads (4 << 5) | 31 into x14 (RVI-F §20.1.2).") (gpr_witness (step_n 87) (register "x14"))) (property (id "fs-dirty-sd") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "The FP CSR writes make mstatus.FS Dirty and SD summarizes it, read into x15 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 89) (register "x15"))) (property (id "refused-csrrw-cause") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "CSRRW to the read-only mhartid raises illegal-instruction: the handler reads mcause 2 into x30 (RVP-CSR §1.1.1).") (gpr_witness (step_n 94) (register "x30"))) (property (id "refused-csrrw-rd-kept") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "The refused CSRRW leaves its rd x5 at the sentinel 7, copied to x16: nothing committed (RVP-CSR §1.1.1).") (gpr_witness (step_n 101) (register "x16"))) (property (id "refused-csrrs-cause") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "CSRRS with rs1 != x0 on the read-only mhartid raises illegal-instruction: mcause 2 into x30 (RVI-ZICSR §5.1.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 104) (register "x30"))) (property (id "refused-csrrs-rd-kept") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "The refused CSRRS leaves its rd x5 at 7: x5 + 1 = 8 into x16, nothing committed (RVP-CSR §1.1.1).") (gpr_witness (step_n 111) (register "x16"))) (property (id "mhartid-kept") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "mhartid reads 0 into x17 after both refused writes of 9: the destination kept its value, and CSRRS with rs1 = x0 is legal on a read-only CSR (RVI-ZICSR §5.1.1; RVP-CSR §1.1.1).") (gpr_witness (step_n 113) (register "x17"))) (property (id "s-reads-sstatus") (requirement_id "REQ-D-CSR-SET") (obligation_ids "OB-CSR-SET") (observation_kinds "gpr-change") (statement "sstatus reads in S into x18: mstatus's supervisor view with SD, UXL, FS Dirty and SIE (