(comment "Deliberately incorrect negative control: only boundary 13 x6 changes from 1 to 0. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "priv-insns-forms.s") (entry "0x0000000080000000") (instructions 30) (fetches 59) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "the base for the handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 16") (writes (write (reg "x1") (value "0x0000000080000010"))) (derivation "the handler, a few rows on: 0x0000000080000010.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "csrrw x0, mtvec, x1") (writes) (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7")) (step (n 3) (insn "jal x0, 20") (writes) (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1")) (step (n 4) (insn "addi x25, x0, 3") (writes (write (reg "x25") (value "0x0000000000000003"))) (derivation "both MPP bits: 0x0000000000000003.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "slli x25, x25, 11") (writes (write (reg "x25") (value "0x0000000000001800"))) (derivation "at bit 11, kept in x25: 0x0000000000001800.") (source "RVI-RV64I §3.1.2.1")) (step (n 6) (insn "addi x19, x0, 1") (writes (write (reg "x19") (value "0x0000000000000001"))) (derivation "MPP = S: 0x0000000000000001.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "slli x19, x19, 11") (writes (write (reg "x19") (value "0x0000000000000800"))) (derivation "at bit 11, kept in x19: 0x0000000000000800.") (source "RVI-RV64I §3.1.2.1")) (step (n 8) (insn "addi x5, x0, 2") (writes (write (reg "x5") (value "0x0000000000000002"))) (derivation "the supervisor software interrupt's bit: 0x0000000000000002.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "csrrs x0, mideleg, x5") (writes) (derivation "delegated to S; no GPR written.") (source "RVP-MACHINE §2.1.1.8")) (step (n 10) (insn "csrrs x0, mie, x5") (writes) (derivation "enabled locally; no GPR written.") (source "RVP-MACHINE §2.1.1.9")) (step (n 11) (insn "csrrs x0, mip, x5") (writes) (derivation "and pending; no GPR written.") (source "RVP-MACHINE §2.1.1.9")) (step (n 12) (insn "wfi") (writes) (derivation "wfi in M, with an interrupt pending and enabled: nothing to wait for.") (source "RVP-MACHINE §2.1.3.3; RVP-INSNS §18.1")) (step (n 13) (insn "addi x6, x0, 1") (writes (write (reg "x6") (value "0x0000000000000000"))) (derivation "the row after it ran: 0x0000000000000001.") (source "RVI-RV32I §1.1.4; RVP-MACHINE §2.1.3.3 (boundary: wfi retires)")) (step (n 14) (insn "sfence.vma x0, x0") (writes) (derivation "sfence.vma in M: it retires.") (source "RVP-SUPERVISOR §11.1.2.1; RVP-INSNS §18.1")) (step (n 15) (insn "addi x7, x0, 2") (writes (write (reg "x7") (value "0x0000000000000002"))) (derivation "the row after it ran: 0x0000000000000002.") (source "RVI-RV32I §1.1.4 (boundary: sfence.vma retires)")) (step (n 16) (insn "csrrc x0, mip, x5") (writes) (derivation "no longer pending; no GPR written.") (source "RVP-MACHINE §2.1.1.9")) (step (n 17) (insn "csrrc x0, mstatus, x25") (writes) (derivation "MPP cleared; no GPR written.") (source "RVI-ZICSR §5.1.1")) (step (n 18) (insn "csrrs x0, mstatus, x19") (writes) (derivation "MPP set; no GPR written.") (source "RVI-ZICSR §5.1.1")) (step (n 19) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x000000008000005c"))) (derivation "the base for the next mode's entry: 0x000000008000005c.") (source "RVI-RV64I §3.1.2.1")) (step (n 20) (insn "addi x4, x4, 16") (writes (write (reg "x4") (value "0x000000008000006c"))) (derivation "its entry, a few rows on: 0x000000008000006c.") (source "RVI-RV32I §1.1.4")) (step (n 21) (insn "csrrw x0, mepc, x4") (writes) (derivation "mepc = there; no GPR written.") (source "RVI-ZICSR §5.1.1")) (step (n 22) (insn "mret") (writes) (derivation "there.") (source "RVP-MACHINE §2.1.3.2")) (step (n 23) (insn "auipc x8, 0") (writes (write (reg "x8") (value "0x000000008000006c"))) (derivation "S reached by mret: 0x000000008000006c.") (source "RVP-MACHINE §2.1.3.2; RVP-INSNS §18.1")) (step (n 24) (insn "auipc x9, 0") (writes (write (reg "x9") (value "0x0000000080000070"))) (derivation "the base for sret's target: 0x0000000080000070.") (source "RVI-RV64I §3.1.2.1")) (step (n 25) (insn "addi x9, x9, 16") (writes (write (reg "x9") (value "0x0000000080000080"))) (derivation "the row after sret: 0x0000000080000080.") (source "RVI-RV32I §1.1.4")) (step (n 26) (insn "csrrw x0, sepc, x9") (writes) (derivation "sepc = there; no GPR written.") (source "RVP-MACHINE §2.1.3.2")) (step (n 27) (insn "sret") (writes) (derivation "sret, with SPP = U: on to U.") (source "RVP-MACHINE §2.1.3.2; RVP-INSNS §18.1")) (step (n 28) (insn "auipc x11, 0") (writes (write (reg "x11") (value "0x0000000080000080"))) (derivation "U reached by sret: 0x0000000080000080.") (source "RVP-MACHINE §2.1.3.2; RVP-INSNS §18.1")) (step (n 29) (insn "c.nop") (writes) (derivation "the end of the program.") (source "RVI-C §27.1.8")))
