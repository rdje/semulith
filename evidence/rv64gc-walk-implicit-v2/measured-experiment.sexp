(experiment (id "rv64gc-walk-implicit-v2") (program "walk-implicit-forms.s") (instructions 95) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a walk reaching another page must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "6 finite predeclared witnesses. the order and number of reads are not compared, since TLB replacement is not architectural; which PTEs are read, their values, their width and the absence of writes are the retained walk record's; what the base corpus's requirement says of rv64i-lab-v0, and the mirror's closure, are catalogue facts, not behaviour a run can witness") (property (id "walk-three") (requirement_id "REQ-D-WALK-IMPLICIT") (obligation_ids "OB-WALK-IMPLICIT") (observation_kinds "gpr-change") (statement "A translated load completes through a three-level walk, its implicit reads being the walk's (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 74) (register "x6"))) (property (id "walk-two") (requirement_id "REQ-D-WALK-IMPLICIT") (obligation_ids "OB-WALK-IMPLICIT") (observation_kinds "gpr-change") (statement "And through two levels, to a 2 MiB leaf (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 77) (register "x6"))) (property (id "leaf-unchanged") (requirement_id "REQ-D-WALK-IMPLICIT") (obligation_ids "OB-WALK-IMPLICIT") (observation_kinds "gpr-change") (statement "Under Svade there are no implicit writes: the leaf reads back as written (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 79) (register "x15"))) (property (id "pointer-unchanged") (requirement_id "REQ-D-WALK-IMPLICIT") (obligation_ids "OB-WALK-IMPLICIT") (observation_kinds "gpr-change") (statement "And so does the level-1 pointer it passed (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 81) (register "x15"))) (property (id "root-unchanged") (requirement_id "REQ-D-WALK-IMPLICIT") (obligation_ids "OB-WALK-IMPLICIT") (observation_kinds "gpr-change") (statement "And the root's (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 83) (register "x15"))) (property (id "store-needs-d") (requirement_id "REQ-D-WALK-IMPLICIT") (obligation_ids "OB-WALK-IMPLICIT") (observation_kinds "gpr-change") (statement "A store with D clear raises the store page fault, 15, in place of any implicit write (RVP-SUPERVISOR §11.1.3.2).") (gpr_witness (step_n 90) (register "x22"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/walk-implicit-forms.s") (sha256 "71319d61768f7d416ad36b2ec5cb7654365872a0d71b443f8616f1073f92c184")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-walk-implicit-v2/guest.elf") (sha256 "f3d5dcdca7523ec3098c45a19715a669326df0a28e03ba5fcc35bd409d2d1676")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-walk-implicit-v2/reference-config.json") (sha256 "795320f7a2c79910683818942c0ce6d0422f04a5f7550dd136db5800fe951472")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-walk-implicit-v2/baseline.expected.sexp") (sha256 "76668445c73f0478800f3444bbe0b4de13331f737f4e67c9fdda0785ff225a0f")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-walk-implicit-v2/control.expected.sexp") (sha256 "915e2d17dd9fcc8cc3e1dbef9656e25b18a626fed11eba9bd1e07d0e3610f68f")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd