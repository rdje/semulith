  (property (id "sv48-from-bare") (cell "form:csrrs") (step_n 17) (register "x5") (expected 0)
    (statement "Of the three schemes defined for SXLEN=64 the profile selects Sv39, so a write naming Sv48 has no effect: satp still reads 0 (RVP-SUPERVISOR §11.1.3–§11.1.4)."))
  (property (id "sv57-from-bare") (cell "form:csrrs") (step_n 25) (register "x5") (expected 0)
    (statement "Of the three schemes defined for SXLEN=64 the profile selects Sv39, so a write naming Sv57 has no effect: satp still reads 0 (RVP-SUPERVISOR §11.1.3–§11.1.4)."))
  (property (id "sv39-taken") (cell "form:csrrs") (step_n 68) (register "x5") (expected 0x8000000000080003)
    (statement "A write naming Sv39 takes: satp reads 0x8000000000080003, MODE 8 and the root's page number (RVP-SUPERVISOR §11.1.3–§11.1.4)."))
  (property (id "sv48-over-sv39") (cell "form:csrrs") (step_n 76) (register "x5") (expected 0x8000000000080003)
    (statement "And over Sv39 the same write leaves MODE and root as they were (RVP-SUPERVISOR §11.1.3–§11.1.4)."))
  (property (id "walk-4k") (cell "form:ld") (step_n 101) (register "x6") (expected 66)
    (statement "A 4 KiB page, three levels down: VPN[2], VPN[1] and VPN[0] each index a table, and the load reads 66 (RVP-SUPERVISOR §11.1.4.1)."))
  (property (id "walk-2m") (cell "form:ld") (step_n 104) (register "x6") (expected 66)
    (statement "A 2 MiB leaf at level 1: the load reads 66 through it (RVP-SUPERVISOR §11.1.4.1)."))
  (property (id "walk-1g") (cell "form:ld") (step_n 110) (register "x6") (expected 66)
    (statement "A 1 GiB leaf at the root, reached by a canonical address at the top of the space: the load reads 66 (RVP-SUPERVISOR §11.1.4.1)."))
  (property (id "not-canonical-cause") (cell "form:csrrs") (step_n 120) (register "x22") (expected 13)
    (statement "Virtual addresses are 39 bits: with bits 63 to 39 not all equal to bit 38 the load raises the page fault, 13 (RVP-SUPERVISOR §11.1.4.1)."))
  (property (id "not-canonical-tval") (cell "form:csrrs") (step_n 121) (register "x23") (expected 0x4000007000)
