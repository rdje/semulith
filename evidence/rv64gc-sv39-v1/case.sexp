  (property (id "misaligned-superpage-cause") (cell "form:csrrs") (step_n 130) (register "x22") (expected 13)
    (statement "A superpage's low page-number bits must be zero: a leaf at level 1 with PPN[0] nonzero raises the page fault, 13 (RVP-SUPERVISOR §11.1.3.2)."))
