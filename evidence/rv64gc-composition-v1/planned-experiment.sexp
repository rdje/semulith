_n 17) (register "x14"))) (property (id "f-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "F executes: 1.0 + 1.0 is single-precision 2.0 (RVI-F §20.1).") (gpr_witness (step_n 24) (register "x16"))) (property (id "d-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "D executes: 1.0 + 1.0 is double-precision 2.0 (RVI-D §21.1).") (gpr_witness (step_n 29) (register "x18"))) (property (id "c-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "C executes: C.ADDI takes one to two (RVI-C §27.1.5.1).") (gpr_witness (step_n 31) (register "x19"))) (property (id "zicsr-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "Zicsr executes: mscratch reads back the 7 written (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 33) (register "x21"))) (property (id "zifencei-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "Zifencei executes: FENCE.I retires and the next row runs (RVI-ZIFENCEI §4.1).") (gpr_witness (step_n 35) (register "x22"))) (property (id "zicntr-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "Zicntr executes: rdinstret reads the count of instructions retired before it (RVI-ZICNTR §6.1.1).") (gpr_witness (step_n 37) (register "x23"))) (property (id "sstc-present") (requirement_id "REQ-D-GC-COMPOSITION") (obligation_ids "OB-GC-COMPOSITION") (observation_kinds "gpr-change") (statement "Sstc executes: stimecmp reads back the 7 written (RVP-SSTC §12.1).") (gpr_witness (step_n 39) (register "x24"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/composition-fo