(comment "Deliberately incorrect negative control: only boundary 5 x5 changes from -9223372036853460691 to -9223372036853460695. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "composition-forms.s") (entry "0x0000000080000000") (instructions 41) (fetches 80) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "the base for the handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 16") (writes (write (reg "x1") (value "0x0000000080000010"))) (derivation "the handler, a few rows on: 0x0000000080000010.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "csrrw x0, mtvec, x1") (writes) (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7")) (step (n 3) (insn "jal x0, 20") (writes) (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1")) (step (n 4) (insn "addi x5, x0, 77") (writes (write (reg "x5") (value "0x000000000000004d"))) (derivation "a sentinel, so the next read changes it.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "csrrs x5, misa, x0") (writes (write (reg "x5") (value "0x8000000000141129"))) (derivation "misa names the base and each letter: 0x800000000014112d.") (source "RVP-MACHINE §2.1.1.1; RVI-NAMING §36.1 (boundary: misa names the composition)")) (step (n 6) (insn "addi x6, x0, -1") (writes (write (reg "x6") (value "0xffffffffffffffff"))) (derivation "all ones: 0xffffffffffffffff.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "srli x6, x6, 32") (writes (write (reg "x6") (value "0x00000000ffffffff"))) (derivation "a 64-bit register keeps the upper half's zeros and the lower half's ones: 0x00000000ffffffff.") (source "RVI-RV64I §3.1.2.1 (boundary: the base is RV64I)")) (step (n 8) (insn "addi x8, x0, 6") (writes (write (reg "x8") (value "0x0000000000000006"))) (derivation "six: 0x0000000000000006.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "addi x9, x0, 7") (writes (write (reg "x9") (value "0x0000000000000007"))) (derivation "seven: 0x0000000000000007.") (source "RVI-RV32I §1.1.4")) (step (n 10) (insn "mul x12, x8, x9") (writes (write (reg "x12") (value "0x000000000000002a"))) (derivation "M is here: 0x000000000000002a.") (source "RVI-M §11.1.1")) (step (n 11) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "0x80000000: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 13) (insn "lui x1, 7") (writes (write (reg "x1") (value "0x0000000000007000"))) (derivation "0x7000: 0x0000000000007000.") (source "RVI-RV64I §3.1.2.1")) (step (n 14) (insn "add x1, x1, x10") (writes (write (reg "x1") (value "0x0000000080007000"))) (derivation "the data cell, on a page of its own, past this program: 0x0000000080007000.") (source "RVI-RV32I §1.1.4")) (step (n 15) (insn "sd x8, 0, x1") (writes) (derivation "the cell holds six.") (source "RVI-RV64I §3.1.3")) (step (n 16) (insn "amoadd.d x13, x9, (x1)") (writes (write (reg "x13") (value "0x0000000000000006"))) (derivation "A is here, and rd takes the old value: 0x0000000000000006.") (source "RVI-A §12.1.3")) (step (n 17) (insn "ld x14, x1, 0") (writes (write (reg "x14") (value "0x000000000000000d"))) (derivation "and memory took the sum: 0x000000000000000d.") (source "RVI-RV64I §3.1.3")) (step (n 18) (insn "lui x2, 6") (writes (write (reg "x2") (value "0x0000000000006000"))) (derivation "mstatus.FS's two bits: 0x0000000000006000.") (source "RVI-RV64I §3.1.2.1")) (step (n 19) (insn "csrrs x0, mstatus, x2") (writes) (derivation "FS = Dirty, so the floating-point forms may run; no GPR written.") (source "RVP-MACHINE §2.1.1.6.5")) (step (n 20) (insn "addi x15, x0, 127") (writes (write (reg "x15") (value "0x000000000000007f"))) (derivation "single-precision 1.0: 0x000000000000007f.") (source "RVI-RV32I §1.1.4")) (step (n 21) (insn "slli x15, x15, 23") (writes (write (reg "x15") (value "0x000000003f800000"))) (derivation "single-precision 1.0: 0x000000003f800