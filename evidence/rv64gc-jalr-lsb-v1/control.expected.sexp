(comment "Deliberately incorrect negative control: only boundary 3 x7 changes from 2147483668 to 2147483669. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "jalr-lsb.s") (entry "0x0000000080000000") (instructions 16) (fetches 32) (step (n 0) (insn "auipc x5, 0") (writes (write (reg "x5") (value "0x0000000080000000"))) (derivation "the base, this instruction's own address: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x6, x5, 21") (writes (write (reg "x6") (value "0x0000000080000015"))) (derivation "base + 21, odd: 0x0000000080000015.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "jalr x1, x6, 0") (writes (write (reg "x1") (value "0x000000008000000c"))) (derivation "JALR: base + 21 with its least-significant bit set to zero lands at base + 20; the link is 0x000000008000000c.") (source "RVI-RV32I §1.1.5.1 (boundary: an odd rs1)")) (step (n 3) (insn "auipc x7, 0") (writes (write (reg "x7") (value "0x0000000080000015"))) (derivation "landed at base + 20, not base + 21: 0x0000000080000014.") (source "RVI-RV32I §1.1.5.1 (boundary: the landing after an odd rs1)")) (step (n 4) (insn "addi x8, x5, 40") (writes (write (reg "x8") (value "0x0000000080000028"))) (derivation "base + 40, even: 0x0000000080000028.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "jalr x9, x8, 1") (writes (write (reg "x9") (value "0x0000000080000020"))) (derivation "base + 40 + 1 with its least-significant bit set to zero lands at base + 40; the link is 0x0000000080000020.") (source "RVI-RV32I §1.1.5.1 (boundary: an odd immediate)")) (step (n 6) (insn "auipc x10, 0") (writes (write (reg "x10") (value "0x0000000080000028"))) (derivation "landed at base + 40: 0x0000000080000028.") (source "RVI-RV32I §1.1.5.1 (boundary: the landing after an odd immediate)")) (step (n 7) (insn "addi x11, x5, 57") (writes (write (reg "x11") (value "0x0000000080000039"))) (derivation "base + 57, odd: 0x0000000080000039.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "jalr x12, x11, -1") (writes (write (reg "x12") (value "0x0000000080000034"))) (derivation "base + 57 - 1 is even, so there is nothing to clear: it lands at base + 56; the link is 0x0000000080000034.") (source "RVI-RV32I §1.1.5.1 (boundary: an odd rs1 and an odd immediate)")) (step (n 9) (insn "auipc x13, 0") (writes (write (reg "x13") (value "0x0000000080000038"))) (derivation "landed at base + 56: 0x0000000080000038.") (source "RVI-RV32I §1.1.5.1 (boundary: the landing after an even sum)")) (step (n 10) (insn "addi x14, x5, 121") (writes (write (reg "x14") (value "0x0000000080000079"))) (derivation "base + 121: 0x0000000080000079.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "jalr x15, x14, -40") (writes (write (reg "x15") (value "0x0000000080000044"))) (derivation "-40 sign-extends: base + 81, its least-significant bit set to zero, lands at base + 80; the link is 0x0000000080000044.") (source "RVI-RV32I §1.1.5.1 (boundary: a negative immediate)")) (step (n 12) (insn "auipc x16, 0") (writes (write (reg "x16") (value "0x0000000080000050"))) (derivation "landed at base + 80: 0x0000000080000050.") (source "RVI-RV32I §1.1.5.1 (boundary: the landing after a negative immediate)")) (step (n 13) (insn "addi x17, x5, 101") (writes (write (reg "x17") (value "0x0000000080000065"))) (derivation "base + 101: 0x0000000080000065.") (source "RVI-RV32I §1.1.4")) (step (n 14) (insn "jalr x17, x17, 0") (writes (write (reg "x17") (value "0x000000008000005c"))) (derivation "rd is rs1: the target reads the old value, landing at base + 100, and the link overwrites it: 0x000000008000005c.") (source "RVI-RV32I §1.1.5.1 (boundary: rd equals rs1)")) (step (n 15) (insn "auipc x18, 0") (writes (write (reg "x18") (value "0x0000000080000064"))) (derivation "landed at base + 100: 0x0000000080000064.") (source "RVI-RV32I §1.1.5.1 (boundary: the landing when rd equals rs1)")))
