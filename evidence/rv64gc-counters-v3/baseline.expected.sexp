    (derivation "the handler, at its offset from the start: 0x0000000080000010.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 3) (insn "jal x0, 36") (writes)
    (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1"))
  (step (n 4) (insn "rdcycle x5") (writes (write (reg "x5") (value "0x0000000000000004")))
