(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-alu-reg-v3") (program "alu-reg-forms.s") (instructions 18) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: SLTU read as signed must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Ten finite predeclared witnesses of the seven register-register forms: SUB's operand order, overflow ignored both ways, signed against unsigned compares on one rs1, and the three bitwise forms; full source/risk/feature policy remains pending.") (property (id "add-form") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "ADD performs the addition of rs1 and rs2: 5 + -7 is -2 in x7 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 2) (register "x7"))) (property (id "sub-order") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "SUB subtracts rs2 from rs1: 5 - -7 is 12 in x8 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 3) (register "x8"))) (property (id "add-overflow-ignored") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "ADD's overflow is ignored: the low 64 bits of 2^63 - 1 + 5 are in x12 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 7) (register "x12"))) (property (id "sub-overflow-ignored") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "SUB's overflow is ignored: 5 back through the same wrap is 2^63 - 1 in x13 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 8) (register "x13"))) (property (id "slt-reads-rs1-as-negative") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "SLT compares signed: -7 < 5 writes 1 to x14 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 9) (register "x14"))) (property (id "sltu-reads-rs1-as-huge") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "SLTU compares unsigned: 2^64 - 7 is not below 5, replacing a sentinel in x15 with 0 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 11) (register "x15"))) (property (id "slt-equal") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "Equal is not less: SLT replaces a sentinel in x17 with 0 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 14) (register "x17"))) (property (id "xor-form") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "XOR is bitwise: 5 ^ -7 in x18 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 15) (register "x18"))) (property (id "or-form") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "OR is bitwise: 5 | -7 in x19 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 16) (register "x19"))) (property (id "and-form") (requirement_id "REQ-D-ALU-REG") (obligation_ids "OB-ALU-REG") (observation_kinds "gpr-change") (statement "AND is bitwise: 5 & -7 in x20 (RVI-RV32I §1.1.4.2).") (gpr_witness (step_n 17) (register "x20"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/alu-reg-forms.s") (sha256 "27138d7bed9feced39132071ee4c03b84a1a0c8997c763d500917a08c293d0c3")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-alu-reg-v3/guest.elf") (sha256 "69da28692b0480a098c69c4d60f7ad9b9abbbe8c72615c3e191e5d777b820c06"