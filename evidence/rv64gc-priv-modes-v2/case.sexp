  (required_input (role "normative-source") (id "RVP-MODES-STATEMENTS") (path "profiles/rv64gc-lab-v0/retained/rvp-modes-statements.html") (sha256 "4c105a6e8f0a1b28f79d4dcfc947b08e1a1b60a475b1b10c5dc6b00fac79e349"))
  (prepared (role "guest-image") (id "guest-image") (name "guest.elf") (byte_size 4680) (sha256 "09b0687414532d8e1e5b87065e73bedf2f5f0d951bd54d019796552649155e62"))
  (prepared (role "reference-config") (id "reference-config") (name "reference-config.json") (byte_size 7669) (sha256 "795320f7a2c79910683818942c0ce6d0422f04a5f7550dd136db5800fe951472"))
