  (prepared (role "expectation") (id "mutant-expectation") (name "control.expected.sexp") (byte_size 19537) (sha256 "1aef6285148b26f538763063073bda2ad6fbfad86401284e6e2564cd1f5db563"))
  (property (id "misa-names-the-modes") (cell "form:csrrs") (step_n 5) (register "x5") (expected 0x800000000014112d)
    (statement "misa reads 0x800000000014112d: S at bit 18 and U at bit 20 set, so three privilege modes, and H at bit 7 clear (RVP-MACHINE §2.1.1.1; RVP-INTRO Introduction)."))
  (property (id "misa-s") (cell "form:and") (step_n 8) (register "x7") (expected 0x40000)
    (statement "S is implemented: misa bit 18 reads set (RVP-MACHINE §2.1.1.1)."))
  (property (id "misa-u") (cell "form:and") (step_n 11) (register "x7") (expected 0x100000)
    (statement "U is implemented: misa bit 20 reads set (RVP-MACHINE §2.1.1.1)."))
  (property (id "misa-no-h") (cell "form:andi") (step_n 13) (register "x7") (expected 0)
    (statement "And H is not: misa bit 7 reads clear (RVP-MACHINE §2.1.1.1)."))
  (property (id "no-h-state") (cell "form:and") (step_n 18) (register "x7") (expected 0)
    (statement "And mstatus carries no hypervisor state: GVA and MPV read 0 (RVP-MACHINE §2.1.1.6.1)."))
  (property (id "ecall-from-m") (cell "form:csrrs") (step_n 25) (register "x30") (expected 11)
    (statement "An environment call from M raises 11, the code for M (RVP-MACHINE §2.1.1.15)."))
  (property (id "mpp-holds-u") (cell "form:and") (step_n 35) (register "x8") (expected 0)
    (statement "MPP holds 0, U (RVP-MACHINE §2.1.1.6.1)."))
  (property (id "mpp-holds-s") (cell "form:and") (step_n 42) (register "x8") (expected 2048)
    (statement "MPP holds 1, S: a mode the profile implements is a value MPP can hold (RVP-MACHINE §2.1.1.6.1)."))
  (property (id "s-reads-sscratch") (cell "form:csrrs") (step_n 48) (register "x9") (expected 0)
    (statement "S reads sscratch: 0, replacing a sentinel, so S's CSRs answer here (RVP-SUPERVISOR §11.1.1.1)."))
  (property (id "s-cannot-read-m") (cell "form:csrrs") (step_n 55) (register "x30") (expected 2)
    (statement "S reading mscratch is illegal-instruction, 2, so S sits below M (RVI-ZICSR §5.1.1)."))
  (property (id "trap-recorded-s") (cell "form:and") (step_n 61) (register "x8") (expected 2048)
    (statement "And the trap recorded where it came from: MPP holds 1, S (RVP-MACHINE §2.1.1.6.1)."))
  (property (id "ecall-from-s") (cell "form:csrrs") (step_n 72) (register "x30") (expected 9)
    (statement "An environment call from S raises 9, the code for S (RVP-MACHINE §2.1.1.15)."))
  (property (id "u-cannot-read-s") (cell "form:csrrs") (step_n 87) (register "x30") (expected 2)
    (statement "U reading sscratch is illegal-instruction, 2, so U sits below S (RVI-ZICSR §5.1.1)."))
  (property (id "trap-recorded-u") (cell "form:and") (step_n 93) (register "x8") (expected 0)
