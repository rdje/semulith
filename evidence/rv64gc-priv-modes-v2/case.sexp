(case (id "rv64gc-priv-modes-v2") (profile_id "rv64gc-lab-v0")
  (program "priv-modes.s") (instructions 109) (source_size 8388)
  (source_sha256 "510be2828c6b2375b3f176686acf3d415e2a8c4c8d243ef077c64d64c4771f6f")
  (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES")
  (contract_id "rv64gc-lab-env-v4") (contract_version "4")
  (control (property_id "misa-names-the-modes") (value 0x800000000010112d) (reason "Only boundary 5 x5 expectation changes to misa with S clear, a machine of M and U.") (id "no-supervisor")
    (statement "Predeclared target: a hart without S must diverge."))
  (limitation "15 finite predeclared witnesses. that three modes are what Linux needs is the selection's reasoning: no Linux is run; that every mode-dependent behaviour is tested in each mode is a claim over the corpus and P4-SYSTEM.2, not this case's; no hypervisor instruction's refusal is compared, since the derivation's vocabulary names none, so H's absence is read from misa and mstatus")
  (source_id "RVP-INTRO") (source_locator "Introduction") (category "implementation-defined") (risk "high")
  (coverage "15 witnesses: misa's mode and H bits, an environment call from each mode with its own cause, MPP holding each mode, each mode's CSR refused below it, and the trap recording where it came from")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
  (adversarial (property_ids "ecall-from-m") (property_ids "ecall-from-s") (property_ids "ecall-from-u") (property_ids "s-cannot-read-m") (property_ids "u-cannot-read-s") (property_ids "trap-recorded-s") (property_ids "trap-recorded-u")
    (failure_mode "a mode that traps with another mode's cause, a CSR readable below its level, or a trap that records the wrong mode"))
  (authority (requirement_semantic_sha256 "34c0215fb12ccfde5c29b893f8f7c5991a0c9ede0aa4b38b4c5c61fc530baa89") (obligation_id "OB-PRIV-MODES")
