(expectations (program "priv-modes.s") (entry "0x0000000080000000") (instructions 109) (fetches 217)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the base for the handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 1) (insn "addi x1, x1, 16") (writes (write (reg "x1") (value "0x0000000080000010")))
    (derivation "the handler, a few rows on: 0x0000000080000010.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 3) (insn "jal x0, 20") (writes)
    (derivation "past the handler; x0 discards the link.") (source "RVI-RV32I §1.1.5.1"))
  (step (n 4) (insn "addi x5, x0, 77") (writes (write (reg "x5") (value "0x000000000000004d")))
    (derivation "a sentinel, so the next read changes it.") (source "RVI-RV32I §1.1.4"))
