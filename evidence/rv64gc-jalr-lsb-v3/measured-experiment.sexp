(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-jalr-lsb-v3") (program "jalr-lsb.s") (instructions 16) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a target that keeps its least-significant bit must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Ten finite predeclared witnesses of JALR's target and link: an odd rs1, an odd immediate, both, a negative immediate and rd equal to rs1, each read back by AUIPC at the landing; full source/risk/feature policy remains pending.") (property (id "link-odd-rs1") (requirement_id "REQ-D-JALR-LSB") (obligation_ids "OB-JALR-LSB") (observation_kinds "gpr-change") (statement "JALR writes the address of the following instruction to rd: base + 12 in x1 (RVI-RV32I §1.1.5.1).") (gpr_witness (step_n 2) (register "x1"))) (property (id "landing-odd-rs1") (requirement_id "REQ-D-JALR-LSB") (obligation_ids "OB-JALR-LSB") (observation_kinds "gpr-change") (statement "An odd rs1 of base + 21 has its least-significant bit set to zero: AUIPC reads base + 20 in x7 at the landing (RVI-RV32I §1.1.5.1).") (gpr_witness (step_n 3) (register "x7"))) (property (id "link-odd-immediate") (requirement_id "REQ-D-JALR-LSB") (obligation_ids "OB-JALR-LSB") (observation_kinds "gpr-change") (statement "JALR's link, base + 32, in x9 (RVI-RV32I §1.1.5.1).") (gpr_witness (step_n 5) (register "x9"))) (property (id "landing-odd-immediate") (requirement_id "REQ-D-JALR-LSB") (obligation_ids "OB-JALR-LSB") (observation_kinds "gpr-change") (statement "An odd immediate has the sum's least-significant bit set to zero: base + 40 in x10 (RVI-RV32I §1.1.5.1).") (gpr_witness (step_n 6) (register "x10"))) (property (id "link-even-sum") (requirement_id "REQ-D-JALR-LSB") (obligation_ids "OB-JALR-LSB") (observation_kinds 