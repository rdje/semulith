(case (id "rv64gc-sc-deterministic-v2") (profile_id "rv64gc-lab-v0")
  (program "sc-deterministic.s") (instructions 159) (source_size 14327)
  (source_sha256 "3cc68034bb48f905a777f18d50ce4cd1dae89d1c23c9f472be220b62ecf5c611")
  (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2")
  (contract_id "rv64gc-lab-env-v4") (contract_version "4")
  (control (property_id "beside-fails") (value 0) (reason "Only boundary 21 x15 expectation changes from 1 to 0, an SC pairing past its LR's address.") (id "sc-past-its-address")
    (statement "Predeclared target: an SC pairing past its address must diverge."))
  (limitation "21 finite predeclared witnesses. the address and width a cleared reservation keeps have no effect while validity is clear, so nothing here observes them; translation reads and TLB fills have no observation in this vocabulary; reservation history as a whole is REQ-D-RESERVATION's case; exact width is past the reference, physical-alias pairing is REQ-D-RESERVATION's case, and this claims nothing of multicore progress")
  (source_id "RVI-A") (source_locator "12.1.2") (category "implementation-defined") (risk "medium")
  (coverage "21 witnesses: an exact pair at each width and what it stores, each failure and what it leaves, the three destination aliases, permission before the failure code, and a target fault's address and what it keeps")
  (authority (requirement_semantic_sha256 "01048c90b4f2dc89ae5133d8200c3d8252390d18bfa97214da0869d849080714") (obligation_id "OB-GC-SC-DETERMINISTIC-V2")
    (obligation_semantic_sha256 "bef30781e49da1df807307136dafa8666686e5978d36fd66b6ba0ceb1f86a32c") (source_sha256 "afbd8def7bdf64287ef51a9cb14dd654fba0f0cfeef63bccdfd47408f5b0dff2"))
  (required_input (role "normative-source") (id "RVI-A-RESERVATION-STATEMENTS") (path "profiles/rv64gc-lab-v0/retained/rvi-a-reservation-statements.html") (sha256 "5b92b951ce522b822438991fceb17848be59d8664c6b3405118eb1a1425e0677"))
  (prepared (role "guest-image") (id "guest-image") (name "guest.elf") (byte_size 4928) (sha256 "5c613b81f9e07e632a896fcc13979947d0c1032998c1354432693121a7b9131f"))
  (prepared (role "reference-config") (id "reference-config") (name "reference-config.json") (byte_size 7742) (sha256 "cd519ac8b76b26666444531a21a02aee08280a3c7f0b8e3aad92c8d7126161e5"))
  (prepared (role "expectation") (id "expectation") (name "baseline.expected.sexp") (byte_size 29676) (sha256 "ada05dec997bf41bfcea757475042870e07c085e641633a213e3d61397b2bf37"))
  (prepared (role "expectation") (id "mutant-expectation") (name "control.expected.sexp") (byte_size 28394) (sha256 "d0443cb9520c903f554c64ce46a4733defdc26a9f5a01390ad6335de51dc043c"))
  (property (id "beside-fails") (cell "form:sc.w") (step_n 21) (register "x15") (expected 1)
    (statement "A valid reservation pairs only at its own address: an SC to the word beside it writes the failure code, 1. No spurious failure and no reach past the address are the selected point (RVI-A §12.1.3)."))
  (property (id "failure-stores-nothing") (cell "form:ld") (step_n 23) (register "x16") (expected 17)
    (statement "A failed SC issues no store: A's doubleword still holds 17 (RVI-A §12.1.3)."))
  (property (id "sc-w-result") (cell "form:sc.w") (step_n 37) (register "x15") (expected 0)
    (statement "With a valid reservation at the same address and width the SC succeeds: 0 in rd, with no spurious failure (RVI-A §12.1.3)."))
  (property (id "sc-w-low-bytes") (cell "form:ld") (step_n 39) (register "x16") (expected 0xffffffff55667788)
    (statement "It stores rs2's low-width bytes: the low word changed, the high word still all ones (RVI-A §12.1.3)."))
  (property (id "sc-d-result") (cell "form:sc.d") (step_n 44) (register "x15") (expected 0)
    (statement "LR.D and SC.D: 0 in rd (RVI-A §12.1.3)."))
  (property (id "sc-d-all-bytes") (cell "form:sc.d") (step_n 46) (register "x16") (expected 0x1122334455667788)
    (statement "And all eight bytes stored (RVI-A §12.1.3)."))
  (property (id "completed-clears") (cell "form:sc.d") (step_n 48) (register "x15") (expected 1)
    (statement "Any completed SC clears validity: the next one writes 1 (RVI-A §12.1.3)."))
  (property (id "no-second-store") (cell "form:ld") (step_n 50) (register "x16") (expected 0x1122334455667788)
    (statement "And stores nothing (RVI-A §12.1.3)."))
  (property (id "rd-is-rs2-result") (cell "form:sc.w") (step_n 54) (register "x5") (expected 0)
    (statement "With rd = rs2, rd takes the result: 0 (RVI-A §12.1.3)."))
  (property (id "rd-is-rs2-stored") (cell "form:ld") (step_n 56) (register "x16") (expected 119)
    (statement "And the store took the register's original value, 0x77 (RVI-A §12.1.3)."))
  (property (id "rd-is-rs1-result") (cell "form:sc.w") (step_n 60) (register "x4") (expected 0)
    (statement "With rd = rs1, rd takes the result: 0, and the address used the original value (RVI-A §12.1.3)."))
  (property (id "rd-is-rs1-stored") (cell "form:ld") (step_n 62) (register "x16") (expected 0x55667788)
    (statement "And the store reached the original address: the sign-extended low word of rs2 reads back there (RVI-A §12.1.3)."))
  (property (id "rd-x0-stored") (cell "form:ld") (step_n 67) (register "x16") (expected 0x55667788)
    (statement "With rd = x0 only the result is discarded: the store still happened (RVI-A §12.1.3)."))
  (property (id "rd-x0-completed") (cell "form:sc.w") (step_n 69) (register "x15") (expected 1)
    (statement "And it completed, so the reservation is gone: 1 (RVI-A §12.1.3)."))
  (property (id "permission-before-failure") (cell "form:csrrs") (step_n 79) (register "x30") (expected 7)
    (statement "An SC with no reservation still obtains store permission: at 2^40 it raises 7, not the failure code 1 (RVI-A §12.1.3)."))
  (property (id "fault-keeps-destination") (cell "form:addi") (step_n 84) (register "x25") (expected 41)
    (statement "A target fault does not complete the SC: rd keeps 41, copied to x25 (RVI-A §12.1.3)."))
  (property (id "target-fault-cause") (cell "form:csrrs") (step_n 140) (register "x22") (expected 15)
    (statement "A target fault does not complete an SC: with D clear it raises the store page fault, 15 (RVI-A §12.1.3)."))
  (property (id "target-fault-vaddr") (cell "form:csrrs") (step_n 141) (register "x23") (expected 0x401000)
    (statement "And it reports the virtual fault address (RVP-SUPERVISOR §11.1.1.9; RVI-A §12.1.3)."))
  (property (id "target-fault-keeps-reservation") (cell "form:sc.w") (step_n 145) (register "x15") (expected 0)
    (statement "And the prior reservation stands: 0 at A (RVI-A §12.1.3)."))
  (property (id "svade-no-update") (cell "form:ld") (step_n 147) (register "x18") (expected 0x20001c47)
    (statement "Svade performs no implicit PTE update: D still clear (RVP-SUPERVISOR §11.1.3.1)."))
  (property (id "translation-before-failure") (cell "form:csrrs") (step_n 154) (register "x22") (expected 15)
    (statement "Without a reservation the same SC still faults, 15, rather than writing 1: translation comes first (RVI-A §12.1.3)."))
