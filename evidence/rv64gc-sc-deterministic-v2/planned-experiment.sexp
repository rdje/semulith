(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-sc-deterministic-v2") (program "sc-deterministic.s") (instructions 159) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: an SC pairing past its address must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "21 finite predeclared witnesses. the address and width a cleared reservation keeps have no effect while validity is clear, so nothing here observes them; translation reads and TLB fills have no observation in this vocabulary; reservation history as a whole is REQ-D-RESERVATION's case; exact width is past the reference, physical-alias pairing is REQ-D-RESERVATION's case, and this claims nothing of multicore progress") (property (id "beside-fails") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "A valid reservation pairs only at its own address: an SC to the word beside it writes the failure code, 1. No spurious failure and no reach past the address are the selected point (RVI-A §12.1.3).") (gpr_witness (step_n 21) (register "x15"))) (property (id "failure-stores-nothing") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "A failed SC issues no store: A's doubleword still holds 17 (RVI-A §12.1.3).") (gpr_witness (step_n 23) (register "x16"))) (property (id "sc-w-result") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "With a valid reservation at the same address and width the SC succeeds: 0 in rd, with no spurious failure (RVI-A §12.1.3).") (gpr_witness (step_n 37) (register "x15"))) (property (id "sc-w-low-bytes") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "It stores rs2's low-width bytes: the low word changed, the high word still all ones (RVI-A §12.1.3).") (gpr_witness (step_n 39) (register "x16"))) (property (id "sc-d-result") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "LR.D and SC.D: 0 in rd (RVI-A §12.1.3).") (gpr_witness (step_n 44) (register "x15"))) (property (id "sc-d-all-bytes") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And all eight bytes stored (RVI-A §12.1.3).") (gpr_witness (step_n 46) (register "x16"))) (property (id "completed-clears") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "Any completed SC clears validity: the next one writes 1 (RVI-A §12.1.3).") (gpr_witness (step_n 48) (register "x15"))) (property (id "no-second-store") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And stores nothing (RVI-A §12.1.3).") (gpr_witness (step_n 50) (register "x16"))) (property (id "rd-is-rs2-result") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "With rd = rs2, rd takes the result: 0 (RVI-A §12.1.3).") (gpr_witness (step_n 54) (register "x5"))) (property (id "rd-is-rs2-stored") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And the store took the register's original value, 0x77 (RVI-A §12.1.3).") (gpr_witness (step_n 56) (register "x16"))) (property (id "rd-is-rs1-result") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "With rd = rs1, rd takes the result: 0, and the address used the original value (RVI-A §12.1.3).") (gpr_witness (step_n 60) (register "x4"))) (property (id "rd-is-rs1-stored") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And the store reached the original address: the sign-extended low word of rs2 reads back there (RVI-A §12.1.3).") (gpr_witness (step_n 62) (register "x16"))) (property (id "rd-x0-stored") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "With rd = x0 only the result is discarded: the store still happened (RVI-A §12.1.3).") (gpr_witness (step_n 67) (register "x16"))) (property (id "rd-x0-completed") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And it completed, so the reservation is gone: 1 (RVI-A §12.1.3).") (gpr_witness (step_n 69) (register "x15"))) (property (id "permission-before-failure") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "An SC with no reservation still obtains store permission: at 2^40 it raises 7, not the failure code 1 (RVI-A §12.1.3).") (gpr_witness (step_n 79) (register "x30"))) (property (id "fault-keeps-destination") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "A target fault does not complete the SC: rd keeps 41, copied to x25 (RVI-A §12.1.3).") (gpr_witness (step_n 84) (register "x25"))) (property (id "target-fault-cause") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "A target fault does not complete an SC: with D clear it raises the store page fault, 15 (RVI-A §12.1.3).") (gpr_witness (step_n 140) (register "x22"))) (property (id "target-fault-vaddr") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And it reports the virtual fault address (RVP-SUPERVISOR §11.1.1.9; RVI-A §12.1.3).") (gpr_witness (step_n 141) (register "x23"))) (property (id "target-fault-keeps-reservation") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "And the prior reservation stands: 0 at A (RVI-A §12.1.3).") (gpr_witness (step_n 145) (register "x15"))) (property (id "svade-no-update") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "Svade performs no implicit PTE update: D still clear (RVP-SUPERVISOR §11.1.3.1).") (gpr_witness (step_n 147) (register "x18"))) (property (id "translation-before-failure") (requirement_id "REQ-D-SC-DETERMINISTIC") (obligation_ids "OB-GC-SC-DETERMINISTIC-V2") (observation_kinds "gpr-change") (statement "Without a reservation the same SC still faults, 15, rather than writing 1: translation comes first (RVI-A §12.1.3).") (gpr_witness (step_n 154) (register "x22"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/sc-deterministic.s") (sha256 "3cc68034bb48f905a777f18d50ce4cd1dae89d1c23c9f472be220b62ecf5c611")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-sc-deterministic-v2/guest.elf") (sha256 "5c613b81f9e07e632a896fcc13979947d0c1032998c1354432693121a7b9131f")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64g