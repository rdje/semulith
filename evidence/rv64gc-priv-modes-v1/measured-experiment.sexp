(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-priv-modes-v1") (program "priv-modes.s") (instructions 109) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a hart without S must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "15 finite predeclared witnesses. that three modes are what Linux needs is the selection's reasoning: no Linux is run; that every mode-dependent behaviour is tested in each mode is a claim over the corpus and P4-SYSTEM.2, not this case's; no hypervisor instruction's refusal is compared, since the derivation's vocabulary names none, so H's absence is read from misa and mstatus") (property (id "misa-names-the-modes") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "misa reads 0x800000000014112d: S at bit 18 and U at bit 20 set, so three privilege modes, and H at bit 7 clear (RVP-MACHINE §2.1.1.1; RVP-INTRO Introduction).") (gpr_witness (step_n 5) (register "x5"))) (property (id "misa-s") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "S is implemented: misa bit 18 reads set (RVP-MACHINE §2.1.1.1).") (gpr_witness (step_n 8) (register "x7"))) (property (id "misa-u") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "U is implemented: misa bit 20 reads set (RVP-MACHINE §2.1.1.1).") (gpr_witness (step_n 11) (register "x7"))) (property (id "misa-no-h") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "And H is not: misa bit 7 reads clear (RVP-MACHINE §2.1.1.1).") (gpr_witness (step_n 13) (register "x7"))) (property (id "no-h-state") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "And mstatus carries no hypervisor state: GVA and MPV read 0 (RVP-MACHINE §2.1.1.6.1).") (gpr_witness (step_n 18) (register "x7"))) (property (id "ecall-from-m") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "An environment call from M raises 11, the code for M (RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 25) (register "x30"))) (property (id "mpp-holds-u") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "MPP holds 0, U (RVP-MACHINE §2.1.1.6.1).") (gpr_witness (step_n 35) (register "x8"))) (property (id "mpp-holds-s") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "MPP holds 1, S: a mode the profile implements is a value MPP can hold (RVP-MACHINE §2.1.1.6.1).") (gpr_witness (step_n 42) (register "x8"))) (property (id "s-reads-sscratch") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "S reads sscratch: 0, replacing a sentinel, so S's CSRs answer here (RVP-SUPERVISOR §11.1.1.1).") (gpr_witness (step_n 48) (register "x9"))) (property (id "s-cannot-read-m") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "S reading mscratch is illegal-instruction, 2, so S sits below M (RVI-ZICSR §5.1.1).") (gpr_witness (step_n 55) (register "x30"))) (property (id "trap-recorded-s") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statement "And the trap recorded where it came from: MPP holds 1, S (RVP-MACHINE §2.1.1.6.1).") (gpr_witness (step_n 61) (register "x8"))) (property (id "ecall-from-s") (requirement_id "REQ-D-PRIV-MODES") (obligation_ids "OB-PRIV-MODES") (observation_kinds "gpr-change") (statemen