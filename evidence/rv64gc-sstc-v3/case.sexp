    (statement "U is below stimecmp's own privilege, so its access is refused whatever the gates say: the handler reads mcause 2 into x30 (RVP-CSR §1.1.1)."))
  (property (id "u-refused-rd-kept") (cell "form:addi") (step_n 148) (register "x21") (expected 24)
