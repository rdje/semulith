  (control (property_id "not-pending-below-compare") (value 32) (reason "Only boundary 172 x11 expectation changes from 0 to 32, what a signed comparison would read: an all-ones compare is -1, below every time, and the statement says unsigned.") (id "compare-read-as-signed")
    (statement "Predeclared target: a compare read as signed must diverge."))
  (limitation "39 finite predeclared witnesses: stimecmp in M, each gate alone, the kernel programming its own timer, STIP below and at the compare, five suppressions, delivery from S, from U and to M, one schedule and its acknowledgement; the exact boundary of a scheduled delivery is what both producers do on this configuration, at one tick per instruction, not a claim about latency, since the manual guarantees a changed comparison reaches STIP eventually; this case's reference configuration carries a CLINT device the laboratory does not declare, and the rate of time stays the environment contract's; mtimecmp and any M-mode timer are not witnessed; full source, risk and feature policy remains pending.")
  (source_id "RVP-SSTC") (source_locator "12.1") (category "implementation-defined") (risk "high")
  (coverage "39 SSTC witnesses: access and both gates, pending below and at the compare, delivery and its suppressions, a schedule, and its acknowledgement")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters and the profile's recorded selection, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
