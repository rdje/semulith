  (property (id "fcvt-d-wu") (cell "form:fcvt.d.wu") (step_n 278) (register "x6") (expected 0x41efffffffe00000)
    (statement "From the unsigned word 2^32 - 1: 0x41efffffffe00000, read back in x6 (RVI-D §21.1.5)."))
  (property (id "fcvt-d-l") (cell "form:fcvt.d.l") (step_n 280) (register "x6") (expected 0xbff0000000000000)
    (statement "From the doubleword -1: 0xbff0000000000000, read back in x6 (RVI-D §21.1.5)."))
  (property (id "fcvt-d-lu") (cell "form:fcvt.d.lu") (step_n 282) (register "x6") (expected 0x43f0000000000000)
    (statement "From the unsigned doubleword 2^64 - 1: 0x43f0000000000000, read back in x6 (RVI-D §21.1.5)."))
  (property (id "box-is-a-quiet-nan") (cell "form:fclass.d") (step_n 287) (register "x14") (expected 512)
    (statement "A NaN-boxed single, read by a D operation, is the quiet NaN it appears as: FCLASS.D sets bit 9 (RVI-D §21.1.2)."))
  (property (id "fcvt-d-s") (cell "form:fcvt.d.s") (step_n 289) (register "x6") (expected 0x3ff8000000000000)
    (statement "FCVT.D.S of a boxed single 1.5 widens exactly: 0x3ff8000000000000, read back in x6 (RVI-D §21.1.5)."))
  (property (id "fcvt-d-s-unboxed") (cell "form:fcvt.d.s") (step_n 291) (register "x6") (expected 0x7ff8000000000000)
    (statement "FCVT.D.S reads 1.0, not boxed as a single, as the canonical NaN: 0x7ff8000000000000, read back in x6 (RVI-D §21.1.5; RVI-D §21.1.2)."))
  (property (id "fcvt-s-d") (cell "form:fcvt.s.d") (step_n 306) (register "x6") (expected 0xffffffff3eaaaaab)
    (statement "FCVT.S.D of a third, under a static RUP, rounds and writes its single boxed: 0xffffffff3eaaaaab, read back in x6 (RVI-D §21.1.5; RVI-D §21.1.2)."))
  (property (id "fcvt-s-d-rounds") (cell "form:fcvt.s.d") (step_n 308) (register "x6") (expected 0xffffffff3eaaaaaa)
    (statement "The same value under a static RDN: 0xffffffff3eaaaaaa, read back in x6 (RVI-D §21.1.5; RVI-F §20.1.2)."))
  (property (id "snan-conversion-invalid") (cell "form:fcvt.s.d") (step_n 312) (register "x20") (expected 16)
    (statement "A signaling NaN into FCVT.S.D sets NV: 16 in x20 (RVI-F §20.1.2; RVI-D §21.1.5)."))
  (property (id "snan-conversion-canonical") (cell "form:fcvt.s.d") (step_n 315) (register "x6") (expected 0xffffffff7fc00000)
    (statement "And its result is the single canonical NaN, boxed (RVI-F §20.1.3; RVI-D §21.1.2)."))
  (property (id "reserved-where-nothing-rounds") (cell "form:fcvt.d.w") (step_n 322) (register "x30") (expected 2)
    (statement "A reserved rounding mode is illegal even on FCVT.D.W, which cannot round: mcause 2, replacing a sentinel (RVI-F §20.1.2; RVP-MACHINE §2.1.1.15)."))
  (property (id "reserved-on-widening") (cell "form:fcvt.d.s") (step_n 332) (register "x30") (expected 2)
    (statement "And on FCVT.D.S, which never rounds: mcause 2, replacing a sentinel (RVI-F §20.1.2; RVP-MACHINE §2.1.1.15)."))
  (property (id "reserved-dynamic") (cell "form:fadd.d") (step_n 343) (register "x30") (expected 2)
    (statement "DYN with frm holding 5 is reserved, so illegal-instruction: mcause 2, replacing a sentinel (RVI-F §20.1.2; RVP-MACHINE §2.1.1.15)."))
