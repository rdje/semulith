  (property (id "auipc-offset") (cell "form:auipc") (step_n 7) (register "x10") (expected 0x8000101c)
    (statement "AUIPC forms the offset 0x1000 from its U-immediate and adds it to its own address, in x10 (RVI-RV64I §3.1.2.1)."))
  (property (id "auipc-sign-extends") (cell "form:auipc") (step_n 8) (register "x11") (expected 32)
    (statement "AUIPC's offset sign-extends to -2^31, cancelling the 0x80000000 of its own address, 0x80000020, and leaving 32 in x11 (RVI-RV64I §3.1.2.1)."))
  (property (id "auipc-largest-positive") (cell "form:auipc") (step_n 9) (register "x12") (expected 0xfffff024)
