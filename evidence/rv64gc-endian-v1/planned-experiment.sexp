(experiment (id "rv64gc-endian-v1") (program "endian-forms.s") (instructions 42) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: big-endian byte order must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "8 finite predeclared witnesses. that the specification delegates this to the EEI is the source's statement, and the pinned binary offers no other choice to compare") (property (id "byte-0") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "Little-endian: byte 0 is the least significant, so this reads 0x88 (RVI-RV32I §1.1.6).") (gpr_witness (step_n 19) (register "x6"))) (property (id "byte-7") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "Little-endian: byte 7 is the most significant, so this reads 0x11 (RVI-RV32I §1.1.6).") (gpr_witness (step_n 21) (register "x6"))) (property (id "half-0") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "Little-endian: the low halfword, its low byte first, so this reads 0x7788 (RVI-RV32I §1.1.6).") (gpr_witness (step_n 23) (register "x6"))) (property (id "word-4") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "Little-endian: the high word, at offset 4, so this reads 0x11223344 (RVI-RV32I §1.1.6).") (gpr_witness (step_n 25) (register "x6"))) (property (id "invariant-byte") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "Byte-address invariant: a byte stored at an address reads back at that address (RVI-RV32I §1.1.6).") (gpr_witness (step_n 29) (register "x8"))) (property (id "invariant-word") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "And it lands at byte 3 of the doubleword, counting from the least significant (RVI-RV32I §1.1.6).") (gpr_witness (step_n 31) (register "x9"))) (property (id "no-big-endian-bits") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "MBE, SBE and UBE read 0 after M tried to set them: no mode can select big-endian (RVP-MACHINE §2.1.1.6).") (gpr_witness (step_n 38) (register "x12"))) (property (id "still-little") (requirement_id "REQ-D-ENDIAN") (obligation_ids "OB-ENDIAN") (observation_kinds "gpr-change") (statement "So byte 0 still reads the least significant byte (RVI-RV32I §1.1.6).") (gpr_witness (step_n 40) (register "x13"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/endian-forms.s") (sha256 "81f121d495daa76be2b5736fc7b3a8c221df6433402b22a6e76b2e310e6c33af")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-endian-v1/guest.elf") (sha256 "f9dcaf6a1848c5e517be55413fa95edc43cef45156b676281d4b359424c4b629")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-endian-v1/reference-config.json") (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-endian-v1/baseline.expected.sexp") (sha256 "67d2d7c162c58af41f88f6be8c5866bb67636671c32a5d4cd568b065b1f7886d")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-endian-v1/control.expected.sexp") (sha256 "9afc4cfa97321bce3cc