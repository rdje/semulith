(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-lui-auipc-v1") (program "lui-auipc-forms.s") (instructions 10) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: an AUIPC offset not sign-extended must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Nine finite predeclared witnesses of LUI and AUIPC at 64 bits: the zeroed low 12 bits, sign-extension from bit 31 on both sides of it, a zero immediate, and AUIPC's offset added to its own address at this program's addresses; full source/risk/feature policy remains pending.") (property (id "lui-low-bits-zero") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "LUI fills the low 12 bits with zeros: 0x12345000 in x5 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 0) (register "x5"))) (property (id "lui-sign-extends") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "LUI's 32-bit result sign-extends to 64 bits from bit 31 in x6 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 1) (register "x6"))) (property (id "lui-largest-positive") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "With bit 31 clear, LUI's result stays positive: 0x7ffff000 in x7 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 2) (register "x7"))) (property (id "lui-all-bits") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "Every U-immediate bit set is -4096, sign-extended, in x8 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 3) (register "x8"))) (property (id "lui-zero") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "A zero immediate replaces a sentinel in x13 with 0 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 5) (register "x13"))) (property (id "auipc-own-address") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "AUIPC adds its offset to its own address: 0 + 0x80000018 in x9 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 6) (register "x9"))) (property (id "auipc-offset") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "AUIPC forms the offset 0x1000 from its U-immediate and adds it to its own address, in x10 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 7) (register "x10"))) (property (id "auipc-sign-extends") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "AUIPC's offset sign-extends to -2^31, cancelling the 0x80000000 of its own address, 0x80000020, and leaving 32 in x11 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 8) (register "x11"))) (property (id "auipc-largest-positive") (requirement_id "REQ-D-LUI-AUIPC") (obligation_ids "OB-LUI-AUIPC") (observation_kinds "gpr-change") (statement "The largest positive offset, 0x7ffff000, added to its own address, in x12 (RVI-RV64I §3.1.2.1).") (gpr_witness (step_n 9) (register "x12"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/lui-auipc-forms.s") (sha256 "49b2c11e4bfd35d051183ebef4c8d976d2fc7b3cc92cd951829a36966e7069e9")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "504bd637dca71d07b6dceed8a70576723ab3f4c1ae90f012868bf6e23bd0e2dd")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "4b7b16225c73d2123b9f177b7c484a6872fd4d106b9896223a12e340211db8da")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-lui-auipc-v1/guest.elf") (sha256 "bbe166bf5ac9f0a76c6f6067ab67beed31f1914b5f368776ee3bd3d004b4b7