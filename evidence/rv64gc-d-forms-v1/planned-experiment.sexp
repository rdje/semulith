(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-d-forms-v1") (program "d-forms.s") (instructions 350) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a static rounding mode that is ignored must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "93 finite predeclared witnesses: all 32 forms at chosen values, static and dynamic rounding, a reserved mode refused even where nothing can round, the flags and their accrual, tininess after rounding, the canonical NaN, payloads kept by the transfers and sign injection, a boxed single seen as the quiet NaN it appears as, FCVT.S.D rounding and boxing, FCVT.D.S widening and reading through the box, a signaling NaN into a conversion, conversions clipping and NaN inputs, FEQ quiet and FLT signaling, FS Off refusing and Dirty following an f-register or a flag alone; numeric results stand at these values, with no claim of exhaustiveness, a reserved mode is witnessed on FCVT.D.W and FCVT.D.S, not on FCVT.D.WU, and FS Off is witnessed on a move, a load and an arithmetic form, not on every form; full source/risk/feature policy remains pending.") (property (id "fs-off-cause") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "With FS Off every D instruction is illegal-instruction: mcause 2, replacing a sentinel (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 15) (register "x30"))) (property (id "fs-off-keeps-rd") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "And the refused move kept rd: 41, copied to x26 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 20) (register "x26"))) (property (id "fs-off-load") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds 