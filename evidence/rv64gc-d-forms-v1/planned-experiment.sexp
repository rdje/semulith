(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-d-forms-v1") (program "d-forms.s") (instructions 326) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a static rounding mode that is ignored must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "64 finite predeclared witnesses: all 32 forms at chosen values, static and dynamic rounding, a reserved mode refused even where nothing can round, the flags and their accrual, tininess after rounding, the canonical NaN, payloads kept by the transfers and sign injection, a boxed single seen as the quiet NaN it appears as, FCVT.S.D rounding and boxing, FCVT.D.S widening and reading through the box, a signaling NaN into a conversion, conversions clipping and NaN inputs, FEQ quiet and FLT signaling, FS Off refusing and Dirty following an f-register or a flag alone; numeric results stand at these values, with no claim of exhaustiveness, and not witnessed at this format are FMIN with two NaNs, a fused multiply of infinity by zero, FCLASS's other eight classes, FS Clean surviving a read, mstatus.SD and FS Off on every form, the F case witnessing the last three at format 32; full source/risk/feature policy remains pending.") (property (id "fs-off-cause") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "With FS Off every D instruction is illegal-instruction: mcause 2, replacing a sentinel (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 15) (register "x30"))) (property (id "fs-off-keeps-rd") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "And the refused move kept rd: 41, copied to x26 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 20) (register "x26"))) (property (id "fs-dirty") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "An f-register write makes the state Dirty: FS reads 3 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 34) (register "x19"))) (property (id "fmv-x-d-moves-bits") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FMV.X.D moves -1.0's bits, all 64: 0xbff0000000000000 in x7 (RVI-D §21.1.5).") (gpr_witness (step_n 47) (register "x7"))) (property (id "fld-loads") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FLD loads what FSD stored: 0x4022000000000000, read back in x6 (RVI-D §21.1.3).") (gpr_witness (step_n 51) (register "x6"))) (property (id "fsd-stores") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FSD stored the bits, read back as an integer (RVI-D §21.1.3).") (gpr_witness (step_n 53) (register "x6"))) (property (id "transfers-keep-payload") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FLD, FSD and the moves keep a non-canonical NaN's payload (RVI-D §21.1.3; RVI-D §21.1.5).") (gpr_witness (step_n 63) (register "x6"))) (property (id "fadd-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FADD: 1.0 + 3.0 is exact: 0x4010000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 66) (register "x6"))) (property (id "fsub-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FSUB: 1.0 - 3.0 is exact: 0xc000000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 69) (register "x6"))) (property (id "fmul-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FMUL: 3.0 * 3.0 is exact: 0x4022000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 72) (register "x6"))) (property (id "fsqrt-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FSQRT of 9.0 is exact: 0x4008000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 78) (register "x6"))) (property (id "fmadd-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FMADD: 3.0 * 3.0 + 1.0: 0x4024000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 81) (register "x6"))) (property (id "fmsub-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FMSUB: 3.0 * 3.0 - 1.0: 0x4020000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 84) (register "x6"))) (property (id "fnmsub-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FNMSUB: -(3.0 * 3.0) + 1.0: 0xc020000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 87) (register "x6"))) (property (id "fnmadd-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FNMADD: -(3.0 * 3.0) - 1.0: 0xc024000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 90) (register "x6"))) (property (id "fsgnj-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FSGNJ takes rs2's sign: 0xbff0000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 93) (register "x6"))) (property (id "fsgnjn-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FSGNJN takes the opposite of rs2's sign: 0x3ff0000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 96) (register "x6"))) (property (id "fsgnjx-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FSGNJX takes the XOR of the signs: 0x3ff0000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 99) (register "x6"))) (property (id "sgnj-keeps-payload") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "Sign injection does not canonicalize a NaN: 0x7ff0000000012345, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 102) (register "x6"))) (property (id "fmin-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FMIN of 0.0 and -0.0, -0.0 counting as the smaller: 0x8000000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 113) (register "x6"))) (property (id "fmax-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FMAX of 1.0 and 3.0: 0x4008000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 116) (register "x6"))) (property (id "fdiv-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FDIV: 1.0 / 3.0, to nearest, ties to even: 0x3fd5555555555555, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 119) (register "x6"))) (property (id "inexact-flag") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "NX: an inexact result sets it: 1 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 121) (register "x20"))) (property (id "div-by-zero") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "1.0 / 0.0 is infinity: 0x7ff0000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 124) (register "x6"))) (property (id "flags-accrue") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "DZ joins NX, which stays set: the flags are sticky: 9 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 126) (register "x20"))) (property (id "static-rounding") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "The same quotient under a static RUP: 0x3fd5555555555556, read back in x6 (RVI-D §21.1.4; RVI-F §20.1.2).") (gpr_witness (step_n 130) (register "x6"))) (property (id "dynamic-rounding") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "The same quotient under DYN, reading frm's RUP: 0x3fd5555555555556, read back in x6 (RVI-D §21.1.4; RVI-F §20.1.2).") (gpr_witness (step_n 134) (register "x6"))) (property (id "invalid-is-canonical") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "The square root of -1.0 is the canonical NaN: 0x7ff8000000000000, read back in x6 (RVI-D §21.1.4; RVI-F §20.1.3).") (gpr_witness (step_n 139) (register "x6"))) (property (id "invalid-flag") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "NV: an invalid operation sets it: 16 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 141) (register "x20"))) (property (id "fmin-one-nan") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "With one NaN input FMIN returns the other, 1.0: 0x3ff0000000000000, read back in x6 (RVI-D §21.1.4).") (gpr_witness (step_n 145) (register "x6"))) (property (id "overflow-flag") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "OF and NX: an overflow sets both: 5 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 152) (register "x20"))) (property (id "underflow-flag") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "UF and NX: a tiny, inexact result sets both: 3 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 161) (register "x20"))) (property (id "tininess-after-rounding") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "Their product is below the least normal, and rounds up to it: 0x10000000000000, read back in x6 (RVI-D §21.1.4; RVI-F §20.1.4).") (gpr_witness (step_n 173) (register "x6"))) (property (id "not-tiny-after-rounding") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "NX alone: tininess is detected after rounding, and this result is normal then: 1 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 175) (register "x20"))) (property (id "feq-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FEQ of equal values: 0x1 in x11 (RVI-D §21.1.6).") (gpr_witness (step_n 187) (register "x11"))) (property (id "flt-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FLT of 1.0 and 3.0: 0x1 in x12 (RVI-D §21.1.6).") (gpr_witness (step_n 189) (register "x12"))) (property (id "fle-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FLE of 3.0 and 1.0: 0x0 in x13 (RVI-D §21.1.6).") (gpr_witness (step_n 191) (register "x13"))) (property (id "feq-quiet") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FEQ on a quiet NaN sets no flag: 0 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 195) (register "x20"))) (property (id "fs-flags-dirty") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "NV is new in fflags: that alone makes the state Dirty: FS reads 3 (RVP-MACHINE §2.1.1.6.7).") (gpr_witness (step_n 211) (register "x19"))) (property (id "flt-signaling") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FLT on a quiet NaN sets NV: 16 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 213) (register "x20"))) (property (id "fclass-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCLASS of 1.0 sets bit 6, a positive normal: 0x40 in x14 (RVI-D §21.1.7).") (gpr_witness (step_n 216) (register "x14"))) (property (id "fclass-signaling") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCLASS of a signaling NaN sets bit 8, 0x100 in x14 (RVI-D §21.1.7).") (gpr_witness (step_n 218) (register "x14"))) (property (id "fcvt-w-rounds") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.W of 1.5 rounds to nearest, ties to even: 0x2 in x15 (RVI-D §21.1.5).") (gpr_witness (step_n 222) (register "x15"))) (property (id "fcvt-wu-saturates") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.WU of -1.0 cannot be represented, and clips to: 0x0 in x16 (RVI-D §21.1.5).") (gpr_witness (step_n 227) (register "x16"))) (property (id "fcvt-invalid-flag") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "NV: an unrepresentable conversion sets it: 16 in x20 (RVI-F §20.1.2).") (gpr_witness (step_n 229) (register "x20"))) (property (id "fcvt-w-nan") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.W of a NaN clips to the largest word, 0x7fffffff in x15 (RVI-D §21.1.5).") (gpr_witness (step_n 232) (register "x15"))) (property (id "fcvt-l-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.L of -1.0: 0xffffffffffffffff in x17 (RVI-D §21.1.5).") (gpr_witness (step_n 236) (register "x17"))) (property (id "fcvt-l-nan") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.L of a NaN clips to the largest doubleword, in x17 (RVI-D §21.1.5).") (gpr_witness (step_n 238) (register "x17"))) (property (id "fcvt-lu-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.LU of 3.0: 0x3 in x18 (RVI-D §21.1.5).") (gpr_witness (step_n 240) (register "x18"))) (property (id "fcvt-d-w") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "From the word -1: 0xbff0000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 245) (register "x6"))) (property (id "fcvt-d-wu") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "From the unsigned word 2^32 - 1: 0x41efffffffe00000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 248) (register "x6"))) (property (id "fcvt-d-l") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "From the doubleword -1: 0xbff0000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 251) (register "x6"))) (property (id "fcvt-d-lu") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "From the unsigned doubleword 2^64 - 1: 0x43f0000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 254) (register "x6"))) (property (id "box-is-a-quiet-nan") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "A NaN-boxed single, read by a D operation, is the quiet NaN it appears as: FCLASS.D sets bit 9 (RVI-D §21.1.2).") (gpr_witness (step_n 259) (register "x14"))) (property (id "fcvt-d-s") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.D.S of a boxed single 1.5 widens exactly: 0x3ff8000000000000, read back in x6 (RVI-D §21.1.5).") (gpr_witness (step_n 262) (register "x6"))) (property (id "fcvt-d-s-unboxed") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.D.S reads 1.0, not boxed as a single, as the canonical NaN: 0x7ff8000000000000, read back in x6 (RVI-D §21.1.5; RVI-D §21.1.2).") (gpr_witness (step_n 265) (register "x6"))) (property (id "fcvt-s-d") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "FCVT.S.D of a third, under a static RUP, rounds and writes its single boxed: 0xffffffff3eaaaaab, read back in x6 (RVI-D §21.1.5; RVI-D §21.1.2).") (gpr_witness (step_n 281) (register "x6"))) (property (id "fcvt-s-d-rounds") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "The same value under a static RDN: 0xffffffff3eaaaaaa, read back in x6 (RVI-D §21.1.5; RVI-F §20.1.2).") (gpr_witness (step_n 284) (register "x6"))) (property (id "snan-conversion-invalid") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "A signaling NaN into FCVT.S.D sets NV: 16 in x20 (RVI-F §20.1.2; RVI-D §21.1.5).") (gpr_witness (step_n 288) (register "x20"))) (property (id "snan-conversion-canonical") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "And its result is the single canonical NaN, boxed (RVI-F §20.1.3; RVI-D §21.1.2).") (gpr_witness (step_n 291) (register "x6"))) (property (id "reserved-where-nothing-rounds") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "A reserved rounding mode is illegal even on FCVT.D.W, which cannot round: mcause 2, replacing a sentinel (RVI-F §20.1.2; RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 298) (register "x30"))) (property (id "reserved-on-widening") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "And on FCVT.D.S, which never rounds: mcause 2, replacing a sentinel (RVI-F §20.1.2; RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 308) (register "x30"))) (property (id "reserved-dynamic") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_kinds "gpr-change") (statement "DYN with frm holding 5 is reserved, so illegal-instruction: mcause 2, replacing a sentinel (RVI-F §20.1.2; RVP-MACHINE §2.1.1.15).") (gpr_witness (step_n 319) (register "x30"))) (property (id "reserved-writes-nothing") (requirement_id "REQ-GC-D") (obligation_ids "OB-GC-D") (observation_k