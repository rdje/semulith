  (property (id "form-mulw") (cell "form:mulw") (step_n 11) (register "x14") (expected 0xffffffff80000000)
    (statement "For MULW with x5 = -7 and x9 = 0x80000000, the x14 change at boundary 11 is 0xffffffff80000000 (the low 32 bits of the product, sign-extended)."))
  (property (id "form-div") (cell "form:div") (step_n 12) (register "x15") (expected 0xfffffffffffffffd)
