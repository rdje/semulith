  (property (id "form-divu") (cell "form:divu") (step_n 13) (register "x16") (expected 0x7fffffffffffffff)
    (statement "For DIVU with x7 = 2^64 - 1 and x6 = 2 (both unsigned), the x16 change at boundary 13 is 2^63 - 1."))
  (property (id "form-rem") (cell "form:rem") (step_n 14) (register "x17") (expected 0xffffffffffffffff)
    (statement "For REM with x5 = -7 and x6 = 2, the x17 change at boundary 14 is -1 (the remainder takes the dividend's sign)."))
  (property (id "form-remu") (cell "form:remu") (step_n 15) (register "x18") (expected 1)
    (statement "For REMU with x7 = 2^64 - 1 and x6 = 2 (both unsigned), the x18 change at boundary 15 is 1."))
  (property (id "form-divw") (cell "form:divw") (step_n 16) (register "x19") (expected 0xffffffffc0000000)
    (statement "For DIVW with the words -2^31 (x9) and 2 (x6), the x19 change at boundary 16 is -2^30, sign-extended."))
  (property (id "form-divuw") (cell "form:divuw") (step_n 17) (register "x20") (expected 0x40000000)
    (statement "For DIVUW with the unsigned words 0x80000000 (x9) and 2 (x6), the x20 change at boundary 17 is 0x40000000."))
  (property (id "form-remw") (cell "form:remw") (step_n 18) (register "x21") (expected 0xfffffffffffffffe)
    (statement "For REMW with the words -2^31 (x9) and -7 (x5), the x21 change at boundary 18 is -2 (the dividend's sign)."))
  (property (id "form-remuw") (cell "form:remuw") (step_n 19) (register "x22") (expected 0xffffffff80000000)
    (statement "For REMUW with the unsigned words 0x80000000 (x9) and 0xfffffff9 (x5), the x22 change at boundary 19 is 0x80000000 sign-extended (the whole dividend)."))
  (property (id "table1-div-by-zero") (cell "table1:div-by-zero") (step_n 20) (register "x23") (expected 0xffffffffffffffff)
    (statement "For DIV with x5 = -7 and x0 = 0, the x23 change at boundary 20 is -1 (Table 1: division by zero, all bits set; no trap)."))
  (property (id "table1-divu-by-zero") (cell "table1:divu-by-zero") (step_n 21) (register "x24") (expected 0xffffffffffffffff)
    (statement "For DIVU with x5 = 2^64 - 7 and x0 = 0, the x24 change at boundary 21 is 2^64 - 1 (Table 1: division by zero, all bits set)."))
  (property (id "table1-rem-by-zero") (cell "table1:rem-by-zero") (step_n 22) (register "x25") (expected 0xfffffffffffffff9)
    (statement "For REM with x5 = -7 and x0 = 0, the x25 change at boundary 22 is -7 (Table 1: the remainder of division by zero is the dividend)."))
  (property (id "table1-remu-by-zero") (cell "table1:remu-by-zero") (step_n 23) (register "x26") (expected 0xfffffffffffffff9)
    (statement "For REMU with x5 = 2^64 - 7 and x0 = 0, the x26 change at boundary 23 is 2^64 - 7 (Table 1: the dividend)."))
  (property (id "table1-div-overflow") (cell "table1:div-overflow") (step_n 24) (register "x27") (expected 0x8000000000000000)
    (statement "For DIV with x8 = -2^63 and x7 = -1, the x27 change at boundary 24 is -2^63 (Table 1: signed overflow, the quotient equals the dividend; no trap)."))
  (property (id "table1-rem-overflow") (cell "table1:rem-overflow") (step_n 26) (register "x28") (expected 0)
    (statement "For REM with x8 = -2^63 and x7 = -1, the x28 change at boundary 26 is 0 (Table 1: the overflow remainder, replacing the sentinel 28)."))
  (property (id "table1-divw-by-zero") (cell "table1:divw-by-zero") (step_n 27) (register "x29") (expected 0xffffffffffffffff)
    (statement "For DIVW with the word -2^31 (x9) and x0 = 0, the x29 change at boundary 27 is -1 (Table 1 at L = 32: all bits set, sign-extended)."))
  (property (id "table1-divuw-by-zero") (cell "table1:divuw-by-zero") (step_n 28) (register "x30") (expected 0xffffffffffffffff)
    (statement "For DIVUW with the unsigned word 0x80000000 (x9) and x0 = 0, the x30 change at boundary 28 is 2^32 - 1 sign-extended (all bits set)."))
  (property (id "table1-remw-by-zero") (cell "table1:remw-by-zero") (step_n 29) (register "x31") (expected 0xffffffff80000000)
    (statement "For REMW with the word -2^31 (x9) and x0 = 0, the x31 change at boundary 29 is -2^31 sign-extended (Table 1: the dividend's word)."))
  (property (id "table1-remuw-by-zero") (cell "table1:remuw-by-zero") (step_n 30) (register "x10") (expected 0xffffffff80000000)
    (statement "For REMUW with the unsigned word 0x80000000 (x9) and x0 = 0, the x10 change at boundary 30 is 0x80000000 sign-extended (Table 1: the dividend's word), replacing the MUL result."))
  (property (id "table1-divw-overflow") (cell "table1:divw-overflow") (step_n 31) (register "x11") (expected 0xffffffff80000000)
    (statement "For DIVW with the words -2^31 (x9) and -1 (x7), the x11 change at boundary 31 is -2^31 sign-extended (Table 1: word overflow, the quotient equals the dividend), replacing the MULH result."))
  (property (id "table1-remw-overflow") (cell "table1:remw-overflow") (step_n 32) (register "x12") (expected 0)
