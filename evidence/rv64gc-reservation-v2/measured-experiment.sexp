(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-reservation-v2") (program "reservation-forms.s") (instructions 190) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a set wider than the reservation must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "24 finite predeclared witnesses. exact width is past the reference: the pinned binary pairs an SC of another width at the same address, so it is a selection this case states and does not compare; the address and width a cleared reservation keeps have no effect while validity is clear, so nothing here observes them; no other hart or device exists here to invalidate anything; only the cleared validity of the reset state is observable; this selects one laboratory realization and claims nothing of multicore behaviour") (property (id "cold-no-reservation") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "Nothing has reserved yet: an SC with no LR writes the failure code, 1. Cold reset starts with no valid reservation (RVI-A §12.1.2).") (gpr_witness (step_n 20) (register "x15"))) (property (id "exact-address") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "The reservation covers exactly the LR's word: an SC to the word beside it, in the same eight bytes, writes 1. The laboratory's reservation set is exactly the reservation, a selection within the latitude (RVI-A §12.1.2).") (gpr_witness (step_n 23) (register "x15"))) (property (id "same-address-pairs") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "At the LR's own address the SC pairs: 0 in rd (RVI-A §12.1.2).") (gpr_witness (step_n 26) (register "x15"))) (property (id "doubleword-pairs") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "And at a doubleword's: LR.D with SC.D, 0 in rd (RVI-A §12.1.2).") (gpr_witness (step_n 30) (register "x15"))) (property (id "lr-replaces-old") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "A completed LR replaces the prior reservation: after LR A and LR B, an SC to A writes 1 (RVI-A §12.1.2).") (gpr_witness (step_n 35) (register "x15"))) (property (id "lr-replaces-new") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "And an SC to B pairs: 0 (RVI-A §12.1.2).") (gpr_witness (step_n 39) (register "x15"))) (property (id "failed-sc-at-b") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "An SC to any other address fails: 1 (RVI-A §12.1.2).") (gpr_witness (step_n 43) (register "x15"))) (property (id "failure-invalidates") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "And that failure invalidated the reservation: the SC to A now writes 1 too (RVI-A §12.1.2).") (gpr_witness (step_n 45) (register "x15"))) (property (id "first-sc-pairs") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "A completed SC invalidates on success too: the first pairs, 0 (RVI-A §12.1.2).") (gpr_witness (step_n 48) (register "x15"))) (property (id "success-invalidates") (requirement_id "REQ-D-RESERVATION") (obligation_ids "OB-GC-RESERVATION-V2") (observation_kinds "gpr-change") (statement "And the second writes 1 (RVI-A §12.1.2).") (gpr_witness (step_n 50) (register "x15"))) (property (id "misaligned-sc-traps") (requirement_id 