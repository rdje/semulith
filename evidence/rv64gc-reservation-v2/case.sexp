  (property (id "exact-address") (cell "form:sc.w") (step_n 23) (register "x15") (expected 1)
    (statement "The reservation covers exactly the LR's word: an SC to the word beside it, in the same eight bytes, writes 1. The laboratory's reservation set is exactly the reservation, a selection within the latitude (RVI-A §12.1.2)."))
  (property (id "same-address-pairs") (cell "form:sc.w") (step_n 26) (register "x15") (expected 0)
