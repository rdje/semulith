(case (id "rv64gc-csr-access-v1") (profile_id "rv64gc-lab-v0")
  (program "csr-access.s") (instructions 66) (source_size 5387)
  (source_sha256 "ce33efd393238396027cc97d5d285cd53f8b0bc8a95449f21ec7aae8eabc11cb")
  (requirement_id "REQ-GC-CSR-ACCESS") (obligation_ids "OB-GC-CSR-ACCESS")
  (contract_id "rv64gc-lab-env-v3") (contract_version "3")
  (control (property_id "csrrwi-zero-extended") (value 0xffffffffffffffff) (reason "Only boundary 15 x15 expectation changes from 31 to all ones, what a 5-bit immediate sign-extended would write.") (id "immediate-sign-extended")
    (statement "Predeclared target: a CSR immediate sign-extended must diverge."))
  (limitation "21 finite predeclared witnesses of the six Zicsr forms on mscratch, sscratch and mhartid: swap, set and clear, the zero-extended immediate, the no-write cases on a read-only CSR, refused writes in M and a refused access in S, each keeping rd; that CSRRW with rd = x0 does not read has no side effect here to observe, and the counter and Sstc gates are REQ-GC-COUNTERS' and REQ-D-SSTC's; full source/risk/feature policy remains pending.")
  (source_id "RVI-ZICSR") (source_locator "5.1.1") (category "defined") (risk "high")
  (coverage "21 witnesses: the six forms, the no-write rules, and refused accesses")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
  (adversarial (property_ids "refused-csrrw-rd-kept") (property_ids "refused-csrrs-rd-kept") (property_ids "refused-csrrsi-rd-kept") (property_ids "s-refused-rd-kept") (property_ids "csrrs-x0-no-write") (property_ids "csrrsi-zero-no-write")
    (failure_mode "a refused access that commits its rd, or a no-write form that traps"))
  (authority (requirement_semantic_sha256 "afc897cdab483621bfb28ec97f9532ee2f9ce11cf634e6aeae3e4549502119dd") (obligation_id "OB-GC-CSR-ACCESS")
