  (property (id "csrrw-reads-old") (cell "form:csrrw") (step_n 6) (register "x6") (expected 0)
    (statement "CSRRW swaps: the old 0 replaces a sentinel in x6 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrw-writes-new") (cell "form:csrrs") (step_n 7) (register "x7") (expected 85)
    (statement "CSRRW wrote 0x55, and CSRRS with rs1 = x0 reads it into x7 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrs-reads-old") (cell "form:csrrs") (step_n 9) (register "x9") (expected 85)
    (statement "CSRRS reads the old value, 0x55, into x9 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrs-sets-bits") (cell "form:csrrs") (step_n 10) (register "x10") (expected 95)
    (statement "CSRRS sets only rs1's bits: 0x5f in x10 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrc-reads-old") (cell "form:csrrc") (step_n 12) (register "x12") (expected 95)
    (statement "CSRRC reads the old value, 0x5f, into x12 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrc-clears-bits") (cell "form:csrrs") (step_n 13) (register "x13") (expected 15)
    (statement "CSRRC clears only rs1's bits: 0x0f in x13 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrwi-reads-old") (cell "form:csrrwi") (step_n 14) (register "x14") (expected 15)
    (statement "CSRRWI reads the old value, 0x0f, into x14 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrwi-zero-extended") (cell "form:csrrs") (step_n 15) (register "x15") (expected 31)
    (statement "CSRRWI's 5-bit immediate is zero-extended: 31 in x15 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrci-reads-old") (cell "form:csrrci") (step_n 16) (register "x16") (expected 31)
    (statement "CSRRCI reads the old value, 31, into x16 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrsi-reads-old") (cell "form:csrrsi") (step_n 18) (register "x18") (expected 30)
    (statement "CSRRSI reads the old value, 30, into x18 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrs-x0-no-write") (cell "form:csrrs") (step_n 21) (register "x20") (expected 0)
    (statement "CSRRS with rs1 = x0 attempts no write, so a read-only CSR does not trap: its 0 replaces a sentinel in x20 (RVI-ZICSR §5.1.1)."))
  (property (id "csrrsi-zero-no-write") (cell "form:csrrsi") (step_n 23) (register "x21") (expected 0)
    (statement "CSRRSI with uimm = 0 attempts no write, so a read-only CSR does not trap: its 0 replaces a sentinel in x21 (RVI-ZICSR §5.1.1)."))
  (property (id "refused-cause-0") (cell "form:csrrs") (step_n 27) (register "x30") (expected 2)
    (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1)."))
  (property (id "refused-csrrw-rd-kept") (cell "form:addi") (step_n 32) (register "x25") (expected 41)
    (statement "A write to a read-only CSR is refused, and rd keeps 41, copied to x25 (RVP-CSR §1.1.1)."))
  (property (id "refused-cause-1") (cell "form:csrrs") (step_n 35) (register "x30") (expected 2)
    (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1)."))
  (property (id "refused-csrrs-rd-kept") (cell "form:addi") (step_n 40) (register "x26") (expected 41)
    (statement "CSRRS with rs1 not x0 attempts a write, so it is refused, and rd keeps 41, copied to x26 (RVP-CSR §1.1.1)."))
  (property (id "refused-cause-2") (cell "form:csrrs") (step_n 43) (register "x30") (expected 2)
    (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1)."))
  (property (id "refused-csrrsi-rd-kept") (cell "form:addi") (step_n 48) (register "x27") (expected 41)
    (statement "CSRRSI with uimm not zero attempts a write, so it is refused, and rd keeps 41, copied to x27 (RVP-CSR §1.1.1)."))
  (property (id "refused-cause-3") (cell "form:csrrs") (step_n 58) (register "x30") (expected 2)
    (statement "This access is refused with illegal-instruction: the handler reads mcause 2, replacing a sentinel in x30 (RVP-CSR §1.1.1)."))
  (property (id "s-refused-rd-kept") (cell "form:addi") (step_n 63) (register "x28") (expected 41)
    (statement "S is below mscratch's privilege, so its read is refused, and rd keeps 41, copied to x28 (RVP-CSR §1.1.1)."))
