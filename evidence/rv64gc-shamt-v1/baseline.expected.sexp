;; shamt-forms.expected.sexp — spec-side observations for `shamt-forms.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py shamt-forms.expected.sexp schema/expectations.sexp

(expectations (program "shamt-forms.s") (entry "0x0000000080000000") (instructions 21) (fetches 42)
  (step (n 0) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "1, the value shifted.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x6, x5, 63") (writes (write (reg "x6") (value "0x8000000000000000")))
    (derivation "SLLI takes a 6-bit amount: 1 << 63 = 0x8000000000000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SLLI's largest amount)"))
  (step (n 2) (insn "srli x7, x6, 63") (writes (write (reg "x7") (value "0x0000000000000001")))
    (derivation "SRLI takes a 6-bit amount: 0x0000000000000001.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRLI's largest amount)"))
  (step (n 3) (insn "srai x8, x6, 63") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "SRAI takes a 6-bit amount and copies the sign: 0xffffffffffffffff.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRAI's largest amount)"))
  (step (n 4) (insn "slli x9, x5, 32") (writes (write (reg "x9") (value "0x0000000100000000")))
    (derivation "an amount of 32 uses bit 5 of the immediate: 0x0000000100000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: an immediate amount above 31)"))
  (step (n 5) (insn "addi x10, x0, 65") (writes (write (reg "x10") (value "0x0000000000000041")))
    (derivation "65, whose low 6 bits are 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "sll x11, x5, x10") (writes (write (reg "x11") (value "0x0000000000000002")))
    (derivation "SLL uses only the low 6 bits of rs2: 1 << 1 = 0x0000000000000002.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SLL with rs2 above 63)"))
  (step (n 7) (insn "srl x12, x6, x10") (writes (write (reg "x12") (value "0x4000000000000000")))
    (derivation "SRL uses only the low 6 bits of rs2: 2^63 >> 1 = 0x4000000000000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRL with rs2 above 63)"))
  (step (n 8) (insn "sra x13, x6, x10") (writes (write (reg "x13") (value "0xc000000000000000")))
    (derivation "SRA uses only the low 6 bits of rs2 and copies the sign: 0xc000000000000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRA with rs2 above 63)"))
  (step (n 9) (insn "addi x14, x0, 64") (writes (write (reg "x14") (value "0x0000000000000040")))
    (derivation "64, whose low 6 bits are 0.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "sll x15, x5, x14") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "so SLL shifts by nothing: 0x0000000000000001.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SLL with rs2 at 64)"))
  (step (n 11) (insn "addi x16, x0, 33") (writes (write (reg "x16") (value "0x0000000000000021")))
    (derivation "33, whose low 5 bits are 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "lui x17, 0x80000") (writes (write (reg "x17") (value "0xffffffff80000000")))
    (derivation "the word with its sign bit set: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2"))
  (step (n 13) (insn "sllw x18, x5, x16") (writes (write (reg "x18") (value "0x0000000000000002")))
    (derivation "SLLW uses rs2[4:0]: 1 << 1 = 0x0000000000000002.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SLLW with rs2 above 31)"))
  (step (n 14) (insn "srlw x19, x17, x16") (writes (write (reg "x19") (value "0x0000000040000000")))
    (derivation "SRLW uses rs2[4:0]: 0x80000000 >> 1 = 0x0000000040000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRLW with rs2 above 31)"))
  (step (n 15) (insn "sraw x20, x17, x16") (writes (write (reg "x20") (value "0xffffffffc0000000")))
    (derivation "SRAW uses rs2[4:0] and copies bit 31: 0xffffffffc0000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRAW with rs2 above 31)"))
  (step (n 16) (insn "addi x21, x0, 32") (writes (write (reg "x21") (value "0x0000000000000020")))
    (derivation "32, whose low 5 bits are 0.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "sllw x22, x5, x21") (writes (write (reg "x22") (value "0x0000000000000001")))
    (derivation "so SLLW shifts by nothing: 0x0000000000000001.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SLLW with rs2 at 32)"))
  (step (n 18) (insn "slliw x23, x5, 31") (writes (write (reg "x23") (value "0xffffffff80000000")))
    (derivation "SLLIW takes 5 bits: 1 << 31 as a word, sign-extended: 0xffffffff80000000.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SLLIW's largest amount)"))
  (step (n 19) (insn "srliw x24, x17, 31") (writes (write (reg "x24") (value "0x0000000000000001")))
    (derivation "SRLIW takes 5 bits: 0x0000000000000001.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRLIW's largest amount)"))
  (step (n 20) (insn "sraiw x25, x17, 31") (writes (write (reg "x25") (value "0xffffffffffffffff")))
    (derivation "SRAIW takes 5 bits and copies bit 31: 0xffffffffffffffff.") (source "RVI-RV64I §3.1.2.1, §3.1.2.2 (boundary: SRAIW's largest amount)"))
)
