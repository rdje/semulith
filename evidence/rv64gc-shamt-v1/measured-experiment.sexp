(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-shamt-v1") (program "shamt-forms.s") (instructions 21) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a shift amount not masked to 6 bits must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Fifteen finite predeclared witnesses of the twelve shifts: each form's largest amount or an rs2 above its range, and an rs2 whose kept bits are zero; full source/risk/feature policy remains pending.") (property (id "slli-largest") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SLLI takes a 6-bit amount: 1 << 63 in x6 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 1) (register "x6"))) (property (id "srli-largest") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRLI takes a 6-bit amount: 2^63 >> 63 is 1 in x7 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 2) (register "x7"))) (property (id "srai-largest") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRAI takes a 6-bit amount and copies the sign: all ones in x8 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 3) (register "x8"))) (property (id "slli-amount-32") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "An amount of 32 uses bit 5 of the immediate: 2^32 in x9 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 4) (register "x9"))) (property (id "sll-rs2-above-63") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SLL uses only the low 6 bits of rs2: 65 reads as 1, so 1 << 1 is 2 in x11 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 6) (register "x11"))) (property (id "srl-rs2-above-63") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRL uses only the low 6 bits of rs2: 2^63 >> 1 in x12 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 7) (register "x12"))) (property (id "sra-rs2-above-63") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRA uses only the low 6 bits of rs2 and copies the sign: -2^62 in x13 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 8) (register "x13"))) (property (id "sll-rs2-at-64") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "64's low 6 bits are 0, so SLL shifts by nothing: 1 in x15 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 10) (register "x15"))) (property (id "sllw-rs2-above-31") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SLLW uses rs2[4:0]: 33 reads as 1, so 1 << 1 is 2 in x18 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 13) (register "x18"))) (property (id "srlw-rs2-above-31") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRLW uses rs2[4:0]: 0x80000000 >> 1 in x19 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 14) (register "x19"))) (property (id "sraw-rs2-above-31") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRAW uses rs2[4:0] and copies bit 31: -2^30 in x20 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 15) (register "x20"))) (property (id "sllw-rs2-at-32") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "32's low 5 bits are 0, so SLLW shifts by nothing: 1 in x22 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 17) (register "x22"))) (property (id "slliw-largest") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SLLIW takes 5 bits: 1 << 31 as a word, sign-extended, in x23 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 18) (register "x23"))) (property (id "srliw-largest") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRLIW takes 5 bits: 1 in x24 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 19) (register "x24"))) (property (id "sraiw-largest") (requirement_id "REQ-D-SHAMT") (obligation_ids "OB-SHAMT") (observation_kinds "gpr-change") (statement "SRAIW takes 5 bits and copies bit 31: all ones in x25 (RVI-RV64I §3.1.2.1, §3.1.2.2).") (gpr_witness (step_n 20) (register "x25"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/shamt-forms.s") (sha256 "5e8bb28e265359002693a7e16eb142619805121a13f9ab8480106ffd11622c4a")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "504bd637dca71d07b6dceed8a70576723ab3f4c1ae90f012868bf6e23bd0e2dd")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "4b7b16225c73d2123b9f177b7c484a6872fd4d106b9896223a12e340211db8da")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-shamt-v1/guest.elf") (sha256 "1366f75906e44d5fee1f73c8b790d23885c1ad1f6472d7a9f38a67f851fef02a")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-shamt-v1/reference-config.json") (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-shamt-v1/baseline.expected.sexp") (sha256 "4b3f01ba67f72f6667c47e456a25503845960bbeefdab415ebc213859c5a43d5")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-shamt-v1/control.expected.sexp") (sha256 "4af588ed3f48aa80a07b951496bc2d274f4a42c3df6b0308826ca0541a06626d")) (input (id "reference-identity") (role "reference