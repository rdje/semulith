(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-ext-closure-v2") (program "ext-closure-forms.s") (instructions 64) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: a hart reading this encoding as Zcf must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "12 finite predeclared witnesses. that nothing is inferred from the letter G is how the catalogue is written, not behaviour a run can witness") (property (id "d-narrows-to-f") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "D depends on F: FCVT.S.D writes a single into the registers both share, and FMV.X.W reads 1.0 (RVI-D §21.1).") (gpr_witness (step_n 10) (register "x6"))) (property (id "f-boxed-in-d") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "The registers are D's width and F's values live in them NaN-boxed: the upper 32 bits read all ones (RVI-D §21.1).") (gpr_witness (step_n 14) (register "x8"))) (property (id "f-reads-unboxed-as-nan") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "And F depends on that boxing: an operand not boxed reads as the canonical NaN (RVI-D §21.1).") (gpr_witness (step_n 17) (register "x9"))) (property (id "fcsr-holds-flags") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "The canonical NaN from an unboxed operand signals nothing, so fcsr still reads 0: F reaches its status through Zicsr (RVI-F §20.1; RVI-ZICSR §5.1.1).") (gpr_witness (step_n 19) (register "x10"))) (property (id "fflags-through-zicsr") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "F depends on Zicsr for status: the inexact sum sets NX, which csrrs reads from fflags (RVI-F §20.1; RVI-ZICSR §5.1.1).") (gpr_witness (step_n 29) (register "x13"))) (property (id "frm-through-zicsr") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "And for control: frm reads back the mode written through Zicsr (RVI-F §20.1; RVI-ZICSR §5.1.1).") (gpr_witness (step_n 33) (register "x15"))) (property (id "fcsr-composes") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "fcsr composes the two, frm at bit 5 over fflags: 33 (RVI-F §20.1; RVI-ZICSR §5.1.1).") (gpr_witness (step_n 35) (register "x16"))) (property (id "zca-present") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "C decomposes as Zca always: C.MV moves the data cell's address (RVI-ZC §28.1.2).") (gpr_witness (step_n 40) (register "x8"))) (property (id "zcd-stores") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "Zcd when D is present: C.FSD stores all 64 bits (RVI-ZC §28.1.2).") (gpr_witness (step_n 55) (register "x19"))) (property (id "zcd-loads") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "And C.FLD loads them (RVI-ZC §28.1.2).") (gpr_witness (step_n 57) (register "x20"))) (property (id "zcf-absent-rd") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "Zcf exists only at RV32: this encoding loads all 64 bits into x11, as C.LD (RVI-ZC §28.1.2).") (gpr_witness (step_n 60) (register "x11"))) (property (id "zcf-absent-fd") (requirement_id "REQ-D-EXT-CLOSURE") (obligation_ids "OB-EXT-CLOSURE") (observation_kinds "gpr-change") (statement "And no float register took a word: f11 is still 0 (RVI-ZC §28.1.2).") (gpr_witness (step_n 62) (register "x21"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/ext-closure-forms.s") (sha256 "1369122b72702d8829f3623cda1189b365c6c75c8418dd91420c7ad8ca7e24ff")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-ext-closure-v2/guest.elf") (sha256 "8232f09dc24845b12ef813cc3dad9b9529914d43c631bdfc55d31614398d98e0")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-ext-closure-v2/reference-config.json") (sha256 "795320f7a2c79910683818942c0ce6d0422f04a5f7550dd136db5800fe951472")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-ext-closure-v2/baseline.expected.sexp") (sha256 "4360f8c24040774f653af535b1f8d0b2bbd52c11263aa061b0aa89aee62b168a")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-ext-closure-v2/control.expected.sexp") (sha256 "94c918e65f53eae709b91669334562b9d76dfeb600526eb1a15889085c8bb84b")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-ext-closure-v2/dependencies.sexp") (sha256 "e8dc2b07c0ba12c402ab8d8c48656818bb92223a371f9c00d0bbe1eb00ee0bdd")) (producer (id "reference") (role "reference") (version "sha256:16de42a86e4ea7a300385092632cd95d153cb3f6c119d31eaa9384953990b7bf") (candidate_id "sail-riscv") (input_ids "guest-source") (input_ids "guest-image") (input_ids "reference-config") (input_ids