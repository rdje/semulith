rvation_kinds "gpr-change") (statement "stimecmp holds all 64 bits: 2^40 written, 2^40 read back into x8 (RVP-SUPERVISOR §11.1.1.12).") (gpr_witness (step_n 15) (register "x8"))) (property (id "s-tm-stce-clear-cause") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "TM and STCE are both clear, so S's access to stimecmp is refused: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 26) (register "x30"))) (property (id "s-tm-stce-clear-rd-kept") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "TM and STCE are both clear, so S's access to stimecmp is refused, and its rd x20 keeps the sentinel 21, copied to x21: nothing committed (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 33) (register "x21"))) (property (id "s-stce-clear-cause") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "TM is set and STCE clear, so S's access is still refused: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.18).") (gpr_witness (step_n 56) (register "x30"))) (property (id "s-stce-clear-rd-kept") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "TM is set and STCE clear, so S's access is still refused, and its rd x20 keeps the sentinel 22, copied to x21: nothing committed (RVP-MACHINE §2.1.1.18).") (gpr_witness (step_n 63) (register "x21"))) (property (id "s-tm-clear-cause") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "STCE is set and TM clear, so S's access is refused: each gate holds alone: the handler reads mcause 2 into x30 (RVP-MACHINE §2.1.1.11).") (gpr_witness (step_n 88) (register "x30"))) (property (id "s-tm-clear-rd-kept") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "STCE is set and TM clear, so S's access is refused: each 