s "gpr-change") (statement "The schedule fires: the handler reads scause, the Interrupt bit with cause 5 (RVP-SUPERVISOR §11.1.1.12; RVP-SUPERVISOR §11.1.1.8).") (gpr_witness (step_n 208) (register "x27"))) (property (id "scheduled-sepc") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "Eight ticks from the read, sepc names counted instruction 6 of 12: what both producers do on this configuration, one tick per instruction, not a claim about latency (RVP-SUPERVISOR §11.1.1.7; RVP-SUPERVISOR §11.1.1.12).") (gpr_witness (step_n 209) (register "x26"))) (property (id "scheduled-count") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "5 of the 12 counted instructions had retired when it fired (RVP-SUPERVISOR §11.1.1.12).") (gpr_witness (step_n 212) (register "x31"))) (property (id "scheduled-acknowledged") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "S acknowledges its own timer again: sip reads 0 (RVP-SUPERVISOR §11.1.1.12).") (gpr_witness (step_n 215) (register "x24"))) (property (id "u-delivered-scause") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "Below S the interrupt is taken whatever sstatus.SIE says: SIE is clear, and the handler reads scause (RVP-SUPERVISOR §11.1.1.3; RVP-SUPERVISOR §11.1.1.8).") (gpr_witness (step_n 249) (register "x27"))) (property (id "u-delivered-sepc") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "sepc names U's first instruction: it had not run (RVP-SUPERVISOR §11.1.1.7).") (gpr_witness (step_n 250) (register "x26"))) (property (id "u-delivered-spp") (requirement_id "REQ-D-SSTC") (obligation_ids "OB-SSTC") (observation_kinds "gpr-change") (statement "sstatus.SPP reads 0: the interrupt came from U (RVP-SUPERVISOR §11.1.1.1).") (gpr_witness (step_n 252) (register "x25")))