(comment "Deliberately incorrect negative control: only boundary 16 x12 changes from -2005440939 to 2289526357. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "load-ext-forms.s") (entry "0x0000000080000000") (instructions 32) (fetches 64) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "0x80000000, the region's base: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "addi x1, x10, 512") (writes (write (reg "x1") (value "0x0000000080000200"))) (derivation "the first data cell, past this program: 0x0000000080000200.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "addi x2, x1, 16") (writes (write (reg "x2") (value "0x0000000080000210"))) (derivation "the second cell: 0x0000000080000210.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "addi x3, x1, 32") (writes (write (reg "x3") (value "0x0000000080000220"))) (derivation "the third cell: 0x0000000080000220.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "addi x4, x1, 48") (writes (write (reg "x4") (value "0x0000000080000230"))) (derivation "the fourth cell: 0x0000000080000230.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "lui x5, 0x44332") (writes (write (reg "x5") (value "0x0000000044332000"))) (derivation "the low half of the pattern: 0x0000000044332000.") (source "RVI-RV64I §3.1.2.1")) (step (n 7) (insn "addi x5, x5, 0x211") (writes (write (reg "x5") (value "0x0000000044332211"))) (derivation "0x44332211: 0x0000000044332211.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "lui x6, 0x88776") (writes (write (reg "x6") (value "0xffffffff88776000"))) (derivation "the high half of the pattern: 0xffffffff88776000.") (source "RVI-RV64I §3.1.2.1")) (step (n 9) (insn "addi x6, x6, 0x655") (writes (write (reg "x6") (value "0xffffffff88776655"))) (derivation "0x88776655, its sign bit set: 0xffffffff88776655.") (source "RVI-RV32I §1.1.4")) (step (n 10) (insn "slli x6, x6, 32") (writes (write (reg "x6") (value "0x8877665500000000"))) (derivation "moved to the upper word: 0x8877665500000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 11) (insn "add x7, x6, x5") (writes (write (reg "x7") (value "0x8877665544332211"))) (derivation "the pattern 0x8877665544332211: 0x8877665544332211.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "addi x9, x0, -1") (writes (write (reg "x9") (value "0xffffffffffffffff"))) (derivation "all ones, to show what a narrow store leaves alone: 0xffffffffffffffff.") (source "RVI-RV32I §1.1.4")) (step (n 13) (insn "sd x7, 0, x1") (writes) (derivation "SD stores all 64 bits of rs2.") (source "RVI-RV64I §3.1.3")) (step (n 14) (insn "ld x11, x1, 0") (writes (write (reg "x11") (value "0x8877665544332211"))) (derivation "LD loads all 64 bits, the store's value back: 0x8877665544332211.") (source "RVI-RV64I §3.1.3 (boundary: LD reads what SD stored)")) (step (n 15) (insn "ld x22, x1, 0") (writes (write (reg "x22") (value "0x8877665544332211"))) (derivation "read again: the first load moved nothing, 0x8877665544332211.") (source "RVI-RV64I §3.1.3")) (step (n 16) (insn "lw x12, x1, 4") (writes (write (reg "x12") (value "0x0000000088776655"))) (derivation "LW sign-extends: the upper word 0x88776655 has its sign bit set: 0xffffffff88776655.") (source "RVI-RV64I §3.1.3 (boundary: LW sign-extends)")) (step (n 17) (insn "lwu x13, x1, 4") (writes (write (reg "x13") (value "0x0000000088776655"))) (derivation "LWU zero-extends the same word: 0x0000000088776655.") (source "RVI-RV64I §3.1.3 (boundary: LWU zero-extends)")) (step (n 18) (insn "lw x14, x1, 0") (writes (write (reg "x14") (value "0x0000000044332211"))) (derivation "LW of a word with its sign bit clear: 0x0000000044332211.") (source "RVI-RV64I §3.1.3 (boundary: LW of a positive word)")) (step (n 19) (insn "lh x15, x1, 6") (writes (write (reg "x15") (value "0xffffffffffff8877"))) (derivation "LH sign-extends the halfword 0x8877: 0xffffffffffff8877.") (source "RVI-RV64I §3.1.3 (boundary: LH sign-extend