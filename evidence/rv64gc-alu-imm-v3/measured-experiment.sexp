(comment "Predeclared claims, not observations or qualification.")
(experiment (id "rv64gc-alu-imm-v3") (program "alu-imm-forms.s") (instructions 19) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: an immediate not sign-extended must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Thirteen finite predeclared witnesses of the six register-immediate forms: negative, largest and smallest immediates, overflow ignored, signed and unsigned compares, and a sign-extended immediate for each logical form; full source/risk/feature policy remains pending.") (property (id "addi-negative") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "For ADDI, 5 plus the sign-extended immediate -7 is -2 in x6 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 1) (register "x6"))) (property (id "addi-overflow-ignored") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "ADDI's overflow is ignored: 2^63 - 1 + 1 keeps the low 64 bits, 2^63, in x9 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 4) (register "x9"))) (property (id "addi-largest") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "The largest 12-bit immediate is 2047 in x10 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 5) (register "x10"))) (property (id "addi-smallest") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "The smallest 12-bit immediate sign-extends to -2048 in x11 (RVI-RV32I §1.1.2).") (gpr_witness (step_n 6) (register "x11"))) (property (id "slti-true") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "For SLTI, 5 < 6 as signed numbers writes 1 to x12 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 7) (register "x12"))) (property (id "slti-negative-immediate") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "For SLTI, 5 < -1 is false as signed numbers, replacing a sentinel in x13 with 0 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 9) (register "x13"))) (property (id "slti-negative-operand") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "For SLTI, -1 < 0 as signed numbers writes 1 to x14 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 10) (register "x14"))) (property (id "sltiu-sign-extended-first") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "SLTIU sign-extends its immediate first and then compares unsigned: 4096 < 2^64 - 1 writes 1 to x16 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 12) (register "x16"))) (property (id "sltiu-negative-operand") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "For SLTIU, 2^64 - 1 < 1 is false as unsigned numbers, replacing a sentinel in x17 with 0 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 14) (register "x17"))) (property (id "sltiu-below-one") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "SLTIU rd, rs1, 1 sets rd when rs1 is zero: 1 in x18 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 15) (register "x18"))) (property (id "xori-sign-extended") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "XORI with the sign-extended -1 is the bitwise NOT of 5 in x19 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 16) (register "x19"))) (property (id "ori-sign-extended") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "ORI with the sign-extended -16 sets every upper bit of x20 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 17) (register "x20"))) (property (id "andi-sign-extended") (requirement_id "REQ-D-ALU-IMM") (obligation_ids "OB-ALU-IMM") (observation_kinds "gpr-change") (statement "ANDI with the sign-extended -16 keeps every upper bit of all-ones in x21 (RVI-RV32I §1.1.4.1).") (gpr_witness (step_n 18) (register "x21"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/alu-imm-forms.s") (sha256 "0d51fba267ff77fd43f6861062ee6968f9a295207b8cc5cf1930f472ee524f17")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "cf685e721cb24ca8e71c74e2288564320b239581ff66089dff29e5a9d1293d36")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "3547137e18db9ad9d9c95770d0fd985f2ed9ec2864a21b7259829dd2a102b411")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-alu-imm-v3/guest.elf") (sha256 "57b272f57b150c920591f5204da5743e06f5d1ed31f545162aad6405ba2cd9db")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-alu-imm-v3/reference-config.json") (sha256 "795320f7a2c79910683818942c0ce6d0422f04a5f7550dd136db5800fe951472")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-alu-imm-v3/baseline.expected.sexp") (sha256 "0ac0b935338a6fa6e2aa59a1d4d9e416140212ba0d5dee434d8767124a4be06e")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-alu-imm-v3/control.expected.sexp") (sha256 "762fda139eba49a6e39b3a0b28bd9c07312eb3e7a49d11d858858110205f75e9")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-alu-imm-v3/dependencies.sexp") (sha256 "c47004c20f7e41fc18c8180896ada50b1ed7a1a0bd73addcaeced3f86cc8f11e")) (produce