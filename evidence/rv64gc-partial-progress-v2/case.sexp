  (control (property_id "load-rd-kept") (value 66) (reason "Only boundary 103 x18 expectation changes from the sentinel to 66, what a load that wrote rd before faulting would leave.") (id "load-committed")
    (statement "Predeclared target: a faulting load committing rd must diverge."))
  (limitation "20 finite predeclared witnesses. the reads themselves are not observed in this vocabulary: a walk's are REQ-D-WALK-IMPLICIT's record, and a straddling fetch's first parcel and an AMO's completed load are the corpus's; that no suboperation is restartable is a claim over the whole engine, not one program; the fixtures the statement names are the corpus's: a fault injected at a chosen suboperation is past the reference; the negative evidence the statement names is the corpus's own")
  (source_id "RVI-INTRO") (source_locator "Exceptions, Traps, and Interrupts") (category "implementation-defined") (risk "high")
  (coverage "20 witnesses: a faulting load, float load, store, AMO and SC and a refused CSR write, each cause, and rd, f, fflags, FS, memory and the reservation as they were")
  (second_method (kind "independent-exact-expectation") (producer_ids "expected") (producer_ids "reference") (common_input_ids "guest-source") (common_input_ids "dependency-manifest")
    (independently_derived "every boundary's GPR changes, derived by the spec-side author from the pinned chapters, never from the reference's output; the two producers share the guest source and the dependency manifest, and their ancestry is otherwise unexamined."))
