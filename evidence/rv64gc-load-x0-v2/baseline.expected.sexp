(expectations (program "load-x0.s") (entry "0x0000000080000000") (instructions 68) (fetches 136)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the handler's base: this instruction's own address, 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 1) (insn "addi x1, x1, 36") (writes (write (reg "x1") (value "0x0000000080000024")))
    (derivation "the handler sits nine instructions on: 0x0000000080000024.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "direct-mode mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.5"))
  (step (n 3) (insn "addi x21, x0, 1") (writes (write (reg "x21") (value "0x0000000000000001")))
    (derivation "1, the bit to place at 2^40.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x21, x21, 40") (writes (write (reg "x21") (value "0x0000010000000000")))
