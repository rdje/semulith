(expectations (program "ecall-ebreak.s") (entry "0x0000000080000000") (instructions 116) (fetches 232)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the base for M's handler: 0x0000000080000000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 1) (insn "addi x1, x1, 36") (writes (write (reg "x1") (value "0x0000000080000024")))
    (derivation "M's handler: 0x0000000080000024.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec = M's handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 3) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x000000008000000c")))
    (derivation "the base for S's handler: 0x000000008000000c.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 4) (insn "addi x1, x1, 60") (writes (write (reg "x1") (value "0x0000000080000048")))
    (derivation "S's handler: 0x0000000080000048.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "csrrw x0, stvec, x1") (writes)
    (derivation "stvec = S's handler; no GPR written.") (source "RVP-SUPERVISOR §11.1.1.2"))
  (step (n 6) (insn "addi x2, x0, 264") (writes (write (reg "x2") (value "0x0000000000000108")))
    (derivation "medeleg's bit 3 (breakpoint) and bit 8 (ecall from U): 264.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 7) (insn "csrrw x0, medeleg, x2") (writes)
    (derivation "those two causes go to S when taken below M; no GPR written.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 8) (insn "jal x0, 64") (writes)
    (derivation "past the handlers; x0 discards the link.") (source "RVI-RV32I §1.1.5.1"))
  (step (n 9) (insn "addi x10, x0, 77") (writes (write (reg "x10") (value "0x000000000000004d")))
