(comment "Deliberately incorrect negative control: only boundary 9 x2 changes from 7 to 2. Baseline derivation text is retained to show why the value is wrong; no execution evidence.")
(expectations (program "fencei-forms.s") (entry "0x0000000080000000") (instructions 10) (fetches 20) (step (n 0) (insn "addi x6, x0, 6") (writes (write (reg "x6") (value "0x0000000000000006"))) (derivation "6, before the first FENCE.I.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "fence.i") (writes) (derivation "FENCE.I retires: no trap and no register written.") (source "RVI-ZIFENCEI §4.1")) (step (n 2) (insn "addi x7, x6, 1") (writes (write (reg "x7") (value "0x0000000000000007"))) (derivation "the next instruction, in sequence, with nothing in between: 0x0000000000000007.") (source "RVI-ZIFENCEI §4.1 (boundary: FENCE.I has no other effect)")) (step (n 3) (insn "lui x1, 0x00700") (writes (write (reg "x1") (value "0x0000000000700000"))) (derivation "the upper half of the patch's word: 0x0000000000700000.") (source "RVI-RV64I §3.1.2.1")) (step (n 4) (insn "addi x1, x1, 0x113") (writes (write (reg "x1") (value "0x0000000000700113"))) (derivation "0x00700113, the encoding of addi x2, x0, 7: 0x0000000000700113.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "auipc x3, 0") (writes (write (reg "x3") (value "0x0000000080000014"))) (derivation "this instruction's own address: 0x0000000080000014.") (source "RVI-RV64I §3.1.2.1")) (step (n 6) (insn "sw x1, 16, x3") (writes) (derivation "the patch: the word four instructions on from that AUIPC.") (source "RVI-RV32I §1.1.6")) (step (n 7) (insn "fence.i") (writes) (derivation "orders that store before every later fetch.") (source "RVI-ZIFENCEI §4.1")) (step (n 8) (insn "addi x4, x0, 4") (writes (write (reg "x4") (value "0x0000000000000004"))) (derivation "an ordinary instruction between.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn ".word 0x00700113") (writes (write (reg "x2") (value "0x0000000000000002"))) (derivation "fetched after the store and the FENCE.I: this runs as the patch, 0x0000000000000007.") (source "RVI-ZIFENCEI §4.1 (boundary: FENCE.I orders a store before a fetch)")))
