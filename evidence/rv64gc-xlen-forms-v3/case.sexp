(case (id "rv64gc-xlen-forms-v3") (profile_id "rv64gc-lab-v0")
  (program "xlen-forms.s") (instructions 25) (source_size 3394)
  (source_sha256 "639442998f70299660776bf0fbd917f0cc7b95294e6f19d9c7619645e2e7f446")
  (requirement_id "REQ-D-XLEN") (obligation_ids "OB-XLEN")
  (contract_id "rv64gc-lab-env-v3") (contract_version "3")
  (control (property_id "xlen-address-reported") (value 0) (reason "Only boundary 24 x31 expectation changes from 2^40 to 0, the address truncated to 32 bits.") (id "truncated-address")
    (statement "Predeclared target: the address truncated to 32 bits must diverge."))
  (limitation "Seventeen finite XLEN witnesses, predeclared: bit 63, 2^64 wrap, RV64 LUI, the *W family and the reported 64-bit address; full source/risk/feature policy remains pending.")
  (source_id "RVI-RV64I") (source_locator "3.1.1 and 3.1.2") (category "defined") (risk "low")
  (coverage "seventeen XLEN witnesses: the 64-bit registers and wrap, RV64 LUI and the *W family, the 64-bit address space")
  (authority (requirement_semantic_sha256 "faf969b1efe70a8abdbd123c28f0a76f2971928c540031ef70bb72fe4edd3efd") (obligation_id "OB-XLEN")
    (obligation_semantic_sha256 "26cc30ac883ea5888be2243328b88b33a17d8d59fb8119c207d6f6d4ac7b5d9b") (source_sha256 "6eadb316c2d535ccb87a7a6feb03ff54af6f4b5bbeb5c1a5102a02af81f13abd"))
  (required_input (role "normative-source") (id "RVI-RV64I-STATEMENTS") (path "profiles/rv64gc-lab-v0/retained/rv64i-statements.html") (sha256 "5c93941804b6bab707d3c0345529fc918b10a953d72bc82d5735bcf78788f2a5"))
  (prepared (role "guest-image") (id "guest-image") (name "guest.elf") (byte_size 4408) (sha256 "89228f06141a273369da1607a3130b790b2ae722613f7e6b1edd48e92e57f5e0"))
  (prepared (role "reference-config") (id "reference-config") (name "reference-config.json") (byte_size 7609) (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2"))
  (prepared (role "expectation") (id "expectation") (name "baseline.expected.sexp") (byte_size 6548) (sha256 "5322f07f9df97863452a72f4dfb88bba17c3853c781fca6735235aa5947d5ffd"))
  (prepared (role "expectation") (id "mutant-expectation") (name "control.expected.sexp") (byte_size 6100) (sha256 "010b17f6a1b7bca1633c65d44a5b3c8f1ad8a9fb7d36cd1caa5e778507603510"))
  (property (id "xlen-bit63") (cell "form:slli") (step_n 1) (register "x5") (expected 0x8000000000000000)
    (statement "For SLLI with x5 = 1 and a shift amount of 63, the x5 change at boundary 1 is -2^63: bit 63 exists (RVI-RV64I §3.1.1, §3.1.2.1)."))
  (property (id "xlen-srli63") (cell "form:srli") (step_n 2) (register "x6") (expected 1)
    (statement "For SRLI by 63 of -2^63 (x5), the x6 change at boundary 2 is 1: the top bit read back was bit 63 (RVI-RV64I §3.1.2.1)."))
  (property (id "xlen-srai63") (cell "form:srai") (step_n 3) (register "x7") (expected 0xffffffffffffffff)
    (statement "For SRAI by 63 of -2^63 (x5), the x7 change at boundary 3 is -1: bit 63 copied into all 64 bits (RVI-RV64I §3.1.2.1)."))
  (property (id "xlen-upper-word") (cell "form:slli") (step_n 5) (register "x9") (expected 0xffffffff00000000)
    (statement "For SLLI by 32 of -1 (x8), the x9 change at boundary 5 is 0xffffffff00000000: bits 32..63 are real register bits (RVI-RV64I §3.1.1)."))
  (property (id "xlen-shamt-40") (cell "form:slli") (step_n 6) (register "x10") (expected 0xffffff0000000000)
    (statement "For SLLI by 40 of -1 (x8), the x10 change at boundary 6 is 0xffffff0000000000: a 6-bit shift amount above 31 is legal in RV64I (RVI-RV64I §3.1.2.1)."))
  (property (id "xlen-max") (cell "form:srli") (step_n 7) (register "x11") (expected 0x7fffffffffffffff)
    (statement "For SRLI by 1 of -1 (x8), the x11 change at boundary 7 is 2^63 - 1, the largest positive XLEN value (RVI-RV64I §3.1.1, §3.1.2.1)."))
  (property (id "xlen-wrap") (cell "form:addi") (step_n 8) (register "x12") (expected 0x8000000000000000)
    (statement "For ADDI of 1 to 2^63 - 1 (x11), the x12 change at boundary 8 is -2^63: the sum wraps modulo 2^64, no overflow trap (RVI-RV64I §3.1.1)."))
  (property (id "xlen-carry") (cell "form:add") (step_n 9) (register "x13") (expected 0xfffffffffffffffe)
    (statement "For ADD of -1 (x8) to itself, the x13 change at boundary 9 is -2: the carry out of bit 63 is discarded (RVI-RV64I §3.1.1)."))
  (property (id "rv64-lui") (cell "form:lui") (step_n 10) (register "x14") (expected 0xffffffff80000000)
    (statement "For LUI 0x80000, the x14 change at boundary 10 is 0xffffffff80000000: the 32-bit result sign-extended to 64 bits (RVI-RV64I §3.1.2.1)."))
  (property (id "rv64-addiw") (cell "form:addiw") (step_n 11) (register "x15") (expected 0xffffffff80000001)
    (statement "For ADDIW of 1 to 0xffffffff80000000 (x14), the x15 change at boundary 11 is 0xffffffff80000001: the 32-bit result sign-extended (RVI-RV64I §3.1.2.1)."))
  (property (id "rv64-srliw") (cell "form:srliw") (step_n 12) (register "x16") (expected 0x40000000)
    (statement "For SRLIW by 1 of the word 0x80000000 (x14), the x16 change at boundary 12 is 0x40000000: the word result sign-extended, bit 31 clear (RVI-RV64I §3.1.2.1)."))
  (property (id "rv64-sraiw") (cell "form:sraiw") (step_n 13) (register "x17") (expected 0xffffffffc0000000)
    (statement "For SRAIW by 1 of the word 0x80000000 (x14), the x17 change at boundary 13 is 0xffffffffc0000000: the word's sign copied, then sign-extended (RVI-RV64I §3.1.2.1)."))
  (property (id "rv64-addw") (cell "form:addw") (step_n 14) (register "x18") (expected 0xffffffffffffffff)
    (statement "For ADDW of -1 (x8) and -2^63 (x5), the x18 change at boundary 14 is -1: bits 32..63 of the inputs are ignored and the word sign-extended (RVI-RV64I §3.1.2, §3.1.2.2)."))
  (property (id "rv64-subw") (cell "form:subw") (step_n 15) (register "x19") (expected 1)
    (statement "For SUBW of 2^63 - 1 (x11) from 0, the x19 change at boundary 15 is 1: 0 - 0xffffffff as a word, sign-extended (RVI-RV64I §3.1.2.2)."))
  (property (id "rv64-sllw") (cell "form:sllw") (step_n 16) (register "x20") (expected 0xffffffff80000000)
    (statement "For SLLW of 1 (x6) by 2^63 - 1 (x11), the x20 change at boundary 16 is 0xffffffff80000000: the shift amount is rs2[4:0] = 31 and the word sign-extended (RVI-RV64I §3.1.2.2)."))
  (property (id "xlen-address") (cell "form:slli") (step_n 21) (register "x21") (expected 0x10000000000)
    (statement "For SLLI by 40 of 1, the x21 change at boundary 21 is 2^40: a 64-bit address outside every declared region (RVI-RV64I §3.1.1)."))
  (property (id "xlen-address-reported") (cell "form:csrrs") (step_n 24) (register "x31") (expected 0x10000000000)
    (statement "After a load at 2^40 faults, the handler's CSRRS of mtval changes x31 at boundary 24 to 2^40: the faulting address reported whole, all 64 bits (RVI-RV64I §3.1.1, the supported address space)."))
