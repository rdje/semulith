  (property (id "c-present") (cell "form:c.addi") (step_n 31) (register "x19") (expected 2)
    (statement "C executes: C.ADDI takes one to two (RVI-C §27.1.5.1)."))
  (property (id "zicsr-present") (cell "form:csrrs") (step_n 33) (register "x21") (expected 7)
    (statement "Zicsr executes: mscratch reads back the 7 written (RVI-ZICSR §5.1.1)."))
  (property (id "zifencei-present") (cell "form:addi") (step_n 35) (register "x22") (expected 9)
    (statement "Zifencei executes: FENCE.I retires and the next row runs (RVI-ZIFENCEI §4.1)."))
