  (property (id "rv64i-width") (cell "form:srli") (step_n 7) (register "x6") (expected 0xffffffff)
    (statement "The base is RV64I: registers hold 64 bits, so all ones shifted right by 32 reads 0xFFFFFFFF (RVI-RV64I §3.1.2.1)."))
  (property (id "m-present") (cell "form:mul") (step_n 10) (register "x12") (expected 42)
