  (property (id "a-present") (cell "form:amoadd.d") (step_n 16) (register "x13") (expected 6)
    (statement "A executes: an AMO reads the old value, 6 (RVI-A §12.1.3)."))
  (property (id "a-stored") (cell "form:ld") (step_n 17) (register "x14") (expected 13)
