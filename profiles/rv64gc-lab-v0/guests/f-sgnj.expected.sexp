;; f-sgnj.expected.sexp — the expected observations for `f-sgnj.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-sgnj.expected.sexp schema/expectations.sexp

(expectations (program "f-sgnj.s") (entry "0x0000000080000000") (instructions 24)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x40491") (writes (write (reg "x5") (value "0x0000000040491000")))
    (derivation "build the pattern 0x40490fdb (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x5, x5, -37") (writes (write (reg "x5") (value "0x0000000040490fdb")))
    (derivation "… its low 12 bits (-37).") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 6) (insn "lui x6, 0xbf800") (writes (write (reg "x6") (value "0xffffffffbf800000")))
    (derivation "build the pattern 0xbf800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "fmv.w.x f2, x6") (writes)
    (derivation "fmv.w.x: f2 <- x6's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 8) (insn "fsgnj.s f3, f1, f2") (writes)
    (derivation "fsgnj.s: rs1's magnitude with the injected sign = 0xc0490fdb; no flag, no canonicalization.") (source "RVI-F §20.1.7"))
  (step (n 9) (insn "fmv.x.w x7, f3") (writes (write (reg "x7") (value "0xffffffffc0490fdb")))
    (derivation "fmv.x.w: the low 32 bits of f3, sign-extended: x7 = 0xffffffffc0490fdb.") (source "RVI-F §20.1.7"))
  (step (n 10) (insn "fsgnjn.s f4, f1, f2") (writes)
    (derivation "fsgnjn.s: rs1's magnitude with the injected sign = 0x40490fdb; no flag, no canonicalization.") (source "RVI-F §20.1.7"))
  (step (n 11) (insn "fmv.x.w x8, f4") (writes (write (reg "x8") (value "0x0000000040490fdb")))
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x8 = 0x0000000040490fdb.") (source "RVI-F §20.1.7"))
  (step (n 12) (insn "fsgnjx.s f5, f3, f2") (writes)
    (derivation "fsgnjx.s: rs1's magnitude with the injected sign = 0x40490fdb; no flag, no canonicalization.") (source "RVI-F §20.1.7"))
  (step (n 13) (insn "fmv.x.w x9, f5") (writes (write (reg "x9") (value "0x0000000040490fdb")))
    (derivation "fmv.x.w: the low 32 bits of f5, sign-extended: x9 = 0x0000000040490fdb.") (source "RVI-F §20.1.7"))
  (step (n 14) (insn "fsgnjn.s f6, f2, f2") (writes)
    (derivation "the FNEG.S spelling (rs2 = rs1).") (source "RVI-F §20.1.7"))
  (step (n 15) (insn "fmv.x.w x10, f6") (writes (write (reg "x10") (value "0x000000003f800000")))
    (derivation "fmv.x.w: the low 32 bits of f6, sign-extended: x10 = 0x000000003f800000.") (source "RVI-F §20.1.7"))
  (step (n 16) (insn "fsgnjx.s f7, f2, f2") (writes)
    (derivation "the FABS.S spelling.") (source "RVI-F §20.1.7"))
  (step (n 17) (insn "fmv.x.w x11, f7") (writes (write (reg "x11") (value "0x000000003f800000")))
    (derivation "fmv.x.w: the low 32 bits of f7, sign-extended: x11 = 0x000000003f800000.") (source "RVI-F §20.1.7"))
  (step (n 18) (insn "lui x12, 0xffa00") (writes (write (reg "x12") (value "0xffffffffffa00000")))
    (derivation "build the pattern 0xffa00123 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "addi x12, x12, 291") (writes (write (reg "x12") (value "0xffffffffffa00123")))
    (derivation "… its low 12 bits (291).") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "fmv.w.x f8, x12") (writes)
    (derivation "fmv.w.x: f8 <- x12's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 21) (insn "fsgnjx.s f9, f8, f8") (writes)
    (derivation "the absolute value of a signaling NaN: the payload kept, the sign cleared — no flag, no canonical NaN.") (source "RVI-F §20.1.7"))
  (step (n 22) (insn "fmv.x.w x13, f9") (writes (write (reg "x13") (value "0x000000007fa00123")))
    (derivation "fmv.x.w: the low 32 bits of f9, sign-extended: x13 = 0x000000007fa00123.") (source "RVI-F §20.1.7"))
  (step (n 23) (insn "csrrs x14, fflags, x0") (writes)
    (derivation "x14 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
