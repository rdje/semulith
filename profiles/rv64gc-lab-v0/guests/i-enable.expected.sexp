;; i-enable.expected.sexp — the expected observations for `i-enable.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-enable.expected.sexp schema/expectations.sexp

(expectations (program "i-enable.s") (entry "0x0000000080000000") (instructions 21) (fetches 20)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 56") (writes (write (reg "x1") (value "0x0000000080000038")))
    (derivation "the handler rides 56 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec programmed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002")))
    (derivation "the SSIP bit position (bit 1).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "csrrs x0, mip, x2") (writes)
    (derivation "SSIP <- 1 FIRST: pending before any enable.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 5) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "enable still clear: the evaluation passes it by — marker one.") (source "RVP-MACHINE §2.1.1.9 (the (b) clause)"))
  (step (n 6) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000002")))
    (derivation "marker two: pending alone never fires.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 7) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1.") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 9) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000003")))
    (derivation "marker three: enable still missing — (b) keeps failing.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 10) (insn "csrrs x0, mie, x2") (writes)
    (derivation "SSIE <- 1 at LAST: the very next boundary takes it.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 11) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in M: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 12) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000001")))
    (derivation "the handler observes the Interrupt bit with cause 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 13) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x000000008000002c")))
    (derivation "mepc is the un-fetched pc (taken BETWEEN instructions).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 14) (insn "csrrc x0, mip, x2") (writes)
    (derivation "SSIP <- 0 before returning.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 15) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x000000008000002c")))
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 16) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x0000000080000030")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 18) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 19) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000004")))
    (derivation "resumed: the marker completes at 4 — the write's immediacy is one boundary, by construction.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 20) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker.") (source "RVI-RV32I §1.1.4 #|end"))
)
