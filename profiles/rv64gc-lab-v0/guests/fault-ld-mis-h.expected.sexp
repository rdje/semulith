;; fault-ld-mis-h.expected.sexp — the expected observations for `fault-ld-mis-h.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-ld-mis-h.expected.sexp schema/expectations.sexp

(comment "fault-ld-mis-h.expected.sexp — the expected observations for `fault-ld-mis-h.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The 2-byte misaligned load at an odd address; smoke-trap pins the 4-byte case. x1 is" "never written — the negative observation a silently-serviced load would fail.")
(expectations (program "fault-ld-mis-h.s") (entry "0x80000000") (instructions 3) (never_written "x1") (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "Building the main-memory base arithmetically; LUI cannot produce a positive 0x80000000.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 at 64 bits is the base of the declared MainMemory region.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "lh x1, x10, 1025") (writes) (derivation "The effective address is 0x80000000 + 1025 = 0x80000401, which is NOT 2-byte aligned. This profile does not handle misaligned accesses invisibly, so the access raises address-misaligned as a contained trap, and x1 is never written. Measured on both references: cause 0x04, tval 0x0000000080000401.") (source "RVI-RV32I §1.1.6 (the EEI defines whether misaligned accesses are handled invisibly) — decision D-MISALIGN-DATA")))
