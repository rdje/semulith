;; m-forms.expected.sexp — spec-side observations for `m-forms.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py m-forms.expected.sexp schema/expectations.sexp

(expectations (program "m-forms.s") (entry "0x0000000080000000") (instructions 33) (fetches 66)
  (step (n 0) (insn "addi x5, x0, -7") (writes (write (reg "x5") (value "0xfffffffffffffff9")))
    (derivation "the signed dividend -7 (also the operand whose word is -7).") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x6, x0, 2") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "the divisor 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "addi x7, x0, -1") (writes (write (reg "x7") (value "0xffffffffffffffff")))
    (derivation "-1: all bits set, the overflow divisor and the unsigned maximum.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "addi x8, x0, 1") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "build the most-negative XLEN value: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x8, x8, 63") (writes (write (reg "x8") (value "0x8000000000000000")))
    (derivation "… at bit 63 = -2^63.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 5) (insn "addi x9, x0, 1") (writes (write (reg "x9") (value "0x0000000000000001")))
    (derivation "build the most-negative WORD with a zero high half: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "slli x9, x9, 31") (writes (write (reg "x9") (value "0x0000000080000000")))
    (derivation "… at bit 31 = 0x80000000, -2^31 as a word, +2^31 as XLEN.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 7) (insn "mul x10, x5, x6") (writes (write (reg "x10") (value "0xfffffffffffffff2")))
    (derivation "MUL: the low 64 bits of -7 x 2 = -14: 0xfffffffffffffff2.") (source "RVI-M §11.1.1"))
  (step (n 8) (insn "mulh x11, x5, x6") (writes (write (reg "x11") (value "0xffffffffffffffff")))
    (derivation "MULH: the high half of the signed product -14: 0xffffffffffffffff.") (source "RVI-M §11.1.1"))
  (step (n 9) (insn "mulhsu x12, x5, x7") (writes (write (reg "x12") (value "0xfffffffffffffff9")))
    (derivation "MULHSU: -7 (signed) x 2^64 - 1 (unsigned) = -7 x 2^64 + 7, the high half -7: 0xfffffffffffffff9.") (source "RVI-M §11.1.1"))
  (step (n 10) (insn "mulhu x13, x7, x6") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "MULHU: (2^64 - 1) x 2 = 2^65 - 2 unsigned, the high half 1: 0x0000000000000001.") (source "RVI-M §11.1.1"))
  (step (n 11) (insn "mulw x14, x5, x9") (writes (write (reg "x14") (value "0xffffffff80000000")))
    (derivation "MULW: the low 32 bits of -7 x 2^31, sign-extended: 0xffffffff80000000 (MUL would give 0xfffffffc80000000).") (source "RVI-M §11.1.1"))
  (step (n 12) (insn "div x15, x5, x6") (writes (write (reg "x15") (value "0xfffffffffffffffd")))
    (derivation "DIV: -7 / 2 rounds TOWARDS ZERO: 0xfffffffffffffffd (-3, not -4).") (source "RVI-M §11.1.2"))
  (step (n 13) (insn "divu x16, x7, x6") (writes (write (reg "x16") (value "0x7fffffffffffffff")))
    (derivation "DIVU: (2^64 - 1) / 2 unsigned: 0x7fffffffffffffff.") (source "RVI-M §11.1.2"))
  (step (n 14) (insn "rem x17, x5, x6") (writes (write (reg "x17") (value "0xffffffffffffffff")))
    (derivation "REM: the remainder takes the dividend's sign: 0xffffffffffffffff (-1).") (source "RVI-M §11.1.2"))
  (step (n 15) (insn "remu x18, x7, x6") (writes (write (reg "x18") (value "0x0000000000000001")))
    (derivation "REMU: (2^64 - 1) rem 2 unsigned: 0x0000000000000001.") (source "RVI-M §11.1.2"))
  (step (n 16) (insn "divw x19, x9, x6") (writes (write (reg "x19") (value "0xffffffffc0000000")))
    (derivation "DIVW: the low words only, -2^31 / 2 = -2^30, sign-extended: 0xffffffffc0000000 (DIV would give 2^30).") (source "RVI-M §11.1.2"))
  (step (n 17) (insn "divuw x20, x9, x6") (writes (write (reg "x20") (value "0x0000000040000000")))
    (derivation "DIVUW: 0x80000000 / 2 unsigned words, bit 31 clear: 0x0000000040000000.") (source "RVI-M §11.1.2"))
  (step (n 18) (insn "remw x21, x9, x5") (writes (write (reg "x21") (value "0xfffffffffffffffe")))
    (derivation "REMW: -2^31 rem -7 as words, the dividend's sign: 0xfffffffffffffffe (-2; REM of +2^31 would give +2).") (source "RVI-M §11.1.2"))
  (step (n 19) (insn "remuw x22, x9, x5") (writes (write (reg "x22") (value "0xffffffff80000000")))
    (derivation "REMUW: 0x80000000 rem 0xfffffff9 unsigned words = the dividend, sign-extended: 0xffffffff80000000.") (source "RVI-M §11.1.2"))
  (step (n 20) (insn "div x23, x5, x0") (writes (write (reg "x23") (value "0xffffffffffffffff")))
    (derivation "DIVISION BY ZERO, signed: Table 1 - the quotient has all bits set, 0xffffffffffffffff; no trap.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 21) (insn "divu x24, x5, x0") (writes (write (reg "x24") (value "0xffffffffffffffff")))
    (derivation "by zero, unsigned: 2^64 - 1, all bits set, 0xffffffffffffffff.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 22) (insn "rem x25, x5, x0") (writes (write (reg "x25") (value "0xfffffffffffffff9")))
    (derivation "the remainder of division by zero equals the dividend: 0xfffffffffffffff9.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 23) (insn "remu x26, x5, x0") (writes (write (reg "x26") (value "0xfffffffffffffff9")))
    (derivation "… unsigned as well: the dividend, 0xfffffffffffffff9.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 24) (insn "div x27, x8, x7") (writes (write (reg "x27") (value "0x8000000000000000")))
    (derivation "SIGNED OVERFLOW, -2^63 / -1: Table 1 - the quotient equals the dividend, 0x8000000000000000; no trap.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 25) (insn "addi x28, x0, 28") (writes (write (reg "x28") (value "0x000000000000001c")))
    (derivation "a sentinel the overflow remainder must REPLACE (a zero over a zero would show nothing).") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "rem x28, x8, x7") (writes (write (reg "x28") (value "0x0000000000000000")))
    (derivation "… and the remainder is zero: 0x0000000000000000.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 27) (insn "divw x29, x9, x0") (writes (write (reg "x29") (value "0xffffffffffffffff")))
    (derivation "WORD division by zero: Table 1 at L = 32 - all bits set, sign-extended: 0xffffffffffffffff.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 28) (insn "divuw x30, x9, x0") (writes (write (reg "x30") (value "0xffffffffffffffff")))
    (derivation "unsigned word by zero: 2^32 - 1, sign-extended: 0xffffffffffffffff.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 29) (insn "remw x31, x9, x0") (writes (write (reg "x31") (value "0xffffffff80000000")))
    (derivation "the word remainder of division by zero is the dividend's word, sign-extended: 0xffffffff80000000.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 30) (insn "remuw x10, x9, x0") (writes (write (reg "x10") (value "0xffffffff80000000")))
    (derivation "… REMUW too: the dividend's word, sign-extended, 0xffffffff80000000 (replacing the MUL result).") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 31) (insn "divw x11, x9, x7") (writes (write (reg "x11") (value "0xffffffff80000000")))
    (derivation "WORD OVERFLOW, -2^31 / -1: the quotient equals the dividend, sign-extended, 0xffffffff80000000 (replacing the MULH result).") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 32) (insn "remw x12, x9, x7") (writes (write (reg "x12") (value "0x0000000000000000")))
    (derivation "… and the word remainder is zero: 0x0000000000000000 (replacing the MULHSU result).") (source "RVI-M §11.1.2 (Table 1)"))
)
