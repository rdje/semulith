;; f-compare.expected.sexp — the expected observations for `f-compare.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-compare.expected.sexp schema/expectations.sexp

(expectations (program "f-compare.s") (entry "0x0000000080000000") (instructions 31)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3f800") (writes (write (reg "x5") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 5) (insn "lui x6, 0x40000") (writes (write (reg "x6") (value "0x0000000040000000")))
    (derivation "build the pattern 0x40000000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "fmv.w.x f2, x6") (writes)
    (derivation "fmv.w.x: f2 <- x6's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 7) (insn "addi x7, x0, 7") (writes (write (reg "x7") (value "0x0000000000000007")))
    (derivation "preload so a 0 result is a visible write.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "feq.s x7, f1, f2") (writes (write (reg "x7") (value "0x0000000000000000")))
    (derivation "feq.s: x7 = 0; flags none.") (source "RVI-F §20.1.8"))
  (step (n 9) (insn "flt.s x8, f1, f2") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "flt.s: x8 = 1; flags none.") (source "RVI-F §20.1.8"))
  (step (n 10) (insn "fle.s x9, f2, f1") (writes)
    (derivation "fle.s: x9 = 0; flags none.") (source "RVI-F §20.1.8"))
  (step (n 11) (insn "fmv.w.x f3, x0") (writes)
    (derivation "+0.0.") (source "RVI-F §20.1.7"))
  (step (n 12) (insn "lui x10, 0x80000") (writes (write (reg "x10") (value "0xffffffff80000000")))
    (derivation "build the pattern 0x80000000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "fmv.w.x f4, x10") (writes)
    (derivation "fmv.w.x: f4 <- x10's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 14) (insn "feq.s x11, f3, f4") (writes (write (reg "x11") (value "0x0000000000000001")))
    (derivation "−0.0 = +0.0 for a compare.") (source "RVI-F §20.1.8"))
  (step (n 15) (insn "csrrs x12, fflags, x0") (writes)
    (derivation "x12 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 16) (insn "lui x13, 0x7fc00") (writes (write (reg "x13") (value "0x000000007fc00000")))
    (derivation "build the pattern 0x7fc00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "fmv.w.x f5, x13") (writes)
    (derivation "fmv.w.x: f5 <- x13's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 18) (insn "addi x14, x0, 7") (writes (write (reg "x14") (value "0x0000000000000007")))
    (derivation "preload.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "feq.s x14, f5, f1") (writes (write (reg "x14") (value "0x0000000000000000")))
    (derivation "FEQ is quiet: a quiet NaN gives 0 and NO flag.") (source "RVI-F §20.1.8"))
  (step (n 20) (insn "csrrs x15, fflags, x0") (writes)
    (derivation "x15 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 21) (insn "flt.s x16, f5, f1") (writes)
    (derivation "FLT is signaling: a quiet NaN raises NV.") (source "RVI-F §20.1.8"))
  (step (n 22) (insn "csrrs x17, fflags, x0") (writes (write (reg "x17") (value "0x0000000000000010")))
    (derivation "x17 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 23) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 24) (insn "lui x18, 0x7fa00") (writes (write (reg "x18") (value "0x000000007fa00000")))
    (derivation "build the pattern 0x7fa00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 25) (insn "fmv.w.x f6, x18") (writes)
    (derivation "fmv.w.x: f6 <- x18's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 26) (insn "feq.s x19, f6, f6") (writes)
    (derivation "FEQ with a signaling NaN: NV.") (source "RVI-F §20.1.8"))
  (step (n 27) (insn "csrrs x20, fflags, x0") (writes (write (reg "x20") (value "0x0000000000000010")))
    (derivation "x20 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 28) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 29) (insn "fle.s x21, f1, f5") (writes)
    (derivation "fle.s: x21 = 0; flags NV.") (source "RVI-F §20.1.8"))
  (step (n 30) (insn "csrrs x22, fflags, x0") (writes (write (reg "x22") (value "0x0000000000000010")))
    (derivation "x22 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
