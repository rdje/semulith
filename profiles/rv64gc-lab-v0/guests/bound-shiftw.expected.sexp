;; bound-shiftw.expected.sexp — the expected observations for `bound-shiftw.s` (P2-SCALAR.2).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py bound-shiftw.expected.sexp schema/expectations.sexp

(comment "bound-shiftw.expected.sexp — the expected observations for `bound-shiftw.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN." "`EVD-05` and `docs/EVIDENCE_AND_GATES.md` require it: an expected value copied out of a model's" "output tests that the model is self-consistent and nothing else. The `derivation` field on each" "step is the reasoning, and `source` is where in the pinned artifacts the rule is stated." "" "The *W shift corner cases (D-SHAMT's 5-bit rule, D-WSUFFIX): the 5-bit shamt domain" "EXHAUSTED by one sraiw sweep over all 32 amounts; slliw/srliw pinned at" "{0,1,2,4,8,16,31}; the register-amount discriminator rs2 = 96 (low6 = 32 vs low5 = 0)" "as the srl/srlw PAIR on identical operands, and rs2 = -1 (low5 = 31).")
(expectations (program "bound-shiftw.s") (entry "0x80000000") (instructions 55) (step (n 0) (insn "lui x8, 0x80000") (writes (write (reg "x8") (value "0xFFFFFFFF80000000"))) (derivation "The U-immediate 0x80000 sign-extends to 0xFFFFFFFF80000000 — the operand whose low 32 bits are 0x80000001 after the next step (bit 31 set, bit 0 set).") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 1) (insn "addi x8, x8, 1") (writes (write (reg "x8") (value "0xFFFFFFFF80000001"))) (derivation "X = 0xFFFFFFFF80000001. The *W shifts read ONLY the low 32 bits: 0x80000001 — bit 31 drives the arithmetic fill and the result's sign extension; bit 0 walks the left shifts.") (source "RVI-RV32I §1.1.4; RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 2) (insn "sraiw x9, x8, 0") (writes (write (reg "x9") (value "0xFFFFFFFF80000001"))) (derivation "shamt 0 of the 5-bit field: the low 32 bits 0x80000001 >> 0 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFF80000001. No shift, but D-WSUFFIX still sign-extends the low half.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 3) (insn "sraiw x9, x8, 1") (writes (write (reg "x9") (value "0xFFFFFFFFC0000000"))) (derivation "shamt 1 of the 5-bit field: the low 32 bits 0x80000001 >> 1 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFC0000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 4) (insn "sraiw x9, x8, 2") (writes (write (reg "x9") (value "0xFFFFFFFFE0000000"))) (derivation "shamt 2 of the 5-bit field: the low 32 bits 0x80000001 >> 2 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFE0000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 5) (insn "sraiw x9, x8, 3") (writes (write (reg "x9") (value "0xFFFFFFFFF0000000"))) (derivation "shamt 3 of the 5-bit field: the low 32 bits 0x80000001 >> 3 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFF0000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 6) (insn "sraiw x9, x8, 4") (writes (write (reg "x9") (value "0xFFFFFFFFF8000000"))) (derivation "shamt 4 of the 5-bit field: the low 32 bits 0x80000001 >> 4 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFF8000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 7) (insn "sraiw x9, x8, 5") (writes (write (reg "x9") (value "0xFFFFFFFFFC000000"))) (derivation "shamt 5 of the 5-bit field: the low 32 bits 0x80000001 >> 5 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFFC000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 8) (insn "sraiw x9, x8, 6") (writes (write (reg "x9") (value "0xFFFFFFFFFE000000"))) (derivation "shamt 6 of the 5-bit field: the low 32 bits 0x80000001 >> 6 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFFE000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 9) (insn "sraiw x9, x8, 7") (writes (write (reg "x9") (value "0xFFFFFFFFFF000000"))) (derivation "shamt 7 of the 5-bit field: the low 32 bits 0x80000001 >> 7 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFFF000000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 10) (insn "sraiw x9, x8, 8") (writes (write (reg "x9") (value "0xFFFFFFFFFF800000"))) (derivation "shamt 8 of the 5-bit field: the low 32 bits 0x80000001 >> 8 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFFF800000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 5-bit amount; D-WSUFFIX: sign-extend from bit 31)")) (step (n 11) (insn "sraiw x9, x8, 9") (writes (write (reg "x9") (value "0xFFFFFFFFFFC00000"))) (derivation "shamt 9 of the 5-bit field: the low 32 bits 0x80000001 >> 9 ARITHMETIC, then sign-extended from bit 31 = 0xFFFFFFFFFFC00000.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT