;; d-sgnj.expected.sexp — the expected observations for `d-sgnj.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-sgnj.expected.sexp schema/expectations.sexp

(expectations (program "d-sgnj.s") (entry "0x0000000080000000") (instructions 35)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x40092") (writes (write (reg "x5") (value "0x0000000040092000")))
    (derivation "build 0x400921fb54442d18: the upper word 0x400921fb first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x5, x5, 507") (writes (write (reg "x5") (value "0x00000000400921fb")))
    (derivation "… its low 12 bits (507).") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x400921fb00000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 6) (insn "lui x28, 0x54443") (writes (write (reg "x28") (value "0x0000000054443000")))
    (derivation "the lower word 0x54442d18.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x28, x28, -744") (writes (write (reg "x28") (value "0x0000000054442d18")))
    (derivation "… its low 12 bits (-744).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x54442d1800000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 9) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000054442d18")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 10) (insn "or x5, x5, x28") (writes (write (reg "x5") (value "0x400921fb54442d18")))
    (derivation "x5 = 0x400921fb54442d18.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 12) (insn "lui x6, 0xbff00") (writes (write (reg "x6") (value "0xffffffffbff00000")))
    (derivation "build 0xbff0000000000000: the upper word 0xbff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "slli x6, x6, 32") (writes (write (reg "x6") (value "0xbff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 14) (insn "fmv.d.x f2, x6") (writes)
    (derivation "fmv.d.x: f2 <- x6's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 15) (insn "fsgnj.d f3, f1, f2") (writes)
    (derivation "fsgnj.d: rs1's magnitude with the injected sign = 0xc00921fb54442d18; no flag, no canonicalization.") (source "RVI-D §21.1.5"))
  (step (n 16) (insn "fmv.x.d x7, f3") (writes (write (reg "x7") (value "0xc00921fb54442d18")))
    (derivation "fmv.x.d: f3's 64 bits, unmodified: x7 = 0xc00921fb54442d18.") (source "RVI-D §21.1.5"))
  (step (n 17) (insn "fsgnjn.d f4, f1, f2") (writes)
    (derivation "fsgnjn.d: rs1's magnitude with the injected sign = 0x400921fb54442d18; no flag, no canonicalization.") (source "RVI-D §21.1.5"))
  (step (n 18) (insn "fmv.x.d x8, f4") (writes (write (reg "x8") (value "0x400921fb54442d18")))
    (derivation "fmv.x.d: f4's 64 bits, unmodified: x8 = 0x400921fb54442d18.") (source "RVI-D §21.1.5"))
  (step (n 19) (insn "fsgnjx.d f5, f3, f2") (writes)
    (derivation "fsgnjx.d: rs1's magnitude with the injected sign = 0x400921fb54442d18; no flag, no canonicalization.") (source "RVI-D §21.1.5"))
  (step (n 20) (insn "fmv.x.d x9, f5") (writes (write (reg "x9") (value "0x400921fb54442d18")))
    (derivation "fmv.x.d: f5's 64 bits, unmodified: x9 = 0x400921fb54442d18.") (source "RVI-D §21.1.5"))
  (step (n 21) (insn "fsgnjn.d f6, f2, f2") (writes)
    (derivation "the FNEG.D spelling (rs2 = rs1).") (source "RVI-D §21.1.5"))
  (step (n 22) (insn "fmv.x.d x10, f6") (writes (write (reg "x10") (value "0x3ff0000000000000")))
    (derivation "fmv.x.d: f6's 64 bits, unmodified: x10 = 0x3ff0000000000000.") (source "RVI-D §21.1.5"))
  (step (n 23) (insn "fsgnjx.d f7, f2, f2") (writes)
    (derivation "the FABS.D spelling.") (source "RVI-D §21.1.5"))
  (step (n 24) (insn "fmv.x.d x11, f7") (writes (write (reg "x11") (value "0x3ff0000000000000")))
    (derivation "fmv.x.d: f7's 64 bits, unmodified: x11 = 0x3ff0000000000000.") (source "RVI-D §21.1.5"))
  (step (n 25) (insn "lui x12, 0xfff40") (writes (write (reg "x12") (value "0xfffffffffff40000")))
    (derivation "build 0xfff4000000000123: the upper word 0xfff40000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "slli x12, x12, 32") (writes (write (reg "x12") (value "0xfff4000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 27) (insn "addi x28, x0, 291") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "the lower word 0x00000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000012300000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 29) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 30) (insn "or x12, x12, x28") (writes (write (reg "x12") (value "0xfff4000000000123")))
    (derivation "x12 = 0xfff4000000000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "fmv.d.x f8, x12") (writes)
    (derivation "fmv.d.x: f8 <- x12's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 32) (insn "fsgnjx.d f9, f8, f8") (writes)
    (derivation "the absolute value of a signaling NaN: the payload kept, the sign cleared — no flag, no canonical NaN.") (source "RVI-D §21.1.5"))
  (step (n 33) (insn "fmv.x.d x13, f9") (writes (write (reg "x13") (value "0x7ff4000000000123")))
    (derivation "fmv.x.d: f9's 64 bits, unmodified: x13 = 0x7ff4000000000123.") (source "RVI-D §21.1.5"))
  (step (n 34) (insn "csrrs x14, fflags, x0") (writes)
    (derivation "x14 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
