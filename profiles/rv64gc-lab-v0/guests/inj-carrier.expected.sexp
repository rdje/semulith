;; inj-carrier.expected.sexp — the expected observations for `inj-carrier.s` (P4-SYSTEM.8,
;; the faults corpus). EVD-05: every value below was derived from the pinned chapters
;; and the .8 brief's declared unit discipline by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py inj-carrier.expected.sexp schema/expectations.sexp

(expectations (program "inj-carrier.s") (entry "0x0000000080000000") (instructions 45)
  (refuse (kind store) (base "0x80000400") (size "0x8"))
  (refuse (kind load) (base "0x80000408") (size "0x8"))
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 holds this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 84") (writes (write (reg "x1") (value "0x0000000080000054")))
    (derivation "the trap handler sits at entry + 0x54 — after the 21-instruction main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec <- the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "the data block's address: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "… << 31 = the region base …") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "addi x10, x10, 1024") (writes (write (reg "x10") (value "0x0000000080000400")))
    (derivation "… + 0x400: A, the store-refused doubleword.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "addi x5, x0, 85") (writes (write (reg "x5") (value "0x0000000000000055")))
    (derivation "the value every store tries to write (0x55).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x6, x0, 3") (writes (write (reg "x6") (value "0x0000000000000003")))
    (derivation "a sentinel the read-back of A must REPLACE (A still holds 0).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "addi x7, x0, 4") (writes (write (reg "x7") (value "0x0000000000000004")))
    (derivation "a sentinel the refused load must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "addi x8, x0, 5") (writes (write (reg "x8") (value "0x0000000000000005")))
    (derivation "another sentinel a refused load must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "addi x11, x0, 6") (writes (write (reg "x11") (value "0x0000000000000006")))
    (derivation "the sentinel the refused AMO must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "sd x5, 0, x10") (writes)
    (derivation "a store to A: the environment REFUSES it — the store access fault 7, memory unchanged.") (source "the experiment's refusal (store, A)"))
  (step (n 12) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000007")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 13) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000400")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 14) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x000000008000002c")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 15) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000030")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 16) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 17) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 18) (insn "ld x6, x10, 0") (writes (write (reg "x6") (value "0x0000000000000000")))
    (derivation "loads of A are allowed: A still reads 0 — the refused store wrote nothing.") (source "RVI-RV64I §3.1.3"))
  (step (n 19) (insn "sd x5, 8, x10") (writes)
    (derivation "a store to B is allowed: B <- 0x55.") (source "RVI-RV64I §3.1.3"))
  (step (n 20) (insn "ld x7, x10, 8") (writes)
    (derivation "a load of B: REFUSED — the load access fault 5, x7 untouched.") (source "the experiment's refusal (load, B)"))
  (step (n 21) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000005")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 22) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000408")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 23) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000038")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 24) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x000000008000003c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 25) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 26) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 27) (insn "lw x8, x10, 12") (writes)
    (derivation "a word inside B's refused bytes: refused too — cause 5, x8 untouched.") (source "the experiment's refusal (load, B)"))
  (step (n 28) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 29) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x000000008000040c")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 30) (insn "csrrs x31, mepc, x0") (writes)
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 31) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000040")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 32) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 33) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 34) (insn "sd x5, 16, x10") (writes)
    (derivation "C = A+16, refused for nothing: the store lands.") (source "RVI-RV64I §3.1.3"))
  (step (n 35) (insn "ld x9, x10, 16") (writes (write (reg "x9") (value "0x0000000000000055")))
    (derivation "and reads back 0x55 — the carrier refuses only the declared bytes and kinds.") (source "RVI-RV64I §3.1.3"))
  (step (n 36) (insn "amoswap.d x11, x5, (x10)") (writes)
    (derivation "an AMO on A: its LOAD half is allowed and completes, its STORE half is refused — the fault after the first suboperation: cause 7, x11 untouched, A unchanged (the completed read is not rolled back, SEM-06; it changed nothing).") (source "RVI-A §12.1.4; the experiment's refusal (store, A)"))
  (step (n 37) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000007")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 38) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000400")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 39) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000048")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 40) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x000000008000004c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 41) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 42) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 43) (insn "ld x12, x10, 0") (writes)
    (derivation "A still reads 0 — the AMO wrote nothing.") (source "RVI-RV64I §3.1.3"))
  (step (n 44) (insn "csrrs x13, mcause, x0") (writes (write (reg "x13") (value "0x0000000000000007")))
    (derivation "the last delivered cause (the AMO's 7).") (source "RVP-MACHINE §2.1.3.1 #|end"))
)
