;; f-dirty.expected.sexp — the expected observations for `f-dirty.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-dirty.expected.sexp schema/expectations.sexp

(expectations (program "f-dirty.s") (entry "0x0000000080000000") (instructions 32)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3f800") (writes (write (reg "x5") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 5) (insn "lui x6, 0x40400") (writes (write (reg "x6") (value "0x0000000040400000")))
    (derivation "build the pattern 0x40400000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "fmv.w.x f2, x6") (writes)
    (derivation "fmv.w.x: f2 <- x6's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 7) (insn "addi x7, x0, 1") (writes (write (reg "x7") (value "0x0000000000000001")))
    (derivation "the FS=Clean pattern starts as 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x7, x7, 14") (writes (write (reg "x7") (value "0x0000000000004000")))
    (derivation "bit 14: with bit 13 cleared, FS = 2 (Clean).") (source "RVP-CSR (the mstatus field table)"))
  (step (n 9) (insn "addi x8, x0, 3") (writes (write (reg "x8") (value "0x0000000000000003")))
    (derivation "both FS bits.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "slli x8, x8, 13") (writes (write (reg "x8") (value "0x0000000000006000")))
    (derivation "3 << 13.") (source "RVP-CSR"))
  (step (n 11) (insn "csrrc x0, mstatus, x8") (writes)
    (derivation "FS := Off …") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "csrrs x0, mstatus, x7") (writes)
    (derivation "… then Clean.") (source "RVI-ZICSR §5.1.1"))
  (step (n 13) (insn "fmv.x.w x9, f1") (writes (write (reg "x9") (value "0x000000003f800000")))
    (derivation "fmv.x.w: the low 32 bits of f1, sign-extended: x9 = 0x000000003f800000.") (source "RVI-F §20.1.7"))
  (step (n 14) (insn "csrrs x10, mstatus, x0") (writes (write (reg "x10") (value "0x0000000a00004000")))
    (derivation "FMV.X.W only READS the FP state: FS stays Clean, SD 0.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 15) (insn "feq.s x11, f1, f2") (writes)
    (derivation "a compare raising no flag leaves fflags unaltered.") (source "RVI-F §20.1.8"))
  (step (n 16) (insn "csrrs x12, mstatus, x0") (writes (write (reg "x12") (value "0x0000000a00004000")))
    (derivation "… so FS stays Clean (the declared Precise rule).") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 17) (insn "fdiv.s f3, f1, f2, 0") (writes)
    (derivation "an f-register write (and NX): FS Dirty.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 18) (insn "csrrs x13, mstatus, x0") (writes (write (reg "x13") (value "0x8000000a00006000")))
    (derivation "FS Dirty, SD 1.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 19) (insn "csrrc x0, mstatus, x8") (writes)
    (derivation "FS := Off …") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "csrrs x0, mstatus, x7") (writes)
    (derivation "… then Clean again.") (source "RVI-ZICSR §5.1.1"))
  (step (n 21) (insn "lui x14, 0x7fc00") (writes (write (reg "x14") (value "0x000000007fc00000")))
    (derivation "build the pattern 0x7fc00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "fmv.w.x f4, x14") (writes)
    (derivation "fmv.w.x: f4 <- x14's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 23) (insn "csrrc x0, mstatus, x8") (writes)
    (derivation "FS := Off … (the fmv.w.x above wrote an f-register)") (source "RVI-ZICSR §5.1.1"))
  (step (n 24) (insn "csrrs x0, mstatus, x7") (writes)
    (derivation "… then Clean.") (source "RVI-ZICSR §5.1.1"))
  (step (n 25) (insn "flt.s x15, f4, f1") (writes)
    (derivation "NV is NEW in fflags: the accrual changes it — FS Dirty without any f-register write.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 26) (insn "csrrs x16, mstatus, x0") (writes (write (reg "x16") (value "0x8000000a00006000")))
    (derivation "FS Dirty.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 27) (insn "csrrc x0, mstatus, x8") (writes)
    (derivation "FS := Off …") (source "RVI-ZICSR §5.1.1"))
  (step (n 28) (insn "csrrs x0, mstatus, x7") (writes)
    (derivation "… then Clean.") (source "RVI-ZICSR §5.1.1"))
  (step (n 29) (insn "flt.s x17, f4, f1") (writes)
    (derivation "NV again — already set: fflags unaltered, so FS stays Clean.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 30) (insn "csrrs x18, mstatus, x0") (writes (write (reg "x18") (value "0x0000000a00004000")))
    (derivation "FS Clean.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 31) (insn "csrrs x19, fflags, x0") (writes (write (reg "x19") (value "0x0000000000000011")))
    (derivation "x19 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
