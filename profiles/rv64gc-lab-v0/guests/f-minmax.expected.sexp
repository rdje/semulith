;; f-minmax.expected.sexp — the expected observations for `f-minmax.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-minmax.expected.sexp schema/expectations.sexp

(expectations (program "f-minmax.s") (entry "0x0000000080000000") (instructions 26)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "fmv.w.x f1, x0") (writes)
    (derivation "f1 = +0.0.") (source "RVI-F §20.1.7"))
  (step (n 4) (insn "lui x5, 0x80000") (writes (write (reg "x5") (value "0xffffffff80000000")))
    (derivation "build the pattern 0x80000000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "fmv.w.x f2, x5") (writes)
    (derivation "fmv.w.x: f2 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 6) (insn "fmin.s f3, f1, f2") (writes)
    (derivation "−0.0 < +0.0 for these instructions only: min is −0.") (source "RVI-F §20.1.6"))
  (step (n 7) (insn "fmv.x.w x6, f3") (writes (write (reg "x6") (value "0xffffffff80000000")))
    (derivation "fmv.x.w: the low 32 bits of f3, sign-extended: x6 = 0xffffffff80000000.") (source "RVI-F §20.1.7"))
  (step (n 8) (insn "fmax.s f4, f2, f1") (writes)
    (derivation "fmax.s: 0x00000000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 9) (insn "fmv.x.w x7, f4") (writes)
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x7 = 0x0000000000000000.") (source "RVI-F §20.1.7"))
  (step (n 10) (insn "lui x8, 0x7fc00") (writes (write (reg "x8") (value "0x000000007fc00000")))
    (derivation "build the pattern 0x7fc00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "fmv.w.x f5, x8") (writes)
    (derivation "fmv.w.x: f5 <- x8's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 12) (insn "lui x9, 0x3f800") (writes (write (reg "x9") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "fmv.w.x f6, x9") (writes)
    (derivation "fmv.w.x: f6 <- x9's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 14) (insn "fmin.s f7, f5, f6") (writes)
    (derivation "one NaN: the other operand.") (source "RVI-F §20.1.6"))
  (step (n 15) (insn "fmv.x.w x10, f7") (writes (write (reg "x10") (value "0x000000003f800000")))
    (derivation "fmv.x.w: the low 32 bits of f7, sign-extended: x10 = 0x000000003f800000.") (source "RVI-F §20.1.7"))
  (step (n 16) (insn "csrrs x11, fflags, x0") (writes)
    (derivation "x11 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 17) (insn "lui x12, 0x7fa00") (writes (write (reg "x12") (value "0x000000007fa00000")))
    (derivation "build the pattern 0x7fa00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "fmv.w.x f8, x12") (writes)
    (derivation "fmv.w.x: f8 <- x12's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 19) (insn "fmax.s f9, f6, f8") (writes)
    (derivation "a signaling NaN input: NV even though the result (1.0) is not NaN.") (source "RVI-F §20.1.6"))
  (step (n 20) (insn "fmv.x.w x13, f9") (writes (write (reg "x13") (value "0x000000003f800000")))
    (derivation "fmv.x.w: the low 32 bits of f9, sign-extended: x13 = 0x000000003f800000.") (source "RVI-F §20.1.7"))
  (step (n 21) (insn "csrrs x14, fflags, x0") (writes (write (reg "x14") (value "0x0000000000000010")))
    (derivation "x14 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 22) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 23) (insn "fmin.s f10, f5, f8") (writes)
    (derivation "both NaN: the canonical NaN (and NV — one is signaling).") (source "RVI-F §20.1.6"))
  (step (n 24) (insn "fmv.x.w x15, f10") (writes (write (reg "x15") (value "0x000000007fc00000")))
    (derivation "fmv.x.w: the low 32 bits of f10, sign-extended: x15 = 0x000000007fc00000.") (source "RVI-F §20.1.7"))
  (step (n 25) (insn "csrrs x16, fflags, x0") (writes (write (reg "x16") (value "0x0000000000000010")))
    (derivation "x16 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
