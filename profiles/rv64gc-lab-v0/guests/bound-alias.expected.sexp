;; bound-alias.expected.sexp — the expected observations for `bound-alias.s` (P2-SCALAR.2).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py bound-alias.expected.sexp schema/expectations.sexp

(comment "bound-alias.expected.sexp — the expected observations for `bound-alias.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN." "`EVD-05` and `docs/EVIDENCE_AND_GATES.md` require it: an expected value copied out of a model's" "output tests that the model is self-consistent and nothing else. The `derivation` field on each" "step is the reasoning, and `source` is where in the pinned artifacts the rule is stated." "" "Alias, overlap and state interactions: the little-endian lane proof (D-ENDIAN) —" "one sd, then lbu at each of the 8 byte lanes; overlap composition (sd + sb over" "byte 3 + sh over bytes 6-7 + one ld); register aliasing (rd = rs1 = rs2, a load" "overwriting its own base register, a self-referential shift); x0 hardwired in" "both directions. 16 crossings, all aligned, all in-region, none faulted.")
(expectations (program "bound-alias.s") (entry "0x80000000") (instructions 37) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "One — raw material for the main-memory base.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 = 0x80000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "lui x1, 0x4030") (writes (write (reg "x1") (value "0x0000000004030000"))) (derivation "0x4030 << 12 = 0x04030000 — the low half's high bits …") (source "RVI-RV64I §3.1.2.1")) (step (n 3) (insn "addi x1, x1, 0x201") (writes (write (reg "x1") (value "0x0000000004030201"))) (derivation "… + 0x201 = 0x04030201.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "lui x2, 0x8070") (writes (write (reg "x2") (value "0x0000000008070000"))) (derivation "0x8070 << 12 = 0x08070000 — bit 31 clear, so no sign fill …") (source "RVI-RV64I §3.1.2.1")) (step (n 5) (insn "addi x2, x2, 0x605") (writes (write (reg "x2") (value "0x0000000008070605"))) (derivation "… + 0x605 = 0x08070605.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "slli x2, x2, 32") (writes (write (reg "x2") (value "0x0807060500000000"))) (derivation "The high half moves up: 0x0807060500000000.") (source "RVI-RV64I §3.1.2.1")) (step (n 7) (insn "or x1, x2, x1") (writes (write (reg "x1") (value "0x0807060504030201"))) (derivation "X = 0x0807060504030201: byte lane i holds i+1, so a lane read identifies itself.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "sd x1, 1024, x10") (writes) (derivation "Commit X. Stores leave no register observation; the crossing census carries the access.") (source "RVI-RV64I §3.1.3")) (step (n 9) (insn "lbu x11, x10, 1024") (writes (write (reg "x11") (value "0x0000000000000001"))) (derivation "Lane 0 holds 1: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 8 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 10) (insn "lbu x12, x10, 1025") (writes (write (reg "x12") (value "0x0000000000000002"))) (derivation "Lane 1 holds 2: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 7 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 11) (insn "lbu x13, x10, 1026") (writes (write (reg "x13") (value "0x0000000000000003"))) (derivation "Lane 2 holds 3: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 6 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 12) (insn "lbu x14, x10, 1027") (writes (write (reg "x14") (value "0x0000000000000004"))) (derivation "Lane 3 holds 4: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 5 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 13) (insn "lbu x15, x10, 1028") (writes (write (reg "x15") (value "0x0000000000000005"))) (derivation "Lane 4 holds 5: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 4 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 14) (insn "lbu x16, x10, 1029") (writes (write (reg "x16") (value "0x0000000000000006"))) (derivation "Lane 5 holds 6: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 3 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 15) (insn "lbu x17, x10, 1030") (writes (write (reg "x17") (value "0x0000000000000007"))) (derivation "Lane 6 holds 7: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 2 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 16) (insn "lbu x18, x10, 1031") (writes (write (reg "x18") (value "0x0000000000000008"))) (derivation "Lane 7 holds 8: the LOWEST address holds the LEAST significant byte — little-endian, byte-address invariant (D-ENDIAN). A big-endian reader would find 1 here.") (source "RVI-RV32I §1.1.6 (D-ENDIAN)")) (step (n 17) (insn "sd x1, 1032, x10") (writes) (derivation "A second copy of X, to be partially overwritten.") (source "RVI-RV64I §3.1.3")) (step (n 18) (insn "addi x3, x0, 0xAA") (writes (write (reg "x3") (value "0x00000000000000AA"))) (derivation "0xAA — the byte that will replace lane 3.") (source "RVI-RV32I §1.1.4")) (step (n 19) (insn "sb x3, 1035, x10") (writes) (derivation "SB over byte lane 3 of the copy: only that lane changes.") (source "RVI-RV64I §3.1.3")) (step (n 20) (insn "addi x4, x0, 0x4CD") (writes (write (reg "x4") (value "0x00000000000004CD"))) (derivation "0x4CD — the halfword that will replace lanes 6-7.") (source "RVI-RV32I §1.1.4")) (step (n 21) (insn "sh x4, 1038, x10") (writes) (derivation "SH over lanes 6-7 (little-endian: 0xCD at 1038, 0x04 at 1039).") (source "RVI-RV64I §3.1.3")) (step (n 22) (insn "ld x19, x10, 1032") (writes (write (reg "x19") (value "0x04CD0605AA030201"))) (derivation "The composed word: lanes [01,02,03,AA,05,06,CD,04] read little-endian = 0x04CD0605AA030201. Each narrower store replaced exactly its own lanes and no neighbour.") (source "RVI-RV32I §1.1.6 (D-ENDIAN); RVI-RV64I §3.1.3")) (step (n 23) (insn "addi x20, x0, 5") (writes (write (reg "x20") (value "0x0000000000000005"))) (derivation "Five.") (source "RVI-RV32I §1.1.4")) (step (n 24) (insn "add x20, x20, x20") (writes (write (reg "x20") (value "0x000000000000000A"))) (derivation "rd = rs1 = rs2: the sources are BOTH the old value, so 5 + 5 = 10 — the write must not disturb the reads.") (source "RVI-RV32I §1.1.4")) (step (n 25) (insn "addi x21, x0, 7") (writes (write (reg "x21") (value "0x0000000000000007"))) (derivation "Seven.") (source "RVI-RV32I §1.1.4")) (step (n 26) (insn "sub x21, x21, x21") (writes (write (reg "x21") (value "0x0000000000000000"))) (derivation "x - x = 0, observed as the 7 → 0 transition.") (source "RVI-RV32I §1.1.4")) (step (n 27) (insn "addi x22, x0, 1") (writes (write (reg "x22") (value "0x0000000000000001"))) (derivation "The pre-write for the 0 below.") (source "RVI-RV32I §1.1.4")) (step (n 28) (insn "slt x22, x22, x22") (writes (write (reg "x22") (value "0x0000000000000000"))) (derivation "A register is never below itself: 1 < 1 is false, so 0 — observed as 1 → 0.") (source "RVI-RV32I §1.1.4")) (step (n 29) (insn "addi x23, x0, 0x21") (writes (write (reg "x23") (value "0x0000000000000021"))) (derivation "33: value AND, below, its own shift amount (low 6 bits).") (source "RVI-RV32I §1.1.4")) (step (n 30) (insn "sll x23, x23, x23") (writes (write (reg "x23") (value "0x0000004200000000"))) (derivation "Self-referential shift: the amount is the OLD value's low 6 bits (33), so 33 << 33 = 0x0000004200000000 — both reads happen before the write.") (source "RVI-RV64I §3.1.2.2 (D-SHAMT)")) (step (n 31) (insn "addi x24, x10, 1024") (writes (write (reg "x24") (value "0x0000000080000400"))) (derivation "x24 = 0x80000400 — the address of X's first copy.") (source "RVI-RV32I §1.1.4")) (step (n 32) (insn "lb x24, x24, 0") (writes (write (reg "x24") (value "0x0000000000000001"))) (derivation "The address is sampled from the OLD x24 BEFORE the loaded value commits: lane 0 of X is 0x01, so x24 becomes 1. A model that wrote the register before computing the address would load from 0x…01 or trap.") (source "RVI-RV32I §1.1.6; RVI-RV64I §3.1.3")) (step (n 33) (insn "addi x0, x0, -1") (writes) (derivation "A write to x0 is DISCARDED: the expectation is the EMPTY writes table — the step happens, x0 stays 0 (the state descriptor's x0_hardwired_zero).") (source "RVI-RV32I §1.1.1 (x0 hardwired)")) (step (n 34) (insn "sd x1, 1040, x10") (writes) (derivation "A third copy of X, to be half-zeroed through x0.") (source "RVI-RV64I §3.1.3")) (step (n 35) (insn "sw x0, 1040, x10") (writes) (derivation "SW of x0 stores ZERO over the low word — x0 as a source reads 0.") (source "RVI-RV32I §1.1.1; RVI-RV64I §3.1.3")) (step (n 36) (insn "ld x25, x10, 1040") (writes (write (reg "x25") (value "0x0807060500000000"))) (derivation "Read back: the low 32 lanes are zeroed, the high half is X's: 0x0807060500000000.") (source "RVI-RV64I §3.1.3")))
