;; authoring model BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py a-amo-arith-w.expected.sexp schema/expectations.sexp

(expectations (program "a-amo-arith-w.s") (entry "0x0000000080000000") (instructions 22)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "x10 = 0x8000_0000, the declared region's base.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 2) (insn "addi x1, x10, 256") (writes (write (reg "x1") (value "0x0000000080000100")))
    (derivation "the cell's data address, clear of the code.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "lui x7, 0x80000") (writes (write (reg "x7") (value "0xffffffff80000000")))
    (derivation "bit 31 rides to the top — the low word is 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 4) (insn "addi x7, x7, 5") (writes (write (reg "x7") (value "0xffffffff80000005")))
    (derivation "x7's low word = 0x8000_0005: the sign-edge initial value.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "lui x6, 0x80000") (writes (write (reg "x6") (value "0xffffffff80000000")))
    (derivation "rs2's low word starts at 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 6) (insn "addi x6, x6, 3") (writes (write (reg "x6") (value "0xffffffff80000003")))
    (derivation "x6's low word = 0x8000_0003.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 0x8000_0005 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 8) (insn "amoadd.w x5, x6, (x1)") (writes (write (reg "x5") (value "0xffffffff80000005")))
    (derivation "rd <- the OLD word 0x8000_0005, SIGN-EXTENDED (0xFFFFFFFF80000005); mem <- old + rs2 = 0x00000008 (32-bit wrap).") (source "RVI-A §12.1.4"))
  (step (n 9) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000008")))
    (derivation "read-back: 0x8000_0007.") (source "RVI-RV64I §3.1.3"))
  (step (n 10) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 0x8000_0005 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 11) (insn "amoswap.w x5, x6, (x1)") (writes)
    (derivation "rd <- the old word sign-extended; mem <- rs2 = 0x8000_0003.") (source "RVI-A §12.1.4"))
  (step (n 12) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0xffffffff80000003")))
    (derivation "read-back: 0x8000_0007.") (source "RVI-RV64I §3.1.3"))
  (step (n 13) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 0x8000_0005 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 14) (insn "amoxor.w x5, x6, (x1)") (writes)
    (derivation "rd <- the old word sign-extended; mem <- 0x8000_0005 XOR 0x8000_0003 = 0x00000006.") (source "RVI-A §12.1.4"))
  (step (n 15) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000006")))
    (derivation "read-back: 0x8000_0007.") (source "RVI-RV64I §3.1.3"))
  (step (n 16) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 0x8000_0005 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 17) (insn "amoand.w x5, x6, (x1)") (writes)
    (derivation "rd <- the old word sign-extended; mem <- 0x8000_0005 AND 0x8000_0003 = 0x8000_0001.") (source "RVI-A §12.1.4"))
  (step (n 18) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0xffffffff80000001")))
    (derivation "read-back: 0x8000_0007.") (source "RVI-RV64I §3.1.3"))
  (step (n 19) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 0x8000_0005 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 20) (insn "amoor.w x5, x6, (x1)") (writes)
    (derivation "rd <- the old word sign-extended; mem <- 0x8000_0005 OR 0x8000_0003 = 0x8000_0007.") (source "RVI-A §12.1.4"))
  (step (n 21) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0xffffffff80000007")))
    (derivation "read-back: 0x8000_0007.") (source "RVI-RV64I §3.1.3"))
)
