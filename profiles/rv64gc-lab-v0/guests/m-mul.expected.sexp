;; m-mul.expected.sexp — the expected observations for `m-mul.s` (P4-SYSTEM.11,
;; the M corpus). EVD-05: every value below was derived from the pinned chapter (RVI-M
;; §11.1, Table 1's rows by name) with exact integers by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py m-mul.expected.sexp schema/expectations.sexp

(expectations (program "m-mul.s") (entry "0x0000000080000000") (instructions 26)
  (step (n 0) (insn "addi x5, x0, 7") (writes (write (reg "x5") (value "0x0000000000000007")))
    (derivation "a small positive operand, 7.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x6, x0, -3") (writes (write (reg "x6") (value "0xfffffffffffffffd")))
    (derivation "a small negative operand, -3.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "mul x7, x5, x6") (writes (write (reg "x7") (value "0xffffffffffffffeb")))
    (derivation "7 x -3, mixed signs: the low 64 bits are -21 = 0xffffffffffffffeb.") (source "RVI-M §11.1.1"))
  (step (n 3) (insn "mulh x8, x5, x6") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "the high half of the signed product -21: 0xffffffffffffffff.") (source "RVI-M §11.1.1"))
  (step (n 4) (insn "mulhsu x9, x5, x6") (writes (write (reg "x9") (value "0x0000000000000006")))
    (derivation "7 (signed) x -3 read UNSIGNED (2^64 - 3): the high half 0x0000000000000006.") (source "RVI-M §11.1.1"))
  (step (n 5) (insn "mulhu x10, x5, x6") (writes (write (reg "x10") (value "0x0000000000000006")))
    (derivation "both unsigned, the same magnitudes: the high half 0x0000000000000006.") (source "RVI-M §11.1.1"))
  (step (n 6) (insn "mulhsu x11, x6, x5") (writes (write (reg "x11") (value "0xffffffffffffffff")))
    (derivation "-3 (signed) x 7 (unsigned): a negative product, high half 0xffffffffffffffff.") (source "RVI-M §11.1.1"))
  (step (n 7) (insn "addi x12, x0, 1") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "build the most-negative value: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x12, x12, 63") (writes (write (reg "x12") (value "0x8000000000000000")))
    (derivation "… shifted to bit 63 = -2^63.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 9) (insn "addi x13, x0, 13") (writes (write (reg "x13") (value "0x000000000000000d")))
    (derivation "a sentinel the zero half must REPLACE.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "mul x13, x12, x12") (writes (write (reg "x13") (value "0x0000000000000000")))
    (derivation "(-2^63)^2 = 2^126: the low half 0x0000000000000000.") (source "RVI-M §11.1.1"))
  (step (n 11) (insn "mulh x14, x12, x12") (writes (write (reg "x14") (value "0x4000000000000000")))
    (derivation "… signed x signed, the high half 0x4000000000000000 (2^62).") (source "RVI-M §11.1.1"))
  (step (n 12) (insn "mulhu x15, x12, x12") (writes (write (reg "x15") (value "0x4000000000000000")))
    (derivation "2^63 x 2^63 unsigned = 2^126: the high half 0x4000000000000000.") (source "RVI-M §11.1.1"))
  (step (n 13) (insn "mulhsu x16, x12, x12") (writes (write (reg "x16") (value "0xc000000000000000")))
    (derivation "-2^63 (signed) x 2^63 (unsigned) = -2^126: the high half 0xc000000000000000.") (source "RVI-M §11.1.1"))
  (step (n 14) (insn "addi x17, x0, -1") (writes (write (reg "x17") (value "0xffffffffffffffff")))
    (derivation "-1: all bits set.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "mul x18, x17, x17") (writes (write (reg "x18") (value "0x0000000000000001")))
    (derivation "(-1) x (-1): the low half 0x0000000000000001.") (source "RVI-M §11.1.1"))
  (step (n 16) (insn "addi x19, x0, 19") (writes (write (reg "x19") (value "0x0000000000000013")))
    (derivation "a sentinel the zero half must REPLACE.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "mulh x19, x17, x17") (writes (write (reg "x19") (value "0x0000000000000000")))
    (derivation "… signed, the product is +1: the high half 0x0000000000000000.") (source "RVI-M §11.1.1"))
  (step (n 18) (insn "mulhu x20, x17, x17") (writes (write (reg "x20") (value "0xfffffffffffffffe")))
    (derivation "(2^64 - 1)^2 unsigned: the high half 0xfffffffffffffffe (2^64 - 2).") (source "RVI-M §11.1.1"))
  (step (n 19) (insn "mulhsu x21, x17, x17") (writes (write (reg "x21") (value "0xffffffffffffffff")))
    (derivation "-1 (signed) x (2^64 - 1) (unsigned): the high half 0xffffffffffffffff.") (source "RVI-M §11.1.1"))
  (step (n 20) (insn "mul x22, x12, x17") (writes (write (reg "x22") (value "0x8000000000000000")))
    (derivation "-2^63 x -1 = 2^63, which wraps at 64 bits: the low half 0x8000000000000000.") (source "RVI-M §11.1.1"))
  (step (n 21) (insn "addi x23, x0, 23") (writes (write (reg "x23") (value "0x0000000000000017")))
    (derivation "a sentinel the zero half must REPLACE.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "mulh x23, x12, x17") (writes (write (reg "x23") (value "0x0000000000000000")))
    (derivation "… and the high half of the exact 2^63: 0x0000000000000000.") (source "RVI-M §11.1.1"))
  (step (n 23) (insn "srli x24, x17, 1") (writes (write (reg "x24") (value "0x7fffffffffffffff")))
    (derivation "the most-positive value, 2^63 - 1.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 24) (insn "mulhu x25, x24, x24") (writes (write (reg "x25") (value "0x3fffffffffffffff")))
    (derivation "(2^63 - 1)^2 unsigned: the high half 0x3fffffffffffffff.") (source "RVI-M §11.1.1"))
  (step (n 25) (insn "mulh x26, x24, x12") (writes (write (reg "x26") (value "0xc000000000000000")))
    (derivation "(2^63 - 1) x -2^63, signed: the high half 0xc000000000000000.") (source "RVI-M §11.1.1"))
)
