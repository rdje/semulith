;; c-memory.expected.sexp — spec-side observations for `c-memory.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py c-memory.expected.sexp schema/expectations.sexp

(expectations (program "c-memory.s") (entry "0x0000000080000000") (instructions 22) (fetches 30)
  (step (n 0) (insn "auipc x2, 0") (writes (write (reg "x2") (value "0x0000000080000000")))
    (derivation "auipc writes the instruction's own address plus the U-immediate.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x2, x2, 1536") (writes (write (reg "x2") (value "0x0000000080000600")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "c.addi4spn x8, 16") (writes (write (reg "x8") (value "0x0000000080000610")))
    (derivation "C.ADDI4SPN uses its declared base operation at length 2: the 12-bit immediate adds into rd.") (source "RVI-C §27.1.5.2; RVI-RV32I §1.1.4"))
  (step (n 3) (insn "c.li x9, -32") (writes (write (reg "x9") (value "0xffffffffffffffe0")))
    (derivation "C.LI uses its declared base operation at length 2: the 12-bit immediate adds into rd.") (source "RVI-C §27.1.5.1; RVI-RV32I §1.1.4"))
  (step (n 4) (insn "c.sw x8, x9, 124") (writes)
    (derivation "C.SW uses its declared base operation at length 2: SW stores the low 32 bits of rs2 — no register observation.") (source "RVI-C §27.1.3.2; RVI-RV64I §3.1.3"))
  (step (n 5) (insn "c.lw x10, x8, 124") (writes (write (reg "x10") (value "0xffffffffffffffe0")))
    (derivation "C.LW uses its declared base operation at length 2: LW sign-extends its 32-bit result to 64 bits.") (source "RVI-C §27.1.3.2; RVI-RV64I §3.1.3 (D-LOAD-EXT)"))
  (step (n 6) (insn "c.sd x8, x9, 248") (writes)
    (derivation "C.SD uses its declared base operation at length 2: SD stores the low 64 bits of rs2 — no register observation.") (source "RVI-C §27.1.3.2; RVI-RV64I §3.1.3"))
  (step (n 7) (insn "c.ld x11, x8, 248") (writes (write (reg "x11") (value "0xffffffffffffffe0")))
    (derivation "C.LD uses its declared base operation at length 2: a full XLEN load needs no extension.") (source "RVI-C §27.1.3.2; RVI-RV64I §3.1.3"))
  (step (n 8) (insn "c.swsp x9, 252") (writes)
    (derivation "C.SWSP uses its declared base operation at length 2: SW stores the low 32 bits of rs2 — no register observation.") (source "RVI-C §27.1.3.1; RVI-RV64I §3.1.3"))
  (step (n 9) (insn "c.lwsp x1, 252") (writes (write (reg "x1") (value "0xffffffffffffffe0")))
    (derivation "C.LWSP uses its declared base operation at length 2: LW sign-extends its 32-bit result to 64 bits.") (source "RVI-C §27.1.3.1; RVI-RV64I §3.1.3 (D-LOAD-EXT)"))
  (step (n 10) (insn "c.sdsp x9, 504") (writes)
    (derivation "C.SDSP uses its declared base operation at length 2: SD stores the low 64 bits of rs2 — no register observation.") (source "RVI-C §27.1.3.1; RVI-RV64I §3.1.3"))
  (step (n 11) (insn "c.ldsp x3, 504") (writes (write (reg "x3") (value "0xffffffffffffffe0")))
    (derivation "C.LDSP uses its declared base operation at length 2: a full XLEN load needs no extension.") (source "RVI-C §27.1.3.1; RVI-RV64I §3.1.3"))
  (step (n 12) (insn "addi x5, x0, 3") (writes (write (reg "x5") (value "0x0000000000000003")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "slli x5, x5, 13") (writes (write (reg "x5") (value "0x0000000000006000")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 14) (insn "csrrs x0, mstatus, x5") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 15) (insn "fmv.d.x f9, x9") (writes)
    (derivation "fmv.d.x: f9 <- x9's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 16) (insn "c.fsd x8, f9, 248") (writes)
    (derivation "C.FSD uses its declared base operation at length 2: fsd: f9's 64 bits to 0x0000000080000708 (unmodified).") (source "RVI-C §27.1.3.2; RVI-D §21.1.3"))
  (step (n 17) (insn "c.fld f8, x8, 248") (writes)
    (derivation "C.FLD uses its declared base operation at length 2: fld: f8 <- the doubleword 0xffffffffffffffe0 (bits unmodified).") (source "RVI-C §27.1.3.2; RVI-D §21.1.3"))
  (step (n 18) (insn "fmv.x.d x12, f8") (writes (write (reg "x12") (value "0xffffffffffffffe0")))
    (derivation "fmv.x.d: f8's 64 bits, unmodified: x12 = 0xffffffffffffffe0.") (source "RVI-D §21.1.5"))
  (step (n 19) (insn "c.fsdsp f9, 504") (writes)
    (derivation "C.FSDSP uses its declared base operation at length 2: fsd: f9's 64 bits to 0x00000000800007f8 (unmodified).") (source "RVI-C §27.1.3.1; RVI-D §21.1.3"))
  (step (n 20) (insn "c.fldsp f1, 504") (writes)
    (derivation "C.FLDSP uses its declared base operation at length 2: fld: f1 <- the doubleword 0xffffffffffffffe0 (bits unmodified).") (source "RVI-C §27.1.3.1; RVI-D §21.1.3"))
  (step (n 21) (insn "fmv.x.d x13, f1") (writes (write (reg "x13") (value "0xffffffffffffffe0")))
    (derivation "fmv.x.d: f1's 64 bits, unmodified: x13 = 0xffffffffffffffe0.") (source "RVI-D §21.1.5"))
)
