;; w-notrap.expected.sexp — spec-side observations for `w-notrap.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py w-notrap.expected.sexp schema/expectations.sexp

(expectations (program "w-notrap.s") (entry "0x0000000080000000") (instructions 21) (fetches 36)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "lui x31, 0x80000") (writes (write (reg "x31") (value "0xffffffff80000000")))
    (derivation "the upper 20 bits land sign-extended in rd.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 1) (insn "csrrs x0, menvcfg, x31") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 2) (insn "addi x8, x0, 10") (writes (write (reg "x8") (value "0x000000000000000a")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "csrrw x0, stimecmp, x8") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 4) (insn "addi x15, x0, 1") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "slli x15, x15, 5") (writes (write (reg "x15") (value "0x0000000000000020")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 6) (insn "csrrs x0, mie, x15") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 7) (insn "wfi") (writes)
    (derivation "a LEGAL wfi: the hart ENTERS the wait (the nop latitude recorded-not-taken — decision 4); it retires the instruction and stalls, the wake evaluating at the next head.") (source "RVP-MACHINE §2.1.3.3; the .5 brief's decision 4"))
  (step (n 8) (insn "<halted>") (writes)
    (derivation "WAITING: no fetch or retirement; the declared time domain ticks once.") (source "RVP-MACHINE §2.1.3.3; the laboratory wait policy"))
  (step (n 9) (insn "<halted>") (writes)
    (derivation "WAITING: no fetch or retirement; the declared time domain ticks once.") (source "RVP-MACHINE §2.1.3.3; the laboratory wait policy"))
  (step (n 10) (insn "rdtime x7") (writes (write (reg "x7") (value "0x000000000000000a")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 11) (insn "csrrs x11, mip, x0") (writes (write (reg "x11") (value "0x0000000000000020")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "addi x8, x0, 16") (writes (write (reg "x8") (value "0x0000000000000010")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "csrrw x0, stimecmp, x8") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 14) (insn "wfi") (writes)
    (derivation "a LEGAL wfi: the hart ENTERS the wait (the nop latitude recorded-not-taken — decision 4); it retires the instruction and stalls, the wake evaluating at the next head.") (source "RVP-MACHINE §2.1.3.3; the .5 brief's decision 4"))
  (step (n 15) (insn "<halted>") (writes)
    (derivation "WAITING: no fetch or retirement; the declared time domain ticks once.") (source "RVP-MACHINE §2.1.3.3; the laboratory wait policy"))
  (step (n 16) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000020")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 17) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "slli x13, x13, 16") (writes (write (reg "x13") (value "0x0000000000010000")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 19) (insn "csrrw x0, stimecmp, x13") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
)
