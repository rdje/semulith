;; d-convert.expected.sexp — the expected observations for `d-convert.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-convert.expected.sexp schema/expectations.sexp

(expectations (program "d-convert.s") (entry "0x0000000080000000") (instructions 39)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x40040") (writes (write (reg "x5") (value "0x0000000040040000")))
    (derivation "build 0x4004000000000000: the upper word 0x40040000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x4004000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 6) (insn "fcvt.w.d x6, f1, 0") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "2.5 in RNE: 2 (ties to even), NX.") (source "RVI-D §21.1.5"))
  (step (n 7) (insn "fcvt.w.d x7, f1, 4") (writes (write (reg "x7") (value "0x0000000000000003")))
    (derivation "2.5 in RMM: 3.") (source "RVI-D §21.1.5"))
  (step (n 8) (insn "lui x8, 0xbff00") (writes (write (reg "x8") (value "0xffffffffbff00000")))
    (derivation "build 0xbff0000000000000: the upper word 0xbff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "slli x8, x8, 32") (writes (write (reg "x8") (value "0xbff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 10) (insn "fmv.d.x f2, x8") (writes)
    (derivation "fmv.d.x: f2 <- x8's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 11) (insn "fcvt.wu.d x9, f2, 1") (writes)
    (derivation "-1.0 to unsigned: out of range — 0 and INVALID.") (source "RVI-D §21.1.5"))
  (step (n 12) (insn "lui x10, 0x43e00") (writes (write (reg "x10") (value "0x0000000043e00000")))
    (derivation "build 0x43e0000000000000: the upper word 0x43e00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "slli x10, x10, 32") (writes (write (reg "x10") (value "0x43e0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 14) (insn "fmv.d.x f3, x10") (writes)
    (derivation "fmv.d.x: f3 <- x10's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 15) (insn "fcvt.l.d x11, f3, 0") (writes (write (reg "x11") (value "0x7fffffffffffffff")))
    (derivation "2^63 to a signed 64-bit integer: clipped to the maximum, INVALID.") (source "RVI-D §21.1.5"))
  (step (n 16) (insn "lui x12, 0x7ff80") (writes (write (reg "x12") (value "0x000000007ff80000")))
    (derivation "build 0x7ff8000000000000: the upper word 0x7ff80000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "slli x12, x12, 32") (writes (write (reg "x12") (value "0x7ff8000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 18) (insn "fmv.d.x f4, x12") (writes)
    (derivation "fmv.d.x: f4 <- x12's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 19) (insn "fcvt.lu.d x13, f4, 0") (writes (write (reg "x13") (value "0xffffffffffffffff")))
    (derivation "a NaN to unsigned 64: the maximum, INVALID (Table 5).") (source "RVI-D §21.1.5"))
  (step (n 20) (insn "csrrs x14, fflags, x0") (writes (write (reg "x14") (value "0x0000000000000011")))
    (derivation "x14 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 21) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 22) (insn "addi x15, x0, -7") (writes (write (reg "x15") (value "0xfffffffffffffff9")))
    (derivation "-7.") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "fcvt.d.w f5, x15, 1") (writes)
    (derivation "-7 to double: exact, whatever the (legal) mode.") (source "RVI-D §21.1.5"))
  (step (n 24) (insn "fmv.x.d x16, f5") (writes (write (reg "x16") (value "0xc01c000000000000")))
    (derivation "fmv.x.d: f5's 64 bits, unmodified: x16 = 0xc01c000000000000.") (source "RVI-D §21.1.5"))
  (step (n 25) (insn "fcvt.d.wu f6, x15, 0") (writes)
    (derivation "0xFFFFFFF9 as unsigned 32: exact.") (source "RVI-D §21.1.5"))
  (step (n 26) (insn "fmv.x.d x17, f6") (writes (write (reg "x17") (value "0x41efffffff200000")))
    (derivation "fmv.x.d: f6's 64 bits, unmodified: x17 = 0x41efffffff200000.") (source "RVI-D §21.1.5"))
  (step (n 27) (insn "lui x18, 0x200") (writes (write (reg "x18") (value "0x0000000000200000")))
    (derivation "build 0x0020000000000001: the upper word 0x00200000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "slli x18, x18, 32") (writes (write (reg "x18") (value "0x0020000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 29) (insn "addi x28, x0, 1") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "the lower word 0x00000001.") (source "RVI-RV32I §1.1.4"))
  (step (n 30) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000100000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 31) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 32) (insn "or x18, x18, x28") (writes (write (reg "x18") (value "0x0020000000000001")))
    (derivation "x18 = 0x0020000000000001.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "fcvt.d.l f7, x18, 0") (writes)
    (derivation "2^53+1: not representable — rounds to even, NX.") (source "RVI-D §21.1.5"))
  (step (n 34) (insn "fmv.x.d x19, f7") (writes (write (reg "x19") (value "0x4340000000000000")))
    (derivation "fmv.x.d: f7's 64 bits, unmodified: x19 = 0x4340000000000000.") (source "RVI-D §21.1.5"))
  (step (n 35) (insn "addi x20, x0, -1") (writes (write (reg "x20") (value "0xffffffffffffffff")))
    (derivation "2^64-1 as unsigned.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "fcvt.d.lu f8, x20, 1") (writes)
    (derivation "2^64-1 in RTZ: the largest double below 2^64, NX.") (source "RVI-D §21.1.5"))
  (step (n 37) (insn "fmv.x.d x21, f8") (writes (write (reg "x21") (value "0x43efffffffffffff")))
    (derivation "fmv.x.d: f8's 64 bits, unmodified: x21 = 0x43efffffffffffff.") (source "RVI-D §21.1.5"))
  (step (n 38) (insn "csrrs x22, fflags, x0") (writes (write (reg "x22") (value "0x0000000000000001")))
    (derivation "x22 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
