;; d-class.expected.sexp — the expected observations for `d-class.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-class.expected.sexp schema/expectations.sexp

(expectations (program "d-class.s") (entry "0x0000000080000000") (instructions 58)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0xfff00") (writes (write (reg "x5") (value "0xfffffffffff00000")))
    (derivation "build 0xfff0000000000000: the upper word 0xfff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0xfff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 6) (insn "fclass.d x6, f1") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "fclass.d: the class mask 0x1; no flag.") (source "RVI-D §21.1.7 (FCLASS.S's Table 6)"))
  (step (n 7) (insn "lui x5, 0xbff00") (writes (write (reg "x5") (value "0xffffffffbff00000")))
    (derivation "build 0xbff0000000000000: the upper word 0xbff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0xbff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 9) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 10) (insn "fclass.d x7, f1") (writes (write (reg "x7") (value "0x0000000000000002")))
    (derivation "fclass.d: the class mask 0x2; no flag.") (source "RVI-D §21.1.7 (FCLASS.S's Table 6)"))
  (step (n 11) (insn "lui x5, 0x80100") (writes (write (reg "x5") (value "0xffffffff80100000")))
    (derivation "build 0x800fffffffffffff: the upper word 0x800fffff first.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "addi x5, x5, -1") (writes (write (reg "x5") (value "0xffffffff800fffff")))
    (derivation "… its low 12 bits (-1).") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x800fffff00000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 14) (insn "addi x28, x0, -1") (writes (write (reg "x28") (value "0xffffffffffffffff")))
