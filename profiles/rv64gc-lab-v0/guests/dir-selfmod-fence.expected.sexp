;; dir-selfmod-fence.expected.sexp — the expected observations for `dir-selfmod-fence.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-selfmod-fence.expected.sexp schema/expectations.sexp

(comment "dir-selfmod-fence.expected.sexp — the expected observations for `dir-selfmod-fence.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05), and the shape was MEASURED BY PROBE on all three models before authoring" "(run_probes_p25s3.py): the patch is visible through FENCE RW,RW on sail 0.14 AND spike" "1.1.1-dev AND semulith. D-CODE-VISIBILITY is the laboratory's declared choice (re-read per" "fetch — a legal implementation choice, NOT an architectural guarantee: without Zifencei a" "caching hart is equally correct), and D-FENCE gives the fence no observable effect in this" "profile (one hart, in-order, no devices, no memory-ordering claim).")
(expectations (program "dir-selfmod-fence.s") (entry "0x80000000") (instructions 8) (step (n 0) (insn "lui x1, 0x00700") (writes (write (reg "x1") (value "0x0000000000700000"))) (derivation "LUI: 0x00700 << 12; bit 19 clear, positive extension.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)")) (step (n 1) (insn "addi x1, x1, 0x113") (writes (write (reg "x1") (value "0x0000000000700113"))) (derivation "0x00700000 + 0x113 = 0x00700113 — the encoding of `addi x2, x0, 7` (imm 7, rs1 x0, funct3 0, rd x2, opcode OP-IMM).") (source "RVI-RV32I §1.1.4; the encoding's fields per the pinned arg_lut")) (step (n 2) (insn "auipc x3, 0") (writes (write (reg "x3") (value "0x0000000080000008"))) (derivation "pc + 0 — this instruction's own address.") (source "RVI-RV64I §3.1.2.1")) (step (n 3) (insn "sw x1, 16, x3") (writes ) (derivation "SW writes the low 32 bits at x3+16 = entry+0x18 — the word of step 6. A store writes no register; the crossing is the census's pin.") (source "RVI-RV32I §1.1.6")) (step (n 4) (insn "fence 0, 3, 3, x0, x0") (writes ) (derivation "FENCE RW,RW between the store and the fetch: no observable effect in this profile (D-FENCE) — and it does NOT hide the patch: measured visible on all three models.") (source "RVI-RV32I §1.1.7 — D-FENCE; D-CODE-VISIBILITY")) (step (n 5) (insn "addi x4, x0, 4") (writes (write (reg "x4") (value "0x0000000000000004"))) (derivation "An ordinary write between the fence and the target.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "addi x2, x0, 2 (patched to addi x2, x0, 7)") (writes (write (reg "x2") (value "0x0000000000000007"))) (derivation "The word at entry+0x18 is fetched AFTER the store and the fence: the laboratory re-reads memory per fetch (D-CODE-VISIBILITY), so the encoding executed is 0x00700113 — addi x2, x0, 7 — not the assembled word. x2 = 7, exactly as both references measured.") (source "RVI-INTRO Memory (implicit reads) — D-CODE-VISIBILITY")) (step (n 7) (insn "addi x5, x0, 5") (writes (write (reg "x5") (value "0x0000000000000005"))) (derivation "The landing: the patch, the fence and the patched fetch all retired.") (source "RVI-RV32I §1.1.4")))
