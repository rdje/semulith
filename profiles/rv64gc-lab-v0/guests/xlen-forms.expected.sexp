;; xlen-forms.expected.sexp — spec-side observations for `xlen-forms.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py xlen-forms.expected.sexp schema/expectations.sexp

(expectations (program "xlen-forms.s") (entry "0x0000000080000000") (instructions 25) (fetches 50)
  (step (n 0) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "1, the bit to place at the top of a 64-bit register.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x5, x5, 63") (writes (write (reg "x5") (value "0x8000000000000000")))
    (derivation "bit 63 exists: 1 << 63 = -2^63, {new} — a 64-bit register, not a 32-bit one.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 2) (insn "srli x6, x5, 63") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "the logical shift back by 63 yields 1: {new} — the top bit was bit 63.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 3) (insn "srai x7, x5, 63") (writes (write (reg "x7") (value "0xffffffffffffffff")))
    (derivation "the arithmetic shift copies bit 63 into all 64 bits: {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 4) (insn "addi x8, x0, -1") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "-1: all 64 bits set, {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "slli x9, x8, 32") (writes (write (reg "x9") (value "0xffffffff00000000")))
    (derivation "bits 32..63 are real: -1 << 32 = {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 6) (insn "slli x10, x8, 40") (writes (write (reg "x10") (value "0xffffff0000000000")))
    (derivation "a 6-bit shift amount (40 > 31 is legal in RV64I): {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 7) (insn "srli x11, x8, 1") (writes (write (reg "x11") (value "0x7fffffffffffffff")))
    (derivation "the largest positive XLEN value 2^63 - 1: {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 8) (insn "addi x12, x11, 1") (writes (write (reg "x12") (value "0x8000000000000000")))
    (derivation "2^63 - 1 + 1 wraps modulo 2^64 to -2^63: {new} — no overflow trap.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "add x13, x8, x8") (writes (write (reg "x13") (value "0xfffffffffffffffe")))
    (derivation "-1 + -1 = -2 modulo 2^64: {new} — the carry out of bit 63 is discarded.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "lui x14, 0x80000") (writes (write (reg "x14") (value "0xffffffff80000000")))
    (derivation "LUI 0x80000: the 32-bit immediate sign-extended to 64 bits: {new}.") (source "RVI-RV64I §3.1.2.2"))
  (step (n 11) (insn "addiw x15, x14, 1") (writes (write (reg "x15") (value "0xffffffff80000001")))
    (derivation "ADDIW: the low word 0x80000001, sign-extended: {new}.") (source "RVI-RV64I §3.1.2"))
  (step (n 12) (insn "srliw x16, x14, 1") (writes (write (reg "x16") (value "0x0000000040000000")))
    (derivation "SRLIW: the low word 0x80000000 >> 1 = 0x40000000, sign-extended with bit 31 clear: {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 13) (insn "sraiw x17, x14, 1") (writes (write (reg "x17") (value "0xffffffffc0000000")))
    (derivation "SRAIW: the low word's sign at bit 31 is copied: 0xC0000000 sign-extended: {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 14) (insn "addw x18, x8, x5") (writes (write (reg "x18") (value "0xffffffffffffffff")))
    (derivation "ADDW ignores bits 32..63 of its inputs: -1 + 0 (the low word of -2^63) = -1 as a word, sign-extended: {new}.") (source "RVI-RV64I §3.1.2"))
  (step (n 15) (insn "subw x19, x0, x11") (writes (write (reg "x19") (value "0x0000000000000001")))
    (derivation "SUBW: 0 - 0xFFFFFFFF (the low word of 2^63 - 1) = 1 as a word, sign-extended: {new}.") (source "RVI-RV64I §3.1.2"))
  (step (n 16) (insn "sllw x20, x6, x11") (writes (write (reg "x20") (value "0xffffffff80000000")))
    (derivation "SLLW takes the low 5 bits of the shift amount: 1 << 31 = 0x80000000, sign-extended: {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 17) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000044")))
    (derivation "the handler's base: this instruction's own 64-bit address, {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "addi x1, x1, 24") (writes (write (reg "x1") (value "0x000000008000005c")))
    (derivation "the handler sits six instructions on, at {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "direct-mode mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.5"))
  (step (n 20) (insn "addi x21, x0, 1") (writes (write (reg "x21") (value "0x0000000000000001")))
    (derivation "1, the bit to place at 2^40.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "slli x21, x21, 40") (writes (write (reg "x21") (value "0x0000010000000000")))
    (derivation "the address 2^40 = {new}: a 64-bit address, outside every declared region.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 22) (insn "ld x22, x21, 0") (writes)
    (derivation "a load at 2^40 raises a load access fault (cause 5, tval = the address); x22 is never written.") (source "RVP-MACHINE §2.1.6 (D-ADDRESS-SPACE)"))
  (step (n 23) (insn "csrrs x30, mcause, x0") (writes (write (reg "x30") (value "0x0000000000000005")))
    (derivation "the handler reads mcause: {new} = 5, a load access fault.") (source "RVP-MACHINE §2.1.6"))
  (step (n 24) (insn "csrrs x31, mtval, x0") (writes (write (reg "x31") (value "0x0000010000000000")))
    (derivation "the handler reads mtval: {new} — the faulting address, all 64 bits of it.") (source "RVP-MACHINE §2.1.7"))
)
