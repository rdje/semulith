;; f-convert.expected.sexp — the expected observations for `f-convert.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-convert.expected.sexp schema/expectations.sexp

(expectations (program "f-convert.s") (entry "0x0000000080000000") (instructions 39)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x40200") (writes (write (reg "x5") (value "0x0000000040200000")))
    (derivation "build the pattern 0x40200000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 5) (insn "fcvt.w.s x6, f1, 0") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "2.5 in RNE: 2 (ties to even), NX.") (source "RVI-F §20.1.7"))
  (step (n 6) (insn "fcvt.w.s x7, f1, 4") (writes (write (reg "x7") (value "0x0000000000000003")))
    (derivation "2.5 in RMM: 3.") (source "RVI-F §20.1.7"))
  (step (n 7) (insn "fcvt.l.s x8, f1, 3") (writes (write (reg "x8") (value "0x0000000000000003")))
    (derivation "fcvt.l.s (RUP): x8 = 0x0000000000000003; flags NX.") (source "RVI-F §20.1.7 (Table 5)"))
  (step (n 8) (insn "csrrs x9, fflags, x0") (writes (write (reg "x9") (value "0x0000000000000001")))
    (derivation "x9 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 9) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 10) (insn "lui x10, 0x4f400") (writes (write (reg "x10") (value "0x000000004f400000")))
    (derivation "build the pattern 0x4f400000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "fmv.w.x f2, x10") (writes)
    (derivation "fmv.w.x: f2 <- x10's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 12) (insn "fcvt.wu.s x11, f2, 1") (writes (write (reg "x11") (value "0xffffffffc0000000")))
    (derivation "3·2^30 fits a u32 — and FCVT.WU sign-extends its 32-bit result: 0xFFFFFFFFC0000000.") (source "RVI-F §20.1.7"))
  (step (n 13) (insn "fcvt.w.s x12, f2, 1") (writes (write (reg "x12") (value "0x000000007fffffff")))
    (derivation "beyond 2^31-1: clipped to 0x7FFFFFFF, NV alone.") (source "RVI-F §20.1.7 (Table 5)"))
  (step (n 14) (insn "csrrs x13, fflags, x0") (writes (write (reg "x13") (value "0x0000000000000010")))
    (derivation "x13 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 15) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 16) (insn "lui x14, 0x7fc00") (writes (write (reg "x14") (value "0x000000007fc00000")))
    (derivation "build the pattern 0x7fc00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "fmv.w.x f3, x14") (writes)
    (derivation "fmv.w.x: f3 <- x14's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 18) (insn "fcvt.lu.s x15, f3, 0") (writes (write (reg "x15") (value "0xffffffffffffffff")))
    (derivation "NaN → the maximum (2^64-1), NV.") (source "RVI-F §20.1.7 (Table 5)"))
  (step (n 19) (insn "lui x16, 0xff800") (writes (write (reg "x16") (value "0xffffffffff800000")))
    (derivation "build the pattern 0xff800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "fmv.w.x f4, x16") (writes)
    (derivation "fmv.w.x: f4 <- x16's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 21) (insn "fcvt.l.s x17, f4, 0") (writes (write (reg "x17") (value "0x8000000000000000")))
    (derivation "−∞ → the minimum (−2^63), NV.") (source "RVI-F §20.1.7 (Table 5)"))
  (step (n 22) (insn "lui x18, 0xbf800") (writes (write (reg "x18") (value "0xffffffffbf800000")))
    (derivation "build the pattern 0xbf800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "fmv.w.x f5, x18") (writes)
    (derivation "fmv.w.x: f5 <- x18's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 24) (insn "fcvt.wu.s x19, f5, 1") (writes)
    (derivation "−1.0 to unsigned: out of range — clipped to 0, NV.") (source "RVI-F §20.1.7 (Table 5)"))
  (step (n 25) (insn "csrrs x20, fflags, x0") (writes (write (reg "x20") (value "0x0000000000000010")))
    (derivation "x20 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 26) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 27) (insn "addi x21, x0, -7") (writes (write (reg "x21") (value "0xfffffffffffffff9")))
    (derivation "x21 = −7.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "fcvt.s.w f6, x21, 0") (writes)
    (derivation "fcvt.s.w (RNE): 0xc0e00000; flags none.") (source "RVI-F §20.1.7"))
  (step (n 29) (insn "fmv.x.w x22, f6") (writes (write (reg "x22") (value "0xffffffffc0e00000")))
    (derivation "fmv.x.w: the low 32 bits of f6, sign-extended: x22 = 0xffffffffc0e00000.") (source "RVI-F §20.1.7"))
  (step (n 30) (insn "fcvt.s.wu f7, x21, 0") (writes)
    (derivation "x21's low 32 bits as UNSIGNED: 4294967289 → rounds to 2^32 in RNE, NX.") (source "RVI-F §20.1.7"))
  (step (n 31) (insn "fmv.x.w x23, f7") (writes (write (reg "x23") (value "0x000000004f800000")))
    (derivation "fmv.x.w: the low 32 bits of f7, sign-extended: x23 = 0x000000004f800000.") (source "RVI-F §20.1.7"))
  (step (n 32) (insn "lui x24, 0x1000") (writes (write (reg "x24") (value "0x0000000001000000")))
    (derivation "x24 = 2^24.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "addi x24, x24, 1") (writes (write (reg "x24") (value "0x0000000001000001")))
    (derivation "2^24 + 1 — not a single.") (source "RVI-RV32I §1.1.4"))
  (step (n 34) (insn "fcvt.s.l f8, x24, 3") (writes)
    (derivation "RUP: 2^24 + 2, NX.") (source "RVI-F §20.1.7"))
  (step (n 35) (insn "fmv.x.w x25, f8") (writes (write (reg "x25") (value "0x000000004b800001")))
    (derivation "fmv.x.w: the low 32 bits of f8, sign-extended: x25 = 0x000000004b800001.") (source "RVI-F §20.1.7"))
  (step (n 36) (insn "fcvt.s.lu f9, x21, 1") (writes)
    (derivation "x21 as a u64 (2^64 − 7) in RTZ.") (source "RVI-F §20.1.7"))
  (step (n 37) (insn "fmv.x.w x26, f9") (writes (write (reg "x26") (value "0x000000005f7fffff")))
    (derivation "fmv.x.w: the low 32 bits of f9, sign-extended: x26 = 0x000000005f7fffff.") (source "RVI-F §20.1.7"))
  (step (n 38) (insn "csrrs x27, fflags, x0") (writes (write (reg "x27") (value "0x0000000000000001")))
    (derivation "x27 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
