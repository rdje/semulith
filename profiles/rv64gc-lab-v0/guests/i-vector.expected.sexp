;; i-vector.expected.sexp — the expected observations for `i-vector.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-vector.expected.sexp schema/expectations.sexp

(expectations (program "i-vector.s") (entry "0x0000000080000000") (instructions 53) (fetches 51)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 109") (writes (write (reg "x1") (value "0x000000008000006d")))
    (derivation "mtvec's BASE rides 108 bytes in; MODE adds 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "ori x1, x1, 1") (writes)
    (derivation "MODE = Vectored.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec = BASE") (source "1. | RVI-ZICSR §5.1.1"))
  (step (n 4) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000010")))
    (derivation "x1 = this address.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "addi x1, x1, 129") (writes (write (reg "x1") (value "0x0000000080000091")))
    (derivation "stvec's BASE rides 129 bytes past this auipc (144 from the entry); MODE adds 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "ori x1, x1, 1") (writes)
    (derivation "MODE = Vectored for stvec too.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "csrrw x0, stvec, x1") (writes)
    (derivation "stvec = SBASE") (source "1. | RVI-ZICSR §5.1.1"))
  (step (n 8) (insn "addi x8, x0, 1") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "raw material for SEIP's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "slli x8, x8, 9") (writes (write (reg "x8") (value "0x0000000000000200")))
    (derivation "x8 = 1 << 9.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 10) (insn "csrrs x0, mip, x8") (writes)
    (derivation "SEIP <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 11) (insn "csrrs x0, mie, x8") (writes)
    (derivation "SEIE <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 12) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1.") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 14) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SEI interrupt in M: xcause carries the Interrupt bit with cause 9, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 15) (insn "jal x0, sei_m_handler") (writes)
    (derivation "BASE+36 slot (which SBASE aliases): the vectored SEI delivery's landing.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 16) (insn "csrrs x13, mcause, x0") (writes (write (reg "x13") (value "0x8000000000000009")))
    (derivation "the BASE+36 slot: the Interrupt bit with cause 9 — the vectored delivery computed it.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 17) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x0000000080000038")))
    (derivation "mepc is the un-fetched pc.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 18) (insn "csrrc x0, mip, x8") (writes)
    (derivation "clear SEIP through MIP — it is read-only in sip, so the M-side cause is the M-cleared one.") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.4"))
  (step (n 19) (insn "csrrs x14, mepc, x0") (writes)
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 20) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x000000008000003c")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 22) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 23) (insn "ecall") (writes)
    (derivation "from M: a SYNCHRONOUS trap under MODE=Vectored still lands at BASE (never BASE + 4×cause).") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 24) (insn "jal x0, base_handler") (writes)
    (derivation "BASE slot: the synchronous trap's landing.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 25) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x000000000000000b")))
    (derivation "the BASE slot: ecall's cause 11 — the synchronous trap ignored the vector offset.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 26) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x000000008000003c")))
    (derivation "mepc is the ecall's own address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 27) (insn "addi x12, x12, 4") (writes (write (reg "x12") (value "0x0000000080000040")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "csrrw x0, mepc, x12") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 29) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 30) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002")))
    (derivation "the SSIP bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "csrrs x0, mideleg, x2") (writes)
    (derivation "mideleg[1] <- 1 FIRST — SSI is masked at M before it can pend there (MIE is 1 again from the return).") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 32) (insn "csrrs x0, mip, x2") (writes)
    (derivation "SSIP <- 1 — delegated, so M's taken-rule never sees it.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 33) (insn "csrrs x0, mie, x2") (writes)
    (derivation "SSIE <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 34) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "raw material for MPP.") (source "RVI-RV32I §1.1.4"))
  (step (n 35) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "mstatus.MPP = S.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 36) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus written.") (source "RVI-ZICSR §5.1.1"))
  (step (n 37) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x000000008000005c")))
    (derivation "x4 = this address.") (source "RVI-RV32I §1.1.4"))
  (step (n 38) (insn "addi x4, x4, 24") (writes (write (reg "x4") (value "0x0000000080000074")))
    (derivation "the S entry rides 24 bytes past this auipc (116 from the entry), inside the M table's unused slots.") (source "RVI-RV32I §1.1.4"))
  (step (n 39) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc = the S entry.") (source "RVI-ZICSR §5.1.1"))
  (step (n 40) (insn "mret") (writes)
    (derivation "enter S.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 41) (insn "addi x6, x0, 2") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "the S entry (riding the M table's unused slots): the SIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 42) (insn "csrrs x0, sstatus, x6") (writes)
    (derivation "SIE <- 1 through the S VIEW (mstatus is M-only from S).") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 43) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in S: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 44) (insn "jal x0, ssi_s_handler") (writes)
    (derivation "SBASE+4 slot: the vectored SSI delivery's landing.") (source "RVP-MACHINE §2.1.1.7; RVP-SUPERVISOR §11.1.1.2"))
  (step (n 45) (insn "csrrs x21, scause, x0") (writes (write (reg "x21") (value "0x8000000000000001")))
    (derivation "the SBASE+4 slot: the Interrupt bit with cause 1.") (source "RVP-MACHINE §2.1.1.7; RVP-SUPERVISOR §11.1.1.2"))
  (step (n 46) (insn "csrrs x22, sepc, x0") (writes (write (reg "x22") (value "0x000000008000007c")))
    (derivation "sepc is the un-fetched pc.") (source "RVP-SUPERVISOR §11.1.1.7"))
  (step (n 47) (insn "csrrc x0, sip, x2") (writes)
    (derivation "clear SSIP through the S view — SSIP is the pending bit software CAN clear from S.") (source "RVP-SUPERVISOR §11.1.1.4"))
  (step (n 48) (insn "csrrs x23, sepc, x0") (writes (write (reg "x23") (value "0x000000008000007c")))
    (derivation "step the resume address.") (source "RVP-SUPERVISOR §11.1.1.7"))
  (step (n 49) (insn "addi x23, x23, 4") (writes (write (reg "x23") (value "0x0000000080000080")))
    (derivation "sepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 50) (insn "csrrw x0, sepc, x23") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 51) (insn "sret") (writes)
    (derivation "the stack pops per SPP and pc <- sepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 52) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker.") (source "RVI-RV32I §1.1.4 #|end"))
)
