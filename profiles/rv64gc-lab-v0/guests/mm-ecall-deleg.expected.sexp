;; mm-ecall-deleg.expected.sexp — the expected observations for `mm-ecall-deleg.s` (P4-SYSTEM.2
;; slice f, the mode-matrix corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py mm-ecall-deleg.expected.sexp schema/expectations.sexp

(expectations (program "mm-ecall-deleg.s") (entry "0x0000000080000000") (instructions 56)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "auipc writes the instruction's own address (entry + 0x0).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 152") (writes (write (reg "x1") (value "0x0000000080000098")))
    (derivation "the delta 152 from the auipc's pc lands on the S-mode handler's first instruction at entry+0x98.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 2) (insn "csrrw x0, stvec, x1") (writes)
    (derivation "stvec is programmed to the S handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x000000008000000c")))
    (derivation "auipc writes the instruction's own address (entry + 0xc).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 4) (insn "addi x1, x1, 180") (writes (write (reg "x1") (value "0x00000000800000c0")))
    (derivation "the delta 180 from the auipc's pc lands on the M-mode handler's first instruction at entry+0xC0.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 5) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed to the M handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 6) (insn "addi x2, x0, 512") (writes (write (reg "x2") (value "0x0000000000000200")))
    (derivation "medeleg bit 9 (ecall from S) starts as 512.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x2, x2, 256") (writes (write (reg "x2") (value "0x0000000000000300")))
    (derivation "plus 256 = bit 8 (ecall from U): medeleg pattern 0x300.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "csrrw x0, medeleg, x2") (writes)
    (derivation "medeleg <- 0x300: both ecall kinds delegate to S; breakpoint does not.") (source "RVP-MACHINE §2.1.3.1 (medeleg)"))
  (step (n 9) (insn "csrrw x0, mstatus, x0") (writes)
    (derivation "mstatus <- 0 clears MPP to U.") (source "RVP-CSR (mstatus field table)"))
  (step (n 10) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000028")))
    (derivation "auipc writes the instruction's own address (entry + 0x28).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 11) (insn "addi x4, x4, 32") (writes (write (reg "x4") (value "0x0000000080000048")))
    (derivation "the delta 32 from the auipc's pc lands on the U-mode cell at entry+0x48.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 12) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x48.") (source "RVI-ZICSR §5.1.1"))
  (step (n 13) (insn "mret") (writes)
    (derivation "drop to U at the first cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 14) (insn "ecall") (writes)
    (derivation "ecall from U with medeleg bit 8 set: the trap is DELEGATED to S — scause 8, sepc the ecall's address, taken at stvec.") (source "RVP-SUPERVISOR §4.1.4 (scause); RVP-MACHINE §2.1.3.1 (delegation)"))
  (step (n 15) (insn "csrrs x8, scause, x0") (writes (write (reg "x8") (value "0x0000000000000008")))
    (derivation "the S handler observes scause 8 in the S CSR, not mcause.") (source "RVP-SUPERVISOR §4.1.4"))
  (step (n 16) (insn "csrrs x9, sepc, x0") (writes (write (reg "x9") (value "0x0000000080000048")))
    (derivation "sepc is the delegated ecall's own address.") (source "RVP-SUPERVISOR §4.1.3 (sepc)"))
  (step (n 17) (insn "addi x9, x9, 4") (writes (write (reg "x9") (value "0x000000008000004c")))
    (derivation "the S handler steps sepc past the ecall.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "csrrw x0, sepc, x9") (writes)
    (derivation "sepc <- entry+0x4C.") (source "RVI-ZICSR §5.1.1"))
  (step (n 19) (insn "sret") (writes)
    (derivation "sret returns to the trapped mode (SPP=U) at sepc.") (source "RVP-INSNS §4.2.2 (sret)"))
  (step (n 20) (insn "ebreak") (writes)
    (derivation "breakpoint is NOT in medeleg (bit 3 clear): the U-mode ebreak is taken in M with cause 3.") (source "RVP-MACHINE §2.1.3.1 (medeleg)"))
  (step (n 21) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 0 — x12 already holds 0, no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 22) (insn "beq x12, x0, dropS") (writes)
    (derivation "stage 0: branch to the drop-to-S sequence.") (source "RVI-RV32I §1.1.5"))
  (step (n 23) (insn "addi x12, x0, 1") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "the stage counter becomes 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 24) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 1.") (source "RVI-ZICSR §5.1.1"))
  (step (n 25) (insn "csrrs x10, mcause, x0") (writes (write (reg "x10") (value "0x0000000000000003")))
    (derivation "the M handler observes cause 3 (the undelegated breakpoint).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 26) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "the MPP=S pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 27) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "1 << 11 is the MPP field's S encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 28) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- 0x800: MPP=S.") (source "RVP-CSR (mstatus field table)"))
  (step (n 29) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x00000000800000fc")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 30) (insn "addi x4, x4, -116") (writes (write (reg "x4") (value "0x0000000080000088")))
    (derivation "the delta -116 lands on the S-mode ecall cell at entry+0x88.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 31) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x88.") (source "RVI-ZICSR §5.1.1"))
  (step (n 32) (insn "mret") (writes)
    (derivation "drop to S at the second cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 33) (insn "ecall") (writes)
    (derivation "ecall from S with medeleg bit 9 set: DELEGATED to S — scause 9, sepc the ecall's address.") (source "RVP-MACHINE §2.1.3.1 (delegation); RVP-SUPERVISOR §4.1.4"))
  (step (n 34) (insn "csrrs x8, scause, x0") (writes (write (reg "x8") (value "0x0000000000000009")))
    (derivation "the S handler's second visit observes scause 9.") (source "RVP-SUPERVISOR §4.1.4"))
  (step (n 35) (insn "csrrs x9, sepc, x0") (writes (write (reg "x9") (value "0x0000000080000088")))
    (derivation "sepc is the S-mode ecall's own address.") (source "RVP-SUPERVISOR §4.1.3"))
  (step (n 36) (insn "addi x9, x9, 4") (writes (write (reg "x9") (value "0x000000008000008c")))
    (derivation "the S handler steps sepc past the ecall.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "csrrw x0, sepc, x9") (writes)
    (derivation "sepc <- entry+0x8C.") (source "RVI-ZICSR §5.1.1"))
  (step (n 38) (insn "sret") (writes)
    (derivation "SPP was set to S by the delegation, so sret returns to S.") (source "RVP-INSNS §4.2.2 (sret)"))
  (step (n 39) (insn "ebreak") (writes)
    (derivation "the S-mode breakpoint: still not delegated (bit 3 clear), taken in M with cause 3.") (source "RVP-MACHINE §2.1.3.1 (medeleg)"))
  (step (n 40) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 1 — x12 already holds 1, no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 41) (insn "beq x12, x0, dropS") (writes)
    (derivation "stage 1: the first branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 42) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the comparison constant 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 43) (insn "beq x12, x13, doecall") (writes)
    (derivation "stage 1: branch to the M-mode ecall cell.") (source "RVI-RV32I §1.1.5"))
  (step (n 44) (insn "addi x12, x0, 2") (writes (write (reg "x12") (value "0x0000000000000002")))
    (derivation "the stage counter becomes 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 45) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 2.") (source "RVI-ZICSR §5.1.1"))
  (step (n 46) (insn "ecall") (writes)
    (derivation "ecall from M is NEVER delegated (medeleg only covers modes below M): taken in M with cause 11 despite medeleg=0x300.") (source "RVP-MACHINE §2.1.3.1 (delegation covers only modes less privileged than M)"))
  (step (n 47) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 2 — x12 already holds 2, no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 48) (insn "beq x12, x0, dropS") (writes)
    (derivation "stage 2: the first branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 49) (insn "addi x13, x0, 1") (writes)
    (derivation "the comparison constant 1 — x13 already holds 1, no change observed.") (source "RVI-RV32I §1.1.4"))
  (step (n 50) (insn "beq x12, x13, doecall") (writes)
    (derivation "stage 2: the second branch does not fire either — fall through.") (source "RVI-RV32I §1.1.5"))
  (step (n 51) (insn "csrrs x10, mcause, x0") (writes (write (reg "x10") (value "0x000000000000000b")))
    (derivation "the M handler's third visit observes cause 11: the M-mode ecall.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 52) (insn "csrrs x11, mepc, x0") (writes (write (reg "x11") (value "0x0000000080000114")))
    (derivation "mepc is the M-mode ecall's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 53) (insn "addi x11, x11, 4") (writes (write (reg "x11") (value "0x0000000080000118")))
    (derivation "the handler steps mepc past the ecall.") (source "RVI-RV32I §1.1.4"))
  (step (n 54) (insn "csrrw x0, mepc, x11") (writes)
    (derivation "mepc <- entry+0x118.") (source "RVI-ZICSR §5.1.1"))
  (step (n 55) (insn "mret") (writes)
    (derivation "the trap recorded MPP=M, so the return lands in M.") (source "RVP-INSNS §3.3.2 (mret)")))
