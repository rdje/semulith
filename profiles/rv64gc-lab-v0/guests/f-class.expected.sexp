;; f-class.expected.sexp — the expected observations for `f-class.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-class.expected.sexp schema/expectations.sexp

(expectations (program "f-class.s") (entry "0x0000000080000000") (instructions 35)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0xff800") (writes (write (reg "x5") (value "0xffffffffff800000")))
    (derivation "build the pattern 0xff800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 5) (insn "fclass.s x6, f1") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "fclass.s: the class mask 0x1; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 6) (insn "lui x5, 0xbf800") (writes (write (reg "x5") (value "0xffffffffbf800000")))
    (derivation "build the pattern 0xbf800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "fmv.w.x f2, x5") (writes)
    (derivation "fmv.w.x: f2 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 8) (insn "fclass.s x7, f2") (writes (write (reg "x7") (value "0x0000000000000002")))
    (derivation "fclass.s: the class mask 0x2; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 9) (insn "lui x5, 0x80000") (writes (write (reg "x5") (value "0xffffffff80000000")))
    (derivation "build the pattern 0x80000001 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0xffffffff80000001")))
    (derivation "… its low 12 bits (1).") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "fmv.w.x f3, x5") (writes)
    (derivation "fmv.w.x: f3 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 12) (insn "fclass.s x8, f3") (writes (write (reg "x8") (value "0x0000000000000004")))
    (derivation "fclass.s: the class mask 0x4; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 13) (insn "lui x5, 0x80000") (writes (write (reg "x5") (value "0xffffffff80000000")))
    (derivation "build the pattern 0x80000000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "fmv.w.x f4, x5") (writes)
    (derivation "fmv.w.x: f4 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 15) (insn "fclass.s x9, f4") (writes (write (reg "x9") (value "0x0000000000000008")))
    (derivation "fclass.s: the class mask 0x8; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 16) (insn "addi x5, x0, 0") (writes (write (reg "x5") (value "0x0000000000000000")))
    (derivation "the pattern 0x0.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "fmv.w.x f5, x5") (writes)
    (derivation "fmv.w.x: f5 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 18) (insn "fclass.s x10, f5") (writes (write (reg "x10") (value "0x0000000000000010")))
    (derivation "fclass.s: the class mask 0x10; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 19) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "the pattern 0x1.") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "fmv.w.x f6, x5") (writes)
    (derivation "fmv.w.x: f6 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 21) (insn "fclass.s x11, f6") (writes (write (reg "x11") (value "0x0000000000000020")))
    (derivation "fclass.s: the class mask 0x20; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 22) (insn "lui x5, 0x3f800") (writes (write (reg "x5") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "fmv.w.x f7, x5") (writes)
    (derivation "fmv.w.x: f7 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 24) (insn "fclass.s x12, f7") (writes (write (reg "x12") (value "0x0000000000000040")))
    (derivation "fclass.s: the class mask 0x40; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 25) (insn "lui x5, 0x7f800") (writes (write (reg "x5") (value "0x000000007f800000")))
    (derivation "build the pattern 0x7f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "fmv.w.x f8, x5") (writes)
    (derivation "fmv.w.x: f8 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 27) (insn "fclass.s x13, f8") (writes (write (reg "x13") (value "0x0000000000000080")))
    (derivation "fclass.s: the class mask 0x80; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 28) (insn "lui x5, 0x7fa00") (writes (write (reg "x5") (value "0x000000007fa00000")))
    (derivation "build the pattern 0x7fa00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "fmv.w.x f9, x5") (writes)
    (derivation "fmv.w.x: f9 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 30) (insn "fclass.s x14, f9") (writes (write (reg "x14") (value "0x0000000000000100")))
    (derivation "fclass.s: the class mask 0x100; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 31) (insn "lui x5, 0x7fc00") (writes (write (reg "x5") (value "0x000000007fc00000")))
    (derivation "build the pattern 0x7fc00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 32) (insn "fmv.w.x f10, x5") (writes)
    (derivation "fmv.w.x: f10 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 33) (insn "fclass.s x15, f10") (writes (write (reg "x15") (value "0x0000000000000200")))
    (derivation "fclass.s: the class mask 0x200; no flag.") (source "RVI-F §20.1.9 (Table 6)"))
  (step (n 34) (insn "csrrs x16, fflags, x0") (writes)
    (derivation "x16 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
