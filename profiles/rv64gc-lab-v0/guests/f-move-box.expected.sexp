;; f-move-box.expected.sexp — the expected observations for `f-move-box.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-move-box.expected.sexp schema/expectations.sexp

(expectations (program "f-move-box.s") (entry "0x0000000080000000") (instructions 21)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "fmv.x.w x6, f0") (writes)
    (derivation "fmv.x.w: the low 32 bits of f0, sign-extended: x6 = 0x0000000000000000.") (source "RVI-F §20.1.7"))
  (step (n 4) (insn "fsgnj.s f1, f0, f0") (writes)
    (derivation "fsgnj.s is NOT a transfer: f0 (reset 0 — the upper 32 bits are not all 1s) unboxes to the canonical NaN.") (source "RVI-D §21.1.2"))
  (step (n 5) (insn "fmv.x.w x7, f1") (writes (write (reg "x7") (value "0x000000007fc00000")))
    (derivation "fmv.x.w: the low 32 bits of f1, sign-extended: x7 = 0x000000007fc00000.") (source "RVI-F §20.1.7"))
  (step (n 6) (insn "lui x5, 0x7fa00") (writes (write (reg "x5") (value "0x000000007fa00000")))
    (derivation "build the pattern 0x7fa00001 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x000000007fa00001")))
    (derivation "… its low 12 bits (1).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "fmv.w.x f2, x5") (writes)
    (derivation "fmv.w.x: f2 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 9) (insn "fmv.x.w x8, f2") (writes (write (reg "x8") (value "0x000000007fa00001")))
    (derivation "fmv.x.w: the low 32 bits of f2, sign-extended: x8 = 0x000000007fa00001.") (source "RVI-F §20.1.7"))
  (step (n 10) (insn "fsgnj.s f3, f2, f2") (writes)
    (derivation "sign injection does not canonicalize: the signaling payload survives.") (source "RVI-F §20.1.7"))
  (step (n 11) (insn "fmv.x.w x9, f3") (writes (write (reg "x9") (value "0x000000007fa00001")))
    (derivation "fmv.x.w: the low 32 bits of f3, sign-extended: x9 = 0x000000007fa00001.") (source "RVI-F §20.1.7"))
  (step (n 12) (insn "auipc x11, 0") (writes (write (reg "x11") (value "0x0000000080000030")))
    (derivation "x11 = this instruction's own address, inside the program region.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 13) (insn "addi x11, x11, 1024") (writes (write (reg "x11") (value "0x0000000080000430")))
    (derivation "1 KiB further: a word-aligned data address past the code, inside the 64 KiB region.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "fsw f2, 0, x11") (writes)
    (derivation "fsw: the low 32 bits of f2 to 0x0000000080000430 (the upper FLEN-32 ignored).") (source "RVI-F §20.1.5; RVI-D §21.1.2"))
  (step (n 15) (insn "lw x12, x11, 0") (writes (write (reg "x12") (value "0x000000007fa00001")))
    (derivation "the stored word reads back through the integer side, sign-extended.") (source "RVI-RV64I §3.1.3"))
  (step (n 16) (insn "flw f4, x11, 0") (writes)
    (derivation "flw: f4 <- the word 0x7fa00001 NaN-boxed (bits unmodified).") (source "RVI-F §20.1.5; RVI-D §21.1.2"))
  (step (n 17) (insn "fmv.x.w x13, f4") (writes (write (reg "x13") (value "0x000000007fa00001")))
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x13 = 0x000000007fa00001.") (source "RVI-F §20.1.7"))
  (step (n 18) (insn "lui x14, 0xbf800") (writes (write (reg "x14") (value "0xffffffffbf800000")))
    (derivation "build the pattern 0xbf800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "fmv.w.x f5, x14") (writes)
    (derivation "fmv.w.x: f5 <- x14's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 20) (insn "fmv.x.w x15, f5") (writes (write (reg "x15") (value "0xffffffffbf800000")))
    (derivation "fmv.x.w: the low 32 bits of f5, sign-extended: x15 = 0xffffffffbf800000.") (source "RVI-F §20.1.7"))
)
