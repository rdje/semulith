;; m-word.expected.sexp — the expected observations for `m-word.s` (P4-SYSTEM.11,
;; the M corpus). EVD-05: every value below was derived from the pinned chapter (RVI-M
;; §11.1, Table 1's rows by name) with exact integers by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py m-word.expected.sexp schema/expectations.sexp

(expectations (program "m-word.s") (entry "0x0000000080000000") (instructions 32)
  (step (n 0) (insn "lui x5, 0x12345") (writes (write (reg "x5") (value "0x0000000012345000")))
    (derivation "garbage for the HIGH word of the first operand …") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x5, x5, 0x678") (writes (write (reg "x5") (value "0x0000000012345678")))
    (derivation "… 0x12345678 …") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x1234567800000000")))
    (derivation "… moved to bits 63..32.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 3) (insn "addi x7, x0, -7") (writes (write (reg "x7") (value "0xfffffffffffffff9")))
    (derivation "the low word to carry: -7 …") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x7, x7, 32") (writes (write (reg "x7") (value "0xfffffff900000000")))
    (derivation "… its low 32 bits isolated: up …") (source "RVI-RV64I §3.1.2.1"))
  (step (n 5) (insn "srli x7, x7, 32") (writes (write (reg "x7") (value "0x00000000fffffff9")))
    (derivation "… and back down, zero-filled: 0xfffffff9.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 6) (insn "or x5, x5, x7") (writes (write (reg "x5") (value "0x12345678fffffff9")))
    (derivation "x5 = 0x12345678_fffffff9: as a WORD it is -7.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "lui x6, 0x2bcdf") (writes (write (reg "x6") (value "0x000000002bcdf000")))
    (derivation "garbage for the high word of the second operand …") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "addi x6, x6, -255") (writes (write (reg "x6") (value "0x000000002bcdef01")))
    (derivation "… 0x2bcdef01 …") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "slli x6, x6, 32") (writes (write (reg "x6") (value "0x2bcdef0100000000")))
    (derivation "… in bits 63..32 …") (source "RVI-RV64I §3.1.2.1"))
  (step (n 10) (insn "addi x6, x6, 2") (writes (write (reg "x6") (value "0x2bcdef0100000002")))
    (derivation "… and the low word 2: x6 = 0x2bcdef01_00000002.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "mulw x8, x5, x6") (writes (write (reg "x8") (value "0xfffffffffffffff2")))
    (derivation "the low 32 bits only: -7 x 2 = -14, sign-extended: 0xfffffffffffffff2.") (source "RVI-M §11.1.1"))
  (step (n 12) (insn "divw x9, x5, x6") (writes (write (reg "x9") (value "0xfffffffffffffffd")))
    (derivation "-7 / 2 as 32-bit signed words, towards zero, sign-extended: 0xfffffffffffffffd.") (source "RVI-M §11.1.2"))
  (step (n 13) (insn "remw x10, x5, x6") (writes (write (reg "x10") (value "0xffffffffffffffff")))
    (derivation "… the 32-bit remainder, sign-extended: 0xffffffffffffffff.") (source "RVI-M §11.1.2"))
  (step (n 14) (insn "divuw x11, x5, x6") (writes (write (reg "x11") (value "0x000000007ffffffc")))
    (derivation "0xfffffff9 / 2 as UNSIGNED words: 0x000000007ffffffc (bit 31 clear).") (source "RVI-M §11.1.2"))
  (step (n 15) (insn "remuw x12, x5, x6") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "… the unsigned word remainder 0x0000000000000001.") (source "RVI-M §11.1.2"))
  (step (n 16) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "a divisor whose LOW WORD is zero: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "slli x13, x13, 32") (writes (write (reg "x13") (value "0x0000000100000000")))
    (derivation "… << 32 = 2^32 - nonzero as XLEN, zero as a word.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 18) (insn "divw x14, x5, x13") (writes (write (reg "x14") (value "0xffffffffffffffff")))
    (derivation "a WORD division by zero: Table 1 at L = 32 - all bits set, sign-extended: 0xffffffffffffffff.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 19) (insn "divuw x15, x5, x13") (writes (write (reg "x15") (value "0xffffffffffffffff")))
    (derivation "unsigned: 2^32 - 1, sign-extended: 0xffffffffffffffff.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 20) (insn "remw x16, x5, x13") (writes (write (reg "x16") (value "0xfffffffffffffff9")))
    (derivation "the remainder is the dividend's word, sign-extended - including on a divide by zero: 0xfffffffffffffff9.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 21) (insn "remuw x17, x5, x13") (writes (write (reg "x17") (value "0xfffffffffffffff9")))
    (derivation "… REMUW sign-extends it too: 0xfffffffffffffff9.") (source "RVI-M §11.1.2"))
  (step (n 22) (insn "lui x18, 0x80000") (writes (write (reg "x18") (value "0xffffffff80000000")))
    (derivation "the most-negative WORD, -2^31, sign-extended.") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "addi x19, x0, -1") (writes (write (reg "x19") (value "0xffffffffffffffff")))
    (derivation "the divisor -1.") (source "RVI-RV32I §1.1.4"))
  (step (n 24) (insn "divw x20, x18, x19") (writes (write (reg "x20") (value "0xffffffff80000000")))
    (derivation "WORD overflow, -2^31 / -1: the quotient equals the dividend, 0xffffffff80000000.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 25) (insn "addi x21, x0, 21") (writes (write (reg "x21") (value "0x0000000000000015")))
    (derivation "a sentinel the overflow remainder must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "remw x21, x18, x19") (writes (write (reg "x21") (value "0x0000000000000000")))
    (derivation "… the remainder zero: 0x0000000000000000.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 27) (insn "addi x22, x0, 1") (writes (write (reg "x22") (value "0x0000000000000001")))
    (derivation "the divisor 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "divuw x23, x19, x22") (writes (write (reg "x23") (value "0xffffffffffffffff")))
    (derivation "0xffffffff / 1 unsigned: the 32-bit quotient has bit 31 set, so it SIGN-extends: 0xffffffffffffffff.") (source "RVI-M §11.1.2"))
  (step (n 29) (insn "lui x24, 0x40000") (writes (write (reg "x24") (value "0x0000000040000000")))
    (derivation "2^30.") (source "RVI-RV32I §1.1.4"))
  (step (n 30) (insn "addi x25, x0, 2") (writes (write (reg "x25") (value "0x0000000000000002")))
    (derivation "2.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "mulw x26, x24, x25") (writes (write (reg "x26") (value "0xffffffff80000000")))
    (derivation "2^30 x 2 = 2^31 wraps to the most-negative word, sign-extended: 0xffffffff80000000.") (source "RVI-M §11.1.1"))
)
