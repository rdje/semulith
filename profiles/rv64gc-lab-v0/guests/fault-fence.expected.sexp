;; fault-fence.expected.sexp — the expected observations for `fault-fence.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-fence.expected.sexp schema/expectations.sexp

(comment "fault-fence.expected.sexp — the expected observations for `fault-fence.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The corrected D-FENCE: a reserved FENCE *configuration* is architecture-SPECIFIED" "behavior — execute as FENCE with fm=0000 — not the UNSPECIFIED reserved-instruction case. Every" "fence below is a nop on this profile (one hart, no devices, in-order), each measured to execute" "exactly so on both references, and the run retires into the step budget.")
(expectations (program "fault-fence.s") (entry "0x80000000") (instructions 8) (step (n 0) (insn "addi x1, x0, 1") (writes (write (reg "x1") (value "0x0000000000000001"))) (derivation "An ordinary write, so the fence nops sit inside a live run.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "fence 1, 15, 15, x0, x0") (writes) (derivation "fm = 1 is a reserved configuration, and the architecture SPECIFIES its behavior: base implementations shall treat all such reserved configurations as FENCE instructions (with fm = 0000) — so it decodes and executes as an ordinary fence, which on this profile has no observable effect. It does NOT fall under D-RESERVED-DECODE. Measured: both references execute it as a nop.") (source "RVI-RV32I §1.1.7 (the reserved-configurations mandate, verbatim) — decision D-FENCE, corrected by P2-SCALAR.3")) (step (n 2) (insn "fence 8, 3, 3, x0, x0") (writes) (derivation "FENCE.TSO (fm=1000) with pred=succ=RW: accepted and treated as FENCE RW,RW, which the specification states is correct — a nop on this profile. Measured on both references.") (source "RVI-RV32I §1.1.7, Table 3 (D-FENCE: FENCE.TSO as FENCE RW,RW is correct)")) (step (n 3) (insn "fence 0, 15, 15, x0, x1") (writes) (derivation "rd != x0: the unused rs1 and rd fields are reserved for finer-grain fences, and for forward compatibility base implementations shall IGNORE these fields — so it executes as an ordinary fence: a nop, and x1 keeps its step-0 value (the fence does not write it). Measured on both references.") (source "RVI-RV32I §1.1.7 (the forward-compatibility rule for rs1/rd); RVI-RV64I §3.1.4 Table 1 (a FENCE HINT code point — D-HINTS)")) (step (n 4) (insn "fence 0, 15, 15, x1, x0") (writes) (derivation "rs1 != x0: ignored for forward compatibility, exactly as step 3 — a nop.") (source "RVI-RV32I §1.1.7 (the forward-compatibility rule for rs1/rd)")) (step (n 5) (insn "fence 0, 0, 15, x0, x0") (writes) (derivation "pred = 0 is a HINT code point (fm=0, pred=0, succ!=0): it executes as a no-op and must not trap. Measured on both references.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS); RVI-RV32I §1.1.7 (reserved pred/succ configurations execute as FENCE fm=0000)")) (step (n 6) (insn "fence 0, 15, 0, x0, x0") (writes) (derivation "succ = 0, the mirror of step 5: a HINT code point, a no-op that must not trap. Measured on both references.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS); RVI-RV32I §1.1.7")) (step (n 7) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002"))) (derivation "The landing: the run retired every fence — a fence that trapped would end the trace before this write.") (source "RVI-RV32I §1.1.4")))
