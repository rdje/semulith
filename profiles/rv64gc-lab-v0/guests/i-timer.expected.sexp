;; i-timer.expected.sexp — spec-side observations for `i-timer.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-timer.expected.sexp schema/expectations.sexp

(expectations (program "i-timer.s") (entry "0x0000000080000000") (instructions 28) (fetches 54)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "lui x31, 0x80000") (writes (write (reg "x31") (value "0xffffffff80000000")))
    (derivation "the upper 20 bits land sign-extended in rd.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 1) (insn "csrrs x0, menvcfg, x31") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 2) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000008")))
    (derivation "auipc writes the instruction's own address plus the U-immediate.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 3) (insn "addi x1, x1, 68") (writes (write (reg "x1") (value "0x000000008000004c")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 5) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000020")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 6) (insn "addi x8, x0, 10") (writes (write (reg "x8") (value "0x000000000000000a")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "csrrw x0, stimecmp, x8") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 8) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000000")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 9) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000020")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 11) (insn "addi x15, x0, 1") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "slli x15, x15, 5") (writes (write (reg "x15") (value "0x0000000000000020")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 13) (insn "csrrs x0, mie, x15") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 14) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 16) (insn "addi x7, x0, 0") (writes)
    (derivation "pending interrupt 5 delivers in M before instruction fetch; EPC is this boundary PC, no retirement.") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3"))
  (step (n 17) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000005")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 18) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000040")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 19) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "slli x13, x13, 16") (writes (write (reg "x13") (value "0x0000000000010000")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 21) (insn "csrrw x0, stimecmp, x13") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 22) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x0000000080000040")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 23) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x0000000080000044")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 24) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 25) (insn "mret") (writes)
    (derivation "the privilege stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 26) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000000")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 27) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
)
