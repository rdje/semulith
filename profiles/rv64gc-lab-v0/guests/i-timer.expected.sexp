;; i-timer.expected.sexp — the expected observations for `i-timer.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-timer.expected.sexp schema/expectations.sexp

(expectations (program "i-timer.s") (entry "0x0000000080000000") (instructions 26) (fetches 25)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 68") (writes (write (reg "x1") (value "0x0000000080000044")))
    (derivation "the handler rides 68 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec programmed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000020")))
    (derivation "THE RESET QUIRK, observed: STIP reads 1 — time 3 >= stimecmp 0 (the bit is computed, not stored; it has read 1 since reset).") (source "RVP-SSTC 12.1; the .5 brief's pre-condition 1"))
  (step (n 4) (insn "addi x8, x0, 8") (writes (write (reg "x8") (value "0x0000000000000008")))
    (derivation "stimecmp's target: 8 — three boundaries past this write.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "csrrw x0, stimecmp, x8") (writes)
    (derivation "stimecmp <- 8 (time is 5 at this step's own head).") (source "RVP-SSTC 12.1"))
  (step (n 6) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000000")))
    (derivation "STIP <- 0 by computation (time 6 < 8): writing stimecmp ABOVE time disarms it.") (source "RVP-SUPERVISOR §11.1.1.12"))
  (step (n 7) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "one more boundary ticks by (time 7 at the next head).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000020")))
    (derivation "STIP <- 1 again (time 8 >= 8): the timer's arrival is time's, no MMIO.") (source "RVP-SSTC 12.1"))
  (step (n 9) (insn "addi x15, x0, 1") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "raw material for STIE's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "slli x15, x15, 5") (writes (write (reg "x15") (value "0x0000000000000020")))
    (derivation "x15 = 1 << 5.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 11) (insn "csrrs x0, mie, x15") (writes)
    (derivation "STIE <- 1 (MIE still clear: the boundaries pass STI by).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 12) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1: the next boundary takes STI.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 14) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the STI interrupt in M: xcause carries the Interrupt bit with cause 5, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 15) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000005")))
    (derivation "the handler observes the Interrupt bit with cause 5 (0x8000000000000005).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 16) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000038")))
    (derivation "mepc is the un-fetched pc.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 17) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "raw material for the high stimecmp value.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "slli x13, x13, 16") (writes (write (reg "x13") (value "0x0000000000010000")))
    (derivation "x13 = 0x10000, far above this guest's clock.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 19) (insn "csrrw x0, stimecmp, x13") (writes)
    (derivation "disarm the timer for good.") (source "RVP-SSTC 12.1"))
  (step (n 20) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x0000000080000038")))
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 21) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x000000008000003c")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 23) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 24) (insn "csrrs x7, mip, x0") (writes (write (reg "x7") (value "0x0000000000000000")))
    (derivation "resumed and disarmed (the handler wrote stimecmp high): STIP stays 0.") (source "RVP-SUPERVISOR §11.1.1.12"))
  (step (n 25) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker.") (source "RVI-RV32I §1.1.4 #|end"))
)
