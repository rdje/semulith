;; f-arith.expected.sexp — the expected observations for `f-arith.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-arith.expected.sexp schema/expectations.sexp

(expectations (program "f-arith.s") (entry "0x0000000080000000") (instructions 50)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3f800") (writes (write (reg "x5") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 5) (insn "lui x6, 0x40400") (writes (write (reg "x6") (value "0x0000000040400000")))
    (derivation "build the pattern 0x40400000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "fmv.w.x f2, x6") (writes)
    (derivation "fmv.w.x: f2 <- x6's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 7) (insn "fdiv.s f3, f1, f2, 0") (writes)
    (derivation "fdiv.s (RNE): 0x3eaaaaab; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 8) (insn "fmv.x.w x7, f3") (writes (write (reg "x7") (value "0x000000003eaaaaab")))
    (derivation "fmv.x.w: the low 32 bits of f3, sign-extended: x7 = 0x000000003eaaaaab.") (source "RVI-F §20.1.7"))
  (step (n 9) (insn "csrrs x8, fflags, x0") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "x8 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 10) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 11) (insn "fdiv.s f4, f1, f2, 1") (writes)
    (derivation "fdiv.s (RTZ): 0x3eaaaaaa; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 12) (insn "fmv.x.w x9, f4") (writes (write (reg "x9") (value "0x000000003eaaaaaa")))
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x9 = 0x000000003eaaaaaa.") (source "RVI-F §20.1.7"))
  (step (n 13) (insn "fdiv.s f4, f1, f2, 3") (writes)
    (derivation "fdiv.s (RUP): 0x3eaaaaab; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 14) (insn "fmv.x.w x10, f4") (writes (write (reg "x10") (value "0x000000003eaaaaab")))
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x10 = 0x000000003eaaaaab.") (source "RVI-F §20.1.7"))
  (step (n 15) (insn "fadd.s f5, f1, f2, 0") (writes)
    (derivation "fadd.s (RNE): 0x40800000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 16) (insn "fmv.x.w x11, f5") (writes (write (reg "x11") (value "0x0000000040800000")))
    (derivation "fmv.x.w: the low 32 bits of f5, sign-extended: x11 = 0x0000000040800000.") (source "RVI-F §20.1.7"))
  (step (n 17) (insn "fsub.s f6, f1, f2, 2") (writes)
    (derivation "fsub.s (RDN): 0xc0000000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 18) (insn "fmv.x.w x12, f6") (writes (write (reg "x12") (value "0xffffffffc0000000")))
    (derivation "fmv.x.w: the low 32 bits of f6, sign-extended: x12 = 0xffffffffc0000000.") (source "RVI-F §20.1.7"))
  (step (n 19) (insn "fmul.s f7, f2, f2, 4") (writes)
    (derivation "fmul.s (RMM): 0x41100000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 20) (insn "fmv.x.w x13, f7") (writes (write (reg "x13") (value "0x0000000041100000")))
    (derivation "fmv.x.w: the low 32 bits of f7, sign-extended: x13 = 0x0000000041100000.") (source "RVI-F §20.1.7"))
  (step (n 21) (insn "csrrs x14, fflags, x0") (writes (write (reg "x14") (value "0x0000000000000001")))
    (derivation "x14 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 22) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 23) (insn "fsqrt.s f8, f2, 0") (writes)
    (derivation "fsqrt.s (RNE): 0x3fddb3d7; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 24) (insn "fmv.x.w x15, f8") (writes (write (reg "x15") (value "0x000000003fddb3d7")))
    (derivation "fmv.x.w: the low 32 bits of f8, sign-extended: x15 = 0x000000003fddb3d7.") (source "RVI-F §20.1.7"))
  (step (n 25) (insn "fsqrt.s f8, f2, 3") (writes)
    (derivation "fsqrt.s (RUP): 0x3fddb3d8; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 26) (insn "fmv.x.w x16, f8") (writes (write (reg "x16") (value "0x000000003fddb3d8")))
    (derivation "fmv.x.w: the low 32 bits of f8, sign-extended: x16 = 0x000000003fddb3d8.") (source "RVI-F §20.1.7"))
  (step (n 27) (insn "csrrs x17, fflags, x0") (writes (write (reg "x17") (value "0x0000000000000001")))
    (derivation "x17 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 28) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 29) (insn "lui x18, 0x7f800") (writes (write (reg "x18") (value "0x000000007f800000")))
    (derivation "build the pattern 0x7f7fffff (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 30) (insn "addi x18, x18, -1") (writes (write (reg "x18") (value "0x000000007f7fffff")))
    (derivation "… its low 12 bits (-1).") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "fmv.w.x f9, x18") (writes)
    (derivation "fmv.w.x: f9 <- x18's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 32) (insn "fadd.s f10, f9, f9, 1") (writes)
    (derivation "MAX+MAX in RTZ: clamped to MAX — and STILL an overflow (the unbounded rounding exceeds MAX).") (source "IEEE 754-2008 §7.4; RVI-F §20.1.6"))
  (step (n 33) (insn "fmv.x.w x19, f10") (writes (write (reg "x19") (value "0x000000007f7fffff")))
    (derivation "fmv.x.w: the low 32 bits of f10, sign-extended: x19 = 0x000000007f7fffff.") (source "RVI-F §20.1.7"))
  (step (n 34) (insn "csrrs x20, fflags, x0") (writes (write (reg "x20") (value "0x0000000000000005")))
    (derivation "x20 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 35) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 36) (insn "fdiv.s f11, f1, f0, 0") (writes)
    (derivation "1 ÷ f0 — f0 unboxes to the canonical NaN, so the result is NaN, no flag.") (source "RVI-D §21.1.2"))
  (step (n 37) (insn "fmv.x.w x21, f11") (writes (write (reg "x21") (value "0x000000007fc00000")))
    (derivation "fmv.x.w: the low 32 bits of f11, sign-extended: x21 = 0x000000007fc00000.") (source "RVI-F §20.1.7"))
  (step (n 38) (insn "fmv.w.x f12, x0") (writes)
    (derivation "f12 = +0.0.") (source "RVI-F §20.1.7"))
  (step (n 39) (insn "fdiv.s f13, f1, f12, 0") (writes)
    (derivation "1 ÷ +0: +∞, divide-by-zero.") (source "RVI-F §20.1.6"))
  (step (n 40) (insn "fmv.x.w x22, f13") (writes (write (reg "x22") (value "0x000000007f800000")))
    (derivation "fmv.x.w: the low 32 bits of f13, sign-extended: x22 = 0x000000007f800000.") (source "RVI-F §20.1.7"))
  (step (n 41) (insn "csrrs x23, fflags, x0") (writes (write (reg "x23") (value "0x0000000000000008")))
    (derivation "x23 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 42) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 43) (insn "fsqrt.s f14, f5, 0") (writes)
    (derivation "fsqrt.s (RNE): 0x40000000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 44) (insn "fmv.x.w x24, f14") (writes (write (reg "x24") (value "0x0000000040000000")))
    (derivation "fmv.x.w: the low 32 bits of f14, sign-extended: x24 = 0x0000000040000000.") (source "RVI-F §20.1.7"))
  (step (n 45) (insn "lui x25, 0xbf800") (writes (write (reg "x25") (value "0xffffffffbf800000")))
    (derivation "build the pattern 0xbf800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 46) (insn "fmv.w.x f15, x25") (writes)
    (derivation "fmv.w.x: f15 <- x25's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 47) (insn "fsqrt.s f16, f15, 0") (writes)
    (derivation "√−1: invalid — the canonical NaN, NV.") (source "RVI-F §20.1.6"))
  (step (n 48) (insn "fmv.x.w x26, f16") (writes (write (reg "x26") (value "0x000000007fc00000")))
    (derivation "fmv.x.w: the low 32 bits of f16, sign-extended: x26 = 0x000000007fc00000.") (source "RVI-F §20.1.7"))
  (step (n 49) (insn "csrrs x27, fflags, x0") (writes (write (reg "x27") (value "0x0000000000000010")))
    (derivation "x27 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
