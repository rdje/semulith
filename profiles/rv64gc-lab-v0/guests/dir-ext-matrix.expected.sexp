;; dir-ext-matrix.expected.sexp — the expected observations for `dir-ext-matrix.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-ext-matrix.expected.sexp schema/expectations.sexp

(comment "dir-ext-matrix.expected.sexp — the expected observations for `dir-ext-matrix.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The matrix: a narrow store read back WIDER (the high bytes are zero — no sign" "propagation across widths; the read's width governs, D-LOAD-EXT), and a wide store read at a" "narrow HIGH lane whose top bit stands (the lane's value sign-extends). The lanes are" "little-endian (D-ENDIAN). Three steps carry EMPTY writes by the laboratory's declared" "visible-change vocabulary: the second `lui x2, 0x80000` reproduces the identical value, and the" "double-edge `lb`/`lh` re-read the lane values the word-edge steps already left in x5/x6 — a" "write that changes nothing is not recorded (state.sexp; the .1 lesson).")
(expectations (program "dir-ext-matrix.s") (entry "0x80000000") (instructions 35) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "pc + 0.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 96") (writes (write (reg "x1") (value "0x00000000800000A0"))) (derivation "&cell = entry+0xA0 — past the code, which ends at entry+0x8C.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "sd x0, 0, x1") (writes ) (derivation "The cell is explicitly zeroed — memory contents are not an entry-state promise (D-ENTRY-STATE covers registers).") (source "RVI-RV64I §3.1.3")) (step (n 3) (insn "addi x2, x0, 128") (writes (write (reg "x2") (value "0x0000000000000080"))) (derivation "0x80 — the byte sign edge.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "sb x2, 0, x1") (writes ) (derivation "SB writes the low 8 bits: cell.b0 <- 0x80; the rest of the cell stays zero.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT's store half)")) (step (n 5) (insn "lb x5, x1, 0") (writes (write (reg "x5") (value "0xFFFFFFFFFFFFFF80"))) (derivation "LB sign-extends the byte: bit 7 set → all-ones upper.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 6) (insn "lbu x6, x1, 0") (writes (write (reg "x6") (value "0x0000000000000080"))) (derivation "LBU zero-extends the same byte.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 7) (insn "lh x7, x1, 0") (writes (write (reg "x7") (value "0x0000000000000080"))) (derivation "The wider read assembles b0|b1 = 0x80|0x00 little-endian → 0x0080; its top bit (15) is clear — NO sign propagation across widths.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT); D-ENDIAN")) (step (n 8) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000080"))) (derivation "0x00000080, top bit (31) clear.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 9) (insn "ld x9, x1, 0") (writes (write (reg "x9") (value "0x0000000000000080"))) (derivation "0x80, full width.") (source "RVI-RV64I §3.1.3")) (step (n 10) (insn "sd x0, 0, x1") (writes ) (derivation "Re-zero before the halfword edge.") (source "RVI-RV64I §3.1.3")) (step (n 11) (insn "lui x2, 8") (writes (write (reg "x2") (value "0x0000000000008000"))) (derivation "LUI: 8 << 12 = 0x8000; the immediate's bit 19 is clear, so the sign extension is positive.") (source "RVI-RV32I §1.1.4; RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 12) (insn "sh x2, 0, x1") (writes ) (derivation "SH writes the low 16 bits: cell <- bytes 00 80 00 …") (source "RVI-RV32I §1.1.6")) (step (n 13) (insn "lb x5, x1, 0") (writes (write (reg "x5") (value "0x0000000000000000"))) (derivation "b0 = 0x00 → 0 (a change from step 5's FF…80, so the vocabulary records it).") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 14) (insn "lb x6, x1, 1") (writes (write (reg "x6") (value "0xFFFFFFFFFFFFFF80"))) (derivation "THE HIGH LANE'S SIGN: b1 = 0x80, bit 7 set → sign-extended. The stored halfword's sign lives in its high byte; only the narrow read of THAT lane sees it.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT); D-ENDIAN")) (step (n 15) (insn "lhu x7, x1, 0") (writes (write (reg "x7") (value "0x0000000000008000"))) (derivation "LHU zero-extends 0x8000.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 16) (insn "lh x8, x1, 0") (writes (write (reg "x8") (value "0xFFFFFFFFFFFF8000"))) (derivation "LH sign-extends 0x8000 (bit 15 set).") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 17) (insn "lw x9, x1, 0") (writes (write (reg "x9") (value "0x0000000000008000"))) (derivation "0x00008000 — the wider read's top bit (31) is clear.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 18) (insn "ld x10, x1, 0") (writes (write (reg "x10") (value "0x0000000000008000"))) (derivation "Full width.") (source "RVI-RV64I §3.1.3")) (step (n 19) (insn "sd x0, 0, x1") (writes ) (derivation "Re-zero before the word edge.") (source "RVI-RV64I §3.1.3")) (step (n 20) (insn "lui x2, 0x80000") (writes (write (reg "x2") (value "0xFFFFFFFF80000000"))) (derivation "LUI's immediate bit 19 IS set: 0x80000 << 12 sign-extends to 0xFFFFFFFF80000000. The store keeps the low 32 bits.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 21) (insn "sw x2, 0, x1") (writes ) (derivation "SW writes the low 32 bits: cell <- 00 00 00 80 00 …") (source "RVI-RV32I §1.1.6")) (step (n 22) (insn "lb x5, x1, 3") (writes (write (reg "x5") (value "0xFFFFFFFFFFFFFF80"))) (derivation "b3 = 0x80 — the stored word's sign byte is lane 3.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT); D-ENDIAN")) (step (n 23) (insn "lh x6, x1, 2") (writes (write (reg "x6") (value "0xFFFFFFFFFFFF8000"))) (derivation "The high HALF (b2|b3 = 0x8000) sign-extends.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT)")) (step (n 24) (insn "lwu x7, x1, 0") (writes (write (reg "x7") (value "0x0000000080000000"))) (derivation "LWU zero-extends the word — the RV64-only form.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 25) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0xFFFFFFFF80000000"))) (derivation "LW sign-extends 0x80000000 (bit 31 set).") (source "RVI-RV64I §3.1.3")) (step (n 26) (insn "ld x9, x1, 0") (writes (write (reg "x9") (value "0x0000000080000000"))) (derivation "Full width — no extension exists at XLEN.") (source "RVI-RV64I §3.1.3")) (step (n 27) (insn "lui x2, 0x80000") (writes ) (derivation "The identical LUI — x2 already holds 0xFFFFFFFF80000000 from step 20, so the visible-change vocabulary records NOTHING (the write changes no state).") (source "state.sexp's reset declaration — the .1 lesson")) (step (n 28) (insn "slli x2, x2, 32") (writes (write (reg "x2") (value "0x8000000000000000"))) (derivation "0xFFFFFFFF80000000 << 32 (6-bit shamt) = 0x8000000000000000 modulo 2^64.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT)")) (step (n 29) (insn "sd x2, 0, x1") (writes ) (derivation "The full-width store: cell <- 0x8000000000000000 (no re-zero needed).") (source "RVI-RV64I §3.1.3")) (step (n 30) (insn "lb x5, x1, 7") (writes ) (derivation "b7 = 0x80 → 0xFF…FF80 — the SAME value step 22 left in x5: no visible change, empty writes (the value is still derived; the vocabulary has nothing to record).") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT); state.sexp")) (step (n 31) (insn "lh x6, x1, 6") (writes ) (derivation "b6|b7 = 0x8000 → 0xFFFF8000 — again the value step 23 left in x6: empty writes.") (source "RVI-RV32I §1.1.6 (D-LOAD-EXT); state.sexp")) (step (n 32) (insn "lw x7, x1, 4") (writes (write (reg "x7") (value "0xFFFFFFFF80000000"))) (derivation "The high WORD (b4..b7 = 0x80000000) sign-extends — x7 changes from 0x80000000, so the vocabulary records it.") (source "RVI-RV64I §3.1.3")) (step (n 33) (insn "ld x8, x1, 0") (writes (write (reg "x8") (value "0x8000000000000000"))) (derivation "The stored double itself.") (source "RVI-RV64I §3.1.3")) (step (n 34) (insn "addi x11, x0, 1") (writes (write (reg "x11") (value "0x0000000000000001"))) (derivation "The landing: the whole matrix retired without a trap.") (source "RVI-RV32I §1.1.4")))
