;; d-move.expected.sexp — the expected observations for `d-move.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-move.expected.sexp schema/expectations.sexp

(expectations (program "d-move.s") (entry "0x0000000080000000") (instructions 26)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x7ff40") (writes (write (reg "x5") (value "0x000000007ff40000")))
    (derivation "build 0x7ff4000000000123: the upper word 0x7ff40000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x7ff4000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "addi x28, x0, 291") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "the lower word 0x00000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000012300000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 7) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 8) (insn "or x5, x5, x28") (writes (write (reg "x5") (value "0x7ff4000000000123")))
    (derivation "x5 = 0x7ff4000000000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 10) (insn "fmv.x.d x6, f1") (writes (write (reg "x6") (value "0x7ff4000000000123")))
    (derivation "fmv.x.d: f1's 64 bits, unmodified: x6 = 0x7ff4000000000123.") (source "RVI-D §21.1.5"))
  (step (n 11) (insn "auipc x11, 0") (writes (write (reg "x11") (value "0x000000008000002c")))
    (derivation "x11 = this instruction's own address, inside the program region.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 12) (insn "addi x11, x11, 1024") (writes (write (reg "x11") (value "0x000000008000042c")))
    (derivation "1 KiB further: a data address past the code, inside the 64 KiB region.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "andi x11, x11, -8") (writes (write (reg "x11") (value "0x0000000080000428")))
    (derivation "… rounded down to a doubleword boundary (FLD/FSD are naturally aligned here).") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "fsd f1, 0, x11") (writes)
    (derivation "the signaling payload stored unmodified.") (source "RVI-D §21.1.3"))
  (step (n 15) (insn "ld x7, x11, 0") (writes (write (reg "x7") (value "0x7ff4000000000123")))
    (derivation "the stored doubleword reads back through the integer side.") (source "RVI-RV64I §3.1.3"))
  (step (n 16) (insn "fld f2, x11, 0") (writes)
    (derivation "loaded back unmodified — no canonicalization.") (source "RVI-D §21.1.3"))
  (step (n 17) (insn "fmv.x.d x8, f2") (writes (write (reg "x8") (value "0x7ff4000000000123")))
    (derivation "fmv.x.d: f2's 64 bits, unmodified: x8 = 0x7ff4000000000123.") (source "RVI-D §21.1.5"))
  (step (n 18) (insn "lui x9, 0x3f800") (writes (write (reg "x9") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "fmv.w.x f3, x9") (writes)
    (derivation "fmv.w.x: f3 <- x9's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 20) (insn "fmv.x.d x10, f3") (writes (write (reg "x10") (value "0xffffffff3f800000")))
    (derivation "fmv.x.d: f3's 64 bits, unmodified: x10 = 0xffffffff3f800000.") (source "RVI-D §21.1.5"))
  (step (n 21) (insn "fsgnj.d f4, f3, f3") (writes)
    (derivation "the boxed single is a negative quiet NaN as a double; sign injection keeps its bits.") (source "RVI-D §21.1.2"))
  (step (n 22) (insn "fmv.x.d x12, f4") (writes (write (reg "x12") (value "0xffffffff3f800000")))
    (derivation "fmv.x.d: f4's 64 bits, unmodified: x12 = 0xffffffff3f800000.") (source "RVI-D §21.1.5"))
  (step (n 23) (insn "fclass.d x13, f3") (writes (write (reg "x13") (value "0x0000000000000200")))
    (derivation "the boxed single classifies as a quiet NaN at format 64.") (source "RVI-D §21.1.7"))
  (step (n 24) (insn "fmv.x.w x14, f1") (writes (write (reg "x14") (value "0x0000000000000123")))
    (derivation "the low 32 bits of the double, sign-extended: a narrower transfer ignores the upper bits.") (source "RVI-D §21.1.2"))
  (step (n 25) (insn "csrrs x15, fflags, x0") (writes)
    (derivation "x15 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
