;; it-prio-jump.expected.sexp — the expected observations for `it-prio-jump.s` (P2-SCALAR.4).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py it-prio-jump.expected.sexp schema/expectations.sexp

(comment "GC IALIGN=16 re-derivation: the historical base-profile basename is retained. Current annotations describe the legal jump/link and declared budget; base IALIGN=32 trap/reference claims do not transfer.")
(expectations (program "it-prio-jump.s") (entry "0x80000000") (instructions 4) (fetches 7) (step (n 0) (insn "lui x1, 0x40000") (writes (write (reg "x1") (value "0x0000000040000000"))) (derivation "LUI forms 0x40000000. Bit 31 is clear, so RV64 sign extension leaves that value; it is outside the laboratory memory region.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)")) (step (n 1) (insn "addi x1, x1, 3") (writes (write (reg "x1") (value "0x0000000040000003"))) (derivation "Adding 3 forms 0x40000003. JALR will clear bit 0 of this sum, retaining bit 1 and producing the halfword-aligned target 0x40000002.") (source "RVI-RV32I §1.1.4.1/§1.1.5.1; RVI-C §27.1")) (step (n 2) (insn "jalr x5, x1, 0") (writes (write (reg "x5") (value "0x000000008000000C"))) (derivation "JALR at 0x80000008 completes with aligned target 0x40000002 and writes x5=pc+4=0x8000000c. Region membership is not checked until a fetch actually requests the target.") (source "RVI-RV32I §1.1.5.1; RVI-C §27.1"))  (step (n 3) (insn "<fetch fault>") (writes) (derivation "The next boundary fetches a parcel at unmapped 0x40000002 and delivers instruction-access-fault: cause 1, EPC/tval 0x40000002. It writes no GPR and leaves the completed JALR link intact. This is the seventh parcel request; the declared four-boundary budget then ends.") (source "RVP-MACHINE §2.1.1.14/§2.1.1.16; RVI-C §27.1"))
)
