;; sstc.expected.sexp — spec-side observations for `sstc.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py sstc.expected.sexp schema/expectations.sexp

(expectations (program "sstc.s") (entry "0x0000000080000000") (instructions 52) (fetches 104)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the handler's base: this instruction's own address, {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x1, x1, 116") (writes (write (reg "x1") (value "0x0000000080000074")))
    (derivation "the handler sits after the main body, at {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "direct-mode mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.5"))
  (step (n 3) (insn "addi x5, x0, -1") (writes (write (reg "x5") (value "0xffffffffffffffff")))
    (derivation "a sentinel the M-mode read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "csrrs x5, stimecmp, x0") (writes (write (reg "x5") (value "0x0000000000000000")))
    (derivation "in M, stimecmp is accessible with STCE and TM both clear; it resets to 0: {new}.") (source "RVP-SSTC §2.1 (stimecmp); the state document's reset"))
  (step (n 5) (insn "addi x6, x0, 1") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "slli x6, x6, 40") (writes (write (reg "x6") (value "0x0000010000000000")))
    (derivation "… at bit 40: a 64-bit compare value, {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 7) (insn "csrrw x0, stimecmp, x6") (writes)
    (derivation "M writes the supervisor timer compare; no GPR written.") (source "RVP-SSTC §2.1"))
  (step (n 8) (insn "addi x7, x0, -1") (writes (write (reg "x7") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read-back must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "csrrs x7, stimecmp, x0") (writes (write (reg "x7") (value "0x0000010000000000")))
    (derivation "stimecmp holds all 64 bits written: {new}.") (source "RVP-SSTC §2.1"))
  (step (n 10) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "… at bit 11: mstatus.MPP = S: {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 12) (insn "csrrs x0, mstatus, x3") (writes)
    (derivation "MPP <- S.") (source "RVI-ZICSR §5.1.1"))
  (step (n 13) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000034")))
    (derivation "the S-mode entry base: {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "addi x4, x4, 16") (writes (write (reg "x4") (value "0x0000000080000044")))
    (derivation "the instruction after mret: {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- the S-mode entry.") (source "RVI-ZICSR §5.1.1"))
  (step (n 16) (insn "mret") (writes)
    (derivation "drop to S at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 17) (insn "addi x8, x0, -1") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "a sentinel the first refused access must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "csrrs x8, stimecmp, x0") (writes)
    (derivation "S access with mcounteren.TM clear: illegal-instruction before any effect; the handler (visit 1) sets TM and returns.") (source "RVP-SSTC §2.1 (mcounteren.TM gates S access to stimecmp)"))
  (step (n 19) (insn "csrrs x30, mcause, x0") (writes (write (reg "x30") (value "0x0000000000000002")))
    (derivation "the handler: the cause, {new} (2, illegal-instruction).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 20) (insn "addi x27, x0, -1") (writes (write (reg "x27") (value "0xffffffffffffffff")))
    (derivation "a sentinel the flag read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "csrrs x27, mscratch, x0") (writes (write (reg "x27") (value "0x0000000000000000")))
    (derivation "the visit flag: 0 on the first visit, 1 on the second.") (source "RVP-MACHINE §2.1.1.3"))
  (step (n 22) (insn "bne x27, x0, second") (writes)
    (derivation "the second visit opens the second gate.") (source "RVI-RV32I §1.1.6"))
  (step (n 23) (insn "addi x28, x0, 2") (writes (write (reg "x28") (value "0x0000000000000002")))
    (derivation "bit 1: mcounteren.TM, {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 24) (insn "csrrs x0, mcounteren, x28") (writes)
    (derivation "visit 1: TM <- 1 (the first gate opens).") (source "RVP-MACHINE §2.1.1.11"))
  (step (n 25) (insn "addi x27, x0, 1") (writes (write (reg "x27") (value "0x0000000000000001")))
    (derivation "the flag's new value, {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "csrrw x0, mscratch, x27") (writes)
    (derivation "remember the visit.") (source "RVP-MACHINE §2.1.1.3"))
  (step (n 27) (insn "beq x0, x0, resume") (writes)
    (derivation "to the common return.") (source "RVI-RV32I §1.1.6"))
  (step (n 28) (insn "csrrs x29, mepc, x0") (writes (write (reg "x29") (value "0x0000000080000048")))
    (derivation "mepc is the refused instruction's own address: {new}.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 29) (insn "addi x29, x29, 4") (writes (write (reg "x29") (value "0x000000008000004c")))
    (derivation "step past it: {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 30) (insn "csrrw x0, mepc, x29") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 31) (insn "mret") (writes)
    (derivation "back to S at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 32) (insn "addi x30, x0, -1") (writes (write (reg "x30") (value "0xffffffffffffffff")))
    (derivation "a sentinel the handler's second cause read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "addi x9, x0, -1") (writes (write (reg "x9") (value "0xffffffffffffffff")))
    (derivation "a sentinel the second refused access must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 34) (insn "csrrs x9, stimecmp, x0") (writes)
    (derivation "S access with TM set but menvcfg.STCE clear: still illegal-instruction; the handler (visit 2) sets STCE and returns.") (source "RVP-SSTC §2.1 (menvcfg.STCE gates stimecmp outside M)"))
  (step (n 35) (insn "csrrs x30, mcause, x0") (writes (write (reg "x30") (value "0x0000000000000002")))
    (derivation "the handler: the cause, {new} (2, illegal-instruction).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 36) (insn "addi x27, x0, -1") (writes (write (reg "x27") (value "0xffffffffffffffff")))
    (derivation "a sentinel the flag read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "csrrs x27, mscratch, x0") (writes (write (reg "x27") (value "0x0000000000000001")))
    (derivation "the visit flag: 0 on the first visit, 1 on the second.") (source "RVP-MACHINE §2.1.1.3"))
  (step (n 38) (insn "bne x27, x0, second") (writes)
    (derivation "the second visit opens the second gate.") (source "RVI-RV32I §1.1.6"))
  (step (n 39) (insn "lui x28, 0x80000") (writes (write (reg "x28") (value "0xffffffff80000000")))
    (derivation "bit 63: menvcfg.STCE, {new} (LUI sign-extends to bit 63).") (source "RVI-RV64I §3.1.2.2"))
  (step (n 40) (insn "csrrs x0, menvcfg, x28") (writes)
    (derivation "visit 2: STCE <- 1 (the second gate opens).") (source "RVP-MACHINE §2.1.1.18; RVP-SSTC §2.1"))
  (step (n 41) (insn "csrrs x29, mepc, x0") (writes (write (reg "x29") (value "0x0000000080000054")))
    (derivation "mepc is the refused instruction's own address: {new}.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 42) (insn "addi x29, x29, 4") (writes (write (reg "x29") (value "0x0000000080000058")))
    (derivation "step past it: {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 43) (insn "csrrw x0, mepc, x29") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 44) (insn "mret") (writes)
    (derivation "back to S at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 45) (insn "addi x10, x0, -1") (writes (write (reg "x10") (value "0xffffffffffffffff")))
    (derivation "a sentinel the now-legal read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 46) (insn "csrrs x10, stimecmp, x0") (writes (write (reg "x10") (value "0x0000010000000000")))
    (derivation "with TM and STCE both set, S reads stimecmp: {new} — the value M wrote.") (source "RVP-SSTC §2.1"))
  (step (n 47) (insn "addi x11, x0, 1") (writes (write (reg "x11") (value "0x0000000000000001")))
    (derivation "1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 48) (insn "slli x11, x11, 41") (writes (write (reg "x11") (value "0x0000020000000000")))
    (derivation "… at bit 41: the kernel's own compare value, {new}.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 49) (insn "csrrw x0, stimecmp, x11") (writes)
    (derivation "the S-mode kernel programs its own timer — no M-mode round trip.") (source "RVP-SSTC §1 (the extension's purpose)"))
  (step (n 50) (insn "addi x12, x0, -1") (writes (write (reg "x12") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read-back must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 51) (insn "csrrs x12, stimecmp, x0") (writes (write (reg "x12") (value "0x0000020000000000")))
    (derivation "S reads back what it programmed: {new}.") (source "RVP-SSTC §2.1"))
)
