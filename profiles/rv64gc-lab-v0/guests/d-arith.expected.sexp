;; d-arith.expected.sexp — the expected observations for `d-arith.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-arith.expected.sexp schema/expectations.sexp

(expectations (program "d-arith.s") (entry "0x0000000080000000") (instructions 60)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "1.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "fcvt.d.w f1, x5, 0") (writes)
    (derivation "1.0, exactly.") (source "RVI-D §21.1.5"))
  (step (n 5) (insn "addi x6, x0, 3") (writes (write (reg "x6") (value "0x0000000000000003")))
    (derivation "3.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "fcvt.d.w f2, x6, 0") (writes)
    (derivation "3.0, exactly.") (source "RVI-D §21.1.5"))
  (step (n 7) (insn "fdiv.d f3, f1, f2, 0") (writes)
    (derivation "1/3 in RNE: inexact.") (source "RVI-D §21.1.4"))
  (step (n 8) (insn "fmv.x.d x7, f3") (writes (write (reg "x7") (value "0x3fd5555555555555")))
    (derivation "fmv.x.d: f3's 64 bits, unmodified: x7 = 0x3fd5555555555555.") (source "RVI-D §21.1.5"))
  (step (n 9) (insn "fdiv.d f4, f1, f2, 3") (writes)
    (derivation "1/3 in RUP: one ulp above RNE's result.") (source "RVI-D §21.1.4"))
  (step (n 10) (insn "fmv.x.d x8, f4") (writes (write (reg "x8") (value "0x3fd5555555555556")))
    (derivation "fmv.x.d: f4's 64 bits, unmodified: x8 = 0x3fd5555555555556.") (source "RVI-D §21.1.5"))
  (step (n 11) (insn "fadd.d f5, f1, f2, 0") (writes)
    (derivation "fadd.d (RNE): 0x4010000000000000; flags none.") (source "RVI-D §21.1.4"))
  (step (n 12) (insn "fmv.x.d x9, f5") (writes (write (reg "x9") (value "0x4010000000000000")))
    (derivation "fmv.x.d: f5's 64 bits, unmodified: x9 = 0x4010000000000000.") (source "RVI-D §21.1.5"))
  (step (n 13) (insn "fsub.d f6, f1, f1, 2") (writes)
    (derivation "1-1 in RDN: the exact zero is -0.") (source "RVI-D §21.1.4"))
  (step (n 14) (insn "fmv.x.d x10, f6") (writes (write (reg "x10") (value "0x8000000000000000")))
    (derivation "fmv.x.d: f6's 64 bits, unmodified: x10 = 0x8000000000000000.") (source "RVI-D §21.1.5"))
  (step (n 15) (insn "addi x11, x0, 2") (writes (write (reg "x11") (value "0x0000000000000002")))
    (derivation "2.") (source "RVI-RV32I §1.1.4"))
  (step (n 16) (insn "fcvt.d.w f7, x11, 0") (writes)
    (derivation "fcvt.d.w (RNE): 0x4000000000000000; flags none.") (source "RVI-D §21.1.5"))
  (step (n 17) (insn "fsqrt.d f8, f7, 0") (writes)
    (derivation "the square root of 2 in RNE.") (source "RVI-D §21.1.4"))
  (step (n 18) (insn "fmv.x.d x12, f8") (writes (write (reg "x12") (value "0x3ff6a09e667f3bcd")))
    (derivation "fmv.x.d: f8's 64 bits, unmodified: x12 = 0x3ff6a09e667f3bcd.") (source "RVI-D §21.1.5"))
  (step (n 19) (insn "csrrs x13, fflags, x0") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "x13 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 20) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 21) (insn "lui x14, 0x7ff00") (writes (write (reg "x14") (value "0x000000007ff00000")))
    (derivation "build 0x7fefffffffffffff: the upper word 0x7fefffff first.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "addi x14, x14, -1") (writes (write (reg "x14") (value "0x000000007fefffff")))
    (derivation "… its low 12 bits (-1).") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "slli x14, x14, 32") (writes (write (reg "x14") (value "0x7fefffff00000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 24) (insn "addi x28, x0, -1") (writes (write (reg "x28") (value "0xffffffffffffffff")))
    (derivation "the lower word 0xffffffff.") (source "RVI-RV32I §1.1.4"))
  (step (n 25) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0xffffffff00000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 26) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x00000000ffffffff")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 27) (insn "or x14, x14, x28") (writes (write (reg "x14") (value "0x7fefffffffffffff")))
    (derivation "x14 = 0x7fefffffffffffff.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "fmv.d.x f9, x14") (writes)
    (derivation "fmv.d.x: f9 <- x14's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 29) (insn "fmul.d f10, f9, f7, 1") (writes)
    (derivation "MAX×2 in RTZ: clamped to MAX — and an OVERFLOW (the magnitude rule).") (source "RVI-D §21.1.4"))
  (step (n 30) (insn "fmv.x.d x15, f10") (writes (write (reg "x15") (value "0x7fefffffffffffff")))
    (derivation "fmv.x.d: f10's 64 bits, unmodified: x15 = 0x7fefffffffffffff.") (source "RVI-D §21.1.5"))
  (step (n 31) (insn "csrrs x16, fflags, x0") (writes (write (reg "x16") (value "0x0000000000000005")))
    (derivation "x16 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 32) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 33) (insn "addi x17, x0, 0") (writes)
    (derivation "build 0x0000000000000001: the upper word 0x00000000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 34) (insn "slli x17, x17, 32") (writes)
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 35) (insn "addi x28, x0, 1") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "the lower word 0x00000001.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000100000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 37) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 38) (insn "or x17, x17, x28") (writes (write (reg "x17") (value "0x0000000000000001")))
    (derivation "x17 = 0x0000000000000001.") (source "RVI-RV32I §1.1.4"))
  (step (n 39) (insn "fmv.d.x f11, x17") (writes)
    (derivation "fmv.d.x: f11 <- x17's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 40) (insn "lui x18, 0x3fe00") (writes (write (reg "x18") (value "0x000000003fe00000")))
    (derivation "build 0x3fe0000000000000: the upper word 0x3fe00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 41) (insn "slli x18, x18, 32") (writes (write (reg "x18") (value "0x3fe0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 42) (insn "fmv.d.x f12, x18") (writes)
    (derivation "fmv.d.x: f12 <- x18's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 43) (insn "fmul.d f13, f11, f12, 0") (writes)
    (derivation "min subnormal × 0.5: a tie to the even zero — tiny and inexact, an UNDERFLOW.") (source "RVI-D §21.1.4"))
  (step (n 44) (insn "fmv.x.d x19, f13") (writes)
    (derivation "fmv.x.d: f13's 64 bits, unmodified: x19 = 0x0000000000000000.") (source "RVI-D §21.1.5"))
  (step (n 45) (insn "csrrs x20, fflags, x0") (writes (write (reg "x20") (value "0x0000000000000003")))
    (derivation "x20 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 46) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 47) (insn "fmv.d.x f14, x0") (writes)
    (derivation "+0.0.") (source "RVI-D §21.1.5"))
  (step (n 48) (insn "fdiv.d f15, f1, f14, 0") (writes)
    (derivation "1/+0: +∞ and DIVIDE-BY-ZERO.") (source "RVI-D §21.1.4"))
  (step (n 49) (insn "fmv.x.d x21, f15") (writes (write (reg "x21") (value "0x7ff0000000000000")))
    (derivation "fmv.x.d: f15's 64 bits, unmodified: x21 = 0x7ff0000000000000.") (source "RVI-D §21.1.5"))
  (step (n 50) (insn "lui x22, 0x7ff40") (writes (write (reg "x22") (value "0x000000007ff40000")))
    (derivation "build 0x7ff4000000000123: the upper word 0x7ff40000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 51) (insn "slli x22, x22, 32") (writes (write (reg "x22") (value "0x7ff4000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 52) (insn "addi x28, x0, 291") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "the lower word 0x00000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 53) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000012300000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 54) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 55) (insn "or x22, x22, x28") (writes (write (reg "x22") (value "0x7ff4000000000123")))
    (derivation "x22 = 0x7ff4000000000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 56) (insn "fmv.d.x f16, x22") (writes)
    (derivation "fmv.d.x: f16 <- x22's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 57) (insn "fadd.d f17, f16, f1, 0") (writes)
    (derivation "a signaling-NaN operand: the canonical NaN and INVALID.") (source "RVI-F §20.1.3"))
  (step (n 58) (insn "fmv.x.d x23, f17") (writes (write (reg "x23") (value "0x7ff8000000000000")))
    (derivation "fmv.x.d: f17's 64 bits, unmodified: x23 = 0x7ff8000000000000.") (source "RVI-D §21.1.5"))
  (step (n 59) (insn "csrrs x24, fflags, x0") (writes (write (reg "x24") (value "0x0000000000000018")))
    (derivation "x24 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
