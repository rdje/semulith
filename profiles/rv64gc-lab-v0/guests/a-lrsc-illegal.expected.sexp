;; a-lrsc-illegal.expected.sexp — the expected observations for `a-lrsc-illegal.s` (P4-SYSTEM.4
;; slice d, the atomics corpus). EVD-05: every value below was derived from the pinned
;; chapters and the declared deterministic SC policy (state.sexp) by the spec-side
;; authoring model BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py a-lrsc-illegal.expected.sexp schema/expectations.sexp

(expectations (program "a-lrsc-illegal.s") (entry "0x0000000080000000") (instructions 33)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 60") (writes (write (reg "x1") (value "0x000000008000003c")))
    (derivation "the handler rides 60 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "x10 = 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 5) (insn "addi x2, x10, 256") (writes (write (reg "x2") (value "0x0000000080000100")))
    (derivation "A, naturally aligned.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "addi x7, x0, 17") (writes (write (reg "x7") (value "0x0000000000000011")))
    (derivation "the initial word.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x6, x0, 42") (writes (write (reg "x6") (value "0x000000000000002a")))
    (derivation "a value no trapped step may store.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "sw x7, 0, x2") (writes)
    (derivation "A = 17.") (source "RVI-RV64I §3.1.3"))
  (step (n 9) (insn ".word 0x103120af") (writes)
    (derivation "an LR.W word with rs2=3 (the lr row's own 24..20=0 rule): NO row matches — delivered illegal-instruction, cause 2, xtval the word.") (source "D-RESERVED-DECODE; RVI-A §12.1.2"))
  (step (n 10) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x0000000000000002")))
    (derivation "the handler observes cause 2 (every visit).") (source "RVI-ZICSR §5.1.1"))
  (step (n 11) (insn "csrrs x12, mtval, x0") (writes (write (reg "x12") (value "0x00000000103120af")))
    (derivation "xtval is the offending WORD (the diagnostic policy's explicit act, one layer up).") (source "D-RESERVED-DECODE; RVP-MACHINE §2.1.1.16"))
  (step (n 12) (insn "csrrs x13, mepc, x0") (writes (write (reg "x13") (value "0x0000000080000024")))
    (derivation "xepc is the .word's own address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 13) (insn "addi x13, x13, 4") (writes (write (reg "x13") (value "0x0000000080000028")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "csrrw x0, mepc, x13") (writes)
    (derivation "write back the resume address.") (source "RVI-ZICSR §5.1.1"))
  (step (n 15) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 16) (insn ".word 0x2800a32f") (writes)
