  (step (n 17) (insn "csrrs x11, mcause, x0") (writes)
    (derivation "the handler observes cause 2 (every visit).") (source "RVI-ZICSR §5.1.1"))
  (step (n 18) (insn "csrrs x12, mtval, x0") (writes (write (reg "x12") (value "0x000000002800a32f")))
