;; sv39-translate-4k.expected.sexp — the expected observations for `sv39-translate-4k.s` (P4-SYSTEM.3
;; slice e, the sv39 corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py sv39-translate-4k.expected.sexp schema/expectations.sexp

(expectations (program "sv39-translate-4k.s") (entry "0x0000000080000000") (instructions 111) (never_written "x7") (never_written "x8") (never_written "x9")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the trap vector materializes pc-relative (auipc forms pc + 0; the addi carries the layout-audited delta).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 408") (writes (write (reg "x1") (value "0x0000000080000198")))
    (derivation "the trap vector materializes pc-relative (auipc forms pc + 0; the addi carries the layout-audited delta).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "the trap vector materializes pc-relative (auipc forms pc + 0; the addi carries the layout-audited delta).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 3) (insn "auipc x11, 0") (writes (write (reg "x11") (value "0x000000008000000c")))
    (derivation "one step of an auipc+addi chain materializing a 0x8000_xxxx address pc-relative (lui would sign-extend bit 19 of the upper half; the chain never exceeds +/-2047 per step).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 4) (insn "addi x11, x11, 2047") (writes (write (reg "x11") (value "0x000000008000080b")))
    (derivation "one step of an auipc+addi chain materializing a 0x8000_xxxx address pc-relative (lui would sign-extend bit 19 of the upper half; the chain never exceeds +/-2047 per step).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 5) (insn "addi x11, x11, 2037") (writes (write (reg "x11") (value "0x0000000080001000")))
    (derivation "one step of an auipc+addi chain materializing a 0x8000_xxxx address pc-relative (lui would sign-extend bit 19 of the upper half; the chain never exceeds +/-2047 per step).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 6) (insn "lui x10, 131073") (writes (write (reg "x10") (value "0x0000000020001000")))
