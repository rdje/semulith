;; f-rounding.expected.sexp — the expected observations for `f-rounding.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-rounding.expected.sexp schema/expectations.sexp

(expectations (program "f-rounding.s") (entry "0x0000000080000000") (instructions 41)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 holds this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 104") (writes (write (reg "x1") (value "0x0000000080000068")))
    (derivation "the trap handler sits at entry + 0x68 — after the 26-instruction main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec <- the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 5) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 6) (insn "lui x5, 0x3f800") (writes (write (reg "x5") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 8) (insn "lui x6, 0x40400") (writes (write (reg "x6") (value "0x0000000040400000")))
    (derivation "build the pattern 0x40400000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "fmv.w.x f2, x6") (writes)
    (derivation "fmv.w.x: f2 <- x6's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 10) (insn "addi x7, x0, 3") (writes (write (reg "x7") (value "0x0000000000000003")))
    (derivation "RUP is 3.") (source "RVI-F §20.1.2 (Table 2)"))
  (step (n 11) (insn "csrrw x0, frm, x7") (writes)
    (derivation "frm <- RUP.") (source "RVI-F §20.1.2"))
  (step (n 12) (insn "fdiv.s f3, f1, f2, 7") (writes)
    (derivation "rm = 111: DYN — rounds by frm (RUP).") (source "RVI-F §20.1.2"))
  (step (n 13) (insn "fmv.x.w x8, f3") (writes (write (reg "x8") (value "0x000000003eaaaaab")))
    (derivation "fmv.x.w: the low 32 bits of f3, sign-extended: x8 = 0x000000003eaaaaab.") (source "RVI-F §20.1.7"))
  (step (n 14) (insn "fdiv.s f4, f1, f2, 1") (writes)
    (derivation "a static RTZ overrides frm.") (source "RVI-F §20.1.2"))
  (step (n 15) (insn "fmv.x.w x9, f4") (writes (write (reg "x9") (value "0x000000003eaaaaaa")))
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x9 = 0x000000003eaaaaaa.") (source "RVI-F §20.1.7"))
  (step (n 16) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 17) (insn "fdiv.s f5, f1, f2, 5") (writes)
    (derivation "rm = 101 is a reserved static mode — reserved behavior, taken as illegal-instruction (cause 2, xtval the word); no flag accrues.") (source "RVI-F §20.1.2 (Table 2); the laboratory's illegal-instruction choice"))
  (step (n 18) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000002")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 19) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x0000000080000044")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 20) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x0000000080000048")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 22) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 23) (insn "fdiv.s f5, f1, f2, 6") (writes)
    (derivation "rm = 110 is a reserved static mode — reserved behavior, taken as illegal-instruction (cause 2, xtval the word); no flag accrues.") (source "RVI-F §20.1.2 (Table 2); the laboratory's illegal-instruction choice"))
  (step (n 24) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 25) (insn "csrrs x30, mepc, x0") (writes)
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 26) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x000000008000004c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 27) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 28) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 29) (insn "csrrs x10, fflags, x0") (writes)
    (derivation "x10 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 30) (insn "addi x11, x0, 7") (writes (write (reg "x11") (value "0x0000000000000007")))
    (derivation "the pattern 111.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "csrrw x0, frm, x11") (writes)
    (derivation "frm <- 111 (frm holds any 3-bit value — the FSRM sentence).") (source "RVI-F §20.1.2"))
  (step (n 32) (insn "fadd.s f6, f1, f2, 7") (writes)
    (derivation "rm = DYN with frm = 111, a reserved dynamic mode — reserved behavior, taken as illegal-instruction (cause 2, xtval the word); no flag accrues.") (source "RVI-F §20.1.2 (Table 2); the laboratory's illegal-instruction choice"))
  (step (n 33) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 34) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x0000000080000058")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 35) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x000000008000005c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 37) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 38) (insn "fadd.s f7, f1, f2, 0") (writes)
    (derivation "a static RNE is unaffected by frm's reserved value.") (source "RVI-F §20.1.2"))
  (step (n 39) (insn "fmv.x.w x12, f7") (writes (write (reg "x12") (value "0x0000000040800000")))
    (derivation "fmv.x.w: the low 32 bits of f7, sign-extended: x12 = 0x0000000040800000.") (source "RVI-F §20.1.7"))
  (step (n 40) (insn "csrrs x13, fcsr, x0") (writes (write (reg "x13") (value "0x00000000000000e0")))
    (derivation "fcsr: frm 111 above the flags.") (source "RVI-F §20.1.2 #|end"))
)
