;; scope-branch.expected.sexp — the expected observations for `scope-branch.s` (P2-SCALAR.1).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py scope-branch.expected.sexp schema/expectations.sexp

(comment "scope-branch.expected.sexp — the expected observations for `scope-branch.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). A taken branch adds its offset to the BRANCH's own address and writes no register;" "a branch that is not taken raises no exception and falls through. The five skipped addi" "instructions are the negative observations: x20..x24 must NEVER be written, which is what" "`docs/CPU_ENVIRONMENT.md` §4 asks a negative fixture to prove." "" "The program assembles to 24 words but executes 19 steps: each taken branch skips exactly one" "instruction. The step numbers below are EXECUTION steps, as in `guest-control`.")
(expectations (program "scope-branch.s") (entry "0x80000000") (instructions 19) (never_written "x20") (never_written "x21") (never_written "x22") (never_written "x23") (never_written "x24") (step (n 0) (insn "addi x1, x0, 5") (writes (write (reg "x1") (value "0x0000000000000005"))) (derivation "Setup: the value 5.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "addi x2, x0, 5") (writes (write (reg "x2") (value "0x0000000000000005"))) (derivation "Setup: a second register holding 5, so BEQ can compare equal operands.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "addi x3, x0, -1") (writes (write (reg "x3") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "Setup: -1 — the smallest signed value and the largest unsigned one, which is what makes the signed and unsigned branches answer oppositely on the same pair.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "beq x1, x2, l_blt") (writes) (derivation "TAKEN: x1 = x2 = 5, so control transfers to l_blt and the intervening addi never executes — x20 must never be written. The branch itself writes no register.") (source "RVI-RV32I §1.1.5.2 (BEQ; the offset is added to the branch's address)")) (step (n 4) (insn "beq x1, x3, l_blt2") (writes) (derivation "NOT taken: 5 != -1, so execution falls through to the addi below. A branch that is not taken raises no exception.") (source "RVI-RV32I §1.1.5.2")) (step (n 5) (insn "addi x4, x0, 1") (writes (write (reg "x4") (value "0x0000000000000001"))) (derivation "The fall-through write: had step 4's branch been wrongly taken, x4 would be missing.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "blt x3, x1, l_bge") (writes) (derivation "TAKEN: signed -1 < 5. x21 must never be written.") (source "RVI-RV32I §1.1.5.2 (BLT is the signed comparison)")) (step (n 7) (insn "blt x1, x3, l_bge2") (writes) (derivation "NOT taken: signed 5 < -1 is false.") (source "RVI-RV32I §1.1.5.2")) (step (n 8) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001"))) (derivation "The fall-through write for step 7.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "bge x1, x3, l_bltu") (writes) (derivation "TAKEN: signed 5 >= -1. x22 must never be written.") (source "RVI-RV32I §1.1.5.2 (BGE is the signed comparison)")) (step (n 10) (insn "bge x3, x1, l_bltu2") (writes) (derivation "NOT taken: signed -1 >= 5 is false.") (source "RVI-RV32I §1.1.5.2")) (step (n 11) (insn "addi x6, x0, 1") (writes (write (reg "x6") (value "0x0000000000000001"))) (derivation "The fall-through write for step 10.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "bltu x1, x3, l_bgeu") (writes) (derivation "TAKEN: unsigned 5 < 0xFFFFFFFFFFFFFFFF. The same operand pair that BLT answered on at step 7 — the unsigned read flips the answer, which is the signedness observation. x23 must never be written.") (source "RVI-RV32I §1.1.5.2 (BLTU is the unsigned comparison)")) (step (n 13) (insn "bltu x3, x1, l_bgeu2") (writes) (derivation "NOT taken: the largest unsigned value is not below 5.") (source "RVI-RV32I §1.1.5.2")) (step (n 14) (insn "addi x7, x0, 1") (writes (write (reg "x7") (value "0x0000000000000001"))) (derivation "The fall-through write for step 13.") (source "RVI-RV32I §1.1.4")) (step (n 15) (insn "bgeu x3, x1, l_end") (writes) (derivation "TAKEN: unsigned 0xFFFFFFFFFFFFFFFF >= 5 — BGE's exact opposite on the same pair (step 10). x24 must never be written.") (source "RVI-RV32I §1.1.5.2 (BGEU is the unsigned comparison)")) (step (n 16) (insn "bgeu x1, x3, l_done") (writes) (derivation "NOT taken: unsigned 5 >= 0xFFFFFFFFFFFFFFFF is false.") (source "RVI-RV32I §1.1.5.2")) (step (n 17) (insn "addi x8, x0, 1") (writes (write (reg "x8") (value "0x0000000000000001"))) (derivation "The fall-through write for step 16.") (source "RVI-RV32I §1.1.4")) (step (n 18) (insn "addi x9, x0, 1") (writes (write (reg "x9") (value "0x0000000000000001"))) (derivation "The end marker: reaching it proves every branch in the program transferred or fell through as the specification states — any wrong decision upstream lands control somewhere that never writes x9 here.") (source "RVI-RV32I §1.1.4")))
