;; a-lrsc-fault.expected.sexp — the expected observations for `a-lrsc-fault.s` (P4-SYSTEM.4
;; slice d, the atomics corpus). EVD-05: every value below was derived from the pinned
;; chapters and the declared deterministic SC policy (state.sexp) by the spec-side
;; authoring model BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py a-lrsc-fault.expected.sexp schema/expectations.sexp

(expectations (program "a-lrsc-fault.s") (entry "0x0000000080000000") (instructions 41)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 68") (writes (write (reg "x1") (value "0x0000000080000044")))
    (derivation "the handler rides 68 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "x10 = 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 5) (insn "addi x2, x10, 256") (writes (write (reg "x2") (value "0x0000000080000100")))
    (derivation "A, naturally aligned.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "addi x1, x10, 254") (writes (write (reg "x1") (value "0x00000000800000fe")))
    (derivation "A−2 — misaligned for a word access.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x7, x0, 17") (writes (write (reg "x7") (value "0x0000000000000011")))
    (derivation "the initial word.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "addi x6, x0, 42") (writes (write (reg "x6") (value "0x000000000000002a")))
    (derivation "the value every trapped step must NOT store.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "sw x7, 0, x2") (writes)
    (derivation "A = 17.") (source "RVI-RV64I §3.1.3"))
  (step (n 10) (insn "lr.w x5, (x1)") (writes)
    (derivation "a misaligned LR: the declared policy takes the LOAD access fault 5 (never the misaligned 4), judged before translation — the trap clears nothing.") (source "RVI-A §12.1.2; state.sexp's policy (decision 6)"))
  (step (n 11) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x0000000000000005")))
    (derivation "the handler observes the cause (5 for the LR, 7 for the SC/AMO visits).") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "csrrs x12, mtval, x0") (writes (write (reg "x12") (value "0x00000000800000fe")))
    (derivation "xtval is the faulting address.") (source "RVP-MACHINE §2.1.1.16"))
  (step (n 13) (insn "csrrs x13, mepc, x0") (writes (write (reg "x13") (value "0x0000000080000028")))
    (derivation "xepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 14) (insn "addi x13, x13, 4") (writes (write (reg "x13") (value "0x000000008000002c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "csrrw x0, mepc, x13") (writes)
    (derivation "write back the resume address.") (source "RVI-ZICSR §5.1.1"))
  (step (n 16) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 17) (insn "sc.w x9, x6, (x1)") (writes)
    (derivation "a misaligned SC: cause 7 likewise (the reservation was empty; nothing else changes).") (source "RVI-A §12.1.2; state.sexp's policy"))
  (step (n 18) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x0000000000000007")))
    (derivation "the handler observes the cause (5 for the LR, 7 for the SC/AMO visits).") (source "RVI-ZICSR §5.1.1"))
  (step (n 19) (insn "csrrs x12, mtval, x0") (writes)
    (derivation "xtval is the faulting address.") (source "RVP-MACHINE §2.1.1.16"))
  (step (n 20) (insn "csrrs x13, mepc, x0") (writes)
    (derivation "xepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 21) (insn "addi x13, x13, 4") (writes (write (reg "x13") (value "0x0000000080000030")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "csrrw x0, mepc, x13") (writes)
    (derivation "write back the resume address.") (source "RVI-ZICSR §5.1.1"))
  (step (n 23) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 24) (insn "amoadd.w x5, x6, (x1)") (writes)
    (derivation "a misaligned AMO: cause 7 likewise.") (source "RVI-A §12.1.4; state.sexp's policy"))
  (step (n 25) (insn "csrrs x11, mcause, x0") (writes)
    (derivation "the handler observes the cause (5 for the LR, 7 for the SC/AMO visits).") (source "RVI-ZICSR §5.1.1"))
  (step (n 26) (insn "csrrs x12, mtval, x0") (writes)
    (derivation "xtval is the faulting address.") (source "RVP-MACHINE §2.1.1.16"))
  (step (n 27) (insn "csrrs x13, mepc, x0") (writes)
    (derivation "xepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 28) (insn "addi x13, x13, 4") (writes (write (reg "x13") (value "0x0000000080000034")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "csrrw x0, mepc, x13") (writes)
    (derivation "write back the resume address.") (source "RVI-ZICSR §5.1.1"))
  (step (n 30) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 31) (insn "lr.w x5, (x2)") (writes (write (reg "x5") (value "0x0000000000000011")))
    (derivation "the survival cell: reserve A (aligned) — rd <- 17.") (source "RVI-A §12.1.2"))
  (step (n 32) (insn "sc.w x9, x6, (x1)") (writes)
    (derivation "the misaligned SC traps BEFORE the policy match: cause 7 — and the reservation SURVIVES (a trap is neither success nor failure).") (source "RVI-A §12.1.2; state.sexp's policy (decision 4)"))
  (step (n 33) (insn "csrrs x11, mcause, x0") (writes)
    (derivation "the handler observes the cause (5 for the LR, 7 for the SC/AMO visits).") (source "RVI-ZICSR §5.1.1"))
  (step (n 34) (insn "csrrs x12, mtval, x0") (writes)
    (derivation "xtval is the faulting address.") (source "RVP-MACHINE §2.1.1.16"))
  (step (n 35) (insn "csrrs x13, mepc, x0") (writes (write (reg "x13") (value "0x0000000080000038")))
    (derivation "xepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 36) (insn "addi x13, x13, 4") (writes (write (reg "x13") (value "0x000000008000003c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "csrrw x0, mepc, x13") (writes)
    (derivation "write back the resume address.") (source "RVI-ZICSR §5.1.1"))
  (step (n 38) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 39) (insn "sc.w x9, x6, (x2)") (writes)
    (derivation "proof: the surviving reservation still pairs — rd <- 0, A <- 42.") (source "RVI-A §12.1.2"))
  (step (n 40) (insn "lw x8, x2, 0") (writes (write (reg "x8") (value "0x000000000000002a")))
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3 #|end"))
)
