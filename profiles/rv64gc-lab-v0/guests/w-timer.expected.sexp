;; w-timer.expected.sexp — spec-side observations for `w-timer.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py w-timer.expected.sexp schema/expectations.sexp

(expectations (program "w-timer.s") (entry "0x0000000080000000") (instructions 25) (fetches 44)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "lui x31, 0x80000") (writes (write (reg "x31") (value "0xffffffff80000000")))
    (derivation "the upper 20 bits land sign-extended in rd.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 1) (insn "csrrs x0, menvcfg, x31") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 2) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000008")))
    (derivation "auipc writes the instruction's own address plus the U-immediate.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 3) (insn "addi x1, x1, 48") (writes (write (reg "x1") (value "0x0000000080000038")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 5) (insn "addi x8, x0, 15") (writes (write (reg "x8") (value "0x000000000000000f")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "csrrw x0, stimecmp, x8") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 7) (insn "addi x15, x0, 1") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x15, x15, 5") (writes (write (reg "x15") (value "0x0000000000000020")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 9) (insn "csrrs x0, mie, x15") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 10) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "wfi") (writes)
    (derivation "a LEGAL wfi: the hart ENTERS the wait (the nop latitude recorded-not-taken — decision 4); it retires the instruction and stalls, the wake evaluating at the next head.") (source "RVP-MACHINE §2.1.3.3; the .5 brief's decision 4"))
  (step (n 13) (insn "<halted>") (writes)
    (derivation "WAITING: no fetch or retirement; the declared time domain ticks once.") (source "RVP-MACHINE §2.1.3.3; the laboratory wait policy"))
  (step (n 14) (insn "<halted>") (writes)
    (derivation "WAITING: no fetch or retirement; the declared time domain ticks once.") (source "RVP-MACHINE §2.1.3.3; the laboratory wait policy"))
  (step (n 15) (insn "addi x9, x0, 42") (writes)
    (derivation "pending interrupt 5 delivers in M before instruction fetch; EPC is this boundary PC, no retirement.") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3"))
  (step (n 16) (insn "rdinstret x14") (writes (write (reg "x14") (value "0x000000000000000d")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 17) (insn "rdtime x13") (writes (write (reg "x13") (value "0x0000000000000011")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 18) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000005")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 19) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000034")))
    (derivation "atomic read and set bits; rs1=x0 does not write the CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "addi x16, x0, 1") (writes (write (reg "x16") (value "0x0000000000000001")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "slli x16, x16, 16") (writes (write (reg "x16") (value "0x0000000000010000")))
    (derivation "logical left shift.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 22) (insn "csrrw x0, stimecmp, x16") (writes)
    (derivation "atomic read/write CSR; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 23) (insn "mret") (writes)
    (derivation "the privilege stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 24) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the 12-bit immediate adds into rd.") (source "RVI-RV32I §1.1.4"))
)
