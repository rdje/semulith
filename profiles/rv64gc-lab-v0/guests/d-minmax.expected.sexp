;; d-minmax.expected.sexp — the expected observations for `d-minmax.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-minmax.expected.sexp schema/expectations.sexp

(expectations (program "d-minmax.s") (entry "0x0000000080000000") (instructions 32)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "fmv.d.x f1, x0") (writes)
    (derivation "f1 = +0.0.") (source "RVI-D §21.1.5"))
  (step (n 4) (insn "lui x5, 0x80000") (writes (write (reg "x5") (value "0xffffffff80000000")))
    (derivation "build 0x8000000000000000: the upper word 0x80000000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x8000000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 6) (insn "fmv.d.x f2, x5") (writes)
    (derivation "fmv.d.x: f2 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 7) (insn "fmin.d f3, f1, f2") (writes)
    (derivation "min(+0, -0) = -0.") (source "RVI-D §21.1.4"))
  (step (n 8) (insn "fmv.x.d x6, f3") (writes (write (reg "x6") (value "0x8000000000000000")))
    (derivation "fmv.x.d: f3's 64 bits, unmodified: x6 = 0x8000000000000000.") (source "RVI-D §21.1.5"))
  (step (n 9) (insn "fmax.d f4, f2, f1") (writes)
    (derivation "max(-0, +0) = +0.") (source "RVI-D §21.1.4"))
  (step (n 10) (insn "fmv.x.d x7, f4") (writes)
    (derivation "fmv.x.d: f4's 64 bits, unmodified: x7 = 0x0000000000000000.") (source "RVI-D §21.1.5"))
  (step (n 11) (insn "lui x8, 0x7ff80") (writes (write (reg "x8") (value "0x000000007ff80000")))
    (derivation "build 0x7ff8000000000000: the upper word 0x7ff80000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "slli x8, x8, 32") (writes (write (reg "x8") (value "0x7ff8000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 13) (insn "fmv.d.x f5, x8") (writes)
    (derivation "fmv.d.x: f5 <- x8's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 14) (insn "lui x9, 0x3ff00") (writes (write (reg "x9") (value "0x000000003ff00000")))
    (derivation "build 0x3ff0000000000000: the upper word 0x3ff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "slli x9, x9, 32") (writes (write (reg "x9") (value "0x3ff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 16) (insn "fmv.d.x f6, x9") (writes)
    (derivation "fmv.d.x: f6 <- x9's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 17) (insn "fmin.d f7, f5, f6") (writes)
    (derivation "one quiet NaN: the other operand, no flag.") (source "RVI-D §21.1.4"))
  (step (n 18) (insn "fmv.x.d x10, f7") (writes (write (reg "x10") (value "0x3ff0000000000000")))
    (derivation "fmv.x.d: f7's 64 bits, unmodified: x10 = 0x3ff0000000000000.") (source "RVI-D §21.1.5"))
  (step (n 19) (insn "csrrs x11, fflags, x0") (writes)
    (derivation "x11 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 20) (insn "lui x12, 0x7ff40") (writes (write (reg "x12") (value "0x000000007ff40000")))
    (derivation "build 0x7ff4000000000123: the upper word 0x7ff40000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "slli x12, x12, 32") (writes (write (reg "x12") (value "0x7ff4000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 22) (insn "addi x28, x0, 291") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "the lower word 0x00000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000012300000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 24) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 25) (insn "or x12, x12, x28") (writes (write (reg "x12") (value "0x7ff4000000000123")))
    (derivation "x12 = 0x7ff4000000000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "fmv.d.x f8, x12") (writes)
    (derivation "fmv.d.x: f8 <- x12's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 27) (insn "fmax.d f9, f8, f6") (writes)
    (derivation "a signaling NaN: the other operand — and INVALID.") (source "RVI-D §21.1.4"))
  (step (n 28) (insn "fmv.x.d x13, f9") (writes (write (reg "x13") (value "0x3ff0000000000000")))
    (derivation "fmv.x.d: f9's 64 bits, unmodified: x13 = 0x3ff0000000000000.") (source "RVI-D §21.1.5"))
  (step (n 29) (insn "fmin.d f10, f5, f8") (writes)
    (derivation "two NaNs: the canonical NaN.") (source "RVI-D §21.1.4"))
  (step (n 30) (insn "fmv.x.d x14, f10") (writes (write (reg "x14") (value "0x7ff8000000000000")))
    (derivation "fmv.x.d: f10's 64 bits, unmodified: x14 = 0x7ff8000000000000.") (source "RVI-D §21.1.5"))
  (step (n 31) (insn "csrrs x15, fflags, x0") (writes (write (reg "x15") (value "0x0000000000000010")))
    (derivation "x15 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
