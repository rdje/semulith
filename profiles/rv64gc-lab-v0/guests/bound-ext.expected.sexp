;; bound-ext.expected.sexp — the expected observations for `bound-ext.s` (P2-SCALAR.2).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py bound-ext.expected.sexp schema/expectations.sexp

(comment "bound-ext.expected.sexp — the expected observations for `bound-ext.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN." "`EVD-05` and `docs/EVIDENCE_AND_GATES.md` require it: an expected value copied out of a model's" "output tests that the model is self-consistent and nothing else. The `derivation` field on each" "step is the reasoning, and `source` is where in the pinned artifacts the rule is stated." "" "Sign/zero extension at the sign edges (D-LOAD-EXT): the byte edge 0x7F/0x80, the" "halfword edge 0x7FFF/0x8000 and the word edge 0x7FFFFFFF/0x80000000, each through" "the sign/zero PAIR at one address; the all-ones value at each width; the 0x00 byte" "observed through a pre-write; store truncation at values that differ from both" "clamping outcomes. 32 crossings, all aligned, all in-region, none faulted.")
(expectations (program "bound-ext.s") (entry "0x80000000") (instructions 47) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "One — raw material for the main-memory base.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 = 0x80000000 — the declared region's base.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "addi x1, x0, 0x7F") (writes (write (reg "x1") (value "0x000000000000007F"))) (derivation "0x7F: the largest positive signed byte.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "addi x2, x0, 0x80") (writes (write (reg "x2") (value "0x0000000000000080"))) (derivation "0x80: the most negative signed byte — the byte sign edge.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "addi x3, x0, -1") (writes (write (reg "x3") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "All ones: the all-ones value at every width.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "lui x4, 0x8") (writes (write (reg "x4") (value "0x0000000000008000"))) (derivation "0x8 << 12 = 0x8000 …") (source "RVI-RV64I §3.1.2.1")) (step (n 6) (insn "addi x4, x4, -1") (writes (write (reg "x4") (value "0x0000000000007FFF"))) (derivation "… minus 1 = 0x7FFF: the largest positive signed halfword.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "lui x5, 0x8") (writes (write (reg "x5") (value "0x0000000000008000"))) (derivation "0x8000: the most negative signed halfword — the halfword sign edge.") (source "RVI-RV64I §3.1.2.1")) (step (n 8) (insn "addi x6, x0, -1") (writes (write (reg "x6") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "All ones …") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "srli x6, x6, 33") (writes (write (reg "x6") (value "0x000000007FFFFFFF"))) (derivation "… >>> 33 = 0x7FFFFFFF: the largest positive signed word.") (source "RVI-RV64I §3.1.2.1")) (step (n 10) (insn "addi x7, x0, 1") (writes (write (reg "x7") (value "0x0000000000000001"))) (derivation "One …") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "slli x7, x7, 31") (writes (write (reg "x7") (value "0x0000000080000000"))) (derivation "… << 31 = 0x80000000: the most negative signed word — the word sign edge.") (source "RVI-RV64I §3.1.2.1")) (step (n 12) (insn "addi x8, x0, 0x180") (writes (write (reg "x8") (value "0x0000000000000180"))) (derivation "0x180: a value whose low byte (0x80) differs from BOTH clamping outcomes — truncation, not saturation, is what a store must do.") (source "RVI-RV32I §1.1.4")) (step (n 13) (insn "lui x9, 0xFFFF8") (writes (write (reg "x9") (value "0xFFFFFFFFFFFF8000"))) (derivation "0xFFFF8 << 12 sign-extends to 0xFFFFFFFFFFFF8000: -32768, whose low halfword is the sign edge 0x8000 and whose low word is 0xFFFF8000.") (source "RVI-RV64I §3.1.2.1")) (step (n 14) (insn "sb x1, 1024, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1024] = 0x7F. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 15) (insn "sb x2, 1025, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1025] = 0x80. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 16) (insn "sb x3, 1026, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1026] = 0xFF. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 17) (insn "sh x4, 1032, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1032..1033] = 0x7FFF. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 18) (insn "sh x5, 1034, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1034..1035] = 0x8000. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 19) (insn "sh x3, 1036, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1036..1037] = 0xFFFF. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 20) (insn "sw x6, 1040, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1040..1043] = 0x7FFFFFFF. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 21) (insn "sw x7, 1044, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1044..1047] = 0x80000000. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 22) (insn "sw x3, 1048, x10") (writes) (derivation "D-LOAD-EXT's store half: mem[1048..1051] = 0xFFFFFFFF. Stores write the low bits of rs2 and leave no register observation — the writes table is EMPTY; the crossing census carries the access.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 23) (insn "lb x11, x10, 1024") (writes (write (reg "x11") (value "0x000000000000007F"))) (derivation "byte 0x7F: bit 7 clear, so sign extension adds nothing.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 24) (insn "lb x12, x10, 1025") (writes (write (reg "x12") (value "0xFFFFFFFFFFFFFF80"))) (derivation "byte 0x80: bit 7 SET — the sign edge — so the upper 56 bits fill with ones.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 25) (insn "lbu x13, x10, 1025") (writes (write (reg "x13") (value "0x0000000000000080"))) (derivation "the SAME byte, zero-extended: 0x80. Steps lb/lbu at one address are the byte pair.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 26) (insn "lb x14, x10, 1026") (writes (write (reg "x14") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "byte 0xFF sign-extends to all ones.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 27) (insn "lbu x15, x10, 1026") (writes (write (reg "x15") (value "0x00000000000000FF"))) (derivation "the same byte zero-extends to 0xFF.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 28) (insn "lh x16, x10, 1032") (writes (write (reg "x16") (value "0x0000000000007FFF"))) (derivation "halfword 0x7FFF: bit 15 clear — no fill.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 29) (insn "lh x17, x10, 1034") (writes (write (reg "x17") (value "0xFFFFFFFFFFFF8000"))) (derivation "halfword 0x8000: bit 15 set — the halfword sign edge — ones fill above.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 30) (insn "lhu x18, x10, 1034") (writes (write (reg "x18") (value "0x0000000000008000"))) (derivation "the SAME halfword, zero-extended: 0x8000. The halfword pair.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 31) (insn "lh x19, x10, 1036") (writes (write (reg "x19") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "halfword 0xFFFF sign-extends to all ones.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 32) (insn "lhu x20, x10, 1036") (writes (write (reg "x20") (value "0x000000000000FFFF"))) (derivation "the same halfword zero-extends to 0xFFFF.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 33) (insn "lw x21, x10, 1040") (writes (write (reg "x21") (value "0x000000007FFFFFFF"))) (derivation "word 0x7FFFFFFF: bit 31 clear — no fill.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 34) (insn "lw x22, x10, 1044") (writes (write (reg "x22") (value "0xFFFFFFFF80000000"))) (derivation "word 0x80000000: bit 31 set — the word sign edge — ones fill the upper half.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 35) (insn "lwu x23, x10, 1044") (writes (write (reg "x23") (value "0x0000000080000000"))) (derivation "the SAME word, ZERO-extended (RV64 only): 0x0000000080000000. The word pair — a sign-extending LWU would answer 0xFFFFFFFF80000000.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 36) (insn "lw x24, x10, 1048") (writes (write (reg "x24") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "word 0xFFFFFFFF sign-extends to all ones.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 37) (insn "lwu x25, x10, 1048") (writes (write (reg "x25") (value "0x00000000FFFFFFFF"))) (derivation "the same word zero-extends to 0xFFFFFFFF.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 38) (insn "sb x0, 1027, x10") (writes) (derivation "x0 reads as zero, so mem[1027] = 0x00 — the byte value whose load result is invisible without a pre-write.") (source "RVI-RV32I §1.1.1 (x0 hardwired); RVI-RV64I §3.1.3")) (step (n 39) (insn "addi x26, x0, -1") (writes (write (reg "x26") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "The pre-write: x26 starts at -1 so the 0 below lands as a transition.") (source "RVI-RV32I §1.1.4")) (step (n 40) (insn "lb x26, x10, 1027") (writes (write (reg "x26") (value "0x0000000000000000"))) (derivation "byte 0x00 sign-extends to 0 — observed as the -1 → 0 transition. The boundary value at the BOTTOM of the byte domain.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT)")) (step (n 41) (insn "sb x8, 1056, x10") (writes) (derivation "SB writes the low 8 bits of 0x180: 0x80 — NOT 0xFF (saturating) and NOT 0x00 (masking the wrong end).") (source "RVI-RV64I §3.1.3")) (step (n 42) (insn "lbu x27, x10, 1056") (writes (write (reg "x27") (value "0x0000000000000080"))) (derivation "Read back: 0x80, the low byte of 0x180.") (source "RVI-RV64I §3.1.3")) (step (n 43) (insn "sh x9, 1064, x10") (writes) (derivation "SH writes the low 16 bits of -32768: 0x8000.") (source "RVI-RV64I §3.1.3")) (step (n 44) (insn "lhu x28, x10, 1064") (writes (write (reg "x28") (value "0x0000000000008000"))) (derivation "Read back: 0x8000, the low halfword.") (source "RVI-RV64I §3.1.3")) (step (n 45) (insn "sw x9, 1072, x10") (writes) (derivation "SW writes the low 32 bits of -32768: 0xFFFF8000.") (source "RVI-RV64I §3.1.3")) (step (n 46) (insn "lwu x29, x10, 1072") (writes (write (reg "x29") (value "0x00000000FFFF8000"))) (derivation "Read back: 0xFFFF8000, the low word, zero-extended.") (source "RVI-RV64I §3.1.3")))
