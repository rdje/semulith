;; d-fused.expected.sexp — the expected observations for `d-fused.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-fused.expected.sexp schema/expectations.sexp

(expectations (program "d-fused.s") (entry "0x0000000080000000") (instructions 41)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3ff00") (writes (write (reg "x5") (value "0x000000003ff00000")))
    (derivation "build 0x3ff0000000000001: the upper word 0x3ff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x3ff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "addi x28, x0, 1") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "the lower word 0x00000001.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000100000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 7) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 8) (insn "or x5, x5, x28") (writes (write (reg "x5") (value "0x3ff0000000000001")))
    (derivation "x5 = 0x3ff0000000000001.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 10) (insn "lui x6, 0x3ff00") (writes (write (reg "x6") (value "0x000000003ff00000")))
    (derivation "build 0x3feffffffffffffe: the upper word 0x3fefffff first.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "addi x6, x6, -1") (writes (write (reg "x6") (value "0x000000003fefffff")))
    (derivation "… its low 12 bits (-1).") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "slli x6, x6, 32") (writes (write (reg "x6") (value "0x3fefffff00000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 13) (insn "addi x28, x0, -2") (writes (write (reg "x28") (value "0xfffffffffffffffe")))
    (derivation "the lower word 0xfffffffe.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0xfffffffe00000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 15) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x00000000fffffffe")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 16) (insn "or x6, x6, x28") (writes (write (reg "x6") (value "0x3feffffffffffffe")))
    (derivation "x6 = 0x3feffffffffffffe.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "fmv.d.x f2, x6") (writes)
    (derivation "fmv.d.x: f2 <- x6's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 18) (insn "lui x7, 0xbff00") (writes (write (reg "x7") (value "0xffffffffbff00000")))
    (derivation "build 0xbff0000000000000: the upper word 0xbff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "slli x7, x7, 32") (writes (write (reg "x7") (value "0xbff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 20) (insn "fmv.d.x f3, x7") (writes)
    (derivation "fmv.d.x: f3 <- x7's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 21) (insn "fmadd.d f4, f1, f2, f3, 0") (writes)
    (derivation "(1+2^-52)(1-2^-53)-1 with ONE rounding: exact where two roundings would give 0.") (source "RVI-D §21.1.4"))
  (step (n 22) (insn "fmv.x.d x8, f4") (writes (write (reg "x8") (value "0xb970000000000000")))
    (derivation "fmv.x.d: f4's 64 bits, unmodified: x8 = 0xb970000000000000.") (source "RVI-D §21.1.5"))
  (step (n 23) (insn "fmsub.d f5, f1, f2, f3, 0") (writes)
    (derivation "fmsub.d (RNE): (f1×f2)-f3 rounded once = 0x4000000000000000; flags NX.") (source "RVI-D §21.1.4 (FMADD.S's rule at 64)"))
  (step (n 24) (insn "fmv.x.d x9, f5") (writes (write (reg "x9") (value "0x4000000000000000")))
    (derivation "fmv.x.d: f5's 64 bits, unmodified: x9 = 0x4000000000000000.") (source "RVI-D §21.1.5"))
  (step (n 25) (insn "fnmsub.d f6, f1, f2, f3, 0") (writes)
    (derivation "fnmsub.d (RNE): -(f1×f2)+f3 rounded once = 0xc000000000000000; flags NX.") (source "RVI-D §21.1.4 (FMADD.S's rule at 64)"))
  (step (n 26) (insn "fmv.x.d x10, f6") (writes (write (reg "x10") (value "0xc000000000000000")))
    (derivation "fmv.x.d: f6's 64 bits, unmodified: x10 = 0xc000000000000000.") (source "RVI-D §21.1.5"))
  (step (n 27) (insn "fnmadd.d f7, f1, f2, f3, 0") (writes)
    (derivation "fnmadd.d (RNE): -(f1×f2)-f3 rounded once = 0x3970000000000000; flags none.") (source "RVI-D §21.1.4 (FMADD.S's rule at 64)"))
  (step (n 28) (insn "fmv.x.d x11, f7") (writes (write (reg "x11") (value "0x3970000000000000")))
    (derivation "fmv.x.d: f7's 64 bits, unmodified: x11 = 0x3970000000000000.") (source "RVI-D §21.1.5"))
  (step (n 29) (insn "csrrs x12, fflags, x0") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "x12 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 30) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 31) (insn "lui x13, 0x7ff00") (writes (write (reg "x13") (value "0x000000007ff00000")))
    (derivation "build 0x7ff0000000000000: the upper word 0x7ff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 32) (insn "slli x13, x13, 32") (writes (write (reg "x13") (value "0x7ff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 33) (insn "fmv.d.x f8, x13") (writes)
    (derivation "fmv.d.x: f8 <- x13's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 34) (insn "fmv.d.x f9, x0") (writes)
    (derivation "+0.0.") (source "RVI-D §21.1.5"))
  (step (n 35) (insn "lui x14, 0x7ff80") (writes (write (reg "x14") (value "0x000000007ff80000")))
    (derivation "build 0x7ff8000000000000: the upper word 0x7ff80000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "slli x14, x14, 32") (writes (write (reg "x14") (value "0x7ff8000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 37) (insn "fmv.d.x f10, x14") (writes)
    (derivation "fmv.d.x: f10 <- x14's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 38) (insn "fmadd.d f11, f8, f9, f10, 0") (writes)
    (derivation "∞×0 + a quiet NaN: INVALID even with the quiet addend.") (source "RVI-F §20.1.6"))
  (step (n 39) (insn "fmv.x.d x15, f11") (writes (write (reg "x15") (value "0x7ff8000000000000")))
    (derivation "fmv.x.d: f11's 64 bits, unmodified: x15 = 0x7ff8000000000000.") (source "RVI-D §21.1.5"))
  (step (n 40) (insn "csrrs x16, fflags, x0") (writes (write (reg "x16") (value "0x0000000000000010")))
    (derivation "x16 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
