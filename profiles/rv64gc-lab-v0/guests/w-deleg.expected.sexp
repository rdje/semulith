;; w-deleg.expected.sexp — the expected observations for `w-deleg.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py w-deleg.expected.sexp schema/expectations.sexp

(expectations (program "w-deleg.s") (entry "0x0000000080000000") (instructions 26) (fetches 24)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 64") (writes (write (reg "x1") (value "0x0000000080000040")))
    (derivation "the handler rides 64 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec programmed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x15, x0, 1") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "raw material for STI's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x15, x15, 5") (writes (write (reg "x15") (value "0x0000000000000020")))
    (derivation "x15 = 1 << 5.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 5) (insn "csrrs x0, mideleg, x15") (writes)
    (derivation "mideleg[5] <- 1 FIRST: the cause is delegated before it can pend (the delegation is what the cell is ABOUT).") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 6) (insn "csrrs x0, mie, x15") (writes)
    (derivation "STIE <- 1 — the local enable the wake honors.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 7) (insn "addi x8, x0, 13") (writes (write (reg "x8") (value "0x000000000000000d")))
    (derivation "stimecmp's target: 13 — two ticks past the wfi's head (time 11 there).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "csrrw x0, stimecmp, x8") (writes)
    (derivation "stimecmp <- 13 (time 8 < 13: STIP computes 0, the wfi's head is quiet).") (source "RVP-SSTC 12.1"))
  (step (n 9) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1 — and yet no trap will fire while the cause is delegated.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 11) (insn "wfi") (writes)
    (derivation "the halt: ONE halted step (time 12 < 13), then STIP arrives and the hart MUST resume — delegation notwithstanding.") (source "RVP-MACHINE §2.1.3.3"))
  (step (n 12) (insn "<halted>") (writes)
    (derivation "the halt: the hart is WAITING — nothing retires and no fetch issues this step; the domain ticks one, and the wake re-evaluates at the next head (a locally-enabled pending interrupt at any privilege level, regardless of the global enables and of mideleg).") (source "RVP-MACHINE §2.1.3.3; the .5 brief's decisions 4 and 6"))
  (step (n 13) (insn "rdtime x7") (writes (write (reg "x7") (value "0x000000000000000d")))
    (derivation "time is 13: the hart WOKE at the timer's arrival — and the delivery did NOT fire (the taken-rule masks a delegated cause at the delegator): the resume is the pc + 4 continuation.") (source "RVP-MACHINE §2.1.3.3, §2.1.1.8"))
  (step (n 14) (insn "csrrc x0, mideleg, x15") (writes)
    (derivation "un-delegate: the SAME still-pending STI now follows M's rule.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 15) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the STI interrupt in M: xcause carries the Interrupt bit with cause 5, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 16) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000005")))
    (derivation "the handler observes the Interrupt bit with cause 5.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 17) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000038")))
    (derivation "mepc is the un-fetched pc (0x80000038 — the delivery placeholder).") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 18) (insn "addi x16, x0, 1") (writes (write (reg "x16") (value "0x0000000000000001")))
    (derivation "raw material for the high stimecmp.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "slli x16, x16, 16") (writes (write (reg "x16") (value "0x0000000000010000")))
    (derivation "x16 = 0x10000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 20) (insn "csrrw x0, stimecmp, x16") (writes)
    (derivation "disarm the timer for good.") (source "RVP-SSTC 12.1"))
  (step (n 21) (insn "csrrs x13, mepc, x0") (writes (write (reg "x13") (value "0x0000000080000038")))
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 22) (insn "addi x13, x13, 4") (writes (write (reg "x13") (value "0x000000008000003c")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "csrrw x0, mepc, x13") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 24) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc — the landing marker.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 25) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker: wake-regardless-of-delegation, then the trap once un-delegated.") (source "RVI-RV32I §1.1.4 #|end"))
)
