;; mm-sret.expected.sexp — the expected observations for `mm-sret.s` (P4-SYSTEM.2
;; slice f, the mode-matrix corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py mm-sret.expected.sexp schema/expectations.sexp

(expectations (program "mm-sret.s") (entry "0x0000000080000000") (instructions 50)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "auipc writes the instruction's own address (entry + 0x0).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 128") (writes (write (reg "x1") (value "0x0000000080000080")))
    (derivation "the delta 128 from the auipc's pc lands on the trap handler's first instruction at entry+0x80.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed to the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "csrrw x0, mstatus, x0") (writes)
    (derivation "mstatus <- 0: SPP=U, TSR=0.") (source "RVP-CSR (mstatus field table)"))
  (step (n 4) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000010")))
    (derivation "auipc writes the instruction's own address (entry + 0x10).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 5) (insn "addi x4, x4, 36") (writes (write (reg "x4") (value "0x0000000080000034")))
    (derivation "the delta 36 from the auipc's pc lands on the U-mode sret cell at entry+0x34.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 6) (insn "csrrw x0, sepc, x4") (writes)
    (derivation "sepc <- entry+0x34.") (source "RVI-ZICSR §5.1.1"))
  (step (n 7) (insn "sret") (writes)
    (derivation "sret executed in M is legal (M may execute sret); it returns to sepc at the SPP-recorded mode — U.") (source "RVP-INSNS §4.2.2 (sret is legal in M)"))
  (step (n 8) (insn "sret") (writes)
    (derivation "sret in U-mode ALWAYS traps illegal-instruction.") (source "RVP-INSNS §4.2.2 (sret in U is illegal)"))
  (step (n 9) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 0 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 10) (insn "beq x12, x0, stage1") (writes)
    (derivation "stage 0: branch to the S-setup stage.") (source "RVI-RV32I §1.1.5"))
  (step (n 11) (insn "addi x12, x0, 1") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "the stage counter becomes 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 1.") (source "RVI-ZICSR §5.1.1"))
  (step (n 13) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000002")))
    (derivation "the handler observes cause 2 (the U-mode sret).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 14) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "the MPP=S pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "1 << 11 is the MPP field's S encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 16) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- 0x800: MPP=S, SPP=U.") (source "RVP-CSR (mstatus field table)"))
  (step (n 17) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x00000000800000bc")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 18) (insn "addi x4, x4, 116") (writes (write (reg "x4") (value "0x0000000080000130")))
    (derivation "the delta 116 lands on the legal S-mode sret cell at entry+0x130.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 19) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x130.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "mret") (writes)
    (derivation "drop to S at the legal sret cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 21) (insn "sret") (writes)
    (derivation "sret in S with TSR=0 is legal: it returns to sepc (entry+0x34, programmed before the first sret) at the SPP-recorded mode — U.") (source "RVP-INSNS §4.2.2 (sret in S, TSR=0)"))
  (step (n 22) (insn "sret") (writes)
    (derivation "the U-mode sret cell again: illegal, and the handler is now at stage 1.") (source "RVP-INSNS §4.2.2 (sret in U is illegal)"))
  (step (n 23) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 1 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 24) (insn "beq x12, x0, stage1") (writes)
    (derivation "stage 1: the first branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 25) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the comparison constant 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 26) (insn "beq x12, x13, stage2") (writes)
    (derivation "stage 1: branch to the TSR stage.") (source "RVI-RV32I §1.1.5"))
  (step (n 27) (insn "addi x12, x0, 2") (writes (write (reg "x12") (value "0x0000000000000002")))
    (derivation "the stage counter becomes 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 28) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 2.") (source "RVI-ZICSR §5.1.1"))
  (step (n 29) (insn "csrrs x7, mcause, x0") (writes)
    (derivation "cause 2 again — x7 already holds 2, no change observed.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 30) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "the MPP=S pattern starts again as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "1 << 11 is MPP's S encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 32) (insn "addi x2, x0, 1") (writes (write (reg "x2") (value "0x0000000000000001")))
    (derivation "the TSR pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "slli x2, x2, 22") (writes (write (reg "x2") (value "0x0000000000400000")))
    (derivation "1 << 22 is TSR.") (source "RVP-CSR (mstatus.TSR is bit 22)"))
  (step (n 34) (insn "or x3, x3, x2") (writes (write (reg "x3") (value "0x0000000000400800")))
    (derivation "MPP=S together with TSR.") (source "RVI-RV32I §1.1.4"))
  (step (n 35) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- MPP=S with TSR=1.") (source "RVP-CSR (mstatus field table)"))
  (step (n 36) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x00000000800000f0")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 37) (insn "addi x4, x4, 72") (writes (write (reg "x4") (value "0x0000000080000138")))
    (derivation "the delta 72 lands on the TSR=1 sret cell at entry+0x138.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 38) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x138.") (source "RVI-ZICSR §5.1.1"))
  (step (n 39) (insn "mret") (writes)
    (derivation "drop to S at the TSR=1 sret cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 40) (insn "sret") (writes)
    (derivation "sret in S with TSR=1 traps illegal-instruction.") (source "RVP-INSNS §4.2.2 (TSR=1 makes sret illegal in S)"))
  (step (n 41) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 2 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 42) (insn "beq x12, x0, stage1") (writes)
    (derivation "stage 2: the first branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 43) (insn "addi x13, x0, 1") (writes)
    (derivation "the comparison constant 1 — x13 already holds 1, no change observed.") (source "RVI-RV32I §1.1.4"))
  (step (n 44) (insn "beq x12, x13, stage2") (writes)
    (derivation "stage 2: the second branch does not fire either — fall through.") (source "RVI-RV32I §1.1.5"))
  (step (n 45) (insn "csrrs x15, mcause, x0") (writes (write (reg "x15") (value "0x0000000000000002")))
    (derivation "the handler's third visit observes cause 2 (the TSR=1 sret).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 46) (insn "csrrs x8, mepc, x0") (writes (write (reg "x8") (value "0x0000000080000138")))
    (derivation "mepc is the trapped sret's address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 47) (insn "addi x8, x8, 4") (writes (write (reg "x8") (value "0x000000008000013c")))
    (derivation "step mepc past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 48) (insn "csrrw x0, mepc, x8") (writes)
    (derivation "mepc <- entry+0x13C.") (source "RVI-ZICSR §5.1.1"))
  (step (n 49) (insn "mret") (writes)
    (derivation "the trap recorded MPP=S, so the return lands back in S.") (source "RVP-INSNS §3.3.2 (mret)")))
