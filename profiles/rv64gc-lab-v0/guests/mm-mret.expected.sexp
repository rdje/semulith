;; mm-mret.expected.sexp — the expected observations for `mm-mret.s` (P4-SYSTEM.2
;; slice f, the mode-matrix corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py mm-mret.expected.sexp schema/expectations.sexp

(expectations (program "mm-mret.s") (entry "0x0000000080000000") (instructions 43)
  (step (n 0) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "the MPP=S pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "1 << 11 is the MPP field's S encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 2) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000008")))
    (derivation "auipc writes the instruction's own address (entry + 0x8).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 3) (insn "addi x1, x1, 104") (writes (write (reg "x1") (value "0x0000000080000070")))
    (derivation "the delta 104 from the auipc's pc lands on the trap handler's first instruction at entry+0x70.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 4) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed BEFORE any mode drop — it is an M-level CSR.") (source "RVI-ZICSR §5.1.1"))
  (step (n 5) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- 0x800: MPP=S.") (source "RVP-CSR (mstatus field table)"))
  (step (n 6) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000018")))
    (derivation "auipc writes the instruction's own address (entry + 0x18).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 7) (insn "addi x4, x4, 32") (writes (write (reg "x4") (value "0x0000000080000038")))
    (derivation "the delta 32 from the auipc's pc lands on the first S-mode cell at entry+0x38.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 8) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x38.") (source "RVI-ZICSR §5.1.1"))
  (step (n 9) (insn "mret") (writes)
    (derivation "the first mret: MPP=S, so it drops to S; MPP becomes U, MPIE becomes 1.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 10) (insn "csrrs x5, sstatus, x0") (writes (write (reg "x5") (value "0x0000000200000000")))
    (derivation "in S, sstatus reads the restricted view: UXL held at 2 (bits 33:32), all other sstatus fields 0.") (source "RVP-SUPERVISOR §4.1.1 (sstatus)"))
  (step (n 11) (insn "ecall") (writes)
    (derivation "ecall from S: cause 9, taken in M.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 12) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 0 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 13) (insn "bne x12, x0, stage2") (writes)
    (derivation "stage 0: the branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 14) (insn "addi x12, x0, 1") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "the stage counter becomes 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 1.") (source "RVI-ZICSR §5.1.1"))
  (step (n 16) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000009")))
    (derivation "the handler observes cause 9.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 17) (insn "addi x2, x0, 1") (writes (write (reg "x2") (value "0x0000000000000001")))
    (derivation "the MPRV pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "slli x2, x2, 17") (writes (write (reg "x2") (value "0x0000000000020000")))
    (derivation "1 << 17 is MPRV.") (source "RVP-CSR (mstatus.MPRV is bit 17)"))
  (step (n 19) (insn "csrrs x0, mstatus, x2") (writes)
    (derivation "set-bits write: mstatus.MPRV <- 1, other fields preserved.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000090")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 21) (insn "addi x4, x4, 48") (writes (write (reg "x4") (value "0x00000000800000c0")))
    (derivation "the delta 48 lands on the second S-mode cell at entry+0xC0.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 22) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0xC0.") (source "RVI-ZICSR §5.1.1"))
  (step (n 23) (insn "mret") (writes)
    (derivation "the second mret: MPP=S, and because the target mode is BELOW M, mret CLEARS MPRV; the return lands in S at entry+0xC0.") (source "RVP-INSNS §3.3.2 (mret: xRET to a mode below M sets MPRV=0)"))
  (step (n 24) (insn "csrrs x6, sstatus, x0") (writes (write (reg "x6") (value "0x0000000200000000")))
    (derivation "back in S: the sstatus read is legal and again shows only UXL=2.") (source "RVP-SUPERVISOR §4.1.1 (sstatus)"))
  (step (n 25) (insn ".word 0") (writes)
    (derivation "a reserved word: the laboratory's D-RESERVED-DECODE policy converts it to a delivered illegal-instruction trap (cause 2), entering the handler at stage 1.") (source "RVP-MACHINE §2.1.3.1; the laboratory's D-RESERVED-DECODE policy"))
  (step (n 26) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 1 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 27) (insn "bne x12, x0, stage2") (writes)
    (derivation "stage 1: branch to the second stage.") (source "RVI-RV32I §1.1.5"))
  (step (n 28) (insn "addi x12, x0, 2") (writes (write (reg "x12") (value "0x0000000000000002")))
    (derivation "the stage counter becomes 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 2.") (source "RVI-ZICSR §5.1.1"))
  (step (n 30) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000002")))
    (derivation "the handler's second visit observes cause 2.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 31) (insn "csrrs x14, mstatus, x0") (writes (write (reg "x14") (value "0x0000000a00000800")))
    (derivation "mstatus now: UXL/SXL held at 2 (0xA << 32), MPRV 0 — cleared by the mret that dropped below M — and MPP=S (0x800) recorded by the trap just taken.") (source "RVP-INSNS §3.3.2 (mret MPRV rule); RVP-CSR (mstatus field table)"))
  (step (n 32) (insn "addi x3, x0, 3") (writes (write (reg "x3") (value "0x0000000000000003")))
    (derivation "the MPP=M pattern starts as a 3.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000001800")))
    (derivation "3 << 11 is the MPP field's M encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 34) (insn "addi x2, x0, 1") (writes (write (reg "x2") (value "0x0000000000000001")))
    (derivation "the MPRV pattern starts again as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 35) (insn "slli x2, x2, 17") (writes (write (reg "x2") (value "0x0000000000020000")))
    (derivation "1 << 17 is MPRV.") (source "RVP-CSR (mstatus.MPRV)"))
  (step (n 36) (insn "or x3, x3, x2") (writes (write (reg "x3") (value "0x0000000000021800")))
    (derivation "MPP=M together with MPRV: 0x1800 | 0x20000.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- MPP=M with MPRV=1.") (source "RVP-CSR (mstatus field table)"))
  (step (n 38) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000120")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 39) (insn "addi x4, x4, 44") (writes (write (reg "x4") (value "0x000000008000014c")))
    (derivation "the delta 44 lands on the M-mode cell at entry+0x14C.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 40) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x14C.") (source "RVI-ZICSR §5.1.1"))
  (step (n 41) (insn "mret") (writes)
    (derivation "the third mret: MPP=M, so the target mode is M itself and MPRV is PRESERVED; the return stays in M at entry+0x14C.") (source "RVP-INSNS §3.3.2 (mret: MPRV unchanged when the target mode is M)"))
  (step (n 42) (insn "csrrs x8, mstatus, x0") (writes (write (reg "x8") (value "0x0000000a00020080")))
    (derivation "mstatus now: UXL/SXL held (0xA << 32), MPRV still 1 (0x20000), MPIE 1 set by the mret (0x80), MPP cleared to U.") (source "RVP-INSNS §3.3.2 (mret); RVP-CSR (mstatus field table)")))
