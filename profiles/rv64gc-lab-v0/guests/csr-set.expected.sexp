;; csr-set.expected.sexp — spec-side observations for `csr-set.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py csr-set.expected.sexp schema/expectations.sexp

(expectations (program "csr-set.s") (entry "0x0000000080000000") (instructions 103) (fetches 206)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the handler's base: this instruction's own address, {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x1, x1, 372") (writes (write (reg "x1") (value "0x0000000080000174")))
    (derivation "the handler sits after the main body, at {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "direct-mode mtvec = the handler; no GPR written.") (source "RVP-MACHINE §2.1.5"))
  (step (n 3) (insn "lui x31, 0x2") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "bit 13: mstatus.FS = Initial, so the FP CSRs are accessible: {new}.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 4) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "set FS; no GPR written.") (source "RVI-ZICSR §5.1.1"))
  (step (n 5) (insn "addi x6, x0, -1") (writes (write (reg "x6") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read of mhartid must replace (a reset value of 0 is then an observed change).") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "csrrs x6, mhartid, x0") (writes (write (reg "x6") (value "0x0000000000000000")))
    (derivation "mhartid is implemented: its reset value {new} replaces the sentinel; rs1 = x0 writes nothing.") (source "RVI-ZICSR §5.1.1; RVP-CSR §1.1.1"))
  (step (n 7) (insn "addi x7, x0, -1") (writes (write (reg "x7") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read of misa must replace (a reset value of 0 is then an observed change).") (source "RVI-RV32I §1.1.4"))
