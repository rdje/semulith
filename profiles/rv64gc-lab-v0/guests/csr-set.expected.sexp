  (step (n 91) (insn "addi x16, x0, -1") (writes (write (reg "x16") (value "0xffffffffffffffff")))
    (derivation "sentinel (in S).") (source "RVI-RV32I §1.1.4"))
  (step (n 92) (insn "csrrs x16, sstatus, x0") (writes (write (reg "x16") (value "0x8000000200006002")))
    (derivation "sstatus is readable in S: {new} (SD, FS Dirty, SIE — mstatus's supervisor view).") (source "RVP-SUPERVISOR §1.1.1"))
  (step (n 93) (insn "addi x17, x0, -1") (writes (write (reg "x17") (value "0xffffffffffffffff")))
    (derivation "the sentinel the privilege-refused access must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 94) (insn "addi x30, x0, -1") (writes (write (reg "x30") (value "0xffffffffffffffff")))
    (derivation "a sentinel the handler's cause read must replace (the first trap left 2 there).") (source "RVI-RV32I §1.1.4"))
  (step (n 95) (insn "csrrs x17, mscratch, x0") (writes)
    (derivation "an M-level CSR from S: illegal-instruction before any effect; the handler (in M) records cause 2 and returns to S.") (source "RVP-CSR §1.1.1; RVI-ZICSR §5.1.1"))
  (step (n 96) (insn "csrrs x30, mcause, x0") (writes (write (reg "x30") (value "0x0000000000000002")))
    (derivation "the handler: the cause, {new}.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 97) (insn "csrrs x29, mepc, x0") (writes (write (reg "x29") (value "0x0000000080000168")))
    (derivation "mepc is the refused instruction's own address: {new}.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 98) (insn "addi x29, x29, 4") (writes (write (reg "x29") (value "0x000000008000016c")))
    (derivation "step past it: {new}.") (source "RVI-RV32I §1.1.4"))
  (step (n 99) (insn "csrrw x0, mepc, x29") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 100) (insn "mret") (writes)
    (derivation "back to the mode the trap came from, at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 101) (insn "addi x18, x0, -1") (writes (write (reg "x18") (value "0xffffffffffffffff")))
    (derivation "sentinel (in S).") (source "RVI-RV32I §1.1.4"))
  (step (n 102) (insn "csrrs x18, sscratch, x0") (writes (write (reg "x18") (value "0x0000000000000000")))
    (derivation "the supervisor's own scratch is readable in S: {new}.") (source "RVP-SUPERVISOR §1.1.4"))
)
