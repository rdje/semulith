;; bound-shift.expected.sexp — the expected observations for `bound-shift.s` (P2-SCALAR.2).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py bound-shift.expected.sexp schema/expectations.sexp

(comment "bound-shift.expected.sexp — the expected observations for `bound-shift.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN." "`EVD-05` and `docs/EVIDENCE_AND_GATES.md` require it: an expected value copied out of a model's" "output tests that the model is self-consistent and nothing else. The `derivation` field on each" "step is the reasoning, and `source` is where in the pinned artifacts the rule is stated." "" "The 64-bit shift corner cases (D-SHAMT): the 6-bit shamt domain EXHAUSTED by one" "srli sweep over all 64 amounts; slli/srai pinned at {0,1,2,4,8,16,32,63} — every" "amount bit on every form; the register-amount corners rs2 = 64 (reads as 0) and" "rs2 = -1 (reads as 63). The sweep operand's results are pairwise distinct, and the" "one identity result is pre-written, so every step is a visible register change.")
(expectations (program "bound-shift.s") (entry "0x80000000") (instructions 89) (step (n 0) (insn "lui x8, 0x80000") (writes (write (reg "x8") (value "0xFFFFFFFF80000000"))) (derivation "The U-immediate 0x80000 gives the 32-bit value 0x80000000; LUI sign-extends to 64 bits and bit 31 is set. First half of building X = 0x8000000000000001.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 1) (insn "slli x8, x8, 32") (writes (write (reg "x8") (value "0x8000000000000000"))) (derivation "0xFFFFFFFF80000000 << 32, low 64 bits kept: the upper half shifts out, leaving 0x8000000000000000. shamt 32 is legal here — the 64-bit immediate shifts take a 6-bit amount.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT)")) (step (n 2) (insn "addi x8, x8, 1") (writes (write (reg "x8") (value "0x8000000000000001"))) (derivation "Adds 1: X = 0x8000000000000001. Bit 63 makes every right-shift fill rule observable; bit 0 walks up through every left shift and out at shamt 63.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "srli x9, x8, 0") (writes (write (reg "x9") (value "0x8000000000000001"))) (derivation "shamt 0 of the 6-bit field: 0x8000000000000001 >>> 0 = 0x8000000000000001 — logical, zeros enter from the top. The identity: nothing moves.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 4) (insn "srli x9, x8, 1") (writes (write (reg "x9") (value "0x4000000000000000"))) (derivation "shamt 1 of the 6-bit field: 0x8000000000000001 >>> 1 = 0x4000000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 5) (insn "srli x9, x8, 2") (writes (write (reg "x9") (value "0x2000000000000000"))) (derivation "shamt 2 of the 6-bit field: 0x8000000000000001 >>> 2 = 0x2000000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 6) (insn "srli x9, x8, 3") (writes (write (reg "x9") (value "0x1000000000000000"))) (derivation "shamt 3 of the 6-bit field: 0x8000000000000001 >>> 3 = 0x1000000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 7) (insn "srli x9, x8, 4") (writes (write (reg "x9") (value "0x0800000000000000"))) (derivation "shamt 4 of the 6-bit field: 0x8000000000000001 >>> 4 = 0x0800000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 8) (insn "srli x9, x8, 5") (writes (write (reg "x9") (value "0x0400000000000000"))) (derivation "shamt 5 of the 6-bit field: 0x8000000000000001 >>> 5 = 0x0400000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 9) (insn "srli x9, x8, 6") (writes (write (reg "x9") (value "0x0200000000000000"))) (derivation "shamt 6 of the 6-bit field: 0x8000000000000001 >>> 6 = 0x0200000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 10) (insn "srli x9, x8, 7") (writes (write (reg "x9") (value "0x0100000000000000"))) (derivation "shamt 7 of the 6-bit field: 0x8000000000000001 >>> 7 = 0x0100000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 11) (insn "srli x9, x8, 8") (writes (write (reg "x9") (value "0x0080000000000000"))) (derivation "shamt 8 of the 6-bit field: 0x8000000000000001 >>> 8 = 0x0080000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 12) (insn "srli x9, x8, 9") (writes (write (reg "x9") (value "0x0040000000000000"))) (derivation "shamt 9 of the 6-bit field: 0x8000000000000001 >>> 9 = 0x0040000000000000 — logical, zeros enter from the top.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: the 6-bit amount; SRLI is logical)")) (step (n 13) (insn "srli x