;; a-amo-aqrl.expected.sexp — the expected observations for `a-amo-aqrl.s` (P4-SYSTEM.4
;; slice d, the atomics corpus). EVD-05: every value below was derived from the pinned
;; chapters and the declared deterministic SC policy (state.sexp) by the spec-side
;; authoring model BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py a-amo-aqrl.expected.sexp schema/expectations.sexp

(expectations (program "a-amo-aqrl.s") (entry "0x0000000080000000") (instructions 21)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "x10 = 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 2) (insn "addi x1, x10, 256") (writes (write (reg "x1") (value "0x0000000080000100")))
    (derivation "the cell's data address.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "addi x7, x0, 41") (writes (write (reg "x7") (value "0x0000000000000029")))
    (derivation "the cell's value.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x6, x0, 1") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "the increment.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 41 (the LR/SC suffix pair).") (source "RVI-RV64I §3.1.3"))
  (step (n 6) (insn "amoadd.w x5, x6, (x1)") (writes (write (reg "x5") (value "0x0000000000000029")))
    (derivation "no suffix: rd <- 41, mem <- 42.") (source "RVI-A §12.1.1"))
  (step (n 7) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0x000000000000002a")))
    (derivation "read-back: 1.") (source "RVI-RV64I §3.1.3"))
  (step (n 8) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 41 (the LR/SC suffix pair).") (source "RVI-RV64I §3.1.3"))
  (step (n 9) (insn "amoadd.w.aq x5, x6, (x1)") (writes)
    (derivation ".aq: rd <- 41, mem <- 42 — identical at one hart.") (source "RVI-A §12.1.1"))
  (step (n 10) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 1.") (source "RVI-RV64I §3.1.3"))
  (step (n 11) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 41 (the LR/SC suffix pair).") (source "RVI-RV64I §3.1.3"))
  (step (n 12) (insn "amoadd.w.rl x5, x6, (x1)") (writes)
    (derivation ".rl: rd <- 41, mem <- 42 — identical at one hart.") (source "RVI-A §12.1.1"))
  (step (n 13) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 1.") (source "RVI-RV64I §3.1.3"))
  (step (n 14) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 41 (the LR/SC suffix pair).") (source "RVI-RV64I §3.1.3"))
  (step (n 15) (insn "amoadd.w.aqrl x5, x6, (x1)") (writes)
    (derivation ".aqrl: rd <- 41, mem <- 42 — identical at one hart.") (source "RVI-A §12.1.1"))
  (step (n 16) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 1.") (source "RVI-RV64I §3.1.3"))
  (step (n 17) (insn "sw x7, 0, x1") (writes)
    (derivation "mem = 41 (the LR/SC suffix pair).") (source "RVI-RV64I §3.1.3"))
  (step (n 18) (insn "lr.w.aqrl x5, (x1)") (writes)
    (derivation "LR with BOTH bits set decodes and reserves identically: rd <- 41.") (source "RVI-A §12.1.1–§12.1.2"))
  (step (n 19) (insn "sc.w.aq x9, x6, (x1)") (writes)
    (derivation "the .aq SC pairs and succeeds: rd <- 0, mem <- 1.") (source "RVI-A §12.1.1–§12.1.2"))
  (step (n 20) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "read-back: 1.") (source "RVI-RV64I §3.1.3"))
)
