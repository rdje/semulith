;; f-fused.expected.sexp — the expected observations for `f-fused.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py f-fused.expected.sexp schema/expectations.sexp

(expectations (program "f-fused.s") (entry "0x0000000080000000") (instructions 41)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any F instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3f800") (writes (write (reg "x5") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f800001 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x000000003f800001")))
    (derivation "… its low 12 bits (1).") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "fmv.w.x f1, x5") (writes)
    (derivation "fmv.w.x: f1 <- x5's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 6) (insn "lui x6, 0x3f800") (writes (write (reg "x6") (value "0x000000003f800000")))
    (derivation "build the pattern 0x3f7ffffe (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x6, x6, -2") (writes (write (reg "x6") (value "0x000000003f7ffffe")))
    (derivation "… its low 12 bits (-2).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "fmv.w.x f2, x6") (writes)
    (derivation "fmv.w.x: f2 <- x6's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 9) (insn "lui x7, 0xbf800") (writes (write (reg "x7") (value "0xffffffffbf800000")))
    (derivation "build the pattern 0xbf800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "fmv.w.x f3, x7") (writes)
    (derivation "fmv.w.x: f3 <- x7's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 11) (insn "fmadd.s f4, f1, f2, f3, 0") (writes)
    (derivation "(1+2^-23)(1-2^-23) + (-1) = -2^-46 exactly — fused, ONE rounding (an unfused product would round to 1 and give 0).") (source "RVI-F §20.1.6"))
  (step (n 12) (insn "fmv.x.w x8, f4") (writes (write (reg "x8") (value "0xffffffffa8800000")))
    (derivation "fmv.x.w: the low 32 bits of f4, sign-extended: x8 = 0xffffffffa8800000.") (source "RVI-F §20.1.7"))
  (step (n 13) (insn "fmsub.s f5, f1, f2, f3, 0") (writes)
    (derivation "fmsub.s (RNE): (f1×f2)-f3 rounded once = 0x40000000; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 14) (insn "fmv.x.w x9, f5") (writes (write (reg "x9") (value "0x0000000040000000")))
    (derivation "fmv.x.w: the low 32 bits of f5, sign-extended: x9 = 0x0000000040000000.") (source "RVI-F §20.1.7"))
  (step (n 15) (insn "fnmsub.s f6, f1, f2, f3, 0") (writes)
    (derivation "fnmsub.s (RNE): -(f1×f2)+f3 rounded once = 0xc0000000; flags NX.") (source "RVI-F §20.1.6"))
  (step (n 16) (insn "fmv.x.w x10, f6") (writes (write (reg "x10") (value "0xffffffffc0000000")))
    (derivation "fmv.x.w: the low 32 bits of f6, sign-extended: x10 = 0xffffffffc0000000.") (source "RVI-F §20.1.7"))
  (step (n 17) (insn "fnmadd.s f7, f1, f2, f3, 0") (writes)
    (derivation "fnmadd.s (RNE): -(f1×f2)-f3 rounded once = 0x28800000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 18) (insn "fmv.x.w x11, f7") (writes (write (reg "x11") (value "0x0000000028800000")))
    (derivation "fmv.x.w: the low 32 bits of f7, sign-extended: x11 = 0x0000000028800000.") (source "RVI-F §20.1.7"))
  (step (n 19) (insn "csrrs x12, fflags, x0") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "x12 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 20) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 21) (insn "lui x13, 0x7f800") (writes (write (reg "x13") (value "0x000000007f800000")))
    (derivation "build the pattern 0x7f800000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "fmv.w.x f8, x13") (writes)
    (derivation "fmv.w.x: f8 <- x13's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 23) (insn "fmv.w.x f9, x0") (writes)
    (derivation "f9 = +0.0.") (source "RVI-F §20.1.7"))
  (step (n 24) (insn "lui x14, 0x7fc00") (writes (write (reg "x14") (value "0x000000007fc00000")))
    (derivation "build the pattern 0x7fc00000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 25) (insn "fmv.w.x f10, x14") (writes)
    (derivation "fmv.w.x: f10 <- x14's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 26) (insn "fmadd.s f11, f8, f9, f10, 0") (writes)
    (derivation "∞×0 + qNaN: NV even with the quiet addend.") (source "RVI-F §20.1.6"))
  (step (n 27) (insn "fmv.x.w x15, f11") (writes (write (reg "x15") (value "0x000000007fc00000")))
    (derivation "fmv.x.w: the low 32 bits of f11, sign-extended: x15 = 0x000000007fc00000.") (source "RVI-F §20.1.7"))
  (step (n 28) (insn "csrrs x16, fflags, x0") (writes (write (reg "x16") (value "0x0000000000000010")))
    (derivation "x16 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 29) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 30) (insn "lui x17, 0x40000") (writes (write (reg "x17") (value "0x0000000040000000")))
    (derivation "build the pattern 0x40000000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "fmv.w.x f12, x17") (writes)
    (derivation "fmv.w.x: f12 <- x17's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 32) (insn "lui x18, 0x40400") (writes (write (reg "x18") (value "0x0000000040400000")))
    (derivation "build the pattern 0x40400000 (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "fmv.w.x f13, x18") (writes)
    (derivation "fmv.w.x: f13 <- x18's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 34) (insn "fnmadd.s f14, f12, f13, f12, 2") (writes)
    (derivation "fnmadd.s (RDN): -(f12×f13)-f12 rounded once = 0xc1000000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 35) (insn "fmv.x.w x19, f14") (writes (write (reg "x19") (value "0xffffffffc1000000")))
    (derivation "fmv.x.w: the low 32 bits of f14, sign-extended: x19 = 0xffffffffc1000000.") (source "RVI-F §20.1.7"))
  (step (n 36) (insn "fmsub.s f15, f12, f12, f12, 0") (writes)
    (derivation "fmsub.s (RNE): (f12×f12)-f12 rounded once = 0x40000000; flags none.") (source "RVI-F §20.1.6"))
  (step (n 37) (insn "fmv.x.w x20, f15") (writes (write (reg "x20") (value "0x0000000040000000")))
    (derivation "fmv.x.w: the low 32 bits of f15, sign-extended: x20 = 0x0000000040000000.") (source "RVI-F §20.1.7"))
  (step (n 38) (insn "fmsub.s f15, f9, f12, f9, 2") (writes)
    (derivation "0×2 − (+0) in RDN: the exact zero sum takes −0 — 'RDN' is the one mode that rounds a cancellation to −0.") (source "IEEE 754-2008 §6.3"))
  (step (n 39) (insn "fmv.x.w x21, f15") (writes (write (reg "x21") (value "0xffffffff80000000")))
    (derivation "fmv.x.w: the low 32 bits of f15, sign-extended: x21 = 0xffffffff80000000.") (source "RVI-F §20.1.7"))
  (step (n 40) (insn "csrrs x22, fflags, x0") (writes)
    (derivation "x22 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
