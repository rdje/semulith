;; sstc-timer.expected.sexp — spec-side observations for `sstc-timer.s`.
;; Author: scripts/derive_rv64gc_expectations.py; explicit-budget parcel route (C-capable).
;; EVD-05: values derive from independent spec-side rules and the declared
;; laboratory policies; each step names its derivation and source.
;; This derivation makes no processor conformance or original-capture claim.
;; Validate with
;;   python3 scripts/check_sexp_schema.py sstc-timer.expected.sexp schema/expectations.sexp

(expectations (program "sstc-timer.s") (entry "0x0000000080000000") (instructions 315) (fetches 622)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "the M handler's base: this instruction's own address.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x1, x1, 712") (writes (write (reg "x1") (value "0x00000000800002c8")))
    (derivation "the M handler sits after the S handler.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "direct-mode mtvec = the M handler; no GPR written.") (source "RVP-MACHINE §2.1.1.7"))
  (step (n 3) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x000000008000000c")))
    (derivation "the S handler's base.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x1, x1, 660") (writes (write (reg "x1") (value "0x00000000800002a0")))
    (derivation "the S handler sits after the main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "csrrw x0, stvec, x1") (writes)
    (derivation "direct-mode stvec = the S handler; no GPR written.") (source "RVP-SUPERVISOR §11.1.1.2"))
  (step (n 6) (insn "addi x28, x0, 2") (writes (write (reg "x28") (value "0x0000000000000002")))
    (derivation "illegal-instruction's cause, for the M handler's one comparison.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x5, x0, -1") (writes (write (reg "x5") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read of time must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "rdtime x5") (writes (write (reg "x5") (value "0x0000000000000008")))
    (derivation "time, the value stimecmp is compared against, reads in M.") (source "RVI-ZICNTR §6.1.1; RVI-ZICSR §5.1.1"))
  (step (n 9) (insn "addi x7, x0, -1") (writes (write (reg "x7") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "csrrs x7, stimecmp, x0") (writes (write (reg "x7") (value "0x0000000000000000")))
    (derivation "in M, stimecmp is accessible with TM and STCE both clear; the laboratory's reset is 0.") (source "RVP-SUPERVISOR §11.1.1.12; RVP-MACHINE §2.1.1.18"))
  (step (n 11) (insn "addi x6, x0, 1") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "1 ...") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "slli x6, x6, 40") (writes (write (reg "x6") (value "0x0000010000000000")))
    (derivation "... at bit 40: a compare value only 64 bits can hold.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 13) (insn "csrrw x0, stimecmp, x6") (writes)
    (derivation "M writes the compare; no GPR written.") (source "RVP-SUPERVISOR §11.1.1.12"))
  (step (n 14) (insn "addi x8, x0, -1") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "a sentinel the read-back must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "csrrs x8, stimecmp, x0") (writes (write (reg "x8") (value "0x0000010000000000")))
    (derivation "stimecmp holds all 64 bits.") (source "RVP-SUPERVISOR §11.1.1.12"))
  (step (n 16) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
