;; a-lrsc-mustfail.expected.sexp — the expected observations for `a-lrsc-mustfail.s` (P4-SYSTEM.4
;; slice d, the atomics corpus). EVD-05: every value below was derived from the pinned
;; chapters and the declared deterministic SC policy (state.sexp) by the spec-side
;; authoring model BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py a-lrsc-mustfail.expected.sexp schema/expectations.sexp

(expectations (program "a-lrsc-mustfail.s") (entry "0x0000000080000000") (instructions 30)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "x10 = 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 2) (insn "addi x1, x10, 256") (writes (write (reg "x1") (value "0x0000000080000100")))
    (derivation "address A.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "addi x2, x10, 264") (writes (write (reg "x2") (value "0x0000000080000108")))
    (derivation "address B.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x7, x0, 17") (writes (write (reg "x7") (value "0x0000000000000011")))
    (derivation "the initial word.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "addi x6, x0, 42") (writes (write (reg "x6") (value "0x000000000000002a")))
    (derivation "the value every failed SC must NOT store.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "sc.w x9, x6, (x1)") (writes (write (reg "x9") (value "0x0000000000000001")))
    (derivation "recovery: the fresh pair succeeds — rd <- 0, A <- 42, the machine stays consistent.") (source "RVI-A §12.1.2"))
  (step (n 7) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3"))
  (step (n 8) (insn "sw x7, 0, x1") (writes)
    (derivation "A = 17.") (source "RVI-RV64I §3.1.3"))
  (step (n 9) (insn "sw x7, 0, x2") (writes)
    (derivation "B = 17.") (source "RVI-RV64I §3.1.3"))
  (step (n 10) (insn "lr.w x5, (x1)") (writes (write (reg "x5") (value "0x0000000000000011")))
    (derivation "reserve A one last time.") (source "RVI-A §12.1.2"))
  (step (n 11) (insn "sc.w x9, x6, (x2)") (writes)
    (derivation "an INTERVENING SC to any address (this one fails) — it clears the reservation too.") (source "RVI-A §12.1.2"))
  (step (n 12) (insn "lw x8, x2, 0") (writes (write (reg "x8") (value "0x0000000000000011")))
    (derivation "read-back: B still 17.") (source "RVI-RV64I §3.1.3"))
  (step (n 13) (insn "lr.w x5, (x1)") (writes)
    (derivation "reserve A one last time.") (source "RVI-A §12.1.2"))
  (step (n 14) (insn "sc.w x9, x6, (x2)") (writes)
    (derivation "an INTERVENING SC to any address (this one fails) — it clears the reservation too.") (source "RVI-A §12.1.2"))
  (step (n 15) (insn "sc.w x9, x6, (x1)") (writes)
    (derivation "recovery: the fresh pair succeeds — rd <- 0, A <- 42, the machine stays consistent.") (source "RVI-A §12.1.2"))
  (step (n 16) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3"))
  (step (n 17) (insn "lr.w x5, (x1)") (writes)
    (derivation "reserve A one last time.") (source "RVI-A §12.1.2"))
  (step (n 18) (insn "lr.w x5, (x2)") (writes)
    (derivation "a later LR REPLACES the reservation with B's.") (source "RVI-A §12.1.2"))
  (step (n 19) (insn "sc.w x9, x6, (x1)") (writes)
    (derivation "recovery: the fresh pair succeeds — rd <- 0, A <- 42, the machine stays consistent.") (source "RVI-A §12.1.2"))
  (step (n 20) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3"))
  (step (n 21) (insn "lr.w x5, (x1)") (writes)
    (derivation "reserve A one last time.") (source "RVI-A §12.1.2"))
  (step (n 22) (insn "sc.d x9, x6, (x1)") (writes)
    (derivation "a .D SC covers bytes OUTSIDE the four reserved — width mismatch, rd <- 1.") (source "RVI-A §12.1.2; state.sexp's reservation candidate (the minimal set)"))
  (step (n 23) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3"))
  (step (n 24) (insn "lr.d x5, (x1)") (writes)
    (derivation "reserve A at width .D.") (source "RVI-A §12.1.2"))
  (step (n 25) (insn "sc.w x9, x6, (x1)") (writes)
    (derivation "recovery: the fresh pair succeeds — rd <- 0, A <- 42, the machine stays consistent.") (source "RVI-A §12.1.2"))
  (step (n 26) (insn "lw x8, x1, 0") (writes)
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3"))
  (step (n 27) (insn "lr.w x5, (x1)") (writes)
    (derivation "reserve A one last time.") (source "RVI-A §12.1.2"))
  (step (n 28) (insn "sc.w x9, x6, (x1)") (writes (write (reg "x9") (value "0x0000000000000000")))
    (derivation "recovery: the fresh pair succeeds — rd <- 0, A <- 42, the machine stays consistent.") (source "RVI-A §12.1.2"))
  (step (n 29) (insn "lw x8, x1, 0") (writes (write (reg "x8") (value "0x000000000000002a")))
    (derivation "read-back: 42.") (source "RVI-RV64I §3.1.3"))
)
