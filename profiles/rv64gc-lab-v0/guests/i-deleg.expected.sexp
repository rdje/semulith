;; i-deleg.expected.sexp — the expected observations for `i-deleg.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-deleg.expected.sexp schema/expectations.sexp

(expectations (program "i-deleg.s") (entry "0x0000000080000000") (instructions 60) (fetches 58)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 136") (writes (write (reg "x1") (value "0x0000000080000088")))
    (derivation "the M handler rides 136 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec programmed (ecall AND the M-taken SSI).") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x000000008000000c")))
    (derivation "x1 = this address.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x1, x1, 96") (writes (write (reg "x1") (value "0x000000008000006c")))
    (derivation "the S handler rides 96 bytes past this auipc (108 from the entry).") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "csrrw x0, stvec, x1") (writes)
    (derivation "stvec programmed (the delegated SSI).") (source "RVI-ZICSR §5.1.1"))
  (step (n 6) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002")))
    (derivation "the SSIP bit position (bit 1).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "csrrs x0, mip, x2") (writes)
    (derivation "SSIP <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 8) (insn "csrrs x0, mie, x2") (writes)
    (derivation "SSIE <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 9) (insn "csrrs x0, mideleg, x2") (writes)
    (derivation "mideleg[1] <- 1: SSI is delegated to S.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 10) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1.") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 12) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "IN M: the mask holds — a delegated SSI is NEVER taken in M, even fully enabled.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 13) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "raw material for MPP.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "mstatus.MPP = S.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 15) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus written.") (source "RVI-ZICSR §5.1.1"))
  (step (n 16) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000040")))
    (derivation "x4 = this address.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "addi x4, x4, 16") (writes (write (reg "x4") (value "0x0000000080000050")))
    (derivation "the S entry is the next-but-one instruction.") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc = the S entry.") (source "RVI-ZICSR §5.1.1"))
  (step (n 19) (insn "mret") (writes)
    (derivation "enter S.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 20) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000002")))
    (derivation "IN S with SIE clear: the delegated SSI still passes by.") (source "RVP-SUPERVISOR §11.1.1.3"))
  (step (n 21) (insn "addi x6, x0, 2") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "the SIE bit (bit 1).") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "csrrs x0, sstatus, x6") (writes)
    (derivation "SIE <- 1 through the S VIEW (mstatus is M-only — from S the access would be illegal).") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 23) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in S: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 24) (insn "csrrs x21, scause, x0") (writes (write (reg "x21") (value "0x8000000000000001")))
    (derivation "the S handler observes the Interrupt bit with cause 1.") (source "RVP-SUPERVISOR §11.1.1.3"))
  (step (n 25) (insn "csrrs x22, sepc, x0") (writes (write (reg "x22") (value "0x000000008000005c")))
    (derivation "sepc is the un-fetched pc.") (source "RVP-SUPERVISOR §11.1.1.7"))
  (step (n 26) (insn "csrrc x0, sip, x2") (writes)
    (derivation "clear SSIP through the S VIEW (mip is M-only).") (source "RVP-SUPERVISOR §11.1.1.4"))
  (step (n 27) (insn "csrrs x23, sepc, x0") (writes (write (reg "x23") (value "0x000000008000005c")))
    (derivation "step the resume address.") (source "RVP-SUPERVISOR §11.1.1.7"))
  (step (n 28) (insn "addi x23, x23, 4") (writes (write (reg "x23") (value "0x0000000080000060")))
    (derivation "sepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "csrrw x0, sepc, x23") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 30) (insn "sret") (writes)
    (derivation "the stack pops per SPP and pc <- sepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 31) (insn "ecall") (writes)
    (derivation "from S: cause 9 to M — the M handler will un-delegate.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 32) (insn "csrrs x24, mcause, x0") (writes (write (reg "x24") (value "0x0000000000000009")))
    (derivation "the M handler reads the cause — ecall-from-S (9) on the first visit, the Interrupt bit with cause 1 on the second.") (source "RVP-MACHINE §2.1.1.15"))
  (step (n 33) (insn "csrrs x25, mepc, x0") (writes (write (reg "x25") (value "0x0000000080000060")))
    (derivation "mepc is the trapping or un-fetched pc.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 34) (insn "addi x10, x0, 15") (writes (write (reg "x10") (value "0x000000000000000f")))
    (derivation "the cause-number mask (mcause carries the Interrupt bit).") (source "RVI-RV32I §1.1.4"))
  (step (n 35) (insn "and x10, x24, x10") (writes (write (reg "x10") (value "0x0000000000000009")))
    (derivation "the visit key: 9 on the ecall visit, 1 on the interrupt visit.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the SSI cause.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "beq x10, x13, m_consume") (writes)
    (derivation "the interrupt visit consumes SSI instead of re-posting it.") (source "RVI-RV32I §1.1.5"))
  (step (n 38) (insn "addi x6, x0, 2") (writes)
    (derivation "the delegation bit again.") (source "RVI-RV32I §1.1.4"))
  (step (n 39) (insn "csrrc x0, mideleg, x6") (writes)
    (derivation "mideleg[1] <- 0: SSI returns to M's rule.") (source "RVP-MACHINE §2.1.1.8"))
  (step (n 40) (insn "csrrs x0, mip, x6") (writes)
    (derivation "SSIP <- 1 again for the M-taken cell.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 41) (insn "beq x0, x0, m_resume") (writes)
    (derivation "to the shared resume.") (source "RVI-RV32I §1.1.5"))
  (step (n 42) (insn "csrrs x26, mepc, x0") (writes (write (reg "x26") (value "0x0000000080000060")))
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 43) (insn "addi x26, x26, 4") (writes (write (reg "x26") (value "0x0000000080000064")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 44) (insn "csrrw x0, mepc, x26") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 45) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 46) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in M: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 47) (insn "csrrs x24, mcause, x0") (writes (write (reg "x24") (value "0x8000000000000001")))
    (derivation "the M handler reads the cause — ecall-from-S (9) on the first visit, the Interrupt bit with cause 1 on the second.") (source "RVP-MACHINE §2.1.1.15"))
  (step (n 48) (insn "csrrs x25, mepc, x0") (writes (write (reg "x25") (value "0x0000000080000064")))
    (derivation "mepc is the trapping or un-fetched pc.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 49) (insn "addi x10, x0, 15") (writes (write (reg "x10") (value "0x000000000000000f")))
    (derivation "the cause-number mask (mcause carries the Interrupt bit).") (source "RVI-RV32I §1.1.4"))
  (step (n 50) (insn "and x10, x24, x10") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "the visit key: 9 on the ecall visit, 1 on the interrupt visit.") (source "RVI-RV32I §1.1.4"))
  (step (n 51) (insn "addi x13, x0, 1") (writes)
    (derivation "the SSI cause.") (source "RVI-RV32I §1.1.4"))
  (step (n 52) (insn "beq x10, x13, m_consume") (writes)
    (derivation "the interrupt visit consumes SSI instead of re-posting it.") (source "RVI-RV32I §1.1.5"))
  (step (n 53) (insn "addi x13, x0, 2") (writes (write (reg "x13") (value "0x0000000000000002")))
    (derivation "SSIP's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 54) (insn "csrrc x0, mip, x13") (writes)
    (derivation "clear SSIP — the M-taken cause is consumed.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 55) (insn "csrrs x26, mepc, x0") (writes)
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 56) (insn "addi x26, x26, 4") (writes (write (reg "x26") (value "0x0000000080000068")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 57) (insn "csrrw x0, mepc, x26") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 58) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 59) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker: resume after the M-taken SSI.") (source "RVI-RV32I §1.1.4 #|end"))
)
