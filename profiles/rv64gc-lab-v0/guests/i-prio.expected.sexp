;; i-prio.expected.sexp — the expected observations for `i-prio.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-prio.expected.sexp schema/expectations.sexp

(expectations (program "i-prio.s") (entry "0x0000000080000000") (instructions 63) (fetches 60)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 76") (writes (write (reg "x1") (value "0x000000008000004c")))
    (derivation "the handler rides 76 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec programmed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002")))
    (derivation "the SSIP bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "csrrs x0, mip, x2") (writes)
    (derivation "SSIP <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 5) (insn "addi x8, x0, 1") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "raw material for SEIP's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "slli x8, x8, 9") (writes (write (reg "x8") (value "0x0000000000000200")))
    (derivation "x8 = 1 << 9 (the SEIP position).") (source "RVI-RV64I §3.1.2.1"))
  (step (n 7) (insn "csrrs x0, mip, x8") (writes)
    (derivation "SEIP <- 1 — and STIP is ALREADY 1 (the reset quirk: time 0 >= stimecmp 0).") (source "RVP-MACHINE §2.1.1.9; RVP-SSTC 12.1"))
  (step (n 8) (insn "csrrs x0, mie, x2") (writes)
    (derivation "SSIE <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 9) (insn "csrrs x0, mie, x8") (writes)
    (derivation "SEIE <- 1.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 10) (insn "addi x15, x0, 1") (writes (write (reg "x15") (value "0x0000000000000001")))
    (derivation "raw material for STIE's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "slli x15, x15, 5") (writes (write (reg "x15") (value "0x0000000000000020")))
    (derivation "x15 = 1 << 5.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 12) (insn "csrrs x0, mie, x15") (writes)
    (derivation "STIE <- 1: all three causes enabled.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 13) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1: the priority walk starts at the next boundary.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 15) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SEI interrupt in M: xcause carries the Interrupt bit with cause 9, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 16) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000009")))
    (derivation "the handler reads the cause it was entered for — the Interrupt bit with 9, then 1, then 5 (each visit sees its own).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 17) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x000000008000003c")))
    (derivation "mepc is the un-fetched pc each time.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 18) (insn "addi x10, x0, 15") (writes (write (reg "x10") (value "0x000000000000000f")))
    (derivation "the cause-number mask (mcause carries the Interrupt bit).") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "and x10, x11, x10") (writes (write (reg "x10") (value "0x0000000000000009")))
    (derivation "the visit key: 9, then 1, then 5.") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "addi x13, x0, 9") (writes (write (reg "x13") (value "0x0000000000000009")))
    (derivation "the SEI cause for the visit key.") (source "RVI-RV32I §1.1.4"))
  (step (n 21) (insn "beq x10, x13, clear_sei") (writes)
    (derivation "visit 1 disarms SEI only.") (source "RVI-RV32I §1.1.5"))
  (step (n 22) (insn "csrrc x0, mip, x8") (writes)
    (derivation "clear SEIP (x8 still 1 << 9 from the main flow).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 23) (insn "beq x0, x0, resume") (writes)
    (derivation "to the shared resume.") (source "RVI-RV32I §1.1.5"))
  (step (n 24) (insn "csrrs x13, mip, x0") (writes (write (reg "x13") (value "0x0000000000000022")))
    (derivation "the remaining pending set is visible (SEIP") (source "SSIP|STIP, then SSIP|STIP, then STIP, then 0). | RVP-MACHINE §2.1.1.9"))
  (step (n 25) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x000000008000003c")))
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 26) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x0000000080000040")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 27) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 28) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 29) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in M: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 30) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000001")))
    (derivation "the handler reads the cause it was entered for — the Interrupt bit with 9, then 1, then 5 (each visit sees its own).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 31) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000040")))
    (derivation "mepc is the un-fetched pc each time.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 32) (insn "addi x10, x0, 15") (writes (write (reg "x10") (value "0x000000000000000f")))
    (derivation "the cause-number mask (mcause carries the Interrupt bit).") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "and x10, x11, x10") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "the visit key: 9, then 1, then 5.") (source "RVI-RV32I §1.1.4"))
  (step (n 34) (insn "addi x13, x0, 9") (writes (write (reg "x13") (value "0x0000000000000009")))
    (derivation "the SEI cause for the visit key.") (source "RVI-RV32I §1.1.4"))
  (step (n 35) (insn "beq x10, x13, clear_sei") (writes)
    (derivation "visit 1 disarms SEI only.") (source "RVI-RV32I §1.1.5"))
  (step (n 36) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the SSI cause — and, on the STI fall-through, raw material for the high stimecmp.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "beq x10, x13, clear_ssi") (writes)
    (derivation "visit 2 disarms SSI only.") (source "RVI-RV32I §1.1.5"))
  (step (n 38) (insn "addi x8, x0, 2") (writes (write (reg "x8") (value "0x0000000000000002")))
    (derivation "SSIP's bit.") (source "RVI-RV32I §1.1.4"))
  (step (n 39) (insn "csrrc x0, mip, x8") (writes)
    (derivation "clear SSIP.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 40) (insn "csrrs x13, mip, x0") (writes (write (reg "x13") (value "0x0000000000000020")))
    (derivation "the remaining pending set is visible (SEIP") (source "SSIP|STIP, then SSIP|STIP, then STIP, then 0). | RVP-MACHINE §2.1.1.9"))
  (step (n 41) (insn "csrrs x14, mepc, x0") (writes)
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 42) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x0000000080000044")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 43) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 44) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 45) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the STI interrupt in M: xcause carries the Interrupt bit with cause 5, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 46) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000005")))
    (derivation "the handler reads the cause it was entered for — the Interrupt bit with 9, then 1, then 5 (each visit sees its own).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 47) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000044")))
    (derivation "mepc is the un-fetched pc each time.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 48) (insn "addi x10, x0, 15") (writes (write (reg "x10") (value "0x000000000000000f")))
    (derivation "the cause-number mask (mcause carries the Interrupt bit).") (source "RVI-RV32I §1.1.4"))
  (step (n 49) (insn "and x10, x11, x10") (writes (write (reg "x10") (value "0x0000000000000005")))
    (derivation "the visit key: 9, then 1, then 5.") (source "RVI-RV32I §1.1.4"))
  (step (n 50) (insn "addi x13, x0, 9") (writes (write (reg "x13") (value "0x0000000000000009")))
    (derivation "the SEI cause for the visit key.") (source "RVI-RV32I §1.1.4"))
  (step (n 51) (insn "beq x10, x13, clear_sei") (writes)
    (derivation "visit 1 disarms SEI only.") (source "RVI-RV32I §1.1.5"))
  (step (n 52) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the SSI cause — and, on the STI fall-through, raw material for the high stimecmp.") (source "RVI-RV32I §1.1.4"))
  (step (n 53) (insn "beq x10, x13, clear_ssi") (writes)
    (derivation "visit 2 disarms SSI only.") (source "RVI-RV32I §1.1.5"))
  (step (n 54) (insn "slli x13, x13, 12") (writes (write (reg "x13") (value "0x0000000000001000")))
    (derivation "fall through to the STI visit: x13 = 0x1000, above any time this guest reaches.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 55) (insn "csrrw x0, stimecmp, x13") (writes)
    (derivation "STIP <- 0 by computation — the timer cause is disarmed for good.") (source "RVP-SSTC 12.1"))
  (step (n 56) (insn "beq x0, x0, resume") (writes)
    (derivation "(the unconditional hop to the shared resume).") (source "RVI-RV32I §1.1.5"))
  (step (n 57) (insn "csrrs x13, mip, x0") (writes (write (reg "x13") (value "0x0000000000000000")))
    (derivation "the remaining pending set is visible (SEIP") (source "SSIP|STIP, then SSIP|STIP, then STIP, then 0). | RVP-MACHINE §2.1.1.9"))
  (step (n 58) (insn "csrrs x14, mepc, x0") (writes)
    (derivation "step the resume address.") (source "RVP-MACHINE §2.1.1.14"))
  (step (n 59) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x0000000080000048")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 60) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 61) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 62) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker: all three drained, in the spec's order.") (source "RVI-RV32I §1.1.4 #|end"))
)
