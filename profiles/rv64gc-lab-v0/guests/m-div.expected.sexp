;; m-div.expected.sexp — the expected observations for `m-div.s` (P4-SYSTEM.11,
;; the M corpus). EVD-05: every value below was derived from the pinned chapter (RVI-M
;; §11.1, Table 1's rows by name) with exact integers by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py m-div.expected.sexp schema/expectations.sexp

(expectations (program "m-div.s") (entry "0x0000000080000000") (instructions 27)
  (step (n 0) (insn "addi x5, x0, -7") (writes (write (reg "x5") (value "0xfffffffffffffff9")))
    (derivation "the dividend -7.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "addi x6, x0, 2") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "the divisor 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "div x7, x5, x6") (writes (write (reg "x7") (value "0xfffffffffffffffd")))
    (derivation "-7 / 2 rounds TOWARDS ZERO: 0xfffffffffffffffd (-3, not -4).") (source "RVI-M §11.1.2"))
  (step (n 3) (insn "rem x8, x5, x6") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "… the remainder takes the dividend's sign: 0xffffffffffffffff (-1).") (source "RVI-M §11.1.2"))
  (step (n 4) (insn "addi x10, x0, 7") (writes (write (reg "x10") (value "0x0000000000000007")))
    (derivation "the dividend 7.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "addi x11, x0, -2") (writes (write (reg "x11") (value "0xfffffffffffffffe")))
    (derivation "the divisor -2.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "div x12, x10, x11") (writes (write (reg "x12") (value "0xfffffffffffffffd")))
    (derivation "7 / -2: 0xfffffffffffffffd (-3).") (source "RVI-M §11.1.2"))
  (step (n 7) (insn "rem x13, x10, x11") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "… the remainder, the dividend's sign: 0x0000000000000001 (+1).") (source "RVI-M §11.1.2"))
  (step (n 8) (insn "div x14, x5, x11") (writes (write (reg "x14") (value "0x0000000000000003")))
    (derivation "-7 / -2: 0x0000000000000003 (+3).") (source "RVI-M §11.1.2"))
  (step (n 9) (insn "rem x15, x5, x11") (writes (write (reg "x15") (value "0xffffffffffffffff")))
    (derivation "… the remainder 0xffffffffffffffff (-1).") (source "RVI-M §11.1.2"))
  (step (n 10) (insn "div x16, x5, x0") (writes (write (reg "x16") (value "0xffffffffffffffff")))
    (derivation "DIVISION BY ZERO, signed: Table 1 - the quotient has all bits set, 0xffffffffffffffff; no trap.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 11) (insn "divu x17, x5, x0") (writes (write (reg "x17") (value "0xffffffffffffffff")))
    (derivation "by zero, unsigned: 2^64 - 1, all bits set, 0xffffffffffffffff.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 12) (insn "rem x18, x5, x0") (writes (write (reg "x18") (value "0xfffffffffffffff9")))
    (derivation "the remainder of division by zero equals the dividend: 0xfffffffffffffff9.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 13) (insn "remu x19, x5, x0") (writes (write (reg "x19") (value "0xfffffffffffffff9")))
    (derivation "… unsigned as well: the dividend, 0xfffffffffffffff9.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 14) (insn "addi x20, x0, 1") (writes (write (reg "x20") (value "0x0000000000000001")))
    (derivation "build the most-negative value: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "slli x20, x20, 63") (writes (write (reg "x20") (value "0x8000000000000000")))
    (derivation "… at bit 63 = -2^63.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 16) (insn "addi x21, x0, -1") (writes (write (reg "x21") (value "0xffffffffffffffff")))
    (derivation "the divisor -1.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "div x22, x20, x21") (writes (write (reg "x22") (value "0x8000000000000000")))
    (derivation "SIGNED OVERFLOW, -2^63 / -1: Table 1 - the quotient equals the dividend, 0x8000000000000000; no trap.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 18) (insn "addi x23, x0, 23") (writes (write (reg "x23") (value "0x0000000000000017")))
    (derivation "a sentinel the overflow remainder must REPLACE (a zero over a zero would show nothing).") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "rem x23, x20, x21") (writes (write (reg "x23") (value "0x0000000000000000")))
    (derivation "… and the remainder is zero: 0x0000000000000000.") (source "RVI-M §11.1.2 (Table 1)"))
  (step (n 20) (insn "divu x24, x21, x6") (writes (write (reg "x24") (value "0x7fffffffffffffff")))
    (derivation "(2^64 - 1) / 2 unsigned: 0x7fffffffffffffff.") (source "RVI-M §11.1.2"))
  (step (n 21) (insn "remu x25, x21, x6") (writes (write (reg "x25") (value "0x0000000000000001")))
    (derivation "… the unsigned remainder 0x0000000000000001.") (source "RVI-M §11.1.2"))
  (step (n 22) (insn "addi x26, x0, 26") (writes (write (reg "x26") (value "0x000000000000001a")))
    (derivation "a sentinel the zero quotient must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "divu x26, x5, x21") (writes (write (reg "x26") (value "0x0000000000000000")))
    (derivation "(2^64 - 7) / (2^64 - 1) unsigned: 0x0000000000000000.") (source "RVI-M §11.1.2"))
  (step (n 24) (insn "remu x27, x5, x21") (writes (write (reg "x27") (value "0xfffffffffffffff9")))
    (derivation "… the remainder is the whole dividend, 0xfffffffffffffff9.") (source "RVI-M §11.1.2"))
  (step (n 25) (insn "div x28, x20, x6") (writes (write (reg "x28") (value "0xc000000000000000")))
    (derivation "-2^63 / 2 - an exact signed quotient: 0xc000000000000000.") (source "RVI-M §11.1.2"))
  (step (n 26) (insn "divu x29, x20, x6") (writes (write (reg "x29") (value "0x4000000000000000")))
    (derivation "… read unsigned, 2^63 / 2: 0x4000000000000000.") (source "RVI-M §11.1.2"))
)
