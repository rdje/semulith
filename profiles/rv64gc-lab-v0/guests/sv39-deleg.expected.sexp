    (derivation "the S-side continuation: the S handler stepped sepc past the faulting load and the sret resumed in S.") (source "RVP-SUPERVISOR §4.1.3 (sepc); RVP-INSNS §4.2.2 (sret)"))
  (step (n 74) (insn "ecall") (writes)
    (derivation "ecall from S: medeleg bit 9 is CLEAR, so this trap lands in M — the selective-delegation control (same guest, two trap kinds, two destinations).") (source "RVP-MACHINE §2.1.3.1 (medeleg; mcause 9)"))
  (step (n 75) (insn "csrrs x22, mcause, x0") (writes (write (reg "x22") (value "0x0000000000000009")))
    (derivation "the M-side record: mcause=9 (ecall from S) — the S handler's scause path never saw it.") (source "RVP-MACHINE §2.1.3.1 (mcause 9)"))
  (step (n 76) (insn "csrrs x23, mtval, x0") (writes)
    (derivation "mtval = 0 for an ecall.") (source "RVP-CSR (mtval)"))
  (step (n 77) (insn "csrrs x24, mepc, x0") (writes (write (reg "x24") (value "0x0000000080000110")))
    (derivation "mepc = the ecall's pc.") (source "RVP-CSR (mepc)"))
  (step (n 78) (insn "addi x24, x24, 4") (writes (write (reg "x24") (value "0x0000000080000114")))
    (derivation "mepc stepped past the ecall.") (source "RVP-CSR (mepc)"))
  (step (n 79) (insn "csrrw x0, mepc, x24") (writes)
    (derivation "mepc stepped past the ecall.") (source "RVP-CSR (mepc)"))
  (step (n 80) (insn "mret") (writes)
    (derivation "mret resumes in S (MPP was S).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 81) (insn "addi x25, x0, 1") (writes (write (reg "x25") (value "0x0000000000000001")))
    (derivation "the M-side continuation: the M handler stepped mepc past the ecall and the mret resumed in S (MPP was S).") (source "RVP-CSR (mepc); RVP-INSNS §3.3.2 (mret)")))
