;; sv39-deleg.expected.sexp — the expected observations for `sv39-deleg.s` (P4-SYSTEM.3
;; slice e, the sv39 corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py sv39-deleg.expected.sexp schema/expectations.sexp

(expectations (program "sv39-deleg.s") (entry "0x0000000080000000") (instructions 82) (fetches 82) (never_written "x14")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "a trap vector materializes pc-relative.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 280") (writes (write (reg "x1") (value "0x0000000080000118")))
    (derivation "the trap vector materializes pc-relative (auipc forms pc + 0; the addi carries the layout-audited delta).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 2) (insn "csrrw x0, stvec, x1") (writes)
    (derivation "stvec := the S handler.") (source "RVP-SUPERVISOR §4.1.2 (stvec)"))
  (step (n 3) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x000000008000000c")))
    (derivation "a trap vector materializes pc-relative.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 4) (insn "addi x1, x1, 292") (writes (write (reg "x1") (value "0x0000000080000130")))
    (derivation "the integer/CSR effect per the pinned chapter.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec := the M handler.") (source "RVP-CSR (mtvec)"))
  (step (n 6) (insn "addi x2, x0, 1") (writes (write (reg "x2") (value "0x0000000000000001")))
    (derivation "medeleg bit 13 materializes.") (source "RVP-MACHINE §2.1.3.1 (medeleg)"))
  (step (n 7) (insn "slli x2, x2, 13") (writes (write (reg "x2") (value "0x0000000000002000")))
    (derivation "medeleg bit 13 materializes.") (source "RVP-MACHINE §2.1.3.1 (medeleg)"))
  (step (n 8) (insn "csrrw x0, medeleg, x2") (writes)
    (derivation "medeleg := 1<<13: LOAD page faults delegate to S; every other cause (ecall's 9 included) still lands in M.") (source "RVP-MACHINE §2.1.3.1 (medeleg)"))
  (step (n 9) (insn "auipc x11, 0") (writes (write (reg "x11") (value "0x0000000080000024")))
    (derivation "one step of an auipc+addi chain materializing a 0x8000_xxxx address pc-relative (lui would sign-extend bit 19 of the upper half; the chain never exceeds +/-2047 per step).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
