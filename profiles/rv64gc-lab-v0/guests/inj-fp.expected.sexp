;; inj-fp.expected.sexp — the expected observations for `inj-fp.s` (P4-SYSTEM.8,
;; the faults corpus). EVD-05: every value below was derived from the pinned chapters
;; and the .8 brief's declared unit discipline by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py inj-fp.expected.sexp schema/expectations.sexp

(expectations (program "inj-fp.s") (entry "0x0000000080000000") (instructions 53)
  (never_written "x27")
  (refuse (kind store) (base "0x80000400") (size "0x10"))
  (refuse (kind load) (base "0x80000420") (size "0x10"))
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 holds this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 116") (writes (write (reg "x1") (value "0x0000000080000074")))
    (derivation "the trap handler sits at entry + 0x74 — after the 29-instruction main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec <- the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "the data block: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "… << 31 = the region base …") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "addi x10, x10, 1024") (writes (write (reg "x10") (value "0x0000000080000400")))
    (derivation "… + 0x400: A (stores refused); A+0x20 = L (loads refused); A+0x40 = M (untouched).") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "addi x7, x0, 119") (writes (write (reg "x7") (value "0x0000000000000077")))
    (derivation "the value every write tries to write (0x77).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x28, x0, 1") (writes (write (reg "x28") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x28, x28, 13") (writes (write (reg "x28") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 9) (insn "csrrs x0, mstatus, x28") (writes)
    (derivation "FS := Initial.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 10) (insn "addi x15, x10, 32") (writes (write (reg "x15") (value "0x0000000080000420")))
    (derivation "x15 = L, the load-refused doubleword.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "addi x12, x0, 12") (writes (write (reg "x12") (value "0x000000000000000c")))
    (derivation "a read-back sentinel the load of A must REPLACE.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "addi x5, x0, -3") (writes (write (reg "x5") (value "0xfffffffffffffffd")))
    (derivation "a known double pattern …") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "fmv.d.x f2, x5") (writes)
    (derivation "… in f2 (an f-register write: FS Dirty).") (source "RVI-D §21.1.5"))
  (step (n 14) (insn "addi x6, x0, 3") (writes (write (reg "x6") (value "0x0000000000000003")))
    (derivation "both FS bits …") (source "RVI-RV32I §1.1.4"))
  (step (n 15) (insn "slli x6, x6, 13") (writes (write (reg "x6") (value "0x0000000000006000")))
    (derivation "… 3 << 13.") (source "RVP-CSR"))
  (step (n 16) (insn "csrrc x0, mstatus, x6") (writes)
    (derivation "FS := Off …") (source "RVI-ZICSR §5.1.1"))
  (step (n 17) (insn "addi x8, x0, 1") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "the Clean pattern …") (source "RVI-RV32I §1.1.4"))
  (step (n 18) (insn "slli x8, x8, 14") (writes (write (reg "x8") (value "0x0000000000004000")))
    (derivation "… 1 << 14.") (source "RVP-CSR"))
  (step (n 19) (insn "csrrs x0, mstatus, x8") (writes)
    (derivation "… then Clean: FS = 2.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "fld f2, x15, 0") (writes)
    (derivation "an FLD whose load is REFUSED: the load access fault 5 — f2 is NOT written, so FS is NOT dirtied.") (source "RVI-D §21.1.3; the experiment's refusal (load, L)"))
  (step (n 21) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000005")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 22) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000420")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 23) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000050")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 24) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000054")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 25) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 26) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 27) (insn "fmv.x.d x9, f2") (writes (write (reg "x9") (value "0xfffffffffffffffd")))
    (derivation "f2 still holds its pattern.") (source "RVI-D §21.1.5"))
  (step (n 28) (insn "csrrs x11, mstatus, x0") (writes (write (reg "x11") (value "0x0000000a00004080")))
    (derivation "FS still Clean, SD 0 — the faulting load committed no FP state.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 29) (insn "fsd f2, 0, x10") (writes)
    (derivation "an FSD whose store is REFUSED: the store access fault 7, A unchanged.") (source "RVI-D §21.1.3; the experiment's refusal (store, A)"))
  (step (n 30) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000007")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 31) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000400")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 32) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x000000008000005c")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 33) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000060")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 34) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 35) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 36) (insn "ld x12, x10, 0") (writes (write (reg "x12") (value "0x0000000000000000")))
    (derivation "A still reads 0.") (source "RVI-RV64I §3.1.3"))
  (step (n 37) (insn "flw f3, x15, 4") (writes)
    (derivation "an FLW inside L's refused bytes: cause 5, f3 untouched.") (source "RVI-F §20.1.5; the experiment's refusal (load, L)"))
  (step (n 38) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000005")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 39) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000424")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 40) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000064")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 41) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000068")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 42) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 43) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 44) (insn "fsw f2, 8, x10") (writes)
    (derivation "an FSW inside A's refused bytes: cause 7.") (source "RVI-F §20.1.5; the experiment's refusal (store, A)"))
  (step (n 45) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000007")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 46) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000408")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 47) (insn "csrrs x31, mepc, x0") (writes)
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 48) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x000000008000006c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 49) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 50) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 51) (insn "csrrs x13, mstatus, x0") (writes (write (reg "x13") (value "0x0000000a00004080")))
    (derivation "FS STILL Clean after four refused FP transfers.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 52) (insn "csrrs x14, mcause, x0") (writes (write (reg "x14") (value "0x0000000000000007")))
    (derivation "the last delivered cause (7).") (source "RVP-MACHINE §2.1.3.1 #|end"))
)
