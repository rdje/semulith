;; mm-wfi.expected.sexp — the expected observations for `mm-wfi.s` (P4-SYSTEM.2
;; slice f, the mode-matrix corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py mm-wfi.expected.sexp schema/expectations.sexp

(expectations (program "mm-wfi.s") (entry "0x0000000080000000") (instructions 45)
  (step (n 0) (insn "wfi") (writes)
    (derivation "WFI in M is always legal and behaves as a nop here.") (source "RVP-INSNS §3.3.3 (wfi)"))
  (step (n 1) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000004")))
    (derivation "auipc writes the instruction's own address (entry + 0x4).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 2) (insn "addi x1, x1, 188") (writes (write (reg "x1") (value "0x00000000800000c0")))
    (derivation "the delta 188 from the auipc's pc lands on the trap handler's first instruction at entry+0xC0.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 3) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed to the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 4) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "the MPP=S pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "1 << 11 is the MPP field's S encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 6) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- 0x800: MPP=S.") (source "RVP-CSR (mstatus field table)"))
  (step (n 7) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x000000008000001c")))
    (derivation "auipc writes the instruction's own address (entry + 0x1c).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 8) (insn "addi x4, x4, 32") (writes (write (reg "x4") (value "0x000000008000003c")))
    (derivation "the delta 32 from the auipc's pc lands on the S-mode cell at entry+0x3C.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 9) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x3C.") (source "RVI-ZICSR §5.1.1"))
  (step (n 10) (insn "mret") (writes)
    (derivation "drop to S at the WFI cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 11) (insn "wfi") (writes)
    (derivation "WFI in S with TW=0 is legal: a nop.") (source "RVP-INSNS §3.3.3 (wfi; TW=0)"))
  (step (n 12) (insn "ecall") (writes)
    (derivation "ecall from S: cause 9, entering the handler at stage 0.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 13) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 0 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 14) (insn "beq x12, x0, stage1") (writes)
    (derivation "stage 0: branch to the TW-enable stage.") (source "RVI-RV32I §1.1.5"))
  (step (n 15) (insn "addi x12, x0, 1") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "the stage counter becomes 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 16) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 1.") (source "RVI-ZICSR §5.1.1"))
  (step (n 17) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000009")))
    (derivation "the handler observes cause 9.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 18) (insn "addi x2, x0, 1") (writes (write (reg "x2") (value "0x0000000000000001")))
    (derivation "the TW pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "slli x2, x2, 21") (writes (write (reg "x2") (value "0x0000000000200000")))
    (derivation "1 << 21 is TW.") (source "RVP-CSR (mstatus.TW is bit 21)"))
  (step (n 20) (insn "csrrs x0, mstatus, x2") (writes)
    (derivation "set mstatus.TW.") (source "RVP-CSR (mstatus field table)"))
  (step (n 21) (insn "csrrs x8, mepc, x0") (writes (write (reg "x8") (value "0x0000000080000040")))
    (derivation "mepc is the ecall's address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 22) (insn "addi x8, x8, 4") (writes (write (reg "x8") (value "0x0000000080000044")))
    (derivation "step mepc past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "csrrw x0, mepc, x8") (writes)
    (derivation "mepc <- entry+0x44.") (source "RVI-ZICSR §5.1.1"))
  (step (n 24) (insn "mret") (writes)
    (derivation "back to S at the TW=1 WFI cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 25) (insn "wfi") (writes)
    (derivation "WFI in S with TW=1 traps illegal-instruction.") (source "RVP-INSNS §3.3.3 (wfi; TW=1 makes WFI illegal below M)"))
  (step (n 26) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 1 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 27) (insn "beq x12, x0, stage1") (writes)
    (derivation "stage 1: the first branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 28) (insn "addi x13, x0, 1") (writes (write (reg "x13") (value "0x0000000000000001")))
    (derivation "the comparison constant 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "beq x12, x13, stage2") (writes)
    (derivation "stage 1: branch to the drop-to-U stage.") (source "RVI-RV32I §1.1.5"))
  (step (n 30) (insn "addi x12, x0, 2") (writes (write (reg "x12") (value "0x0000000000000002")))
    (derivation "the stage counter becomes 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 2.") (source "RVI-ZICSR §5.1.1"))
  (step (n 32) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000002")))
    (derivation "the handler's second visit observes cause 2 (the TW=1 WFI).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 33) (insn "csrrw x0, mstatus, x0") (writes)
    (derivation "mstatus <- 0 clears MPP to U (and TW back to 0).") (source "RVP-CSR (mstatus field table)"))
  (step (n 34) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x000000008000011c")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 35) (insn "addi x4, x4, -152") (writes (write (reg "x4") (value "0x0000000080000084")))
    (derivation "the delta -152 lands on the U-mode WFI cell at entry+0x84.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 36) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x84.") (source "RVI-ZICSR §5.1.1"))
  (step (n 37) (insn "mret") (writes)
    (derivation "drop to U at the WFI cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 38) (insn "wfi") (writes)
    (derivation "WFI in U-mode traps illegal-instruction on this composition (the laboratory's WFI-in-U policy: U-mode WFI is not implemented).") (source "RVP-INSNS §3.3.3 (wfi is optionally unavailable in U); the laboratory's policy"))
  (step (n 39) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 2 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 40) (insn "beq x12, x0, stage1") (writes)
    (derivation "stage 2: the first branch does not fire.") (source "RVI-RV32I §1.1.5"))
  (step (n 41) (insn "addi x13, x0, 1") (writes)
    (derivation "the comparison constant 1 — x13 already holds 1, no change observed.") (source "RVI-RV32I §1.1.4"))
  (step (n 42) (insn "beq x12, x13, stage2") (writes)
    (derivation "stage 2: the second branch does not fire either — fall through.") (source "RVI-RV32I §1.1.5"))
  (step (n 43) (insn "csrrs x15, mcause, x0") (writes (write (reg "x15") (value "0x0000000000000002")))
    (derivation "the handler's third visit observes cause 2 (the U-mode WFI).") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 44) (insn "csrrs x8, mepc, x0") (writes (write (reg "x8") (value "0x0000000080000084")))
    (derivation "mepc is the trapped U-mode wfi's address.") (source "RVP-MACHINE §2.1.3.1")))
