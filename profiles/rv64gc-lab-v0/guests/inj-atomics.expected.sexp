;; inj-atomics.expected.sexp — the expected observations for `inj-atomics.s` (P4-SYSTEM.8,
;; the faults corpus). EVD-05: every value below was derived from the pinned chapters
;; and the .8 brief's declared unit discipline by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py inj-atomics.expected.sexp schema/expectations.sexp

(expectations (program "inj-atomics.s") (entry "0x0000000080000000") (instructions 47)
  (never_written "x27")
  (refuse (kind store) (base "0x80000400") (size "0x10"))
  (refuse (kind load) (base "0x80000420") (size "0x10"))
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 holds this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 92") (writes (write (reg "x1") (value "0x000000008000005c")))
    (derivation "the trap handler sits at entry + 0x5c — after the 23-instruction main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec <- the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "the data block: 1 …") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "… << 31 = the region base …") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "addi x10, x10, 1024") (writes (write (reg "x10") (value "0x0000000080000400")))
    (derivation "… + 0x400: A (stores refused); A+0x20 = L (loads refused); A+0x40 = M (untouched).") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "addi x7, x0, 119") (writes (write (reg "x7") (value "0x0000000000000077")))
    (derivation "the value every write tries to write (0x77).") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x5, x0, 5") (writes (write (reg "x5") (value "0x0000000000000005")))
    (derivation "sentinels: x5 …") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "addi x11, x0, 11") (writes (write (reg "x11") (value "0x000000000000000b")))
    (derivation "… x11 …") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "addi x13, x0, 13") (writes (write (reg "x13") (value "0x000000000000000d")))
    (derivation "… x13 — each left untouched by the instruction that faults.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "addi x8, x0, 8") (writes (write (reg "x8") (value "0x0000000000000008")))
    (derivation "read-back sentinels the loads must REPLACE: x8 …") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "addi x12, x0, 12") (writes (write (reg "x12") (value "0x000000000000000c")))
    (derivation "… and x12.") (source "RVI-RV32I §1.1.4"))
  (step (n 12) (insn "addi x15, x10, 32") (writes (write (reg "x15") (value "0x0000000080000420")))
    (derivation "x15 = L, the load-refused doubleword.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "addi x16, x10, 64") (writes (write (reg "x16") (value "0x0000000080000440")))
    (derivation "x16 = M, refused for nothing.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "lr.d x5, (x15)") (writes)
    (derivation "an LR whose load is REFUSED: the load access fault 5 (an LR is a load), x5 untouched — and no reservation is registered (it is registered only on a completed load).") (source "RVI-A §12.1.2; the experiment's refusal (load, L)"))
  (step (n 15) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000005")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 16) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000420")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 17) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000038")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 18) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x000000008000003c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 21) (insn "sc.d x6, x7, (x16)") (writes (write (reg "x6") (value "0x0000000000000001")))
    (derivation "so an SC (to M, allowed) finds no reservation: it FAILS — x6 <- 1, nothing stored.") (source "RVI-A §12.1.2; state.sexp's deterministic SC policy"))
  (step (n 22) (insn "ld x8, x16, 0") (writes (write (reg "x8") (value "0x0000000000000000")))
    (derivation "M still reads 0: the failed SC wrote nothing.") (source "RVI-RV64I §3.1.3"))
  (step (n 23) (insn "lr.d x9, (x10)") (writes)
    (derivation "an LR on A (loads of A are allowed): x9 <- 0, the reservation registered on A.") (source "RVI-A §12.1.2"))
  (step (n 24) (insn "sc.d x11, x7, (x10)") (writes)
    (derivation "the SC's store to A is REFUSED: the store access fault 7, x11 untouched, A unchanged — the trap clears nothing (the declared policy).") (source "RVI-A §12.1.2; the experiment's refusal (store, A)"))
  (step (n 25) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000007")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 26) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000400")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 27) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000048")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 28) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x000000008000004c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 30) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 31) (insn "amoadd.w x13, x7, (x10)") (writes)
    (derivation "an AMO on A: its LOAD half completes, its STORE half is refused — cause 7 after the first suboperation, x13 untouched, A unchanged (the completed read is not rolled back, and it changed nothing).") (source "RVI-A §12.1.4; the experiment's refusal (store, A)"))
  (step (n 32) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 33) (insn "csrrs x30, mtval, x0") (writes)
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 34) (insn "csrrs x31, mepc, x0") (writes)
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 35) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000050")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 37) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 38) (insn "ld x12, x10, 0") (writes (write (reg "x12") (value "0x0000000000000000")))
    (derivation "A still reads 0.") (source "RVI-RV64I §3.1.3"))
  (step (n 39) (insn "amoor.d x13, x7, (x15)") (writes)
    (derivation "an AMO on L: its LOAD half is refused, so its store is never issued — cause 7 (an AMO's access faults are store/AMO faults), x13 untouched.") (source "RVI-A §12.1.4; the experiment's refusal (load, L)"))
  (step (n 40) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 41) (insn "csrrs x30, mtval, x0") (writes (write (reg "x30") (value "0x0000000080000420")))
    (derivation "the faulting address.") (source "RVP-MACHINE §2.1.4"))
  (step (n 42) (insn "csrrs x31, mepc, x0") (writes (write (reg "x31") (value "0x0000000080000054")))
    (derivation "the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 43) (insn "addi x31, x31, 4") (writes (write (reg "x31") (value "0x0000000080000058")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 44) (insn "csrrw x0, mepc, x31") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 45) (insn "mret") (writes)
    (derivation "back at mepc, in the mode the trap came from (MPP).") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 46) (insn "csrrs x14, mcause, x0") (writes (write (reg "x14") (value "0x0000000000000007")))
    (derivation "the last delivered cause (7).") (source "RVP-MACHINE §2.1.3.1 #|end"))
)
