;; mm-csr-ro-write.expected.sexp — the expected observations for `mm-csr-ro-write.s` (P4-SYSTEM.8,
;; the faults corpus). EVD-05: every value below was derived from the pinned chapters
;; and the .8 brief's declared unit discipline by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py mm-csr-ro-write.expected.sexp schema/expectations.sexp

(expectations (program "mm-csr-ro-write.s") (entry "0x0000000080000000") (instructions 51)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 holds this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 84") (writes (write (reg "x1") (value "0x0000000080000054")))
    (derivation "the trap handler sits at entry + 0x54 — after the 21-instruction main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec <- the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x5, x0, 7") (writes (write (reg "x5") (value "0x0000000000000007")))
    (derivation "the sentinel each refused instruction must leave untouched.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x6, x0, 9") (writes (write (reg "x6") (value "0x0000000000000009")))
    (derivation "a value to (try to) write.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "addi x7, x0, 11") (writes (write (reg "x7") (value "0x000000000000000b")))
    (derivation "another sentinel.") (source "RVI-RV32I §1.1.4"))
  (step (n 6) (insn "addi x8, x0, 13") (writes (write (reg "x8") (value "0x000000000000000d")))
    (derivation "another sentinel.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x9, x0, 15") (writes (write (reg "x9") (value "0x000000000000000f")))
    (derivation "another sentinel.") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "addi x10, x0, 17") (writes (write (reg "x10") (value "0x0000000000000011")))
    (derivation "another sentinel.") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "addi x11, x0, 19") (writes (write (reg "x11") (value "0x0000000000000013")))
    (derivation "a sentinel the legal read must REPLACE.") (source "RVI-RV32I §1.1.4"))
  (step (n 10) (insn "addi x12, x0, 21") (writes (write (reg "x12") (value "0x0000000000000015")))
    (derivation "another sentinel the legal read must replace.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "csrrw x5, mhartid, x6") (writes)
    (derivation "a write to the read-only mhartid: illegal — and the instruction faults as a unit, so rd keeps 7.") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000002")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 13) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x000000008000002c")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 14) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x0000000080000030")))
