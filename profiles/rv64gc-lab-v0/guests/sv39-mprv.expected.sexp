    (derivation "MPRV=0: the same VA is now a PHYSICAL address — 0x0040_2000 is outside the declared region, a load ACCESS fault (cause 5, mtval = the address), visibly distinct from the page faults; x16 is never written.") (source "RVP-MACHINE §2.1.1.6.4 (MPRV); RVI-RV32I §1.1.6 (D-ADDRESS-SPACE)"))
  (step (n 69) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000005")))
    (derivation "the fault-record path: mcause/mtval/mepc into x7/x8/x9, mepc stepped past the faulting instruction, mret.") (source "RVP-CSR (mcause/mtval/mepc); RVI-ZICSR §5.1.1"))
  (step (n 70) (insn "csrrs x8, mtval, x0") (writes)
    (derivation "the fault-record path: mcause/mtval/mepc into x7/x8/x9, mepc stepped past the faulting instruction, mret.") (source "RVP-CSR (mcause/mtval/mepc); RVI-ZICSR §5.1.1"))
  (step (n 71) (insn "csrrs x9, mepc, x0") (writes (write (reg "x9") (value "0x00000000800000f8")))
    (derivation "the fault-record path: mcause/mtval/mepc into x7/x8/x9, mepc stepped past the faulting instruction, mret.") (source "RVP-CSR (mcause/mtval/mepc); RVI-ZICSR §5.1.1"))
  (step (n 72) (insn "addi x9, x9, 4") (writes (write (reg "x9") (value "0x00000000800000fc")))
    (derivation "the fault-record path: mcause/mtval/mepc into x7/x8/x9, mepc stepped past the faulting instruction, mret.") (source "RVP-CSR (mcause/mtval/mepc); RVI-ZICSR §5.1.1"))
  (step (n 73) (insn "csrrw x0, mepc, x9") (writes)
    (derivation "the fault-record path: mcause/mtval/mepc into x7/x8/x9, mepc stepped past the faulting instruction, mret.") (source "RVP-CSR (mcause/mtval/mepc); RVI-ZICSR §5.1.1"))
  (step (n 74) (insn "mret") (writes)
    (derivation "the fault-record path: mcause/mtval/mepc into x7/x8/x9, mepc stepped past the faulting instruction, mret.") (source "RVP-CSR (mcause/mtval/mepc); RVI-ZICSR §5.1.1"))
  (step (n 75) (insn "addi x21, x0, 1") (writes (write (reg "x21") (value "0x0000000000000001")))
    (derivation "the continuation proof: both faults recorded, the handler resumed past each. Execution NEVER left M despite MPRV=1 — with no code mapping present, a translated fetch would have page-faulted on root[2]=0; none did (fetch is MPRV-immune).") (source "RVP-MACHINE §2.1.1.6.4 (MPRV applies to loads/stores only)")))
