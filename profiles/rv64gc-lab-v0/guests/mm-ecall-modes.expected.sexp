;; mm-ecall-modes.expected.sexp — the expected observations for `mm-ecall-modes.s` (P4-SYSTEM.2
;; slice f, the mode-matrix corpus). EVD-05: every value below was derived from the
;; pinned chapters BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py mm-ecall-modes.expected.sexp schema/expectations.sexp

(expectations (program "mm-ecall-modes.s") (entry "0x0000000080000000") (instructions 61)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "auipc writes the instruction's own address (entry + 0x0).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 152") (writes (write (reg "x1") (value "0x0000000080000098")))
    (derivation "the delta 152 from the auipc's pc lands on the trap handler's first instruction at entry+0x98.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec is programmed to the handler; rd=x0 discards the old value.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "the mode marker starts at 1 (M).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "ecall") (writes)
    (derivation "ecall from M: cause 11, mepc the ecall's own address, taken in M.") (source "RVP-MACHINE §2.1.3.1 (mcause 11 = ecall from M)"))
  (step (n 5) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 0 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 6) (insn "addi x13, x0, 2") (writes (write (reg "x13") (value "0x0000000000000002")))
    (derivation "the drop-stage comparison constant 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "beq x12, x13, dropU") (writes)
    (derivation "stage 0: not the drop visit.") (source "RVI-RV32I §1.1.5"))
  (step (n 8) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x000000000000000b")))
    (derivation "the handler observes cause 11.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 9) (insn "csrrs x8, mepc, x0") (writes (write (reg "x8") (value "0x0000000080000010")))
    (derivation "mepc is the M-mode ecall's address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 10) (insn "addi x8, x8, 4") (writes (write (reg "x8") (value "0x0000000080000014")))
    (derivation "the handler steps mepc past the ecall.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "csrrw x0, mepc, x8") (writes)
    (derivation "mepc <- entry+0x14.") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "addi x12, x12, 1") (writes (write (reg "x12") (value "0x0000000000000001")))
    (derivation "the stage counter advances to 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 13) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 1.") (source "RVI-ZICSR §5.1.1"))
  (step (n 14) (insn "mret") (writes)
    (derivation "return in M to the ecall's successor.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 15) (insn "addi x6, x0, 2") (writes (write (reg "x6") (value "0x0000000000000002")))
    (derivation "the completion marker for the M-mode cell.") (source "RVI-RV32I §1.1.4"))
  (step (n 16) (insn "addi x3, x0, 1") (writes (write (reg "x3") (value "0x0000000000000001")))
    (derivation "the MPP=S pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "slli x3, x3, 11") (writes (write (reg "x3") (value "0x0000000000000800")))
    (derivation "1 << 11 is the MPP field's S encoding.") (source "RVP-CSR (mstatus.MPP)"))
  (step (n 18) (insn "csrrw x0, mstatus, x3") (writes)
    (derivation "mstatus <- 0x800: MPP=S — written in M, where mstatus is accessible.") (source "RVP-CSR (mstatus field table)"))
  (step (n 19) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000024")))
    (derivation "auipc writes the instruction's own address (entry + 0x24).") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 20) (insn "addi x4, x4, 32") (writes (write (reg "x4") (value "0x0000000080000044")))
    (derivation "the delta 32 from the auipc's pc lands on the S-mode cell at entry+0x44.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 21) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x44.") (source "RVI-ZICSR §5.1.1"))
  (step (n 22) (insn "mret") (writes)
    (derivation "drop to S at the second cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 23) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000002")))
    (derivation "the mode marker becomes 2 (S).") (source "RVI-RV32I §1.1.4"))
  (step (n 24) (insn "ecall") (writes)
    (derivation "ecall from S: medeleg is reset (all clear), so it is taken in M with cause 9.") (source "RVP-MACHINE §2.1.3.1 (mcause 9 = ecall from S; medeleg)"))
  (step (n 25) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 1 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 26) (insn "addi x13, x0, 2") (writes)
    (derivation "the comparison constant — x13 already holds 2, no change observed.") (source "RVI-RV32I §1.1.4"))
  (step (n 27) (insn "beq x12, x13, dropU") (writes)
    (derivation "stage 1: not the drop visit yet.") (source "RVI-RV32I §1.1.5"))
  (step (n 28) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000009")))
    (derivation "the handler observes cause 9.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 29) (insn "csrrs x8, mepc, x0") (writes (write (reg "x8") (value "0x0000000080000048")))
    (derivation "mepc is the S-mode ecall's address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 30) (insn "addi x8, x8, 4") (writes (write (reg "x8") (value "0x000000008000004c")))
    (derivation "the handler steps mepc past the ecall.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "csrrw x0, mepc, x8") (writes)
    (derivation "mepc <- entry+0x4C.") (source "RVI-ZICSR §5.1.1"))
  (step (n 32) (insn "addi x12, x12, 1") (writes (write (reg "x12") (value "0x0000000000000002")))
    (derivation "the stage counter advances to 2.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 2.") (source "RVI-ZICSR §5.1.1"))
  (step (n 34) (insn "mret") (writes)
    (derivation "MPP was S, so the return lands back in S.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 35) (insn "addi x6, x6, 1") (writes (write (reg "x6") (value "0x0000000000000003")))
    (derivation "the completion marker for the S-mode cell.") (source "RVI-RV32I §1.1.4"))
  (step (n 36) (insn "ecall") (writes)
    (derivation "a second ecall from S: the M handler performs the mode drop (mstatus is M-level, so the drop cannot be inline S code).") (source "RVP-MACHINE §2.1.3.1; RVP-CSR §2.1 (mstatus is M-level)"))
  (step (n 37) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 2 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 38) (insn "addi x13, x0, 2") (writes)
    (derivation "the comparison constant — no change observed.") (source "RVI-RV32I §1.1.4"))
  (step (n 39) (insn "beq x12, x13, dropU") (writes)
    (derivation "stage 2: branch to the drop sequence.") (source "RVI-RV32I §1.1.5"))
  (step (n 40) (insn "csrrs x7, mcause, x0") (writes)
    (derivation "cause 9 again — x7 already holds 9, no change observed.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 41) (insn "addi x12, x0, 3") (writes (write (reg "x12") (value "0x0000000000000003")))
    (derivation "the stage counter becomes 3.") (source "RVI-RV32I §1.1.4"))
  (step (n 42) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 3.") (source "RVI-ZICSR §5.1.1"))
  (step (n 43) (insn "csrrw x0, mstatus, x0") (writes)
    (derivation "mstatus <- 0 clears MPP to U — in M, where the write is legal.") (source "RVP-CSR (mstatus field table)"))
  (step (n 44) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x00000000800000d0")))
    (derivation "auipc writes the instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 45) (insn "addi x4, x4, -104") (writes (write (reg "x4") (value "0x0000000080000068")))
    (derivation "the delta -104 lands on the U-mode cell at entry+0x68.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 46) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc <- entry+0x68.") (source "RVI-ZICSR §5.1.1"))
  (step (n 47) (insn "mret") (writes)
    (derivation "drop to U at the third cell.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 48) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000003")))
    (derivation "the mode marker becomes 3 (U).") (source "RVI-RV32I §1.1.4"))
  (step (n 49) (insn "ecall") (writes)
    (derivation "ecall from U: cause 8, taken in M (medeleg clear).") (source "RVP-MACHINE §2.1.3.1 (mcause 8 = ecall from U)"))
  (step (n 50) (insn "csrrs x12, mscratch, x0") (writes)
    (derivation "the stage counter reads 3 — no change observed.") (source "RVI-ZICSR §5.1.1"))
  (step (n 51) (insn "addi x13, x0, 2") (writes)
    (derivation "the comparison constant — no change observed.") (source "RVI-RV32I §1.1.4"))
  (step (n 52) (insn "beq x12, x13, dropU") (writes)
    (derivation "stage 3: not the drop visit.") (source "RVI-RV32I §1.1.5"))
  (step (n 53) (insn "csrrs x7, mcause, x0") (writes (write (reg "x7") (value "0x0000000000000008")))
    (derivation "the handler observes cause 8.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 54) (insn "csrrs x8, mepc, x0") (writes (write (reg "x8") (value "0x000000008000006c")))
    (derivation "mepc is the U-mode ecall's address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 55) (insn "addi x8, x8, 4") (writes (write (reg "x8") (value "0x0000000080000070")))
    (derivation "the handler steps mepc past the ecall.") (source "RVI-RV32I §1.1.4"))
  (step (n 56) (insn "csrrw x0, mepc, x8") (writes)
    (derivation "mepc <- entry+0x70.") (source "RVI-ZICSR §5.1.1"))
  (step (n 57) (insn "addi x12, x12, 1") (writes (write (reg "x12") (value "0x0000000000000004")))
    (derivation "the stage counter advances to 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 58) (insn "csrrw x0, mscratch, x12") (writes)
    (derivation "mscratch <- 4.") (source "RVI-ZICSR §5.1.1"))
  (step (n 59) (insn "mret") (writes)
    (derivation "the trap recorded MPP=U, so the return lands back in U.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 60) (insn "addi x6, x6, 1") (writes (write (reg "x6") (value "0x0000000000000004")))
    (derivation "the completion marker for the U-mode cell.") (source "RVI-RV32I §1.1.4")))
