;; dir-cmp-branch.expected.sexp — the expected observations for `dir-cmp-branch.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-cmp-branch.expected.sexp schema/expectations.sexp

(comment "dir-cmp-branch.expected.sexp — the expected observations for `dir-cmp-branch.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The idiom under test: the branch's condition register is written by the immediately" "preceding comparison — the compiler's canonical compare→branch pair. The skipped markers" "(x8 <- 17, x8 <- 34) must NEVER be written; the taken branches jump over them.")
(expectations (program "dir-cmp-branch.s") (entry "0x80000000") (instructions 13) (never_written "x8") (step (n 0) (insn "addi x5, x0, 5") (writes (write (reg "x5") (value "0x0000000000000005"))) (derivation "The comparands.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "addi x6, x0, 7") (writes (write (reg "x6") (value "0x0000000000000007"))) (derivation "The comparands.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "slt x7, x5, x6") (writes (write (reg "x7") (value "0x0000000000000001"))) (derivation "SLT: 5 < 7 signed → 1.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "bne x7, x0, l1") (writes ) (derivation "BNE on the FRESH predicate: 1 != 0 → TAKEN to l1 (pc + 8). A branch writes no register; the taken direction is observed by the next step's pc and by x8 never receiving 17.") (source "RVI-RV32I §1.1.5")) (step (n 4) (insn "slti x7, x6, 0") (writes (write (reg "x7") (value "0x0000000000000000"))) (derivation "SLTI: 7 < 0 signed → 0 — a change from 1, so the vocabulary records it.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "beq x7, x0, l2") (writes ) (derivation "BEQ on the fresh predicate: 0 == 0 → TAKEN to l2.") (source "RVI-RV32I §1.1.5")) (step (n 6) (insn "sub x7, x6, x6") (writes ) (derivation "SUB: 7 − 7 = 0 — x7 already holds 0 from step 4, so the visible-change vocabulary records nothing.") (source "RVI-RV32I §1.1.4; state.sexp")) (step (n 7) (insn "bne x7, x0, l3") (writes ) (derivation "BNE: 0 != 0 false → NOT taken; execution falls through to the addi.") (source "RVI-RV32I §1.1.5")) (step (n 8) (insn "addi x9, x0, 3") (writes (write (reg "x9") (value "0x0000000000000003"))) (derivation "The not-taken path executes.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "slt x7, x5, x6") (writes (write (reg "x7") (value "0x0000000000000001"))) (derivation "The predicate recomputed: 1 again.") (source "RVI-RV32I §1.1.4")) (step (n 10) (insn "beq x7, x0, l4") (writes ) (derivation "BEQ: 1 == 0 false → NOT taken.") (source "RVI-RV32I §1.1.5")) (step (n 11) (insn "addi x10, x0, 4") (writes (write (reg "x10") (value "0x0000000000000004"))) (derivation "The not-taken path executes.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "addi x11, x0, 11") (writes (write (reg "x11") (value "0x000000000000000B"))) (derivation "The landing: all four senses (taken/not-taken × bne/beq) retired on computed predicates.") (source "RVI-RV32I §1.1.4")))
