;; a-amo-arith-d.expected.sexp — the expected observations for `a-amo-arith-d.s` (P4-SYSTEM.4
;; slice d, the atomics corpus). EVD-05: every value below was derived from the pinned
;; chapters and the declared deterministic SC policy (state.sexp) by the spec-side
;; authoring model BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py a-amo-arith-d.expected.sexp schema/expectations.sexp

(expectations (program "a-amo-arith-d.s") (entry "0x0000000080000000") (instructions 20)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001")))
    (derivation "raw material for the region base.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000")))
    (derivation "x10 = 0x8000_0000.") (source "RVI-RV64I §3.1.2.1"))
  (step (n 2) (insn "addi x1, x10, 256") (writes (write (reg "x1") (value "0x0000000080000100")))
    (derivation "the cell's data address.") (source "RVI-RV32I §1.1.4"))
  (step (n 3) (insn "addi x7, x0, -5") (writes (write (reg "x7") (value "0xfffffffffffffffb")))
    (derivation "x7 = -5 = 0xFFFFFFFFFFFFFFFB: a negative initial value.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x6, x0, 7") (writes (write (reg "x6") (value "0x0000000000000007")))
    (derivation "x6 = 7.") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "sd x7, 0, x1") (writes)
    (derivation "mem = -5 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 6) (insn "amoadd.d x5, x6, (x1)") (writes (write (reg "x5") (value "0xfffffffffffffffb")))
    (derivation "rd <- the old doubleword -5; mem <- -5 + 7 = 2.") (source "RVI-A §12.1.4"))
  (step (n 7) (insn "ld x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000002")))
    (derivation "read-back: -1.") (source "RVI-RV64I §3.1.3"))
  (step (n 8) (insn "sd x7, 0, x1") (writes)
    (derivation "mem = -5 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 9) (insn "amoswap.d x5, x6, (x1)") (writes)
    (derivation "rd <- -5; mem <- 7.") (source "RVI-A §12.1.4"))
  (step (n 10) (insn "ld x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000007")))
    (derivation "read-back: -1.") (source "RVI-RV64I §3.1.3"))
  (step (n 11) (insn "sd x7, 0, x1") (writes)
    (derivation "mem = -5 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 12) (insn "amoxor.d x5, x6, (x1)") (writes)
    (derivation "rd <- -5; mem <- -5 XOR 7 = 0xFFFFFFFFFFFFFFFC (-4).") (source "RVI-A §12.1.4"))
  (step (n 13) (insn "ld x8, x1, 0") (writes (write (reg "x8") (value "0xfffffffffffffffc")))
    (derivation "read-back: -1.") (source "RVI-RV64I §3.1.3"))
  (step (n 14) (insn "sd x7, 0, x1") (writes)
    (derivation "mem = -5 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 15) (insn "amoand.d x5, x6, (x1)") (writes)
    (derivation "rd <- -5; mem <- -5 AND 7 = 3.") (source "RVI-A §12.1.4"))
  (step (n 16) (insn "ld x8, x1, 0") (writes (write (reg "x8") (value "0x0000000000000003")))
    (derivation "read-back: -1.") (source "RVI-RV64I §3.1.3"))
  (step (n 17) (insn "sd x7, 0, x1") (writes)
    (derivation "mem = -5 (the or cell).") (source "RVI-RV64I §3.1.3"))
  (step (n 18) (insn "amoor.d x5, x6, (x1)") (writes)
    (derivation "rd <- -5; mem <- -5 OR 7 = 0xFFFFFFFFFFFFFFFF (-1).") (source "RVI-A §12.1.4"))
  (step (n 19) (insn "ld x8, x1, 0") (writes (write (reg "x8") (value "0xffffffffffffffff")))
    (derivation "read-back: -1.") (source "RVI-RV64I §3.1.3"))
)
