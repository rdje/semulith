;; d-f2f.expected.sexp — the expected observations for `d-f2f.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-f2f.expected.sexp schema/expectations.sexp

(expectations (program "d-f2f.s") (entry "0x0000000080000000") (instructions 65)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3fd55") (writes (write (reg "x5") (value "0x000000003fd55000")))
    (derivation "build 0x3fd5555555555555: the upper word 0x3fd55555 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "addi x5, x5, 1365") (writes (write (reg "x5") (value "0x000000003fd55555")))
    (derivation "… its low 12 bits (1365).") (source "RVI-RV32I §1.1.4"))
  (step (n 5) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x3fd5555500000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 6) (insn "lui x28, 0x55555") (writes (write (reg "x28") (value "0x0000000055555000")))
    (derivation "the lower word 0x55555555.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "addi x28, x28, 1365") (writes (write (reg "x28") (value "0x0000000055555555")))
    (derivation "… its low 12 bits (1365).") (source "RVI-RV32I §1.1.4"))
  (step (n 8) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x5555555500000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 9) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000055555555")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 10) (insn "or x5, x5, x28") (writes (write (reg "x5") (value "0x3fd5555555555555")))
    (derivation "x5 = 0x3fd5555555555555.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 12) (insn "fcvt.s.d f2, f1, 0") (writes)
    (derivation "1/3 to single in RNE: inexact, NaN-boxed.") (source "RVI-D §21.1.5"))
  (step (n 13) (insn "fmv.x.d x6, f2") (writes (write (reg "x6") (value "0xffffffff3eaaaaab")))
    (derivation "fmv.x.d: f2's 64 bits, unmodified: x6 = 0xffffffff3eaaaaab.") (source "RVI-D §21.1.5"))
  (step (n 14) (insn "fcvt.s.d f3, f1, 1") (writes)
    (derivation "… in RTZ: truncated — one ulp below RNE's (which rounded up).") (source "RVI-D §21.1.5"))
  (step (n 15) (insn "fmv.x.d x7, f3") (writes (write (reg "x7") (value "0xffffffff3eaaaaaa")))
    (derivation "fmv.x.d: f3's 64 bits, unmodified: x7 = 0xffffffff3eaaaaaa.") (source "RVI-D §21.1.5"))
  (step (n 16) (insn "csrrs x8, fflags, x0") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "x8 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 17) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 18) (insn "lui x9, 0x7ff00") (writes (write (reg "x9") (value "0x000000007ff00000")))
    (derivation "build 0x7fefffffffffffff: the upper word 0x7fefffff first.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "addi x9, x9, -1") (writes (write (reg "x9") (value "0x000000007fefffff")))
    (derivation "… its low 12 bits (-1).") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "slli x9, x9, 32") (writes (write (reg "x9") (value "0x7fefffff00000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 21) (insn "addi x28, x0, -1") (writes (write (reg "x28") (value "0xffffffffffffffff")))
    (derivation "the lower word 0xffffffff.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0xffffffff00000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 23) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x00000000ffffffff")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 24) (insn "or x9, x9, x28") (writes (write (reg "x9") (value "0x7fefffffffffffff")))
    (derivation "x9 = 0x7fefffffffffffff.") (source "RVI-RV32I §1.1.4"))
  (step (n 25) (insn "fmv.d.x f4, x9") (writes)
    (derivation "fmv.d.x: f4 <- x9's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 26) (insn "fcvt.s.d f5, f4, 1") (writes)
    (derivation "double MAX to single in RTZ: clamped to the single MAX — an OVERFLOW.") (source "RVI-D §21.1.5"))
  (step (n 27) (insn "fmv.x.d x10, f5") (writes (write (reg "x10") (value "0xffffffff7f7fffff")))
    (derivation "fmv.x.d: f5's 64 bits, unmodified: x10 = 0xffffffff7f7fffff.") (source "RVI-D §21.1.5"))
  (step (n 28) (insn "csrrs x11, fflags, x0") (writes (write (reg "x11") (value "0x0000000000000005")))
    (derivation "x11 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 29) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 30) (insn "lui x12, 0x38100") (writes (write (reg "x12") (value "0x0000000038100000")))
    (derivation "build 0x380fffffe0000000: the upper word 0x380fffff first.") (source "RVI-RV32I §1.1.4"))
  (step (n 31) (insn "addi x12, x12, -1") (writes (write (reg "x12") (value "0x00000000380fffff")))
    (derivation "… its low 12 bits (-1).") (source "RVI-RV32I §1.1.4"))
  (step (n 32) (insn "slli x12, x12, 32") (writes (write (reg "x12") (value "0x380fffff00000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 33) (insn "lui x28, 0xe0000") (writes (write (reg "x28") (value "0xffffffffe0000000")))
    (derivation "the lower word 0xe0000000.") (source "RVI-RV32I §1.1.4"))
  (step (n 34) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0xe000000000000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 35) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x00000000e0000000")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 36) (insn "or x12, x12, x28") (writes (write (reg "x12") (value "0x380fffffe0000000")))
    (derivation "x12 = 0x380fffffe0000000.") (source "RVI-RV32I §1.1.4"))
  (step (n 37) (insn "fmv.d.x f6, x12") (writes)
    (derivation "fmv.d.x: f6 <- x12's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 38) (insn "fcvt.s.d f7, f6, 0") (writes)
    (derivation "2^-126·(1-2^-24): tiny unbounded, rounds up to the smallest normal — still an UNDERFLOW.") (source "RVI-D §21.1.5"))
  (step (n 39) (insn "fmv.x.d x13, f7") (writes (write (reg "x13") (value "0xffffffff00800000")))
    (derivation "fmv.x.d: f7's 64 bits, unmodified: x13 = 0xffffffff00800000.") (source "RVI-D §21.1.5"))
  (step (n 40) (insn "csrrs x14, fflags, x0") (writes (write (reg "x14") (value "0x0000000000000003")))
    (derivation "x14 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 41) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 42) (insn "lui x15, 0x7ff40") (writes (write (reg "x15") (value "0x000000007ff40000")))
    (derivation "build 0x7ff4000000000123: the upper word 0x7ff40000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 43) (insn "slli x15, x15, 32") (writes (write (reg "x15") (value "0x7ff4000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 44) (insn "addi x28, x0, 291") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "the lower word 0x00000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 45) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000012300000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 46) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 47) (insn "or x15, x15, x28") (writes (write (reg "x15") (value "0x7ff4000000000123")))
    (derivation "x15 = 0x7ff4000000000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 48) (insn "fmv.d.x f8, x15") (writes)
    (derivation "fmv.d.x: f8 <- x15's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 49) (insn "fcvt.s.d f9, f8, 0") (writes)
    (derivation "a signaling NaN narrowed: the canonical single, boxed — and INVALID.") (source "RVI-D §21.1.5"))
  (step (n 50) (insn "fmv.x.d x16, f9") (writes (write (reg "x16") (value "0xffffffff7fc00000")))
    (derivation "fmv.x.d: f9's 64 bits, unmodified: x16 = 0xffffffff7fc00000.") (source "RVI-D §21.1.5"))
  (step (n 51) (insn "csrrs x17, fflags, x0") (writes (write (reg "x17") (value "0x0000000000000010")))
    (derivation "x17 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 52) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 53) (insn "lui x18, 0x3dccd") (writes (write (reg "x18") (value "0x000000003dccd000")))
    (derivation "build the pattern 0x3dcccccd (upper 20 bits).") (source "RVI-RV32I §1.1.4"))
  (step (n 54) (insn "addi x18, x18, -819") (writes (write (reg "x18") (value "0x000000003dcccccd")))
    (derivation "… its low 12 bits (-819).") (source "RVI-RV32I §1.1.4"))
  (step (n 55) (insn "fmv.w.x f10, x18") (writes)
    (derivation "fmv.w.x: f10 <- x18's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 56) (insn "fcvt.d.s f11, f10, 0") (writes)
    (derivation "a boxed single widened: exact, no flag.") (source "RVI-D §21.1.5"))
  (step (n 57) (insn "fmv.x.d x19, f11") (writes (write (reg "x19") (value "0x3fb99999a0000000")))
    (derivation "fmv.x.d: f11's 64 bits, unmodified: x19 = 0x3fb99999a0000000.") (source "RVI-D §21.1.5"))
  (step (n 58) (insn "fcvt.d.s f12, f1, 0") (writes)
    (derivation "a register holding a DOUBLE is not a boxed single: it unboxes to the canonical NaN — no flag.") (source "RVI-D §21.1.2"))
  (step (n 59) (insn "fmv.x.d x20, f12") (writes (write (reg "x20") (value "0x7ff8000000000000")))
    (derivation "fmv.x.d: f12's 64 bits, unmodified: x20 = 0x7ff8000000000000.") (source "RVI-D §21.1.5"))
  (step (n 60) (insn "lui x21, 0x7fa00") (writes (write (reg "x21") (value "0x000000007fa00000")))
