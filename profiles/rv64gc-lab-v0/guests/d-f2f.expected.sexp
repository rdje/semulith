  (step (n 61) (insn "fmv.w.x f13, x21") (writes)
    (derivation "fmv.w.x: f13 <- x21's low 32 bits, NaN-boxed.") (source "RVI-F §20.1.7; RVI-D §21.1.2"))
  (step (n 62) (insn "fcvt.d.s f14, f13, 0") (writes)
    (derivation "a signaling single widened: the canonical double — and INVALID.") (source "RVI-D §21.1.5"))
  (step (n 63) (insn "fmv.x.d x22, f14") (writes (write (reg "x22") (value "0x7ff8000000000000")))
