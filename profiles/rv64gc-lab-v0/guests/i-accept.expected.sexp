;; i-accept.expected.sexp — the expected observations for `i-accept.s` (P4-SYSTEM.5
;; slice b, the interrupts corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .5 brief's declared delivery rule by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py i-accept.expected.sexp schema/expectations.sexp

(expectations (program "i-accept.s") (entry "0x0000000080000000") (instructions 36) (fetches 34)
  (never_written "x28")
  (never_written "x29")
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 = this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 80") (writes (write (reg "x1") (value "0x0000000080000050")))
    (derivation "the handler rides 80 bytes in.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec programmed; rd=x0 discards.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002")))
    (derivation "the SSIP bit position (bit 1, cause 1).") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "csrrs x0, mip, x2") (writes)
    (derivation "SSIP <- 1: a software pending bit is posted.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 5) (insn "csrrs x0, mie, x2") (writes)
    (derivation "SSIE <- 1: the cause is enabled.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 6) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001")))
    (derivation "M with MIE CLEAR (reset): the evaluation passes the pending interrupt by — the marker executes.") (source "RVP-MACHINE §2.1.1.9 (the (a) clause)"))
  (step (n 7) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000002")))
    (derivation "and a second boundary, still untaken.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 8) (insn "addi x6, x0, 8") (writes (write (reg "x6") (value "0x0000000000000008")))
    (derivation "the MIE bit position (bit 3).") (source "RVI-RV32I §1.1.4"))
  (step (n 9) (insn "csrrs x0, mstatus, x6") (writes)
    (derivation "MIE <- 1: (a)(b)(c) now all hold at the next boundary.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 10) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in M: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 11) (insn "csrrs x11, mcause, x0") (writes (write (reg "x11") (value "0x8000000000000001")))
    (derivation "the handler observes the Interrupt bit with cause 1 (0x8000000000000001).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 12) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000028")))
    (derivation "mepc is the un-fetched pc (interrupts are taken BETWEEN instructions).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 13) (insn "csrrs x13, mstatus, x0") (writes (write (reg "x13") (value "0x0000000a00001880")))
    (derivation "the stack: MPIE <- 1, MIE <- 0, MPP <- the originating mode.") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 14) (insn "csrrc x0, mip, x2") (writes)
    (derivation "SSIP <- 0: the pending bit is cleared before returning (else the next boundary re-fires).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 15) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x0000000080000028")))
    (derivation "step the resume address past the interrupted instruction.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 16) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x000000008000002c")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 17) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 18) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 19) (insn "addi x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000003")))
    (derivation "resumed after the handler: the marker completes at 3.") (source "RVI-RV32I §1.1.4"))
  (step (n 20) (insn "csrrw x0, mstatus, x0") (writes)
    (derivation "mstatus <- 0: MPP = U (and MIE clears — the boundary before the mret passes the pending by).") (source "RVI-ZICSR §5.1.1"))
  (step (n 21) (insn "auipc x4, 0") (writes (write (reg "x4") (value "0x0000000080000034")))
    (derivation "x4 = this address.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "addi x4, x4, 20") (writes (write (reg "x4") (value "0x0000000080000048")))
    (derivation "the U entry rides 20 bytes past this auipc (72 from the entry).") (source "RVI-RV32I §1.1.4"))
  (step (n 23) (insn "csrrw x0, mepc, x4") (writes)
    (derivation "mepc = the U entry.") (source "RVI-ZICSR §5.1.1"))
  (step (n 24) (insn "csrrs x0, mip, x2") (writes)
    (derivation "SSIP <- 1 again — posted FROM M (mip is M-only; a U-mode write would be illegal): M with MIE clear passes it by.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 25) (insn "mret") (writes)
    (derivation "the stack pops per MPP: enter U, pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 26) (insn "addi x7, x0, 0") (writes)
    (derivation "the pending evaluation takes the SSI interrupt in M: xcause carries the Interrupt bit with cause 1, xepc is the un-fetched pc (interrupts are taken BETWEEN instructions), and pc moves to the vector as declared (no register observation — the handler's csrr reads below are the evidence).") (source "RVP-MACHINE §2.1.1.9; RVP-SUPERVISOR §11.1.1.3; the .5 brief's decision 3"))
  (step (n 27) (insn "csrrs x11, mcause, x0") (writes)
    (derivation "the handler observes the Interrupt bit with cause 1 (0x8000000000000001).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 28) (insn "csrrs x12, mepc, x0") (writes (write (reg "x12") (value "0x0000000080000048")))
    (derivation "mepc is the un-fetched pc (interrupts are taken BETWEEN instructions).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 29) (insn "csrrs x13, mstatus, x0") (writes (write (reg "x13") (value "0x0000000a00000000")))
    (derivation "the stack: MPIE <- 1, MIE <- 0, MPP <- the originating mode.") (source "RVP-MACHINE §2.1.1.6.1"))
  (step (n 30) (insn "csrrc x0, mip, x2") (writes)
    (derivation "SSIP <- 0: the pending bit is cleared before returning (else the next boundary re-fires).") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 31) (insn "csrrs x14, mepc, x0") (writes (write (reg "x14") (value "0x0000000080000048")))
    (derivation "step the resume address past the interrupted instruction.") (source "RVP-MACHINE §2.1.1.9"))
  (step (n 32) (insn "addi x14, x14, 4") (writes (write (reg "x14") (value "0x000000008000004c")))
    (derivation "mepc + 4.") (source "RVI-RV32I §1.1.4"))
  (step (n 33) (insn "csrrw x0, mepc, x14") (writes)
    (derivation "write it back.") (source "RVI-ZICSR §5.1.1"))
  (step (n 34) (insn "mret") (writes)
    (derivation "the stack pops per MPP and pc <- mepc.") (source "RVP-MACHINE §2.1.3.2"))
  (step (n 35) (insn "addi x9, x0, 42") (writes (write (reg "x9") (value "0x000000000000002a")))
    (derivation "the landing marker: the flow arrives past the U cell.") (source "RVI-RV32I §1.1.4 #|end"))
)
