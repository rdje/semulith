;; d-compare.expected.sexp — the expected observations for `d-compare.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-compare.expected.sexp schema/expectations.sexp

(expectations (program "d-compare.s") (entry "0x0000000080000000") (instructions 35)
  (step (n 0) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 1) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 2) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 3) (insn "lui x5, 0x3ff00") (writes (write (reg "x5") (value "0x000000003ff00000")))
    (derivation "build 0x3ff0000000000000: the upper word 0x3ff00000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x5, x5, 32") (writes (write (reg "x5") (value "0x3ff0000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 5) (insn "fmv.d.x f1, x5") (writes)
    (derivation "fmv.d.x: f1 <- x5's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 6) (insn "lui x6, 0x40000") (writes (write (reg "x6") (value "0x0000000040000000")))
    (derivation "build 0x4000000000000000: the upper word 0x40000000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "slli x6, x6, 32") (writes (write (reg "x6") (value "0x4000000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 8) (insn "fmv.d.x f2, x6") (writes)
    (derivation "fmv.d.x: f2 <- x6's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 9) (insn "feq.d x7, f1, f1") (writes (write (reg "x7") (value "0x0000000000000001")))
    (derivation "feq.d: x7 = 1; flags none.") (source "RVI-D §21.1.6"))
  (step (n 10) (insn "flt.d x8, f1, f2") (writes (write (reg "x8") (value "0x0000000000000001")))
    (derivation "flt.d: x8 = 1; flags none.") (source "RVI-D §21.1.6"))
  (step (n 11) (insn "fle.d x9, f2, f1") (writes)
    (derivation "fle.d: x9 = 0; flags none.") (source "RVI-D §21.1.6"))
  (step (n 12) (insn "fmv.d.x f3, x0") (writes)
    (derivation "+0.0.") (source "RVI-D §21.1.5"))
  (step (n 13) (insn "lui x10, 0x80000") (writes (write (reg "x10") (value "0xffffffff80000000")))
    (derivation "build 0x8000000000000000: the upper word 0x80000000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 14) (insn "slli x10, x10, 32") (writes (write (reg "x10") (value "0x8000000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 15) (insn "fmv.d.x f4, x10") (writes)
    (derivation "fmv.d.x: f4 <- x10's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 16) (insn "feq.d x11, f3, f4") (writes (write (reg "x11") (value "0x0000000000000001")))
    (derivation "+0 = -0.") (source "RVI-D §21.1.6"))
  (step (n 17) (insn "csrrs x12, fflags, x0") (writes)
    (derivation "x12 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 18) (insn "lui x13, 0x7ff80") (writes (write (reg "x13") (value "0x000000007ff80000")))
    (derivation "build 0x7ff8000000000000: the upper word 0x7ff80000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "slli x13, x13, 32") (writes (write (reg "x13") (value "0x7ff8000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 20) (insn "fmv.d.x f5, x13") (writes)
    (derivation "fmv.d.x: f5 <- x13's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 21) (insn "feq.d x14, f5, f1") (writes)
    (derivation "a quiet NaN: 0 and no flag — FEQ is quiet.") (source "RVI-D §21.1.6"))
  (step (n 22) (insn "csrrs x15, fflags, x0") (writes)
    (derivation "x15 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 23) (insn "flt.d x16, f5, f1") (writes)
    (derivation "a quiet NaN: 0 and INVALID — FLT is signaling.") (source "RVI-D §21.1.6"))
  (step (n 24) (insn "csrrs x17, fflags, x0") (writes (write (reg "x17") (value "0x0000000000000010")))
    (derivation "x17 = the accrued flags so far.") (source "RVI-F §20.1.2"))
  (step (n 25) (insn "csrrw x0, fflags, x0") (writes)
    (derivation "clear the accrued flags (an explicit software write — the only way they clear).") (source "RVI-F §20.1.2"))
  (step (n 26) (insn "lui x18, 0x7ff40") (writes (write (reg "x18") (value "0x000000007ff40000")))
    (derivation "build 0x7ff4000000000123: the upper word 0x7ff40000 first.") (source "RVI-RV32I §1.1.4"))
  (step (n 27) (insn "slli x18, x18, 32") (writes (write (reg "x18") (value "0x7ff4000000000000")))
    (derivation "… shifted into bits 63..32.") (source "RVI-RV64I §3.1.2"))
  (step (n 28) (insn "addi x28, x0, 291") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "the lower word 0x00000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 29) (insn "slli x28, x28, 32") (writes (write (reg "x28") (value "0x0000012300000000")))
    (derivation "… zero-extended: up …") (source "RVI-RV64I §3.1.2"))
  (step (n 30) (insn "srli x28, x28, 32") (writes (write (reg "x28") (value "0x0000000000000123")))
    (derivation "… and back down.") (source "RVI-RV64I §3.1.2"))
  (step (n 31) (insn "or x18, x18, x28") (writes (write (reg "x18") (value "0x7ff4000000000123")))
    (derivation "x18 = 0x7ff4000000000123.") (source "RVI-RV32I §1.1.4"))
  (step (n 32) (insn "fmv.d.x f6, x18") (writes)
    (derivation "fmv.d.x: f6 <- x18's 64 bits, unmodified.") (source "RVI-D §21.1.5"))
  (step (n 33) (insn "feq.d x19, f6, f1") (writes)
    (derivation "a signaling NaN: INVALID even for FEQ.") (source "RVI-D §21.1.6"))
  (step (n 34) (insn "csrrs x20, fflags, x0") (writes (write (reg "x20") (value "0x0000000000000010")))
    (derivation "x20 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
