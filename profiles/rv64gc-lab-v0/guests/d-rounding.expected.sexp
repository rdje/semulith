;; d-rounding.expected.sexp — the expected observations for `d-rounding.s` (P4-SYSTEM.7,
;; the floating-point corpus). EVD-05: every value below was derived from the pinned
;; chapters and the .7 brief's declared FP-state rules by the spec-side authoring model
;; BEFORE any engine run; the corpus runner falsifies against it.
;; Validate with
;;   python3 scripts/check_sexp_schema.py d-rounding.expected.sexp schema/expectations.sexp

(expectations (program "d-rounding.s") (entry "0x0000000080000000") (instructions 38)
  (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000")))
    (derivation "x1 holds this instruction's own address.") (source "RVI-RV32I §1.1.4 (D-LUI-AUIPC)"))
  (step (n 1) (insn "addi x1, x1, 72") (writes (write (reg "x1") (value "0x0000000080000048")))
    (derivation "the trap handler sits at entry + 0x48 — after the 18-instruction main body.") (source "RVI-RV32I §1.1.4"))
  (step (n 2) (insn "csrrw x0, mtvec, x1") (writes)
    (derivation "mtvec <- the handler.") (source "RVI-ZICSR §5.1.1"))
  (step (n 3) (insn "addi x31, x0, 1") (writes (write (reg "x31") (value "0x0000000000000001")))
    (derivation "the FS=Initial pattern starts as a 1.") (source "RVI-RV32I §1.1.4"))
  (step (n 4) (insn "slli x31, x31, 13") (writes (write (reg "x31") (value "0x0000000000002000")))
    (derivation "1 << 13 — mstatus.FS's low bit.") (source "RVP-CSR (the mstatus field table)"))
  (step (n 5) (insn "csrrs x0, mstatus, x31") (writes)
    (derivation "FS := Initial: the floating-point state is enabled before any D instruction.") (source "RVP-MACHINE §2.1.1.6.7"))
  (step (n 6) (insn "addi x5, x0, 5") (writes (write (reg "x5") (value "0x0000000000000005")))
    (derivation "5.") (source "RVI-RV32I §1.1.4"))
  (step (n 7) (insn "fcvt.d.w f1, x5, 5") (writes)
    (derivation "rm = 101, a reserved static mode: illegal even though the conversion is exact — the rm field is decoded as usual.") (source "RVI-F §20.1.2"))
  (step (n 8) (insn "csrrs x29, mcause, x0") (writes (write (reg "x29") (value "0x0000000000000002")))
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 9) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x000000008000001c")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 10) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x0000000080000020")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 11) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 12) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 13) (insn "fcvt.d.w f1, x5, 0") (writes)
    (derivation "fcvt.d.w (RNE): 0x4014000000000000; flags none.") (source "RVI-D §21.1.5"))
  (step (n 14) (insn "fmv.x.d x6, f1") (writes (write (reg "x6") (value "0x4014000000000000")))
    (derivation "fmv.x.d: f1's 64 bits, unmodified: x6 = 0x4014000000000000.") (source "RVI-D §21.1.5"))
  (step (n 15) (insn "fcvt.d.s f2, f1, 6") (writes)
    (derivation "rm = 110 on the never-rounding widening: illegal.") (source "RVI-F §20.1.2"))
  (step (n 16) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 17) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x0000000080000028")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 18) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x000000008000002c")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 19) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 20) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 21) (insn "addi x7, x0, 6") (writes (write (reg "x7") (value "0x0000000000000006")))
    (derivation "the pattern 110.") (source "RVI-RV32I §1.1.4"))
  (step (n 22) (insn "csrrw x0, frm, x7") (writes)
    (derivation "frm <- 110 (frm holds any 3-bit value).") (source "RVI-F §20.1.2"))
  (step (n 23) (insn "fadd.d f3, f1, f1, 7") (writes)
    (derivation "DYN with frm = 110: a reserved dynamic mode — illegal.") (source "RVI-F §20.1.2"))
  (step (n 24) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 25) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x0000000080000034")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 26) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x0000000080000038")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 27) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 28) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 29) (insn "fadd.d f4, f1, f1, 0") (writes)
    (derivation "a static RNE is unaffected by frm's reserved value.") (source "RVI-F §20.1.2"))
  (step (n 30) (insn "fmv.x.d x8, f4") (writes (write (reg "x8") (value "0x4024000000000000")))
    (derivation "fmv.x.d: f4's 64 bits, unmodified: x8 = 0x4024000000000000.") (source "RVI-D §21.1.5"))
  (step (n 31) (insn "fcvt.s.d f5, f1, 7") (writes)
    (derivation "DYN on the narrowing conversion: illegal too.") (source "RVI-F §20.1.2"))
  (step (n 32) (insn "csrrs x29, mcause, x0") (writes)
    (derivation "the handler: the cause.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 33) (insn "csrrs x30, mepc, x0") (writes (write (reg "x30") (value "0x0000000080000040")))
    (derivation "mepc is the trapping instruction's own address.") (source "RVP-MACHINE §2.1.3.1"))
  (step (n 34) (insn "addi x30, x30, 4") (writes (write (reg "x30") (value "0x0000000080000044")))
    (derivation "step past it.") (source "RVI-RV32I §1.1.4"))
  (step (n 35) (insn "csrrw x0, mepc, x30") (writes)
    (derivation "mepc <- the next instruction.") (source "RVI-ZICSR §5.1.1"))
  (step (n 36) (insn "mret") (writes)
    (derivation "back to M at mepc.") (source "RVP-INSNS §3.3.2 (mret)"))
  (step (n 37) (insn "csrrs x9, fflags, x0") (writes)
    (derivation "x9 = the accrued flags so far.") (source "RVI-F §20.1.2 #|end"))
)
