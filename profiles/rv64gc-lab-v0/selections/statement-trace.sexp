;; statement-trace.sexp — the selections' statement traces (schema/statement-trace.sexp), beside their records. scripts/statement_trace.py reads this with the profile's own.

(trace (requirement_id "REQ-D-ABI")
  (clause (text "The toolchain ABI is LP64D — the standard RV64G ABI (ELFCLASS64 with EF_RISCV_FLOAT_ABI_DOUBLE,") (properties "object-lp64d") (properties "object-lp64") (properties "workload-flags")
    (limits "the assembler's own guests carry no calling convention and are tagged soft-float by design (scripts/probe_elf_writer.py), so this reads what the pinned compiler builds, not those")
    (limits "the ACT suites assemble under -mabi=lp64 for the same reason: they make no calls across the ABI"))
  (clause (text "the hardware floating-point calling convention with ABI_FLEN=64);") (properties "object-lp64f")
    (limits "one function shows the convention, and it does not exercise the whole of the psABI"))
  (clause (text "the toolchain is the host's clang/lld 21.1.8 with an rv64gc target (the existing guest-toolchain decision).") (properties "toolchain-pin")))

(trace (requirement_id "REQ-D-FP-DEFER")
  (clause (text "F and D are in the profile because the standard RV64G userspace ABI is LP64D, which requires the D extension, and both are implemented.") (properties "f-and-d-selected") (properties "needs-the-abi")
    (limits "the numeric and instruction guarantees are REQ-GC-F's and REQ-GC-D's own credits: this reads which backend was selected and how it is held"))
  (clause (text "The selected floating-point backend is the qualified rustc_apfloat 0.2.3+llvm-462a31f5a5ab, required as =0.2.3 and artifact-pinned by Cargo.lock, behind the RISC-V model layer crates/semulith-core/src/fp.rs.") (properties "backend-requirement") (properties "backend-artifact") (properties "model-layer") (properties "backend-consumers"))
  (clause (text "The qualification decision and closing measurement record finite evidence, including the model layer's corrections to overflow and underflow flags;") (properties "qualification-status") (properties "flag-corrections-recorded")
    (limits "the qualification decision and the closing measurement are read as active records, and their finite evidence is theirs"))
  (clause (text "the numeric and instruction guarantees retain their own checks.")
    (limits "the numeric and instruction guarantees are REQ-GC-F's and REQ-GC-D's own credits: this reads which backend was selected and how it is held"))
  (clause (text "Sail and Spike share SoftFloat numeric ancestry, so their agreement is encoding/state evidence and never two independent numeric implementations.") (properties "shared-ancestry-status")))

(trace (requirement_id "REQ-D-ROUTE-FLIP")
  (clause (text "This unit uses the generated-definition vehicle.") (properties "vehicle"))
  (clause (text "Its encoding composition is complete for the declared profile scope, with no unbound slots;") (properties "composition"))
  (clause (text "the canonical state, encoding/semantics and guest corpus own the generated state_rv64gc.rs, definition_rv64gc.rs and guests_rv64gc.rs mirrors.") (properties "mirror-state") (properties "mirror-definition") (properties "mirror-guests"))
  (clause (text "The owner generators and their drift gates govern those mirrors.") (properties "drift-gates")
    (limits "a read here does not run the generators: their drift gates run in every commit's gate, and the record retains one run of each through the named check"))
  (clause (text "Selection and generated-route consistency are scope evidence; instruction behavior is established separately by executable checks.")
    (limits "selection and generated-route consistency are scope evidence: instruction behavior is established separately by executable checks")))

(trace (requirement_id "REQ-D-SCOPE-CENSUS")
  (clause (text "The scope block enumerates the RV64I base census (52 forms — the same enumeration and source as rv64i-lab-v0);") (properties "base-census") (properties "same-enumeration-as-rv64i") (properties "same-source-as-rv64i"))
  (clause (text "each extension's instruction census lands with its encoding fragment in the evidence leaves (the RV32/64G listings and the privileged listings are the census references),") (properties "grows-with-its-fragments")
    (limits "the listings themselves are the citations' to hold (scripts/check_citations.py)"))
  (clause (text "and the declared scope grows only with them.") (properties "total")
    (limits "the census is compared with the composition and with rv64i-lab-v0's enumeration; that each form is executed is EXERCISE-COVERAGE's, and that it behaves is each extension's credit")))
