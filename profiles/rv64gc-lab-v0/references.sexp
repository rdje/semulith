stderr") (observation_ids "baseline-process-receipt")) (run (id "repeat") (kind "repeat") (argv "target/refs/sail-riscv-Mac-arm64/bin/sail_riscv_sim") (argv "--config-override") (argv "evidence/rv64gc-m-forms-v5/reference-config.json") (argv "--inst-limit") (argv "33") (argv "--trace-instr") (argv "--trace-gpr") (argv "--trace-exception") (argv "--trace-output") (argv "evidence/rv64gc-m-forms-v5/repeat.trace") (argv "evidence/rv64gc-m-forms-v5/guest.elf") (input_ids "guest-source") (input_ids "guest-image") (input_ids "reference-config") (input_ids "reference-identity") (input_ids "collector") (input_ids "adapter") (input_ids "dependency-manifest") (input_ids "expectation") (producer_ids "reference") (producer_ids "expected") (repeat_of "baseline") (process_exit 0) (verdict "AGREE") (observation_ids "repeat-raw-gpr") (observation_ids "repeat-process-stdout") (observation_ids "repeat-process-stderr") (observation_ids "repeat-process-receipt")) (run (id "control") (kind "control") (argv "target/refs/sail-riscv-Mac-arm64/bin/sail_riscv_sim") (argv "--config-override") (argv "evidence/rv64gc-m-forms-v5/reference-config.json") (argv "--inst-limit") (argv "33") (argv "--trace-instr") (argv "--trace-gpr") (argv "--trace-exception") (argv "--trace-output") (argv "evidence/rv64gc-m-forms-v5/control.trace") (argv "evidence/rv64gc-m-forms-v5/guest.elf") (input_ids "guest-source") (input_ids "guest-image") (input_ids "reference-config") (input_ids "reference-identity") (input_ids "collector") (input_ids "adapter") (input_ids "dependency-manifest") (input_ids "mutant-expectation") (producer_ids "reference") (producer_ids "expected-mutant") (process_exit 0) (verdict "DIVERGE") (observation_ids "control-raw-gpr") (observation_ids "control-process-stdout") (observation_ids "control-process-stderr") (observation_ids "control-process-receipt")) (control_run (id "wrong-quotient") (run_id "control") (baseline_id "baseline") (mutation_input_ids "mutant-expectation") (property_ids "form-