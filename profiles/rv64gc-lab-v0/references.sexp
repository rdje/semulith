  (comment "───────────────────────────────────────── the qualified matched experiments (P4-SYSTEM.14 a42bc; v4 since a44-5; XLEN since a43a-3; v5 and xlen-v2 since a43b-2e)"
    "Each record below is its case's measured record, form for form (evidence/<case>/measured-experiment.sexp"
    "owns it; PROFILE-CONSISTENCY refuses the day the two differ). It is qualified only while a current credit"
    "record names the case (credit_records.dossier_qualification); the record's own verdict and prose words grant nothing.")
  (experiment (id "rv64gc-m-forms-v5") (program "m-forms.s") (instructions 33) (models "sail-riscv") (verdict "AGREE") (reproduced "Predeclared target: fresh baseline and exact-byte repeat.") (control "Predeclared target: wrong quotient must diverge.") (verification (format_version "matched-gpr-v1") (comparison_rule "sail-gpr-change-v1") (limitations "The planned record uses zero output placeholders; collection replaces sizes, hashes and exits with measurements.") (limitations "Twenty-five finite M witnesses, the 13 forms and the 12 Table 1 cells, predeclared; full source/risk/feature policy remains pending.") (property (id "form-mul") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For MUL with x5 = -7 and x6 = 2, the x10 change at boundary 7 is -14 (the low 64 bits of the product).") (gpr_witness (step_n 7) (register "x10"))) (property (id "form-mulh") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For MULH with x5 = -7 and x6 = 2, the x11 change at boundary 8 is -1 (the high 64 bits of the signed product -14).") (gpr_witness (step_n 8) (register "x11"))) (property (id "form-mulhsu") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For MULHSU with x5 = -7 (signed) and x7 = 2^64 - 1 (unsigned), the x12 change at boundary 9 is -7 (the high 64 bits of -7 x 2^64 + 7).") (gpr_witness (step_n 9) (register "x12"))) (property (id "form-mulhu") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For MULHU with x7 = 2^64 - 1 and x6 = 2 (both unsigned), the x13 change at boundary 10 is 1 (the high 64 bits of 2^65 - 2).") (gpr_witness (step_n 10) (register "x13"))) (property (id "form-mulw") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For MULW with x5 = -7 and x9 = 0x80000000, the x14 change at boundary 11 is 0xffffffff80000000 (the low 32 bits of the product, sign-extended).") (gpr_witness (step_n 11) (register "x14"))) (property (id "form-div") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIV with x5 = -7 and x6 = 2, the x15 change at boundary 12 is -3 (rounding toward zero).") (gpr_witness (step_n 12) (register "x15"))) (property (id "form-divu") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVU with x7 = 2^64 - 1 and x6 = 2 (both unsigned), the x16 change at boundary 13 is 2^63 - 1.") (gpr_witness (step_n 13) (register "x16"))) (property (id "form-rem") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REM with x5 = -7 and x6 = 2, the x17 change at boundary 14 is -1 (the remainder takes the dividend's sign).") (gpr_witness (step_n 14) (register "x17"))) (property (id "form-remu") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMU with x7 = 2^64 - 1 and x6 = 2 (both unsigned), the x18 change at boundary 15 is 1.") (gpr_witness (step_n 15) (register "x18"))) (property (id "form-divw") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVW with the words -2^31 (x9) and 2 (x6), the x19 change at boundary 16 is -2^30, sign-extended.") (gpr_witness (step_n 16) (register "x19"))) (property (id "form-divuw") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVUW with the unsigned words 0x80000000 (x9) and 2 (x6), the x20 change at boundary 17 is 0x40000000.") (gpr_witness (step_n 17) (register "x20"))) (property (id "form-remw") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMW with the words -2^31 (x9) and -7 (x5), the x21 change at boundary 18 is -2 (the dividend's sign).") (gpr_witness (step_n 18) (register "x21"))) (property (id "form-remuw") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMUW with the unsigned words 0x80000000 (x9) and 0xfffffff9 (x5), the x22 change at boundary 19 is 0x80000000 sign-extended (the whole dividend).") (gpr_witness (step_n 19) (register "x22"))) (property (id "table1-div-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIV with x5 = -7 and x0 = 0, the x23 change at boundary 20 is -1 (Table 1: division by zero, all bits set; no trap).") (gpr_witness (step_n 20) (register "x23"))) (property (id "table1-divu-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVU with x5 = 2^64 - 7 and x0 = 0, the x24 change at boundary 21 is 2^64 - 1 (Table 1: division by zero, all bits set).") (gpr_witness (step_n 21) (register "x24"))) (property (id "table1-rem-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REM with x5 = -7 and x0 = 0, the x25 change at boundary 22 is -7 (Table 1: the remainder of division by zero is the dividend).") (gpr_witness (step_n 22) (register "x25"))) (property (id "table1-remu-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMU with x5 = 2^64 - 7 and x0 = 0, the x26 change at boundary 23 is 2^64 - 7 (Table 1: the dividend).") (gpr_witness (step_n 23) (register "x26"))) (property (id "table1-div-overflow") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIV with x8 = -2^63 and x7 = -1, the x27 change at boundary 24 is -2^63 (Table 1: signed overflow, the quotient equals the dividend; no trap).") (gpr_witness (step_n 24) (register "x27"))) (property (id "table1-rem-overflow") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REM with x8 = -2^63 and x7 = -1, the x28 change at boundary 26 is 0 (Table 1: the overflow remainder, replacing the sentinel 28).") (gpr_witness (step_n 26) (register "x28"))) (property (id "table1-divw-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVW with the word -2^31 (x9) and x0 = 0, the x29 change at boundary 27 is -1 (Table 1 at L = 32: all bits set, sign-extended).") (gpr_witness (step_n 27) (register "x29"))) (property (id "table1-divuw-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVUW with the unsigned word 0x80000000 (x9) and x0 = 0, the x30 change at boundary 28 is 2^32 - 1 sign-extended (all bits set).") (gpr_witness (step_n 28) (register "x30"))) (property (id "table1-remw-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMW with the word -2^31 (x9) and x0 = 0, the x31 change at boundary 29 is -2^31 sign-extended (Table 1: the dividend's word).") (gpr_witness (step_n 29) (register "x31"))) (property (id "table1-remuw-by-zero") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMUW with the unsigned word 0x80000000 (x9) and x0 = 0, the x10 change at boundary 30 is 0x80000000 sign-extended (Table 1: the dividend's word), replacing the MUL result.") (gpr_witness (step_n 30) (register "x10"))) (property (id "table1-divw-overflow") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For DIVW with the words -2^31 (x9) and -1 (x7), the x11 change at boundary 31 is -2^31 sign-extended (Table 1: word overflow, the quotient equals the dividend), replacing the MULH result.") (gpr_witness (step_n 31) (register "x11"))) (property (id "table1-remw-overflow") (requirement_id "REQ-GC-M") (obligation_ids "OB-GC-M") (observation_kinds "gpr-change") (statement "For REMW with the words -2^31 (x9) and -1 (x7), the x12 change at boundary 32 is 0 (Table 1: the word overflow remainder), replacing the MULHSU result.") (gpr_witness (step_n 32) (register "x12"))) (input (id "guest-source") (role "guest-source") (path "profiles/rv64gc-lab-v0/guests/m-forms.s") (sha256 "232b4d96d87125c3ab876b2ec415d250a572433df57d5696afffde6a95f8d7a6")) (input (id "collector") (role "collector") (path "scripts/matched_gpr_unit_collector.py") (sha256 "504bd637dca71d07b6dceed8a70576723ab3f4c1ae90f012868bf6e23bd0e2dd")) (input (id "adapter") (role "adapter") (path "scripts/run_rv64gc_sail.py") (sha256 "4b7b16225c73d2123b9f177b7c484a6872fd4d106b9896223a12e340211db8da")) (input (id "guest-image") (role "guest-image") (path "evidence/rv64gc-m-forms-v5/guest.elf") (sha256 "208865142e1569636925a5cea6abff6fc4495f317d5d8e79a06e48d3b0f061b1")) (input (id "reference-config") (role "reference-config") (path "evidence/rv64gc-m-forms-v5/reference-config.json") (sha256 "666d937305f503aa2754784186945f033ade43601f9c9d0073a9ffeefeb43ed2")) (input (id "expectation") (role "expectation") (path "evidence/rv64gc-m-forms-v5/baseline.expected.sexp") (sha256 "561b5da3cf87ea4825fca4e1a001a9c7d26321e491d86515c571f47b0019f44f")) (input (id "mutant-expectation") (role "expectation") (path "evidence/rv64gc-m-forms-v5/control.expected.sexp") (sha256 "ba99e4eca2e784d8389859e35cf04590c180162807311361eef70add589f4ba0")) (input (id "reference-identity") (role "reference-identity") (path "profiles/rv64gc-lab-v0/retained/sail-identity.sexp") (sha256 "b0d88c7ae4b3cbb6b856af338811947dd58c6d8e754043d901f2952aeaecea77")) (input (id "dependency-manifest") (role "dependency-manifest") (path "evidence/rv64gc-m-forms-v5/dependencies.sexp") (sha256 "9166a71c0c423f70ffc7417033b2c31e7eca4a99a3bb032274881e9935532fdf")) (producer (id "reference") (role "reference") (version "sha256:16de42a86e4ea7a300385092632cd95d153cb3f6c119d31eaa9384953990b7bf") (candidate_id "sail-risc