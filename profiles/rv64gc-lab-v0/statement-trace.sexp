  (clause (text "rounding by the static rm or, for DYN, frm,") (properties "fdiv-d") (properties "static-rounding") (properties "dynamic-rounding") (properties "static-rtz") (properties "fcvt-w-rounds") (properties "fcvt-w-rtz") (properties "fcvt-w-rdn") (properties "fcvt-w-rup") (properties "fcvt-w-rmm"))
  (clause (text "a reserved rounding mode an illegal-instruction exception even on an operation that cannot round (FCVT.D.W[U], FCVT.D.S);") (properties "reserved-where-nothing-rounds") (properties "reserved-on-widening") (properties "reserved-dynamic") (properties "reserved-writes-nothing") (limits "a reserved mode is witnessed on FCVT.D.W and FCVT.D.S, not on FCVT.D.WU"))
  (clause (text "the five flags accrue sticky;") (properties "inexact-flag") (properties "div-by-zero") (properties "flags-accrue") (properties "invalid-flag") (properties "overflow-flag") (properties "underflow-flag") (properties "tininess-after-rounding") (properties "not-tiny-after-rounding") (properties "exact-sets-no-flag") (properties "fmin-signaling-invalid") (properties "fused-invalid-flag") (properties "feq-quiet") (properties "flt-signaling"))
  (clause (text "every NaN an arithmetic operation produces is the canonical NaN 0x7ff8000000000000;") (properties "invalid-is-canonical") (properties "fused-invalid"))
