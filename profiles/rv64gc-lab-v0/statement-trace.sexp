  (clause (text "every rounded operation rounds by its static rm field or, for DYN (111), by frm;") (properties "fdiv-s") (properties "static-rounding") (properties "dynamic-rounding") (properties "static-rtz") (properties "fcvt-w-rounds") (properties "fcvt-w-rtz") (properties "fcvt-w-rdn") (properties "fcvt-w-rup") (properties "fcvt-w-rmm"))
  (clause (text "a reserved rounding mode (a static 101/110, or DYN while frm holds 101-111) is an illegal-instruction exception that writes nothing;") (properties "reserved-static-5") (properties "reserved-static-6") (properties "reserved-dynamic") (properties "reserved-dynamic-6") (properties "reserved-dynamic-7") (properties "reserved-writes-nothing"))
  (clause (text "the five exception flags accrue sticky in fflags, with tininess detected after rounding;") (properties "inexact-flag") (properties "div-by-zero") (properties "flags-accrue") (properties "invalid-flag") (properties "overflow-flag") (properties "underflow-flag") (properties "tininess-after-rounding") (properties "not-tiny-after-rounding") (properties "exact-sets-no-flag") (properties "fmin-signaling-invalid") (properties "fused-invalid-flag") (properties "feq-quiet") (properties "flt-signaling"))
  (clause (text "every NaN an arithmetic operation produces is the canonical NaN 0x7fc00000, while the transfers, sign injection and the bit moves keep the bits;") (properties "invalid-is-canonical") (properties "fused-invalid") (properties "transfers-keep-payload") (properties "sgnj-keeps-payload") (properties "sgnj-sets-no-flag"))
  (clause (text "because D is present every single-precision value lives NaN-boxed in its 64-bit register and an input that is not properly boxed reads as the canonical NaN;") (properties "fmv-w-x-boxes") (properties "improper-box-is-nan"))
  (clause (text "the float-to-integer conversions round by the mode and saturate out-of-range and NaN inputs with NV per the chapter's table;") (properties "fcvt-w-rounds") (properties "fcvt-wu-saturates") (properties "fcvt-invalid-flag") (properties "fcvt-w-nan") (properties "fcvt-wu-nan") (properties "fcvt-l-nan") (properties "fcvt-w-too-large") (properties "fcvt-w-negative-infinity") (properties "fcvt-l-too-large") (properties "fcvt-lu-negative"))
  (clause (text "and with mstatus.FS Off every F instruction is an illegal-instruction exception, while FS becomes Dirty whenever an f-register or the accrued flags change (the declared Precise rule).") (properties "fs-off-cause") (properties "fs-off-keeps-rd") (properties "fs-off-load") (properties "fs-off-arithmetic") (properties "fs-dirty") (properties "fs-clean-stays") (properties "fs-flags-dirty") (properties "fs-dirty-sd") (limits "FS Off is witnessed on a move, a load and an arithmetic form, not on every form")))

(trace (requirement_id "REQ-GC-D")
