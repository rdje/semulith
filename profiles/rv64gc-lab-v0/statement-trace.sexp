;; statement-trace.sexp — each traced requirement's statement, clause by clause (schema/statement-trace.sexp, scripts/statement_trace.py).
;; A clause names the declared properties of the requirement's case that witness it, and the limits that case's limitation names for what none does.
;; The review holds the clauses to the statement's words on every read. Annotation, not proof of semantics (RULES EVD-06).

(trace (requirement_id "REQ-GC-M")
  (clause (text "The M extension's 13 forms compute as the pinned chapter defines them:") (properties "form-mul") (properties "form-mulh") (properties "form-mulhsu") (properties "form-mulhu") (properties "form-mulw") (properties "form-div") (properties "form-divu") (properties "form-rem") (properties "form-remu") (properties "form-divw") (properties "form-divuw") (properties "form-remw") (properties "form-remuw"))
  (clause (text "MUL places the lower XLEN bits of the product in rd;") (properties "form-mul"))
  (clause (text "MULH, MULHSU and MULHU the upper XLEN bits of the full 2xXLEN-bit product, signed x signed, signed x unsigned and unsigned x unsigned;") (properties "form-mulh") (properties "form-mulhsu") (properties "form-mulhu"))
  (clause (text "DIV and DIVU divide rounding towards zero, and REM and REMU give the corresponding remainder, a nonzero signed remainder taking the dividend's sign;") (properties "form-div") (properties "form-divu") (properties "form-rem") (properties "form-remu"))
  (clause (text "the RV64 word forms MULW, DIVW, DIVUW, REMW and REMUW operate on the lower 32 bits and sign-extend the 32-bit result, including on a divide by zero;") (properties "form-mulw") (properties "form-divw") (properties "form-divuw") (properties "form-remw") (properties "form-remuw") (properties "table1-divw-by-zero") (properties "table1-divuw-by-zero") (properties "table1-remw-by-zero") (properties "table1-remuw-by-zero"))
  (clause (text "division by zero yields a quotient with all bits set and a remainder equal to the dividend, and signed overflow (the most-negative integer divided by -1) a quotient equal to the dividend and a remainder of zero -") (properties "table1-div-by-zero") (properties "table1-divu-by-zero") (properties "table1-rem-by-zero") (properties "table1-remu-by-zero") (properties "table1-div-overflow") (properties "table1-rem-overflow") (properties "table1-divw-overflow") (properties "table1-remw-overflow"))
  (clause (text "no M instruction raises an exception.") (properties "table1-div-by-zero") (properties "table1-rem-by-zero") (properties "table1-div-overflow") (properties "table1-rem-overflow")))

(trace (requirement_id "REQ-D-XLEN")
  (clause (text "XLEN = 64.") (properties "xlen-bit63") (properties "xlen-srli63") (properties "xlen-srai63") (properties "xlen-upper-word") (properties "xlen-shamt-40") (properties "xlen-max") (properties "xlen-wrap") (properties "xlen-carry") (properties "rv64-lui") (properties "rv64-addiw") (properties "rv64-srliw") (properties "rv64-sraiw") (properties "rv64-addw") (properties "rv64-subw") (properties "rv64-sllw"))
  (clause (text "The integer registers and the supported user address space are 64 bits.") (properties "xlen-max") (properties "xlen-address") (properties "xlen-address-reported")))

(trace (requirement_id "REQ-D-CSR-SET")
  (clause (text "The implemented CSR set is the committed minimum of 33: mhartid and misa; mstatus, mtvec, medeleg, mideleg, mie, mip, mscratch, mepc, mcause and mtval; menvcfg, mcounteren, mcycle and minstret; sstatus, stvec, sscratch, sepc, scause, stval, sie, sip and scounteren; satp; stimecmp; cycle, time and instret; and fflags, frm and fcsr.") (properties "csr-mhartid") (properties "csr-misa") (properties "csr-mstatus") (properties "csr-mtvec") (properties "csr-medeleg") (properties "csr-mideleg") (properties "csr-mie") (properties "csr-mscratch") (properties "csr-mepc") (properties "csr-mcause") (properties "csr-mtval") (properties "csr-menvcfg") (properties "csr-mcounteren") (properties "csr-mcycle") (properties "csr-minstret") (properties "csr-sstatus") (properties "csr-stvec") (properties "csr-sscratch") (properties "csr-sepc") (properties "csr-scause") (properties "csr-stval") (properties "csr-sie") (properties "csr-sip") (properties "csr-scounteren") (properties "csr-satp") (properties "csr-stimecmp") (properties "csr-cycle") (properties "csr-time") (properties "csr-instret") (properties "csr-fflags") (properties "csr-frm") (properties "csr-fcsr") (properties "csr-mip") (properties "alias-sie-mie") (properties "csr-sip-alias") (properties "alias-sip-clear") (properties "alias-sstatus-mstatus") (properties "alias-fcsr") (properties "fs-dirty-sd") (properties "refused-csrrw-cause") (properties "refused-csrrw-rd-kept") (properties "refused-csrrs-cause") (properties "refused-csrrs-rd-kept") (properties "mhartid-kept") (properties "s-reads-sstatus") (properties "s-refused-cause") (properties "s-refused-mscratch-kept") (properties "s-refused-rd-kept") (properties "s-reads-sscratch") (properties "u-reads-fflags") (properties "u-refused-cause") (properties "u-refused-sscratch-kept") (properties "u-refused-rd-kept"))
  (clause (text "Per-CSR field semantics (WPRI/WARL/WLRL) belong to the privilege leaf (P4-SYSTEM.2).") (limits "per-CSR field semantics stay with P4-SYSTEM.2")))

(trace (requirement_id "REQ-D-ZICNTR")
  (clause (text "The Zicntr base counters (cycle, time, instret) are included") (properties "m-reads-cycle") (properties "m-reads-time") (properties "m-reads-instret") (properties "m-reads-mcycle") (properties "m-reads-minstret") (properties "instret-progress") (properties "cycle-progress") (properties "ro-csrrw-cause") (properties "ro-csrrw-rd-kept") (properties "ro-csrrs-cause") (properties "ro-csrrs-rd-kept") (properties "ro-csrrsi-cause") (properties "ro-csrrsi-rd-kept") (properties "ro-csrrci-cause") (properties "ro-csrrci-rd-kept") (properties "ro-csrrwi-cause") (properties "ro-csrrwi-rd-kept") (properties "ro-read-rs1-x0") (properties "ro-read-uimm-0") (properties "trap-retires-nothing") (properties "s-closed-cycle-cause") (properties "s-closed-cycle-rd-kept") (properties "s-closed-time-cause") (properties "s-closed-time-rd-kept") (properties "s-closed-instret-cause") (properties "s-closed-instret-rd-kept") (properties "s-cy-time-cause") (properties "s-cy-time-rd-kept") (properties "s-cy-instret-cause") (properties "s-cy-instret-rd-kept") (properties "u-closed-cycle-cause") (properties "u-closed-cycle-rd-kept") (properties "u-ir-cycle-cause") (properties "u-ir-cycle-rd-kept") (properties "u-m-closed-instret-cause") (properties "u-m-closed-instret-rd-kept") (properties "s-cy-reads-cycle") (properties "s-reads-instret") (properties "u-reads-instret") (properties "u-reads-cycle") (properties "u-reads-time") (properties "alias-mcycle-cycle") (properties "alias-minstret-instret"))
  (clause (text "— explicitly beyond the G abbreviation — because a Linux-capable profile must offer the supervisor-mode time read;") (properties "s-reads-time"))
  (clause (text "the counters' rate and progress semantics are the environment contract's to declare (P4-SYSTEM.5 and P4-SYSTEM.9), not this resolution's.") (limits "the counters' rate and progress semantics stay the environment contract's"))
  (clause (text "Zihpm (hardware performance monitors) is not selected.") (limits "nor is Zihpm's absence")))

(trace (requirement_id "REQ-D-SSTC")
  (clause (text "Sstc is included — the supervisor timer-compare register stimecmp, gated by menvcfg.STCE —") (properties "m-reads-time") (properties "m-stimecmp-reset") (properties "m-stimecmp-64bits") (properties "s-tm-stce-clear-cause") (properties "s-tm-stce-clear-rd-kept") (properties "s-stce-clear-cause") (properties "s-stce-clear-rd-kept") (properties "s-tm-clear-cause") (properties "s-tm-clear-rd-kept") (properties "u-refused-cause") (properties "u-refused-rd-kept") (properties "not-pending-below-compare") (properties "pending-at-compare") (properties "suppressed-stie-clear") (properties "suppressed-sie-clear") (properties "suppressed-delegated-in-m") (properties "m-still-pending") (properties "suppressed-stce-clear") (properties "stce-clear-not-delivered"))
  (clause (text "so an S-mode kernel programs its own timer without an M-mode round trip.") (properties "s-reads-stimecmp") (properties "s-programs-own") (properties "delivered-scause") (properties "delivered-sepc") (properties "delivered-spp") (properties "delivered-acknowledged") (properties "delivery-resumes") (properties "s-reads-the-time") (properties "scheduled-scause") (properties "scheduled-sepc") (properties "scheduled-count") (properties "scheduled-acknowledged") (properties "u-delivered-scause") (properties "u-delivered-sepc") (properties "u-delivered-spp") (properties "u-acknowledged") (properties "u-resumes") (properties "undelegated-mcause") (properties "undelegated-mepc") (properties "undelegated-resumes")))

(trace (requirement_id "REQ-D-ALU-IMM")
  (clause (text "ADDI adds the sign-extended 12-bit immediate to rs1, wrapping modulo 2^XLEN; overflow is ignored.") (properties "addi-negative") (properties "addi-overflow-ignored") (properties "addi-largest") (properties "addi-smallest"))
  (clause (text "SLTI and SLTIU compare rs1 against the sign-extended immediate, signed and unsigned respectively — SLTIU still sign-extends the immediate first and then compares unsigned.") (properties "slti-true") (properties "slti-negative-immediate") (properties "slti-negative-operand") (properties "sltiu-sign-extended-first") (properties "sltiu-negative-operand") (properties "sltiu-below-one"))
  (clause (text "XORI, ORI and ANDI are bitwise against the sign-extended immediate.") (properties "xori-sign-extended") (properties "ori-sign-extended") (properties "andi-sign-extended")))

(trace (requirement_id "REQ-D-ALU-REG")
  (clause (text "ADD and SUB add and subtract modulo 2^XLEN; overflow is ignored and the result wraps.") (properties "add-form") (properties "sub-order") (properties "add-overflow-ignored") (properties "sub-overflow-ignored"))
  (clause (text "SLT and SLTU are signed and unsigned comparisons respectively, producing 0 or 1.") (properties "slt-reads-rs1-as-negative") (properties "sltu-reads-rs1-as-huge") (properties "slt-equal"))
  (clause (text "XOR, OR and AND are bitwise.") (properties "xor-form") (properties "or-form") (properties "and-form")))

(trace (requirement_id "REQ-D-LUI-AUIPC")
  (clause (text "LUI places the 32-bit U-immediate in rd with the low 12 bits zeroed, sign-extended to 64 bits.") (properties "lui-low-bits-zero") (properties "lui-sign-extends") (properties "lui-largest-positive") (properties "lui-all-bits") (properties "lui-zero"))
  (clause (text "AUIPC forms the same 32-bit offset, sign-extends it to 64 bits, and adds it to the address of the AUIPC instruction.") (properties "auipc-own-address") (properties "auipc-offset") (properties "auipc-sign-extends") (properties "auipc-largest-positive")))

(trace (requirement_id "REQ-D-JALR-LSB")
  (clause (text "JALR computes its target by adding the sign-extended 12-bit immediate to rs1 and then setting the least-significant bit of the result to zero.") (properties "link-odd-rs1") (properties "landing-odd-rs1") (properties "link-odd-immediate") (properties "landing-odd-immediate") (properties "link-even-sum") (properties "landing-even-sum") (properties "link-negative-immediate") (properties "landing-negative-immediate") (properties "link-rd-equals-rs1") (properties "landing-rd-equals-rs1")))

(trace (requirement_id "REQ-D-NO-DELAY-SLOTS")
  (clause (text "Control transfers have no architecturally visible delay slots.") (properties "jal-link") (properties "jalr-link") (properties "jal-no-delay-slot") (properties "jalr-no-delay-slot") (properties "beq-no-delay-slot") (properties "bne-no-delay-slot") (properties "blt-no-delay-slot") (properties "bge-no-delay-slot") (properties "bltu-no-delay-slot") (properties "bgeu-no-delay-slot") (properties "not-taken-falls-through")))

(trace (requirement_id "REQ-D-SHAMT")
  (clause (text "SLLI/SRLI/SRAI take a 6-bit shift amount from the I-immediate;") (properties "slli-largest") (properties "srli-largest") (properties "srai-largest") (properties "slli-amount-32"))
  (clause (text "SLL/SRL/SRA use only the low 6 bits of rs2.") (properties "sll-rs2-above-63") (properties "srl-rs2-above-63") (properties "sra-rs2-above-63") (properties "sll-rs2-at-64"))
  (clause (text "SLLIW/SRLIW/SRAIW take 5 bits,") (properties "slliw-largest") (properties "srliw-largest") (properties "sraiw-largest"))
  (clause (text "and SLLW/SRLW/SRAW use rs2[4:0].") (properties "sllw-rs2-above-31") (properties "srlw-rs2-above-31") (properties "sraw-rs2-above-31") (properties "sllw-rs2-at-32")))

(trace (requirement_id "REQ-D-WSUFFIX")
  (clause (text "The *W instructions ignore the upper 32 bits of their inputs,") (properties "addiw-ignores-upper") (properties "addw-ignores-upper") (properties "srlw-ignores-upper"))
  (clause (text "produce a 32-bit signed result, and sign-extend it to 64 bits — bits XLEN-1 through 31 are equal.") (properties "slliw-sign-extends") (properties "srliw-by-zero") (properties "srliw-zero-fills") (properties "sraiw-copies-bit-31") (properties "sllw-form") (properties "sraw-form"))
  (clause (text "Overflow is ignored.") (properties "addiw-overflow") (properties "addw-overflow") (properties "subw-underflow")))

(trace (requirement_id "REQ-D-LOAD-EXT")
  (clause (text "LW sign-extends its 32-bit result to 64 bits; LWU zero-extends it.") (properties "lw-sign-extends") (properties "lwu-zero-extends") (properties "lw-positive"))
  (clause (text "LH/LB sign-extend and LHU/LBU zero-extend analogously.") (properties "lh-sign-extends") (properties "lhu-zero-extends") (properties "lb-sign-extends") (properties "lbu-zero-extends"))
  (clause (text "SD/SW/SH/SB store the low 64/32/16/8 bits of rs2.") (properties "sd-ld-round-trip") (properties "ld-form") (properties "sb-low-byte-only") (properties "sh-low-half-only") (properties "sw-low-word-only")))

(trace (requirement_id "REQ-D-LOAD-X0")
  (clause (text "A load with rd = x0 must still raise any exceptions") (properties "lb-x0-faults") (properties "lb-x0-address") (properties "lh-x0-faults") (properties "lh-x0-address") (properties "lw-x0-faults") (properties "lw-x0-address") (properties "lbu-x0-faults") (properties "lbu-x0-address") (properties "lhu-x0-faults") (properties "lhu-x0-address") (properties "lwu-x0-faults") (properties "lwu-x0-address") (properties "ld-x0-faults") (properties "ld-x0-address") (properties "no-fault-in-sequence"))
  (clause (text "and cause any other side effects,") (limits "the other side effects a load may cause are not witnessed"))
  (clause (text "even though the loaded value is discarded.") (properties "x0-reads-zero")))

(trace (requirement_id "REQ-D-ECALL-EBREAK")
  (clause (text "ECALL and EBREAK raise synchronous exceptions the architecture delivers:") (properties "m-ecall-cause") (properties "m-ebreak-cause") (properties "s-ebreak-cause") (properties "s-ecall-cause") (properties "u-ecall-delegated-cause") (properties "u-ebreak-delegated-cause") (properties "u-ecall-cause") (properties "u-ebreak-cause"))
  (clause (text "ecall's cause names the originating mode (8 from U, 9 from S, 11 from M) with xtval 0,") (properties "m-ecall-tval") (properties "s-ecall-tval") (properties "u-ecall-delegated-tval") (properties "u-ecall-tval"))
  (clause (text "ebreak's is 3 with xtval the instruction's own address;") (properties "m-ebreak-tval") (properties "s-ebreak-tval") (properties "u-ebreak-delegated-tval") (properties "u-ebreak-tval"))
  (clause (text "delegation (medeleg) chooses the M or S handler,") (properties "u-illegal-cause") (properties "s-ebreak-cause") (properties "u-ecall-delegated-cause"))
  (clause (text "xepc is the instruction's own address,") (properties "m-ecall-epc") (properties "m-ebreak-epc") (properties "s-ebreak-epc") (properties "s-ecall-epc") (properties "u-ecall-delegated-epc") (properties "u-ebreak-delegated-epc") (properties "u-ecall-epc") (properties "u-ebreak-epc"))
  (clause (text "and execution continues in the handler - never a report to the harness.") (properties "m-ecall-cause") (limits "the laboratory's halting report is not a trap and is not in this case")))

(trace (requirement_id "REQ-GC-CSR-ACCESS")
  (clause (text "The Zicsr instructions atomically read and write the addressed CSR under the uniform permission model:") (properties "s-reaches-own"))
  (clause (text "csrrw swaps, csrrs sets bits, csrrc clears bits, and the immediate forms use the zero-extended 5-bit uimm;") (properties "csrrw-reads-old") (properties "csrrw-writes-new") (properties "csrrs-reads-old") (properties "csrrs-sets-bits") (properties "csrrc-reads-old") (properties "csrrc-clears-bits") (properties "csrrwi-reads-old") (properties "csrrwi-zero-extended") (properties "csrrci-reads-old") (properties "csrrsi-reads-old"))
  (clause (text "csrrw/csrrwi with rd=x0 do not read the CSR;") (limits "that CSRRW with rd = x0 does not read has no side effect here to observe"))
  (clause (text "csrrs/csrrc with rs1=x0 and csrrsi/csrrci with uimm=0 do not write it.") (properties "csrrs-x0-no-write") (properties "csrrsi-zero-no-write") (properties "csrrc-x0-no-write") (properties "csrrci-zero-no-write"))
  (clause (text "An access below the address's privilege level,") (properties "refused-cause-3") (properties "s-refused-rd-kept"))
  (clause (text "a write to a read-only address,") (properties "refused-cause-0") (properties "refused-csrrw-rd-kept") (properties "refused-cause-1") (properties "refused-csrrs-rd-kept") (properties "refused-cause-2") (properties "refused-csrrsi-rd-kept"))
  (clause (text "a counter read gated off by mcounteren (and scounteren in U), an stimecmp access below M with mcounteren.TM=0 or menvcfg.STCE=0,") (limits "the counter and Sstc gates are REQ-GC-COUNTERS' and REQ-D-SSTC's"))
  (clause (text "and a satp access in S with mstatus.TVM=1 each raise an illegal-instruction exception.") (properties "satp-tvm-cause") (properties "satp-tvm-rd-kept")))

(trace (requirement_id "REQ-GC-COUNTERS")
  (clause (text "The Zicntr counter reads rdcycle/rdtime/rdinstret read the cycle/time/instret values into rd;") (properties "m-reads-cycle") (properties "m-reads-time") (properties "m-reads-instret"))
  (clause (text "they are csrrs specializations (rs1=x0, the counter's address) and obey the counter-enable gates:") (properties "s-open-reads") (properties "u-open-reads"))
  (clause (text "below M the read is legal only with the mcounteren bit,") (properties "s-closed-rd-kept") (properties "s-time-gate-own-bit"))
  (clause (text "and in U additionally the scounteren bit;") (properties "u-needs-scounteren"))
  (clause (text "the counters' rate and progress are the environment contract's (P4-SYSTEM.5/.9).") (limits "rates and progress stay the environment contract's")))

(trace (requirement_id "REQ-GC-FENCEI")
  (clause (text "fence.i retires as a no-op with no observable effect and never traps:") (properties "fence-i-no-other-effect"))
  (clause (text "the instruction-fetch synchronization is already provided by construction — this machine re-reads memory on every fetch, so a store to a later-fetched address is visible to the next fetch immediately (the laboratory's declared choice, D-CODE-VISIBILITY), and the chapter's coherent/uncached-RAM latitude ('just the fetch pipeline needs to be flushed at a FENCE.I') leaves nothing to flush.") (properties "fence-i-orders-the-store") (properties "store-visible-without-fence"))
  (clause (text "The instruction's funct12/rs1/rd fields are decoded and IGNORED — a fence.i word with nonzero fields executes, never raises (the chapter's forward-compatibility rule: base implementations shall ignore these fields);") (properties "fence-i-fields-ignored"))
  (clause (text "standard software zeroes them.") (properties "fence-i-no-other-effect")))

(trace (requirement_id "REQ-D-IALIGN-16")
  (clause (text "With the C extension present, IALIGN is 16 — instructions start on any 16-bit boundary —") (properties "jalr-halfword-landing") (properties "branch-halfword-landing") (properties "jal-halfword-landing") (properties "c-form-advances-two"))
  (clause (text "while ILEN remains 32;") (limits "ILEN's own diagnostic is REQ-GC-C's"))
  (clause (text "no instruction-address-misaligned exception arises from C's 16-bit forms.") (properties "jalr-halfword-link") (properties "jal-halfword-link") (properties "jalr-halfword-landing")))

(trace (requirement_id "REQ-GC-ATOMICS")
  (clause (text "The A extension's 22 forms behave per the pinned chapter:") (properties "amoswap-w-old") (properties "amoadd-w-old") (properties "amoxor-w-old") (properties "amoand-w-old") (properties "amoor-w-old") (properties "amomin-w-old") (properties "amomax-w-old") (properties "amominu-w-old") (properties "amomaxu-w-old") (properties "amoswap-d-old") (properties "amoadd-d-old") (properties "amoxor-d-old") (properties "amoand-d-old") (properties "amoor-d-old") (properties "amomin-d-old") (properties "amomax-d-old") (properties "amominu-d-old") (properties "amomaxu-d-old") (properties "lr-w-sign-extends") (properties "lr-d-reads") (properties "sc-w-succeeds") (properties "sc-d-succeeds"))
  (clause (text "LR loads the word or doubleword and registers the reservation (sign-extended for .W);") (properties "lr-w-sign-extends") (properties "lr-d-reads") (properties "sc-w-succeeds") (properties "sc-d-succeeds") (properties "lr-fault-cause") (properties "lr-fault-keeps-rd") (properties "lr-fault-reserves-nothing"))
  (clause (text "SC conditionally stores and writes the code to rd — 0 on success, 1 on failure under the declared deterministic policy;") (properties "sc-w-succeeds") (properties "sc-w-stored") (properties "sc-d-succeeds") (properties "sc-d-stored") (properties "second-sc-fails") (properties "failed-sc-stores-nothing") (properties "lr-fault-reserves-nothing"))
  (clause (text "the nine AMOs read-modify-write atomically at both widths — the old memory value to rd (sign-extended for .W), the computed value to memory,") (properties "amoswap-w-old") (properties "amoswap-w-new") (properties "amoadd-w-old") (properties "amoadd-w-new") (properties "amoxor-w-old") (properties "amoxor-w-new") (properties "amoand-w-old") (properties "amoand-w-new") (properties "amoor-w-old") (properties "amoor-w-new") (properties "amomin-w-old") (properties "amomin-w-new") (properties "amomax-w-old") (properties "amomax-w-new") (properties "amominu-w-old") (properties "amominu-w-new") (properties "amomaxu-w-old") (properties "amomaxu-w-new") (properties "amoswap-d-old") (properties "amoswap-d-new") (properties "amoadd-d-old") (properties "amoadd-d-new") (properties "amoxor-d-old") (properties "amoxor-d-new") (properties "amoand-d-old") (properties "amoand-d-new") (properties "amoor-d-old") (properties "amoor-d-new") (properties "amomin-d-old") (properties "amomin-d-new") (properties "amomax-d-old") (properties "amomax-d-new") (properties "amominu-d-old") (properties "amominu-d-new") (properties "amomaxu-d-old") (properties "amomaxu-d-new") (properties "word-amo-keeps-upper") (properties "word-amo-ignores-rs2-upper") (properties "rd-equals-rs2-old") (properties "rd-equals-rs2-sum") (properties "rd-equals-rs1-old") (properties "rd-equals-rs1-sum") (properties "amo-fault-cause") (properties "amo-fault-keeps-rd") (limits "one hart earns no multicore or weak-memory claim"))
  (clause (text "one store/AMO-rules translation (an AMO on an unreadable page raises a store page fault, never a load page fault).") (properties "amo-unreadable-cause") (properties "amo-unreadable-stval") (properties "translated-amo-reads") (properties "translated-amo-writes"))
  (clause (text "The aq/rl annotations decode (all four combinations) and order nothing observable at one hart.") (properties "amoadd-aq-decodes") (properties "amoadd-rl-decodes") (properties "amoadd-aqrl-decodes") (properties "amoadd-w-old") (properties "lr-aqrl-decodes") (properties "sc-aq-decodes")))

(trace (requirement_id "REQ-GC-C")
  (clause (text "The RV64+D C selection has 37 sixteen-bit forms, Zca plus Zcd.") (properties "c-li") (properties "c-addi") (properties "c-mv") (properties "c-add") (properties "c-lui") (properties "c-slli") (properties "c-srli") (properties "c-srai") (properties "c-andi") (properties "c-sub") (properties "c-xor") (properties "c-or") (properties "c-and") (properties "c-addiw") (properties "c-addw") (properties "c-subw") (properties "c-addi16sp") (properties "c-addi4spn") (properties "c-sw-lw") (properties "c-sd-ld") (properties "c-swsp-lwsp") (properties "c-sdsp-ldsp") (properties "c-fld-loads") (properties "c-fsd-stores") (properties "c-fldsp-loads") (properties "c-fsdsp-stores") (properties "c-nop-advances-two") (properties "c-beqz-taken") (properties "c-bnez-taken") (properties "c-j-taken") (properties "c-jr-taken") (properties "c-jalr-links-next-parcel") (properties "c-ebreak-cause"))
  (clause (text "Each executes its declared single base-instruction expansion over the reconstructed compact registers and signed/scaled immediates;") (properties "c-addi16sp") (properties "c-addi4spn") (properties "c-sw-lw") (properties "c-sd-ld") (properties "c-swsp-lwsp") (properties "c-sdsp-ldsp") (properties "c-lui") (properties "c-andi"))
  (clause (text "C.JALR takes its target from the old source and writes pc+2, including rd=rs1.") (properties "c-jalr-links-next-parcel") (properties "c-jalr-takes-old-source"))
  (clause (text "Instruction PCs advance by two or four bytes under IALIGN=16.") (properties "c-nop-advances-two") (properties "hints-advance-only"))
  (clause (text "HINTs preserve architectural state except advancing PC and applicable performance counters,") (properties "hints-advance-only") (properties "hints-keep-state") (limits "a HINT's effect on the performance counters is not read"))
  (clause (text "and C.EBREAK delivers breakpoint cause 3.") (properties "c-ebreak-cause") (properties "c-ebreak-epc"))
  (clause (text "Compressed D memory obeys the D extension and FS gate.") (properties "c-fld-fs-off") (properties "c-fsdsp-fs-off") (properties "c-fld-off-writes-nothing") (properties "c-fld-loads") (properties "c-fsd-stores") (properties "c-fldsp-loads") (properties "c-fsdsp-stores"))
  (clause (text "Reserved operands are refused with their original sixteen bits under the declared illegal-instruction policy.") (properties "reserved-c-lwsp") (properties "reserved-c-jr") (properties "all-zero-parcel"))
  (clause (text "Fetch reads the first parcel exactly and a second only for a 32-bit instruction;") (properties "parcel-before-page-end") (properties "one-parcel-at-page-end") (properties "next-fetch-faults-there") (limits "never by counting the environment's requests"))
  (clause (text "a second-parcel translation fault reports that parcel VA in xtval and the instruction start in xepc, before any instruction effect.") (properties "second-parcel-cause") (properties "second-parcel-tval") (properties "second-parcel-epc") (properties "second-parcel-no-effect"))
  (clause (text "The all-ones illegal instruction retains all ILEN=32 bits in the diagnostic.") (properties "all-ones-keeps-ilen"))
  (clause (text "Valid C forms preserve the constrained LR/SC guarantee.") (properties "c-keeps-reservation")))

(trace (requirement_id "REQ-GC-F")
  (clause (text "The F extension's 30 single-precision forms behave per the pinned chapter under IEEE 754-2008:") (properties "flw-loads") (properties "fsw-stores") (properties "fadd-s") (properties "fsub-s") (properties "fmul-s") (properties "fdiv-s") (properties "fsqrt-s") (properties "fmadd-s") (properties "fmsub-s") (properties "fnmsub-s") (properties "fnmadd-s") (properties "fsgnj-s") (properties "fsgnjn-s") (properties "fsgnjx-s") (properties "fmin-s") (properties "fmax-s") (properties "fmin-one-nan") (properties "fmin-both-nan") (properties "fmin-signaling-other") (properties "fcvt-l-s") (properties "fcvt-lu-s") (properties "fcvt-s-w") (properties "fcvt-s-wu") (properties "fcvt-s-l") (properties "fcvt-s-lu") (properties "fmv-x-w-moves-bits") (properties "feq-s") (properties "flt-s") (properties "fle-s") (properties "fclass-s") (properties "fclass-negative-infinity") (properties "fclass-negative-normal") (properties "fclass-negative-subnormal") (properties "fclass-negative-zero") (properties "fclass-positive-zero") (properties "fclass-positive-subnormal") (properties "fclass-positive-infinity") (properties "fclass-signaling") (properties "fclass-quiet"))
  (clause (text "every rounded operation rounds by its static rm field or, for DYN (111), by frm;") (properties "fdiv-s") (properties "static-rounding") (properties "dynamic-rounding") (properties "static-rtz") (properties "fcvt-w-rounds") (properties "fcvt-w-rtz") (properties "fcvt-w-rdn") (properties "fcvt-w-rup") (properties "fcvt-w-rmm"))
  (clause (text "a reserved rounding mode (a static 101/110, or DYN while frm holds 101-111) is an illegal-instruction exception that writes nothing;") (properties "reserved-static-5") (properties "reserved-static-6") (properties "reserved-dynamic") (properties "reserved-dynamic-6") (properties "reserved-dynamic-7") (properties "reserved-writes-nothing"))
  (clause (text "the five exception flags accrue sticky in fflags, with tininess detected after rounding;") (properties "inexact-flag") (properties "div-by-zero") (properties "flags-accrue") (properties "invalid-flag") (properties "overflow-flag") (properties "underflow-flag") (properties "tininess-after-rounding") (properties "not-tiny-after-rounding") (properties "exact-sets-no-flag") (properties "fmin-signaling-invalid") (properties "fused-invalid-flag") (properties "feq-quiet") (properties "flt-signaling"))
  (clause (text "every NaN an arithmetic operation produces is the canonical NaN 0x7fc00000, while the transfers, sign injection and the bit moves keep the bits;") (properties "invalid-is-canonical") (properties "fused-invalid") (properties "transfers-keep-payload") (properties "sgnj-keeps-payload") (properties "sgnj-sets-no-flag"))
  (clause (text "because D is present every single-precision value lives NaN-boxed in its 64-bit register and an input that is not properly boxed reads as the canonical NaN;") (properties "fmv-w-x-boxes") (properties "improper-box-is-nan"))
  (clause (text "the float-to-integer conversions round by the mode and saturate out-of-range and NaN inputs with NV per the chapter's table;") (properties "fcvt-w-rounds") (properties "fcvt-wu-saturates") (properties "fcvt-invalid-flag") (properties "fcvt-w-nan") (properties "fcvt-wu-nan") (properties "fcvt-l-nan") (properties "fcvt-w-too-large") (properties "fcvt-w-negative-infinity") (properties "fcvt-l-too-large") (properties "fcvt-lu-negative"))
  (clause (text "and with mstatus.FS Off every F instruction is an illegal-instruction exception, while FS becomes Dirty whenever an f-register or the accrued flags change (the declared Precise rule).") (properties "fs-off-cause") (properties "fs-off-keeps-rd") (properties "fs-off-load") (properties "fs-off-arithmetic") (properties "fs-dirty") (properties "fs-clean-stays") (properties "fs-flags-dirty") (properties "fs-dirty-sd") (limits "FS Off is witnessed on a move, a load and an arithmetic form, not on every form")))

(trace (requirement_id "REQ-GC-D")
  (clause (text "The D extension's 32 double-precision forms behave as their single-precision counterparts at format 64, as the pinned chapter defines them:") (properties "fld-loads") (properties "fsd-stores") (properties "fadd-d") (properties "fsub-d") (properties "fmul-d") (properties "fdiv-d") (properties "fsqrt-d") (properties "fmadd-d") (properties "fmsub-d") (properties "fnmsub-d") (properties "fnmadd-d") (properties "fsgnj-d") (properties "fsgnjn-d") (properties "fsgnjx-d") (properties "fmin-d") (properties "fmax-d") (properties "fmin-one-nan") (properties "fmin-both-nan") (properties "fmin-signaling-other") (properties "fcvt-l-d") (properties "fcvt-lu-d") (properties "fcvt-d-w") (properties "fcvt-d-wu") (properties "fcvt-d-l") (properties "fcvt-d-lu") (properties "feq-d") (properties "flt-d") (properties "fle-d") (properties "fclass-d") (properties "fclass-negative-infinity") (properties "fclass-negative-normal") (properties "fclass-negative-subnormal") (properties "fclass-negative-zero") (properties "fclass-positive-zero") (properties "fclass-positive-subnormal") (properties "fclass-positive-infinity") (properties "fclass-signaling") (properties "fclass-quiet"))
  (clause (text "rounding by the static rm or, for DYN, frm,") (properties "fdiv-d") (properties "static-rounding") (properties "dynamic-rounding") (properties "static-rtz") (properties "fcvt-w-rounds") (properties "fcvt-w-rtz") (properties "fcvt-w-rdn") (properties "fcvt-w-rup") (properties "fcvt-w-rmm"))
  (clause (text "a reserved rounding mode an illegal-instruction exception even on an operation that cannot round (FCVT.D.W[U], FCVT.D.S);") (properties "reserved-where-nothing-rounds") (properties "reserved-on-widening") (properties "reserved-dynamic") (properties "reserved-writes-nothing") (limits "a reserved mode is witnessed on FCVT.D.W and FCVT.D.S, not on FCVT.D.WU"))
  (clause (text "the five flags accrue sticky;") (properties "inexact-flag") (properties "div-by-zero") (properties "flags-accrue") (properties "invalid-flag") (properties "overflow-flag") (properties "underflow-flag") (properties "tininess-after-rounding") (properties "not-tiny-after-rounding") (properties "exact-sets-no-flag") (properties "fmin-signaling-invalid") (properties "fused-invalid-flag") (properties "feq-quiet") (properties "flt-signaling"))
  (clause (text "every NaN an arithmetic operation produces is the canonical NaN 0x7ff8000000000000;") (properties "invalid-is-canonical") (properties "fused-invalid"))
  (clause (text "FLD/FSD and FMV.X.D/FMV.D.X move the 64 bits unmodified,") (properties "fmv-x-d-moves-bits") (properties "transfers-keep-payload") (properties "sgnj-keeps-payload") (properties "sgnj-sets-no-flag"))
  (clause (text "so a NaN-boxed single read by a D operation is the negative quiet NaN it appears as;") (properties "box-is-a-quiet-nan"))
  (clause (text "FCVT.S.D rounds by rm and writes its single NaN-boxed,") (properties "fcvt-s-d") (properties "fcvt-s-d-rounds"))
  (clause (text "FCVT.D.S widens exactly and reads its operand through the boxing rule (an unboxed input is the canonical NaN);") (properties "fcvt-d-s") (properties "fcvt-d-s-unboxed"))
  (clause (text "a signaling-NaN input to a conversion raises NV;") (properties "snan-conversion-invalid") (properties "snan-conversion-canonical"))
  (clause (text "the integer conversions saturate with NV as FCVT.int.S does;") (properties "fcvt-wu-saturates") (properties "fcvt-invalid-flag") (properties "fcvt-w-nan") (properties "fcvt-wu-nan") (properties "fcvt-l-nan") (properties "fcvt-w-too-large") (properties "fcvt-w-negative-infinity") (properties "fcvt-l-too-large") (properties "fcvt-lu-negative"))
  (clause (text "and every D instruction is an illegal-instruction exception at mstatus.FS Off, with FS Dirty on any f-register write or flag change.") (properties "fs-off-cause") (properties "fs-off-keeps-rd") (properties "fs-off-load") (properties "fs-off-arithmetic") (properties "fs-dirty") (properties "fs-clean-stays") (properties "fs-flags-dirty") (properties "fs-dirty-sd") (limits "FS Off is witnessed on a move, a load and an arithmetic form, not on every form")))
