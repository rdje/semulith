  (state (integer_registers 32) (comment "x0..x31") (x0_hardwired_zero true) (register_width_bits 64) (program_counter "pc") (comment "the f0–f31 floating-point file and the per-CSR field census land with the state document in the definition leaves (P4-SYSTEM.2/.7)") (csrs "mhartid") (csrs "misa") (csrs "mstatus") (csrs "mtvec") (csrs "medeleg") (csrs "mideleg") (csrs "mie") (csrs "mip") (csrs "mscratch") (csrs "mepc") (csrs "mcause") (csrs "mtval") (csrs "menvcfg") (csrs "mcounteren") (csrs "mcycle") (csrs "minstret") (csrs "sstatus") (csrs "stvec") (csrs "sscratch") (csrs "sepc") (csrs "scause") (csrs "stval") (csrs "sie") (csrs "sip") (csrs "scounteren") (csrs "satp") (csrs "stimecmp") (csrs "cycle") (csrs "time") (csrs "instret") (csrs "fflags") (csrs "frm") (csrs "fcsr") (comment "D-CSR-SET: the committed minimum, 33 named CSRs; WPRI/WARL/WLRL per-field semantics are P4-SYSTEM.2's") (authority architecture) (source "RVI-RV32I §1.1.1 Programmers' Model; RVI-RV64I §3.1.1 Register State; RVP-CSR 1.1 (the CSR listings); RVI-F 20.1.1 (the FP CSRs); RVP-SSTC 12.1 (stimecmp); RVI-ZICNTR 6.1 (the counter CSRs)"))
  (comment "─────────────────────────────────────────────────────────────── instruction scope" "The RV64I base census (52 forms — the same enumeration and source as rv64i-lab-v0, the" "profile this one extends) plus the evidence leaves' extension censuses (D-SCOPE-CENSUS):" "the Zicsr six (RVI-ZICSR §5.1.1), the privileged four (RVP-INSNS 18.1; D-PRIV-INSNS) and" "the Zicntr three (RVI-ZICNTR §6.1.1), and the A 22 (RVI-RVWMO §17.1.3 Tables 6/7, the pinned enumeration; RVI-A §12.1) — 87 forms at P4-SYSTEM.4 slice (e); + FENCE.I (RVI-ZIFENCEI §4.1) = 88 at P4-SYSTEM.6 slice (b); + the F 30 (RVI-F §20.1.5–§20.1.9, the pinned chapter's single-precision forms) = 118 at P4-SYSTEM.7 slice (c6); + the D 32 (RVI-D §21.1.3–§21.1.7, the double-precision forms) = 150 at slice (d5). The Zicntr" "three are the specification's instruction LISTINGS; the encoding realizes them as csrrs" "specializations (definitions/riscv/zicntr.sexp's pseudos) — the census is the profile's" "spec-facing form set; the pseudo relation is the realization's, and EXERCISE-COVERAGE" "observes the spelling in the expectations' insn text (measured: its numerator is the" "first token of (step (insn …))).")
  (scope (count_base 40) (count_rv64i_additions 12) (count_total 150) (authority architecture) (source "RVI-RV32I §1.1.4–§1.1.8; RVI-RV64I §3.1.2–§3.1.3; RVI-ZICSR §5.1.1; RVI-ZICNTR §6.1.1; RVP-INSNS 18.1; RVI-A §12.1; RVI-RVWMO §17.1.3 Tables 6/7; RVI-ZIFENCEI §4.1; RVI-F §20.1.5–§20.1.9; RVI-D §21.1.3–§21.1.7") (base_u_type "LUI") (base_u_type "AUIPC") (base_jumps "JAL") (base_jumps "JALR") (base_branches "BEQ") (base_branches "BNE") (base_branches "BLT") (base_branches "BGE") (base_branches "BLTU") (base_branches "BGEU") (base_loads "LB") (base_loads "LH") (base_loads "LW") (base_loads "LBU") (base_loads "LHU") (base_stores "SB") (base_stores "SH") (base_stores "SW") (base_op_imm "ADDI") (base_op_imm "SLTI") (base_op_imm "SLTIU") (base_op_imm "XORI") (base_op_imm "ORI") (base_op_imm "ANDI") (base_op_imm "SLLI") (base_op_imm "SRLI") (base_op_imm "SRAI") (base_op "ADD") (base_op "SUB") (base_op "SLL") (base_op "SLT") (base_op "SLTU") (base_op "XOR") (base_op "SRL") (base_op "SRA") (base_op "OR") (base_op "AND") (base_misc_mem "FENCE") (base_system "ECALL") (base_system "EBREAK") (rv64_loads "LWU") (rv64_loads "LD") (rv64_stores "SD") (rv64_op_imm_32 "ADDIW") (rv64_op_imm_32 "SLLIW") (rv64_op_imm_32 "SRLIW") (rv64_op_imm_32 "SRAIW") (rv64_op_32 "ADDW") (rv64_op_32 "SUBW") (rv64_op_32 "SLLW") (rv64_op_32 "SRLW") (rv64_op_32 "SRAW") (zicsr_csrs "CSRRW") (zicsr_csrs "CSRRS") (zicsr_csrs "CSRRC") (zicsr_csrs "CSRRWI") (zicsr_csrs "CSRRSI") (zicsr_csrs "CSRRCI") (system_privileged "MRET") (system_privileged "SRET") (system_privileged "WFI") (system_privileged "SFENCE.VMA") (zicntr_counters "RDCYCLE") (zicntr_counters "RDTIME") (zicntr_counters "RDINSTRET") (a_atomics "LR.W") (a_atomics "SC.W") (a_atomics "AMOSWAP.W") (a_atomics "AMOADD.W") (a_atomics "AMOXOR.W") (a_atomics "AMOAND.W") (a_atomics "AMOOR.W") (a_atomics "AMOMIN.W") (a_atomics "AMOMAX.W") (a_atomics "AMOMINU.W") (a_atomics "AMOMAXU.W") (a_atomics "LR.D") (a_atomics "SC.D") (a_atomics "AMOSWAP.D") (a_atomics "AMOADD.D") (a_atomics "AMOXOR.D") (a_atomics "AMOAND.D") (a_atomics "AMOOR.D") (a_atomics "AMOMIN.D") (a_atomics "AMOMAX.D") (a_atomics "AMOMINU.D") (a_atomics "AMOMAXU.D") (zifencei_fencei "FENCE.I") (f_single "FLW") (f_single "FSW") (f_single "FMADD.S") (f_single "FMSUB.S") (f_single "FNMSUB.S") (f_single "FNMADD.S") (f_single "FADD.S") (f_single "FSUB.S") (f_single "FMUL.S") (f_single "FDIV.S") (f_single "FSQRT.S") (f_single "FSGNJ.S") (f_single "FSGNJN.S") (f_single "FSGNJX.S") (f_single "FMIN.S") (f_single "FMAX.S") (f_single "FCVT.W.S") (f_single "FCVT.WU.S") (f_single "FMV.X.W") (f_single "FEQ.S") (f_single "FLT.S") (f_single "FLE.S") (f_single "FCLASS.S") (f_single "FCVT.S.W") (f_single "FCVT.S.WU") (f_single "FMV.W.X") (f_single "FCVT.L.S") (f_single "FCVT.LU.S") (f_single "FCVT.S.L") (f_single "FCVT.S.LU") (d_double "FLD") (d_double "FSD") (d_double "FMADD.D") (d_double "FMSUB.D") (d_double "FNMSUB.D") (d_double "FNMADD.D") (d_double "FADD.D") (d_double "FSUB.D") (d_double "FMUL.D") (d_double "FDIV.D") (d_double "FSQRT.D") (d_double "FSGNJ.D") (d_double "FSGNJN.D") (d_double "FSGNJX.D") (d_double "FMIN.D") (d_double "FMAX.D") (d_double "FCVT.S.D") (d_double "FCVT.D.S") (d_double "FEQ.D") (d_double "FLT.D") (d_double "FLE.D") (d_double "FCLASS.D") (d_double "FCVT.W.D") (d_double "FCVT.WU.D") (d_double "FCVT.D.W") (d_double "FCVT.D.WU") (d_double "FCVT.L.D") (d_double "FCVT.LU.D") (d_double "FMV.X.D") (d_double "FCVT.D.L") (d_double "FCVT.D.LU") (d_double "FMV.D.X"))
  (vehicle (route generated-definition) (authority laboratory) (source "docs/tasks/P4-SYSTEM.md, the .2 design brief (2026-10-03), checkpoint (h) — the atomic flip"))
  (comment "─────────────────────────────────────────────────────────────── resolved decisions" "id | authority | the decision | where it comes from")
  (decision (id "D-GC-COMPOSITION") (authority architecture) (statement "The profile's instruction set is RV64I plus the extensions M, A, F, D and C, plus Zicsr and Zifencei, plus Zicntr: 'G' is the defined abbreviation for the IMAFDZicsr_Zifencei base-and-extensions combination, and this profile is G plus C and Zicntr on the unprivileged side and Sstc on the privileged side.") (source "RVI-NAMING 36.1 (the G definition); RVI-ZICNTR 6.1; RVP-SSTC 12.1"))
  (decision (id "D-EXT-CLOSURE") (authority architecture) (statement "The extension dependency closure is complete under the pinned revision: D depends on F; F depends on Zicsr for control and status register access; and C decomposes as Zca always plus Zcd when D is present (Zcf exists only at RV32). Nothing in this profile is inferred from the letter 'G' alone.") (source "RVI-D 21.1; RVI-F 20.1; RVI-ZC 28.1.2; RVI-NAMING 36.1"))
  (decision (id "D-PRIV-REVISION") (authority architecture) (statement "The privileged architecture is the pinned publication's: Machine-Level ISA Version 1.13 and Supervisor-Level ISA Version 1.13, under spec revision v20260120 — the same publication family as the unprivileged pin.") (source "RVP-MACHINE 2.1; RVP-SUPERVISOR 11.1 (the chapters' own stated versions)"))
  (decision (id "D-PRIV-MODES") (authority laboratory) (statement "The profile implements machine, supervisor and user modes — the minimum a Linux-capable profile needs (M-mode firmware, S-mode kernel, U-mode userspace); the hypervisor extension is excluded, and every mode-dependent behaviour is tested in each supported mode (P4-SYSTEM.2).") (source "RVP-INTRO (the modes and their intent); ROADMAP.md §P4"))
  (decision (id "D-SV39") (authority laboratory) (statement "Translation is Sv39: of the three paged virtual-memory schemes defined for SXLEN=64 (Sv39, Sv48, Sv57), the profile selects the minimal Linux-capable one — also the one the pinned SoC precedent implements (the FU540-C000's U54 supports Bare and Sv39). The U54's A/D behaviour (page faults instead of setting PTE A/D bits) is recorded as P4-SYSTEM.3's policy input, not as this profile's rule.") (source "RVP-SUPERVISOR 11.1.3–11.1.4; SIFIVE-FU540-C000 §4.7") (note "Followed up by D-SVADE (P4-SYSTEM.3 slice a, 2026-10-03): the U54's page-fault scheme is now the profile's RULE (Svade selected). The 'not as this profile's rule' clause is the pre-.3 record, kept verbatim because the requirement catalogue mirrors it (RECORD-SCHEMA rule 4)."))
  (decision (id "D-SVADE") (authority laboratory) (statement "The profile implements Svade: when a translation needs an A or D PTE update, the hart raises a page fault instead of performing the hardware update. Three evidence legs: (i) the pinned revision defines exactly two A/D schemes and names the page-fault one Svade (RVP-SUPERVISOR §11.1.3.1, §11.1.10); (ii) the profile's own translation precedent — the U54 MMU the Sv39 choice already cites — implements exactly that scheme ('does not automatically set the A and D bits … Instead, the U54 MMU will raise a page fault', FU540 §4.7); (iii) the laboratory's observe-through-the-ISA discipline (P4-SYSTEM.2 decision 6) can evidence a page fault (scause/stval via csrr) but cannot evidence an implicit PTE write, so the hardware-update default would price a new observation vocabulary to test a side effect the laboratory need not produce. Svadu is NOT selected: menvcfg's ADUE stays WPRI (the state document's wpri_62_0 field).") (source "RVP-SUPERVISOR §11.1.3.1, §11.1.10; SIFIVE-FU540-C000 §4.7; docs/tasks/P4-SYSTEM.md, the .3 design brief (2026-10-03)"))
  (decision (id "D-IALIGN-16") (authority architecture) (statement "With the C extension present, IALIGN is 16 — instructions start on any 16-bit boundary — while ILEN remains 32; no instruction-address-misaligned exception arises from C's 16-bit forms.") (source "RVI-C 27.1"))
  (decision (id "D-ZICNTR") (authority laboratory) (statement "The Zicntr base counters (cycle, time, instret) are included — explicitly beyond the G abbreviation — because a Linux-capable profile must offer the supervisor-mode time read; the counters' rate and progress semantics are the environment contract's to declare (P4-SYSTEM.5 and P4-SYSTEM.9), not this resolution's. Zihpm (hardware performance monitors) is not selected.") (source "RVI-ZICNTR 6.1; ROADMAP.md §P4"))
  (decision (id "D-SSTC") (authority laboratory) (statement "Sstc is included — the supervisor timer-compare register stimecmp, gated by menvcfg.STCE — so an S-mode kernel programs its own timer without an M-mode round trip.") (source "RVP-SSTC 12.1"))
  (decision (id "D-FP-DEFER") (authority laboratory) (statement "F and D are in the profile because the standard RV64G userspace ABI is LP64D, which requires the D extension; the model implements no floating point until the floating-point backend passes qualification (P4-SYSTEM.7), the CPU-SYSTEM gate verdict reads incomplete until then, and a Sail-versus-Spike floating-point comparison is one implementation twice (the SoftFloat shared ancestry), never independent numeric evidence.") (source "RVI-PSABI (the LP64D statement); docs/decisions/reference_softfloat-shared-ancestry.md; the P4-SYSTEM tree's non-goals"))
  (decision (id "D-ABI") (authority laboratory) (statement "The toolchain ABI is LP64D — the standard RV64G ABI (ELFCLASS64 with EF_RISCV_FLOAT_ABI_DOUBLE, the hardware floating-point calling convention with ABI_FLEN=64); the toolchain is the host's clang/lld 21.1.8 with an rv64gc target (the existing guest-toolchain decision).") (source "RVI-PSABI (the ABI table and the LP64D note); docs/decisions/decision_c-guest-routing-and-toolchain.md"))
  (decision (id "D-SBI") (authority laboratory) (statement "The firmware contract for the Linux boot route is SBI 2.0: compatible M-mode firmware provides selected SBI services (timer, console, system reset, hart state management) before entering the S-mode kernel — real firmware, and a host-modelled SBI is a different contract, never silently substituted.") (source "RVI-SBI (the extension inventory: base, TIME, sPI, RFENCE, HSM, SRST, DBCN); ROADMAP.md §P6"))
  (decision (id "D-CSR-SET") (authority laboratory) (statement "The implemented CSR set is the committed minimum of 33: mhartid and misa; mstatus, mtvec, medeleg, mideleg, mie, mip, mscratch, mepc, mcause and mtval; menvcfg, mcounteren, mcycle and minstret; sstatus, stvec, sscratch, sepc, scause, stval, sie, sip and scounteren; satp; stimecmp; cycle, time and instret; and fflags, frm and fcsr. Per-CSR field semantics (WPRI/WARL/WLRL) belong to the privilege leaf (P4-SYSTEM.2).") (source "RVP-MACHINE 2.1; RVP-SUPERVISOR 11.1; RVP-CSR 1.1; RVI-F 20.1.1; RVI-ZICNTR 6.1; RVP-SSTC 12.1"))
  (decision (id "D-NO-PMP") (authority laboratory) (statement "PMP is excluded at v0: the privileged architecture's physical memory protection unit is optional, and the first boot contract does not require it; the decision is revisited by the board branch that needs it.") (source "RVP-MACHINE §2.1.7 ('an optional physical memory protection (PMP) unit'); ROADMAP.md §P4"))
  (decision (id "D-NO-H") (authority laboratory) (statement "The hypervisor extension is excluded: the profile has one hart and no virtualization workload in the first Linux profile; H would arrive with a consumer, never ahead of one.") (source "RVP-INTRO; ROADMAP.md §P4"))
  (decision (id "D-RVWMO") (authority architecture) (statement "The memory consistency model is RVWMO: with the A extension in the profile the memory model is load-bearing even at one hart (the AMOs and their aq/rl annotations), and the multicore exposure of the weak model is MC-MULTICORE's, never smuggled in.") (source "RVI-RVWMO 17.1; RVI-A 12.1"))
  (decision (id "D-PRIV-INSNS") (authority architecture) (statement "The privileged instructions in scope are mret, sret, wfi and sfence.vma (the pinned privileged instruction listings); wfi's wake semantics belong to the interrupt/counter/wait leaf (P4-SYSTEM.5).") (source "RVP-INSNS 18.1; RVP-MACHINE 2.1; RVP-SUPERVISOR 11.1"))
  (decision (id "D-RESOLUTION-ROUTE") (authority laboratory) (statement "This unit is a profile resolution: the selection is exact and citable, and the definition pipeline (encoding fragments, semantics, guests) has not started; the dossier declares the profile-resolution vehicle route, and the definition-pipeline gates refuse any encoding, state-census or guest-corpus document beside the declaration.") (source "docs/tasks/P4-SYSTEM.md, the .1 design brief (2026-10-02)") (note "Superseded by D-ROUTE-FLIP (P4-SYSTEM.2 slice h, 2026-10-03): the definition pipeline landed — the statement's 'has not started' is the historical record of the resolution stage, kept verbatim because the requirement catalogue mirrors it (RECORD-SCHEMA rule 4); the route it declared is replaced, not edited."))
  (decision (id "D-ROUTE-FLIP") (authority laboratory) (statement "The definition pipeline has landed and the dossier declares the generated-definition vehicle route: the unit carries its encoding composition (the RV64I base plus Zicsr, Zicntr and the privileged-system fragment — (status partial) with six declared slots for M/A/F/D/C/Zifencei), the 33-CSR state document, the 62-guest corpus (the base mirror plus the mode matrix) and the 7-axis interaction matrix, and the generated mirrors (state_rv64gc.rs, definition_rv64gc.rs, guests_rv64gc.rs) are tracked because their canonical inputs are tracked in the same commit (decision_generated-mirror-needs-tracked-input).") (source "docs/tasks/P4-SYSTEM.md, the .2 design brief (2026-10-03), checkpoint (h)"))
  (decision (id "D-WALK-IMPLICIT") (authority laboratory) (statement "When address translation is active (satp.MODE=Sv39), the hart's implicit memory accesses are the instruction fetch AND the translation algorithm's page-table reads: up to LEVELS (3) implicit 8-byte reads per access, each crossing the environment boundary as the walk-access kind, never silently as a data load. Under Svade the permitted page-table side effects are NONE: no implicit writes, ever. This AMENDS the implicit-access vocabulary for the translated composition: the base corpus's REQ-D-FETCH-IMPLICIT stays true of rv64i-lab-v0 (no translation exists there), and rv64gc's catalogue never carried it — measured: the mirror's closure is 13 records and it is not among them.") (source "RVP-SUPERVISOR §11.1.3.2; RVI-INTRO Memory; docs/tasks/P4-SYSTEM.md, the .3 design brief (2026-10-03)"))
  (decision (id "D-RESERVATION") (authority laboratory) (statement "The hart's reservation is one (physical address, width, valid) of the most recent LR — the minimal conformant reservation set (exactly the accessed word's or doubleword's bytes, RVI-A §12.1.2, the latitude the same section grants), keyed on the physical address (the aliasing latitude resolved to exact physical match). Invalidation is exactly the specification's one-hart set: any LR replaces; any SC — success or failure, any address — clears; a trap does NOT invalidate (the SC's own trap included).") (source "RVI-A §12.1.2; docs/tasks/P4-SYSTEM.md, the .4 design brief (2026-10-04), decisions 2 and 4"))
  (decision (id "D-SC-DETERMINISTIC") (authority laboratory) (statement "Store-conditional is deterministic: SC succeeds iff the reservation is valid and the physical address equals and the width equals, writing rs2's value and rd<-0; otherwise it fails with rd<-1 (the 'unspecified failure' code), writing nothing; it NEVER spuriously fails — one legal point of the architectural nondeterminism (RVI-A §12.1.2–§12.1.3 permits unconditional failure of unconstrained sequences), chosen so exact-value expectations stay derivable (EVD-05).") (source "RVI-A §12.1.2–§12.1.3; docs/tasks/P4-SYSTEM.md, the .4 design brief (2026-10-04), decision 3"))
  (decision (id "D-ATOMIC-MISALIGN") (authority laboratory) (statement "Misaligned atomic accesses take the access-fault family by kind — 5 for LR (a load exception: RVP-MACHINE's exception table maps load-reserved to load exceptions), 7 for SC/AMO (store/AMO exceptions): the specification offers misaligned-or-access-fault (RVI-A §12.1.2, §12.1.4) and the choice is reference-matched to the tracked Sail override's declared PMAs ((amo AccessFault) (lrsc AccessFault)); judged before translation (the P4-SYSTEM.3 decision-7 hand-off).") (source "RVI-A §12.1.2; RVI-A §12.1.4; RVP-MACHINE's exception table; profiles/rv64gc-lab-v0/override.sexp; docs/tasks/P4-SYSTEM.md, the .4 design brief (2026-10-04), decision 6") (note "Amended `2026-10-05` at P4-SYSTEM.4 slice (f): the Sail matched experiment measured the bind-day uniform-cause-7 form FALSE for LR — Sail 0.14 delivers the LOAD access-fault cause 5 for a misaligned LR (the exception table maps load-reserved to load exceptions: the legal set for LR is causes 4/5, never 7). The kind-matched form above is what the reference and the table both require."))
  (decision (id "D-SCOPE-CENSUS") (authority laboratory) (statement "The scope block enumerates the RV64I base census (52 forms — the same enumeration and source as rv64i-lab-v0); each extension's instruction census lands with its encoding fragment in the evidence leaves (the RV32/64G listings and the privileged listings are the census references), and the declared scope grows only with them.") (source "RVI-RV32I §1.1.4–§1.1.8; RVI-RV64I §3.1.2–§3.1.3; RVI-G-LISTING 35.1; RVP-INSNS 18.1"))
  (decision (id "D-FAULT-PRIORITY") (authority laboratory) (statement "Synchronous exceptions follow the pinned priority table (decreasing priority): the instruction-address translation faults, then the instruction access fault, then illegal-instruction, environment call and environment break, then - the table's one implementation-defined position - load/store/AMO address-misaligned, which this profile takes HIGH, judged before the explicit access's translation (the laboratory's choice at P4-SYSTEM.3 decision 7; misaligned atomics take their declared access-fault codes at the same point), then the explicit access's translation faults (the first encountered), then its physical access fault. Instruction-address-misaligned is unreachable here (IALIGN 16 with C) and no breakpoint exists (no Sdtrig). Every adjacent pair the profile can produce is pinned by a guest on both engines: the fetch fault over decode (fault-fetch), illegal-instruction over misaligned and over translation faults (prio-sv39's FS=Off cells, f-fs-off, d-fs-off), misaligned over page and access faults (it-prio-load, prio-sv39, a-amo-sv39), translation over the physical access (prio-sv39).") (source "RVP-MACHINE §2.1.1.15 (the synchronous-exception priority table); docs/tasks/P4-SYSTEM.md, the .3 brief's decision 7 and the .8 brief")))
