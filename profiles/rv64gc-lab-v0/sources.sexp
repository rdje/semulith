;; sources.sexp — the pinned specification sources for `rv64gc-lab-v0` (P4-SYSTEM.1,
;; 2026-10-02). One document form; validate with
;;   python3 scripts/check_sexp_schema.py profiles/rv64gc-lab-v0/sources.sexp schema/sources.sexp

(comment "profiles/rv64gc-lab-v0/sources.sexp — the pinned specification sources for the"
         "Linux-capable profile's resolution."
         ""
         "THE PUBLICATION is the RISC-V Ratified Specifications Library snapshot at v20260120 —"
         "the same pinned snapshot rv64i-lab-v0 cites (RVI-PINNED-V20260120), which CARRIES the"
         "privileged chapters: measured 2026-10-02, .materials/riscv/pinned-v20260120/ holds"
         "priv/ (24 pages) and unpriv/ (46 pages), every row below re-hashed against the"
         "snapshot's tracked SHA256SUMS (21/21 match). The category census's older phrasing"
         "('the privileged volume is absent from this unprivileged snapshot') is measured false"
         "and superseded. ⛔ The numbering-trap discipline is unchanged: cite THESE pages by"
         "their own section numbers, never the release PDFs' (a different publication family —"
         "see rv64i-lab-v0's sources.sexp comment and"
         "docs/knowledge/a-version-string-is-not-an-identity.md)."
         ""
         "THREE ROWS ARE NOT THE PUBLICATION — declared, not hidden: RVI-PSABI and RVI-SBI are"
         "the ratified psABI 1.0 and SBI 2.0 PDFs, and SIFIVE-FU540-C000 is the pinned SoC"
         "manual — all three acquired into the materials catalog through the chipdoc channel"
         "and cached under .materials/. For these rows `file` is the cache-relative path,"
         "http_status is 0 BY DECLARATION (no HTTP fetch was performed by this project — the"
         "sifive-uart-lab-v0 precedent), and the digests were re-verified from the cache on"
         "the retrieved date (psABI a8d06bdc…bc23d9, SBI 63084f54…b3a682b, FU540"
         "5fa68a67…3ecab79c — matching the catalog pins). Locators into the two PDFs use the"
         "PDFs' OWN section numbering (the numbering trap is an ISA-manual property; these"
         "publications exist only as these PDFs). scripts/fetch_sources.sh is URL-shaped and"
         "will report such rows UNREACHABLE — honest, and the same shape as the device"
         "dossiers' corpus-sourced rows."
         ""
         "Terms: as rv64i-lab-v0 — the artifacts are READ, not redistributed; SRC-01's"
         "actual-terms recording is owned by DOSSIER.md's open question when shipping is"
         "reached.")

(sources (publication "RISC-V Ratified Specifications Library (docs.riscv.org), pinned snapshot v20260120 — plus three catalog-cached artifacts declared in the comment above") (not_this_publication "github.com/riscv/riscv-isa-manual releases — different section numbering (the numbering trap)") (revision "v20260120") (base_url "https://docs.riscv.org/reference/isa/v20260120") (retrieved "2026-10-02") (work_dir "target/sources/rv64gc-lab-v0") (comment "repo-volume, untracked; the snapshot rows re-hash against the pinned SHA256SUMS, the three declared extra rows re-verify against the .materials cache")
  (source (id "RVI-INTRO") (file "unpriv/intro.html") (title "Introduction :: RISC-V Ratified Specifications Library") (sha256 "3d65f713115bfd58f783fcebcce3f243f508d0af71bbac79a59e5ff79e13bf0c") (bytes 69772) (http_status 200) (supplies "execution-environment interface (EEI) and hart definitions; the four trap effects; the meaning of UNSPECIFIED"))
  (source (id "RVI-RV32I") (file "unpriv/rv32.html") (title "1.1. RV32I Base Integer Instruction Set, Version 2.1") (chapter_version "2.1") (sha256 "3b20e92f067509535f95883832e84b32dbea43a29e1347b7925c374213ad75ec") (bytes 107630) (http_status 200) (supplies "the base integer ISA that RV64I modifies: register state, formats, control transfer, load/store, FENCE, ECALL/EBREAK, HINTs"))
  (source (id "RVI-RV64I") (file "unpriv/rv64.html") (title "3.1. RV64I Base Integer Instruction Set, Version 2.1") (chapter_version "2.1") (sha256 "6eadb316c2d535ccb87a7a6feb03ff54af6f4b5bbeb5c1a5102a02af81f13abd") (bytes 49246) (http_status 200) (supplies "the RV64I deltas: XLEN=64, the *W instruction family, 6-bit shift amounts, LWU/LD/SD, RV64I HINT table"))
  (source (id "RVI-NAMING") (file "unpriv/naming.html") (title "36.1. ISA Extension Naming Conventions") (sha256 "4ab3aa0dc9f5626e522eb6849708197f0f014903532a04dbe03dd8bed64abb1d") (bytes 41699) (http_status 200) (supplies "the G abbreviation's definition (IMAFDZicsr_Zifencei), the extension naming/ordering rules the ISA string follows, and the dependency-discipline context for the closure"))
  (source (id "RVI-G-LISTING") (file "unpriv/rv-32-64g.html") (title "35.1. RV32/64G Instruction Set Listings") (sha256 "5c61e7c4628282fad0d2c5e4d9b248a92fdaf067e3a2cf97e7917a89a1873549") (bytes 252364) (http_status 200) (supplies "the RV32/64G instruction set listings and the base opcode map — the reference each extension's instruction census is drawn from in the evidence leaves"))
  (source (id "RVI-M") (file "unpriv/m-st-ext.html") (title "11.1. \"M\" Extension for Integer Multiplication and Division, Version 2.0") (chapter_version "2.0") (sha256 "85e1db6c831ba6d325722d728d257b3ac9a9bf0a654ba1dc385108e99df75716") (bytes 35588) (http_status 200) (supplies "the M extension: multiply/divide semantics, the *W forms, division-by-zero and overflow conventions"))
  (source (id "RVI-A") (file "unpriv/a-st-ext.html") (title "12.1. \"A\" Extension for Atomic Instructions, Version 2.1") (chapter_version "2.1") (sha256 "afbd8def7bdf64287ef51a9cb14dd654fba0f0cfeef63bccdfd47408f5b0dff2") (bytes 56889) (http_status 200) (supplies "the A extension: LR/SC reservation semantics, the AMO operations, the aq/rl ordering annotations"))
  (source (id "RVI-F") (file "unpriv/f-st-ext.html") (title "20.1. \"F\" Extension for Single-Precision Floating-Point, Version 2.2") (chapter_version "2.2") (sha256 "8e42e6ae9b3ab18fcf9c3d4f26a1a251310e3fd08b67368235fb5e9affd32edd") (bytes 70860) (http_status 200) (supplies "the F extension: f0–f31 and the FP CSRs, single-precision arithmetic under IEEE 754-2008, and the stated dependency on Zicsr"))
  (source (id "RVI-D") (file "unpriv/d-st-ext.html") (title "21.1. \"D\" Extension for Double-Precision Floating-Point, Version 2.2") (chapter_version "2.2") (sha256 "fe3beb3c4db381063bccf03f5451d0a6184100ac37bb39b4dd1ec726a2befde4") (bytes 40001) (http_status 200) (supplies "the D extension: FLEN=64 widening, NaN boxing, double-precision arithmetic — and the stated dependency on F"))
  (source (id "RVI-C") (file "unpriv/c-st-ext.html") (title "27.1. \"C\" Extension for Compressed Instructions, Version 2.0") (chapter_version "2.0") (sha256 "3f7e7d853d6e12e9d44c3d1bb488d1c312179a308d608182fb01db43a49d6aeb") (bytes 95631) (http_status 200) (supplies "the C extension: 16-bit encodings, IALIGN=16 with C, the alignment-exception consequence"))
  (source (id "RVI-ZC") (file "unpriv/zc.html") (title "28.1. \"Zc\" Extensions for Compressed Instructions") (sha256 "3bc5a6f600995f96df57ea895f7db1f7fdba5967e7f084ae0be0e7a0d53924b6") (bytes 156112) (http_status 200) (supplies "the C decomposition: C implies Zca always, Zcf only at RV32 with F, Zcd when D is present — the closure's C leg"))
  (source (id "RVI-ZICSR") (file "unpriv/zicsr.html") (title "5.1. \"Zicsr\" Extension for Control and Status Register (CSR) Instructions, Version 2.0") (chapter_version "2.0") (sha256 "0c06e00db7343b293a120e6378a4eee7e4c101a5786a9b661513ceed7dcf047d") (bytes 44903) (http_status 200) (supplies "the six CSR instructions (csrrw/csrrs/csrrc and immediates), the read/write side-effect discipline, and the counter-CSR access rules"))
  (source (id "RVI-ZIFENCEI") (file "unpriv/zifencei.html") (title "4.1. \"Zifencei\" Extension for Instruction-Fetch Fence, Version 2.0") (chapter_version "2.0") (sha256 "4026de34713f4b898595eb4a17bb58176a0e2905196705a904d3d8fab4432a91") (bytes 32380) (http_status 200) (supplies "FENCE.I: when newly written code becomes executable — the instruction-visibility contract the rv64i profile deliberately excluded"))
  (source (id "RVI-ZICNTR") (file "unpriv/counters.html") (title "6.1. \"Zicntr\" and \"Zihpm\" Extensions for Counters, Version 2.0") (chapter_version "2.0") (sha256 "8d619d6ef71d6cd87415342782aa615a0aff121a537342e4497658947f4fa81c") (bytes 40747) (http_status 200) (supplies "the Zicntr base counters (cycle, time, instret) — the S-mode time read a Linux profile needs; Zihpm (performance counters) is named here and NOT selected"))
  (source (id "RVI-RVWMO") (file "unpriv/rvwmo.html") (title "17.1. RVWMO Memory Consistency Model, Version 2.0") (chapter_version "2.0") (sha256 "6126b0e31c33f3ff492308c14f264e9f86ae0d30dfeddaa6f834191c0ab37d91") (bytes 121633) (http_status 200) (supplies "the RVWMO memory consistency model — the memory-model claim this profile makes (the A extension's atomics make it load-bearing even at one hart)"))
  (source (id "RVP-INTRO") (file "priv/priv-intro.html") (title "Introduction :: RISC-V Ratified Specifications Library") (sha256 "12c7a31aafbc32fa1f4fab82d60786c65af35f68e648aca7575a05034edf525e") (bytes 38003) (http_status 200) (supplies "the privileged architecture's introduction: the privilege modes and their intent, the platform-level sweep"))
  (source (id "RVP-CSR") (file "priv/priv-csrs.html") (title "1.1. Control and Status Registers (CSRs)") (sha256 "330a17314ef803231955a915748176e5175fc773469f25a8c6b5ae922c9df425") (bytes 140884) (http_status 200) (supplies "the CSR address-space conventions, the listings, the WPRI/WARL/WLRL field disciplines the privilege leaf (P4-SYSTEM.2) owns"))
  (source (id "RVP-MACHINE") (file "priv/machine.html") (title "2.1. Machine-Level ISA, Version 1.13") (chapter_version "1.13") (sha256 "b63fe33517fef2dabe53cdbc45b05d656bf808eebf83f0af5a4ab74549617fea") (bytes 271851) (http_status 200) (supplies "the machine-level ISA: the M-mode CSRs, the trap model (medeleg/mideleg included), the counter machinery, the optional PMP (§2.1.7), mret/wfi"))
  (source (id "RVP-SUPERVISOR") (file "priv/supervisor.html") (title "11.1. Supervisor-Level ISA, Version 1.13") (chapter_version "1.13") (sha256 "d5186efc3ead1c1f693ac2b16aeccdcab95d990264f49b559252d2dc413a651a") (bytes 186455) (http_status 200) (supplies "the supervisor-level ISA: the S-mode CSRs, satp, and the three paged schemes at SXLEN=64 (Sv39 §11.1.4, Sv48 §11.1.5, Sv57 §11.1.6)"))
  (source (id "RVP-INSNS") (file "priv/priv-insns.html") (title "18.1. RISC-V Privileged Instruction Set Listings") (sha256 "54d95bd687e83395d2c2fa35c2fb9a9f9465a3859e1cf3db3c2e4090bfea6f9a") (bytes 25987) (http_status 200) (supplies "the privileged instruction listings — the reference the privileged-instruction census is drawn from in the evidence leaves"))
  (source (id "RVP-SSTC") (file "priv/sstc.html") (title "12.1. \"Sstc\" Extension for Supervisor-mode Timer Interrupts, Version 1.0") (chapter_version "1.0") (sha256 "30bea862eee800d485ce34636b2824bf9909a4676b39d2c5734e92fba14216e1") (bytes 27429) (http_status 200) (supplies "Sstc: the stimecmp CSR and the menvcfg.STCE gate — the S-mode timer without an M-mode round trip"))
  (source (id "RVI-PSABI") (file "riscv/riscv-elf-psabi-1.0.pdf") (title "RISC-V ELF psABI Document, Version 1.0 (ratified) — catalog RVI-PSABI-1.0; cache-cached, see the header comment") (sha256 "a8d06bdcaa82a6a4567a1904dc27ef1ca1043ebaa1f523558c927a9d72bc23d9") (bytes 273939) (http_status 0) (supplies "the toolchain-output contract: the calling convention, and the LP64D statement — the standard RV64G ABI requires D (hardware floating-point calling convention, ABI_FLEN=64)"))
  (source (id "RVI-SBI") (file "riscv/riscv-sbi-2.0.pdf") (title "RISC-V Supervisor Binary Interface Specification, Version 2.0 (ratified) — catalog RISCV-SBI-2.0; cache-cached, see the header comment") (sha256 "63084f54f382715efb340f46695d0e5cebd98965292d034d1b184b1abd3a682b") (bytes 485497) (http_status 0) (supplies "the M-mode firmware contract for the P6 boot route: the base extension plus TIME, sPI, RFENCE, HSM, SRST, DBCN — the services a Linux boot needs"))
  (source (id "SIFIVE-FU540-C000") (file "sifive/fu540/current/FU540-C000_v1p5_manual.pdf") (title "SiFive FU540-C000 Manual, v1p5 — the pinned SoC manual (catalog SIFIVE-FU540-C000); cache-cached, see the header comment") (sha256 "5fa68a677ca4bc9fc81456840834eb4fa72874a2bd72a76c33f6709f3ecab79c") (bytes 2361460) (http_status 0) (supplies "the implemented-precedent leg for the Sv39 selection: the U54's MMU supports Bare and Sv39 (§4.7) and raises page faults rather than setting PTE A/D bits — the A/D-policy data point P4-SYSTEM.3 inherits"))
)
