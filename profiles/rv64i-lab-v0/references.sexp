;; references.sexp — reference candidate dossier, converted from references.toml by
;; scripts/convert_dossier.py (SOT-FORMAT.4). One document form; validate with
;;   python3 scripts/check_sexp_schema.py references.sexp schema/references.sexp
;; Round-trip: `python3 scripts/convert_dossier.py verify references.toml references.sexp` — data-equal, comment census exact.

(comment "profiles/rv64i-lab-v0/references.toml — the reference candidate dossier for `rv64i-lab-v0`." "" "⛔ EVERY FIELD HERE IS AN OBSERVED FACT. Rule `SRC-03` forbids recording availability that has" "not been established, and this file is where that rule bites hardest: a candidate list is the" "easiest document in a project to fill in from reputation. Each `obtained` row below was run on" "this host; each `not_obtained` row records the attempt and what stopped it." "" "⚠️ WHAT THIS FILE DOES NOT CLAIM. Nothing here says a reference is USABLE. `P0-PROFILE.6` is" "the leaf that runs a matched-profile experiment and reproduces it, and `docs/EVIDENCE_AND_GATES.md`" "§5 makes that the gate: a reference is not usable until a real experiment has passed against it." "These rows say \"we have it, we can configure it, and this is exactly which it is\"." "" "⚠️ AND NOTHING HERE IS AN INDEPENDENCE CLAIM. Three obtained models is not three opinions —" "`EVD-04` requires shared semantic ancestry to be examined rather than inferred from the fact" "that the binaries differ. `P0-PROFILE.7` owns that, and the `lineage` field below is its input," "not its answer." "" "Re-derive with `scripts/fetch_references.sh [--verify-only]`. It needs the network and a" "compiler, so it is deliberately NOT a commit gate — the same reasoning as `fetch_sources.sh`.")
(references (profile "rv64i-lab-v0") (retrieved "2026-09-14") (work_dir "target/refs") (comment "The host matters and is therefore recorded: two of the three candidates below were obtained in" "a form that is specific to it (a prebuilt Mac-arm64 binary; a source build against the system" "toolchain). On another host the same commands can produce a different answer, and `SRC-03`" "makes that a fact to re-establish rather than inherit.") (host (os "macOS 26.6.2 (build 25G83)") (kernel "Darwin 25.6.0") (arch "arm64") (cxx "Apple clang (/usr/bin/clang)") (note "The repository volume is /dev/disk7s1; the shared toolchain prefix /opt/homebrew is on /dev/disk3s1s1. They are DIFFERENT volumes, which is why every artifact this project owns is built or unpacked under `target/refs/` and nothing is installed into the shared prefix (policy: project data locality).")) (comment "───────────────────────────────────────────────────────────── candidate 1: Sail RISC-V") (candidate (id "sail-riscv") (role "primary oracle candidate") (status "obtained") (kind "prebuilt release binary") (origin "https://github.com/riscv/sail-riscv") (release "0.14") (released "2026-09-05") (asset "sail-riscv-Mac-arm64.tar.gz") (asset_sha256 "340ab7080871b191b0e719b5ed5be34f4725704dfe52a5aeb50ea36be277464e") (binary "target/refs/sail-riscv-Mac-arm64/bin/sail_riscv_sim") (binary_sha256 "16de42a86e4ea7a300385092632cd95d153cb3f6c119d31eaa9384953990b7bf") (build_info "Sail RISC-V release 0.14; git 29e6158; Sail 0.20.2 (opam-v2.5.1); AppleClang 21.0.0.21000101; CLI11 2.6.2; ELFIO 3.12; JSONCONS 1.8.1; ASIO 103600") (invocation "sail_riscv_sim --config-override <override.json> [--trace...] <elf>") (trace_granularity "per instruction, and per effect within it: --trace-instr, --trace-gpr, --trace-csr, --trace-mem, --trace-exception, --trace-interrupt, --trace-pma, --trace-pmp, --trace-step; --trace enables all but TLB/PTW/gdbserver. Output to --trace-output <file>.") (injection "--gdb-server-port <n> (GDB remote: register and memory write, single step) and --rvfi-dii <port> (RVFI Direct Instruction Injection). --inst-limit bounds a run.") (matched_config "reference/sail-rv64i-lab-v0.override.json") (matched_isa_string "rv64i_zvl32b") (matched_isa_string_source "observed — `sail_riscv_sim --config-override <cfg> --print-isa-string`") (matched_scope "⛔ THE ISA STRING ESTABLISHES THE INSTRUCTION SET AND NOTHING ELSE. It does not establish the platform, the memory map, the devices, the memory attributes or the semantics. Reading it as a whole-configuration verdict is precisely the defect P0-PROFILE.10 corrected. The platform is matched separately, by configuration, and compared against the model's own device tree with `scripts/compare_platforms.py`.") (terms "BSD-2-Clause (the sail-riscv model). Read and executed locally; no copy is committed and nothing is redistributed.") (lineage "The Sail RISC-V model is the RISC-V International reference formal model, written in the Sail ISA description language. Any tool that DERIVES expected results from it — notably ACT's reference signatures — shares an ancestor with it. Input to P0-PROFILE.7; not resolved here.") (asset_bytes 2038243) (http_status 200)) (comment "───────────────────────────────────────────────────────────── candidate 2: Spike") (candidate (id "spike") (role "second implementation") (status "obtained") (kind "source build") (origin "https://github.com/riscv-software-src/riscv-isa-sim") (binary "target/refs/spike-build/spike") (binary_sha256 "8fdf43ac80ccafb96ab076c91967adf6df119b05c5b926ed49a033efe57836a3") (invocation "spike --isa=rv64i --priv=m --log-commits --instructions=<n> <elf>") (trace_granularity "commit level: --log-commits prints the committed instruction with its register and memory writes; -l/--log gives an execution log; spike-dasm decodes it.") (injection "built-in interactive debug mode (-d) with register/memory read-write and single step; OpenOCD/GDB via --rbb-port.") (matched_config "command line only: --isa=rv64i --priv=m") (matched_isa_string "rv64i") (matched_isa_string_source "observed — `spike --isa=rv64i --priv=m --dump-dts <elf>` reports `riscv,isa = \"rv64i\"`. ⛔ CORRECTED at MODEL-METHOD.1: this value was previously the command-line INPUT recorded in an observation's slot, never read back. Spike has no --print-isa option, so nobody had confirmed it configured what it was told. The device tree is the read-back, and the control is that it tracks the input: `--isa=rv64im` reports `rv64im`.") (matched_scope "As above — the instruction set only. Spike's platform is NOT matched and cannot be: its device tree advertises clint@2000000, plic@c000000 and ns16550@10000000, an Sv57 MMU and 16 PMP regions. See DIFF-PLATFORM-SPIKE.") (terms "BSD-3-Clause (Regents of the University of California). Built and executed locally; no copy is committed.") (lineage "An independently written C++ interpreter, historically the RISC-V golden model and older than the Sail model. Independence from Sail is PLAUSIBLE and NOT established — P0-PROFILE.7 owns examining it per subsystem rather than inferring it.") (version "Spike RISC-V ISA Simulator 1.1.1-dev") (source_commit "1e05ddac3a6c351bfc0aeed0cf3a68940e7200ab") (source_authored "2026-09-11") (release_assets "none — the latest tagged release (v1.1.0, 2021-12-17) publishes no binaries, so a source build is the only route") (build_prefix "target/refs/spike-prefix") (build_note "configure + make -j8 against the system toolchain; `dtc` 1.8.1 was ALREADY present and is used read-only. Boost is documented as a prerequisite in configure.ac but configure succeeded (rc=0) without it, so nothing was installed into the shared prefix.")) (comment "───────────────────────────────────────────────────────────── candidate 3: QEMU") (candidate (id "qemu") (role "third implementation, discovered during this leaf") (status "obtained") (kind "pre-existing host toolchain, used read-only") (origin "https://www.qemu.org") (binary "/opt/homebrew/bin/qemu-system-riscv64") (binary_sha256 "03725d89f81f327c7e95dd6129dc7e9a6440d49d7158ade0d558efa9d6bd56f3") (invocation "qemu-system-riscv64 -machine virt -cpu rv64i -bios none -nographic -d in_asm,cpu,int -D <log> -kernel <elf>") (trace_granularity "translation-block level by default; per-instruction with one-insn-per-tb. -d cpu dumps the register file before each block, -d in_asm the target assembly, -d int exceptions.") (injection "GDB remote via -s/-S (register and memory write, single step).") (matched_config "command line only: -cpu rv64i") (matched_isa_string "not printed by QEMU; the CPU model is named rv64i and the ISA is not emitted as a string") (matched_isa_string_source "NOT OBSERVED. QEMU emits no ISA string, so nothing has been read back from it at all.") (matched_scope "Nothing is established. QEMU has never been configured, run or compared in this project — it is `obtained` and un-exercised, and this field exists so that its emptiness is visible rather than inferred from an absent row.") (terms "GPL-2.0-only. Installed on this host before this project existed; used read-only as a toolchain dependency and never modified, copied or redistributed.") (lineage "A dynamic binary translator whose RISC-V target was written independently of both Sail and Spike. The most promising of the three for EVD-04, and still an input to P0-PROFILE.7 rather than a conclusion.") (version "QEMU emulator version 11.1.1") (cross_volume "YES — this binary lives on /dev/disk3s1s1, not the repository volume. It is a pre-existing operating-system-level toolchain, read-only, never written to, and nothing this project owns is stored beside it. Recorded here because the data-locality policy requires every cross-volume dependency to be explicitly identified rather than silently used.")) (comment "───────────────────────────────────────────────────────────── candidate 4: ACT") (candidate (id "act4") (role "external test suite, not a model") (status "reachable, not acquired") (kind "test corpus") (origin "https://github.com/riscv/riscv-arch-test") (lineage "ACT computes expected results using a CONFIGURED SAIL MODEL. It therefore shares an ancestor with candidate 1 by construction, and agreement between ACT and sail-riscv is NOT two opinions. This is the single most important lineage fact in this file and it is recorded before any evidence rests on it.") (default_branch "act4") (tag_shape "ctp-release-<short-sha>-<date>, e.g. ctp-release-dcffc6b-2026-01-01") (status_reason "Deliberately NOT acquired by this leaf. ACT is a test corpus, not a reference model; it belongs to the evidence campaign, and acquiring it before a model can run a single instruction would be inventory rather than progress. Owner: P0-PROFILE.9 (the evidence-obligation policy) and P2-SCALAR.") (license "Apache-2.0") (redirect_note "the locator in docs/SOURCES_AND_NAMING.md is riscv-non-isa/riscv-arch-test, which now 301-redirects to riscv/riscv-arch-test — recorded because a redirect that is followed silently is a locator that has quietly changed") (last_pushed "2026-09-13") (http_status 200) (tags_listed 30)) (comment "───────────────────────────────────────────────────────── attempts that did NOT work out" "`SRC-02` makes an honest \"no route\" a legitimate result that bounds a claim. These are the" "routes that were tried and rejected, recorded so the next reader does not retry them blind.") (attempt (what "install the Sail toolchain from the host package manager") (command "brew info --formula sail") (outcome "WRONG PROJECT — a name collision. `brew`'s `sail` 0.10.9 is \"CLI toolkit to provision and deploy WordPress applications to DigitalOcean\" (https://sailed.io, GPL-3.0-only). It is not the Sail ISA specification language.") (consequence "Recording \"sail is available via brew\" would have been false in exactly the way SRC-03 exists to prevent: the name matched, the formula existed, and it was the wrong software. Identity was checked, not assumed.")) (attempt (what "build Sail from source with a repository-local OPAMROOT, the default the task-tree proposed") (outcome "NOT NEEDED — superseded by an observed fact. Release 0.14 publishes `sail-riscv-Mac-arm64.tar.gz`, a prebuilt native binary for this host's exact architecture. The OCaml/opam toolchain the tree budgeted for is not required to RUN the model.") (consequence "The tree's \"Director input wanted\" section priced this leaf on an OCaml build that no longer has to happen. Building from source remains the route if the model must be MODIFIED, and it is unattempted, so no claim is made about its tractability here.")) (attempt (what "dump the effective (merged) configuration the Sail model actually ran with") (command "sail_riscv_sim --config-override <override> --print-default-config") (outcome "NOT SUPPORTED — the dump ignores the override. Byte-compared against the plain default: identical.") (consequence "⛔ A real limitation with evidential weight. `docs/EVIDENCE_AND_GATES.md` §5 requires the EFFECTIVE configuration to be recorded exactly, and this model will not emit it. So the effective configuration is recorded as (release 0.14 default) + (the tracked override), and the merge is OURS, not the model's. The cross-check the model DOES emit is `--print-isa-string`, which is why that string is pinned above. Owner of closing the gap: P0-PROFILE.6, which must not treat our merge as the model's own report.")) (comment "───────────────────────────────────────────── the matched-profile experiments (P0-PROFILE.6)" "⛔ A REFERENCE IS NOT USABLE UNTIL ONE OF THESE PASSES (`docs/EVIDENCE_AND_GATES.md` §5). These" "records are what changed `sail-riscv` and `spike` from \"obtained\" to \"exercised\"." "" "⚠️ AND A PASS IS NOT A PROOF. It means: for THESE inputs, two models agreed with each other and" "with values derived from the specification, and the run reproduced. Finite differential testing" "is tested evidence, never universal trace inclusion — and two models sharing semantic ancestry" "can agree while both being wrong (`EVD-04`, owned by `P0-PROFILE.7`)." "" "Re-run every row with `scripts/run_smoke.py`.") (experiment (id "smoke-arith") (program "guests/smoke-arith.s") (instructions 12) (models "sail-riscv") (models "spike") (sail_invocation "sail_riscv_sim --config-override reference/sail-rv64i-lab-v0.override.json --inst-limit 12 --trace-instr --trace-gpr --trace-exception --trace-output <file> <elf>") (spike_invocation "spike --isa=rv64i --priv=m -l --log-commits --log=<file> --instructions=17 <elf>") (elf_sha256 "59b0029bcf33fa36") (verdict "AGREE over 12 aligned step(s)") (expectations "12 of 12 specification-derived expected values matched, each with its source locator in guests/smoke-arith.expected.toml") (reproduced "yes — a second run produced a byte-identical trace, sha256 29d34aaa8218111b…") (exercises "D-LUI-AUIPC, D-WSUFFIX, D-SHAMT (both the 6-bit and the 5-bit form), x0 hardwired zero, 64-bit wrapping addition") (control "falsifying one expected value (srai's all-ones result changed to 1) failed the run: 'step 5 (srai x6, x4, 63): expected {x6: 1}, observed {x6: 18446744073709551615}'")) (experiment (id "smoke-trap") (program "guests/smoke-trap.s") (instructions 3) (models "sail-riscv") (models "spike") (sail_invocation "as above, --inst-limit 3") (spike_invocation "as above, --instructions=8") (elf_sha256 "05551a3a22afcbbc") (verdict "AGREE over 3 aligned step(s), including the trap: cause 0x04 (misaligned load), tval 0x0000000080000401, on both models") (expectations "no separate expectations file; the expected observation IS the trap, and D-MISALIGN-DATA states it") (reproduced "yes — byte-identical second run, sha256 32f5f132fc965719…") (exercises "D-MISALIGN-DATA — a misaligned 4-byte load raising address-misaligned rather than being handled invisibly") (control "⭐ the decisive one. Flipping the Sail configuration's misaligned policy back to 'handled invisibly' — changing NOTHING else, same ELF — produced a real divergence: 'FIRST DIVERGENCE at aligned step 2 … sail-riscv writes=[(x1, 0)] … spike writes=[]'. The two models agree BECAUSE the profile is matched, which is what makes 'matched profile' a checked claim rather than a hopeful one.")) (comment "─────────────────────────────────────── differences observed while running, not assumed absent") (difference (id "DIFF-ELF-STRICTNESS") (kind "harness") (observed "Spike refuses an ELF with no section header table — `Assertion failed: (from_le(eh->e_shstrndx) < from_le(eh->e_shnum)), elfloader.cc:116` — while the Sail model loads and runs it.") (resolution "The guest writer emits a conformant section header table. An input only one comparator accepts is not a matched experiment, so the artifact was fixed rather than the invocation.")) (difference (id "DIFF-RESET-VECTOR") (kind "harness") (observed "Spike executes a 5-instruction built-in reset vector at 0x1000 before transferring to the ELF entry; the Sail model begins at the entry point directly.") (resolution "Both traces are aligned on the first step whose pc equals the declared entry. Comparing step 0 with step 0 would report a divergence that is purely a harness difference.")) (difference (id "DIFF-TRAP-RECORD-SHAPE") (kind "trace vocabulary") (observed "Spike emits NO commit record for a trapping instruction — it prints the disassembly line and the exception, and nothing commits. The Sail model records the trapping instruction as a step carrying the trap.") (resolution "The adapter reassembles Spike's split record into the one step both models describe, using Spike's own disassembly line for the pc and encoding. ⛔ Before this was handled, the comparator reported `AGREE over 2 aligned step(s)` for a run in which one model trapped and the other stopped — a green verdict on a truncated trace. A shorter trace is now a non-agreeing verdict that must be explained.")) (difference (id "DIFF-FETCH-GRANULARITY") (kind "observable") (observed "The Sail model performs TWO 16-bit fetch reads per 32-bit instruction (`mem[X,0x…0] -> 0x0513`, `mem[X,0x…2] -> 0x0010`), even with IALIGN=32 and no compressed extension.") (resolution "Recorded, not normalized. `D-FETCH-IMPLICIT` says every executed instruction entails an implicit fetch read; it does not say how many. This is below the granularity this profile observes, but a future memory-access comparison would see it, so it is written down before it surprises someone.")) (difference (id "DIFF-PLATFORM-DEFAULT") (kind "configuration — CORRECTED, not merely recorded") (observed "⛔ The matched-profile override configured the INSTRUCTION SET and nothing else. `--print-isa-string` read `rv64i_zvl32b`, which was taken as \"matched\" — but it answers a narrower question than that. Underneath the correct ISA the reference kept its default platform: a core-local interruptor at 0x0200_0000, a simple interrupt generator at 0x0C00_0000, machine software/timer/external interrupts all `supported: true`, and TWO IOMemory regions (0x1000 and 0x0200_0000..0x11ff_ffff). Measured by probe: a guest read CLINT `mtime` at 0x0200_BFF8 with a plain `ld` — no CSR instruction needed — and the value ADVANCED across reads (2, then 3).") (resolution "CORRECTED at P0-PROFILE.10, not enumerated away. The override now sets `platform.clint.supported = false`, the interrupt generator off, all three machine interrupt sources off, and `memory.regions` to the single MainMemory region the profile declares. Both probes now raise `load-access-fault` (tval 0x0200_0000 and 0x0200_BFF8), and all three original guests still agree over 28 aligned steps. The repair is held by a tracked negative fixture, `guests/guest-no-device.s`, which fails the run if a device becomes reachable again. ⭐ The lesson is the instrument: an ISA string describes an instruction set, and reading it as a whole-configuration verdict is what let this survive four leaves.")) (difference (id "DIFF-PLATFORM-SPIKE") (kind "layer — the reference bundles a BOARD with its CPU") (observed "Spike is NOT platform-matched and cannot be, from its command line. It services the same load from 0x0200_0000 (`x1 0x0 … mem 0x0000000002000000`): its core-local interruptor is built into the simulator, and `spike --help` offers no option to remove it — `--device` only ADDS MMIO plugins. Restricting the map with `-m0x80000000:0x10000` does not help either: Spike's own reset vector lives at 0x1000 and the run then dies with `trap_instruction_access_fault, epc 0x0000000000001000`.") (resolution "⭐ The right framing is a LAYER one, not a configuration one: Spike ships a CPU *and a small board* — an interruptor, a platform interrupt controller and a UART — and does not separate them. A processor model owns neither, so what is being measured here is how much board each reference drags in. Enumerated rather than fixed, which `SRC-02` makes a legitimate result that BOUNDS a claim. The consequence is stated precisely: any guest touching 0x1000 or 0x0200_0000..0x11ff_ffff will behave differently on the two references. The three original guests touch neither, which is why they agree — and that is now a STATED PRECONDITION rather than luck. `guest-no-device` disables its cross-model comparison for this reason, and the skip is printed on every run rather than silently applied.")) (difference (id "DIFF-FENCEI-EXECUTED") (kind "extension presence — the ISA string is not the whole answer, again") (observed "Measured by probe (P2-SCALAR.3, 2026-09-29): the word 0x0000100F (fence.i) EXECUTES as a no-op on both references, although the matched configurations exclude Zifencei — sail-riscv 0.14 with `Zifencei supported: false` in the tracked override (its own --print-isa-string reads rv64i_zvl32b) still runs it, and spike --isa=rv64i runs it too. The semulith model reports the same word as a reserved encoding — the profile declares Zifencei absent — and the laboratory's D-RESERVED-DECODE policy converts that to illegal-instruction.") (resolution "Recorded, not reconciled: a legitimate UNSPECIFIED divergence (SEM-07) — the reserved-instruction note leaves the behavior to the platform, the references chose to keep fence.i (it was base ISA in 2.0, moved to Zifencei in 2.1), and this profile chose the laboratory policy. Routed to P2-SCALAR.4 at P2-SCALAR.3 (the comparator then could not express an EXPECTED divergence). LANDED at P2-SCALAR.4: `guests/it-fencei.s` declares `(expect_divergence (difference \"DIFF-FENCEI-EXECUTED\") (at_step 1))`; the smoke run checks the prefix agrees, the first divergence against each reference lands at exactly the fence.i step with semulith carrying the policy trap, and sail vs spike agree over their full length. The deeper lesson is DIFF-PLATFORM-DEFAULT's, repeated: the ISA string and even the extension flags do not fully describe what a reference executes.")) (difference (id "DIFF-TVAL-PHYS-MASK") (kind "observable — a physical-address width, measured") (observed "Measured by probe (P2-SCALAR.4 design, 2026-09-29): sail-riscv 0.14 MASKS the access-fault tval to its 56-bit physical-address width — an `sd` at 0xFFFF_FFFF_FFFF_FFF8 reports tval 0x00FF_FFFF_FFFF_FFF8 on sail, the full address on spike AND semulith; at exactly 2^56 sail reports tval 0, spike the full 0x0100_0000_0000_0000; at 2^55 both report it intact. A reference-vs-reference difference, not a model defect.") (resolution "Recorded, not reconciled. Consequence: three-way tval comparisons keep fault addresses BELOW 2^56 — the `it-fault-wrap-sd` guest wraps its store address to 0 (tval 0, exact on all three) rather than probing the top of the space. Owner of reopening: whichever profile declares addresses >= 2^56 meaningful.")) (comment "──────────────────────────────────────────── the independence inventory (P0-PROFILE.7, EVD-04)" "⛔ TWO TOOLS WITH DIFFERENT NAMES ARE NOT TWO OPINIONS. `EVD-04` requires shared semantic code" "or shared expected-result derivation to be EXAMINED per subsystem, and both known common" "ancestry and UNKNOWN ancestry to be recorded — neither independence nor correlation assumed." "" "⚠️ Read `verdict` as a statement about the EVIDENCE, not about the world. `not-shared` means a" "measurement looked and found no sharing; `not-examined` means nobody looked yet, and it is" "recorded rather than omitted precisely because an omission reads like independence.") (independence (subsystem "instruction encoding") (pair "sail-riscv") (pair "spike") (verdict "not-shared") (evidence "Spike's `riscv/encoding.h` declares itself auto-generated from riscv-opcodes (commit c1d9bdf) in its own header comment. The Sail model hand-writes its encodings: 59 files under `model/` define `mapping clause encdec`, and `riscv-opcodes` occurs ZERO times anywhere under `model/` (it appears in exactly one file in the whole repository, `test/first_party/src/common/encoding.h`, which is test scaffolding and not the model).") (consequence "⭐ This cuts in a direction worth stating: OUR assembler derives its encodings from riscv-opcodes, so it shares an ancestor with SPIKE and not with SAIL. Sail decoding our bytes as intended is therefore a genuinely independent confirmation of the encoding; Spike doing so is not.")) (independence (subsystem "floating point") (pair "sail-riscv") (pair "spike") (verdict "shared") (evidence "Both vendor Berkeley SoftFloat. Sail: `dependencies/softfloat/berkeley-softfloat-3/`, Release 3e (2018-01-20), 326 source files. Spike: `softfloat/`, Release 3d, 263 source files, 495 softfloat-shaped symbols in the built binary. Census over the overlap: 199 `.c` files exist in BOTH copies, and once the release-number comment line is normalized, 184 of the 199 are BYTE-IDENTICAL. The 15 that differ are the genuine 3d-to-3e changes, mostly rounding and bf16 conversion.") (consequence "⛔ THE SINGLE MOST IMPORTANT ROW IN THIS FILE. For 184 shared files the two models do not merely share an ancestor — they run the same source. A differential floating-point test between them would, for those operations, be testing ONE implementation twice and reporting agreement. This profile has no floating point, so nothing here is affected today; P4 has floating point, and its evidence plan must not count Sail-versus-Spike as independent numeric confirmation. Routed to P4-SYSTEM.")) (independence (subsystem "integer semantics") (pair "sail-riscv") (pair "spike") (verdict "no-evidence-of-sharing") (evidence "`grep -ril sail` over Spike's C++, headers and makefiles returns zero files. The Sail model mentions `spike` in 10 files, and the mentions under `model/` are device-tree `compatible` strings (`ucbbar,spike-bare-dev`) — platform naming for OS compatibility, not semantics.") (consequence "⚠️ Deliberately NOT recorded as `not-shared`. Absence of a textual reference is weak evidence: it rules out one implementation importing the other, and says nothing about two authors having read the same third source, which for an ISA model is the normal case. This is the strongest claim the available evidence supports, and the smoke test's 15 agreeing steps rest on it.")) (independence (subsystem "expected-result derivation") (pair "act4") (pair "sail-riscv") (verdict "shared") (evidence "ACT computes its expected results using a CONFIGURED SAIL MODEL. Recorded as a known fact from the project's supplied design inputs (`ROADMAP.md` §1, `docs/EVIDENCE_AND_GATES.md`) rather than re-measured here, because ACT was deliberately not acquired at P0-PROFILE.5.") (consequence "ACT agreeing with sail-riscv is one semantics answering twice. ACT remains valuable as EXTERNAL TESTS — a corpus someone else chose, which is a different kind of value from a second opinion — but it can never serve as independent confirmation of the Sail model.")) (independence (subsystem "all") (pair "qemu") (pair "sail-riscv") (verdict "not-examined") (evidence "none. QEMU was obtained as a pre-existing host binary at P0-PROFILE.5 and its source has not been read. No measurement has been made.") (consequence "Recorded as unexamined rather than omitted, because an omitted pair reads exactly like an independent one. QEMU is not used as a comparator in any evidence this project currently holds, so nothing rests on it. Owner: whichever leaf first proposes QEMU as a comparator — it must do this examination before the agreement is counted.")) (independence (subsystem "all") (pair "qemu") (pair "spike") (verdict "not-examined") (evidence "none, for the same reason as the row above.") (consequence "Same disposition. Two unexamined pairs are listed separately rather than as one 'QEMU unexamined' row, because independence is a property of a PAIR and a subsystem, not of a tool.")) (comment "─────────────────────────────────────── the ENCODING source (P0-PROFILE.6 and .8)" "⛔ THE PINNED SPECIFICATION DOES NOT CONTAIN INSTRUCTION ENCODINGS. Measured over all six pinned" "artifacts: `grep -cE '[01]{7}'` -> 0 for every one, because the format diagrams are IMAGES (31" "in the RV32I chapter alone). The SEMANTICS are all present in prose — which is the half that" "matters for expected values — but the bit layouts had to come from somewhere else, and that" "somewhere is recorded here as its own provenance rather than blurred into \"the specification\"." "" "⚠️ SHARED ANCESTRY, stated: this source is upstream of SPIKE (whose `encoding.h` declares itself" "generated from it at commit c1d9bdf) and NOT of SAIL (which hand-writes 59 files of `encdec`" "mappings and never mentions it under `model/`). So Sail decoding our bytes as intended is an" "independent confirmation of the encoding; Spike doing so is not. See the `[[independence]]`" "record for the encoding subsystem." "" "⭐ Unplanned corroboration: `rv_i` + `rv64_i` enumerate exactly 52 instructions for this" "profile's extension set, and `P0-PROFILE.1` enumerated exactly 52 by hand from the prose without" "using them. Symmetric difference: NONE.") (encoding_source (id "RISCV-OPCODES") (origin "https://github.com/riscv/riscv-opcodes") (license "BSD-3-Clause (RISC-V International, 2022)") (retrieved "2026-09-14") (work_dir "target/refs/riscv-opcodes") (supplies "instruction fixed bits and operand lists for the RV64I base (rv_i, rv64_i) and the M extension (rv_m, rv64_m); operand field positions (arg_lut.csv); and the B/J scrambled-immediate layouts (constants.py). The M files are pinned because MODEL-COMPOSE.1 composed them against the base and MODEL-COMPOSE.2 made the result a tracked fragment — a fragment composed from an unpinned source would be a model built on something nobody can re-derive.") (note "constants.py was acquired at P0-PROFILE.8 specifically for the B and J immediate layouts, which spread an immediate across non-adjacent bits. scripts/riscv_asm.py PARSES those descriptors and refuses any whose accounted bits do not total the field width (7, 5, 20, 20) — a layout it cannot reconcile is one it will not use.") (file (name "rv_i") (sha256 "146e297ddbe346f325d993aaf56d7006f1bfde39df584b888b221543def17b97") (bytes 4415)) (file (name "rv64_i") (sha256 "262cbd0884fe1383fcb7c42070cbc73e309d0452ff8d00b38452a4dee7cfa7f5") (bytes 947)) (file (name "arg_lut.csv") (sha256 "cdc61339ffe379c0cd24ad2dc20e57deda95e1da663f94fccb5969d191a8e136") (bytes 1971)) (file (name "rv_m") (sha256 "1a53ea03820b7044de4f0f04d207c1e4fc0ced46deb2c6ed4a3ca268fa37ddbe") (bytes 432)) (file (name "rv64_m") (sha256 "112bf223a31b7cc51761ce1572a8a35c2502ab2c5a6e318db80c0601b587480e") (bytes 297)) (file (name "constants.py") (sha256 "101c5b8a4169a47f80ff6175a19339cf332eb09f3b09489df6ccabd40afe629b") (bytes 8950))))
