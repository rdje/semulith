;; contract-obligations.sexp — the CPU/environment contract obligation catalogue, converted from contract-obligations.jsonl by
;; scripts/convert_records.py (SOT-FORMAT.3). One record per form; validate with
;;   python3 scripts/check_sexp_schema.py contract-obligations.sexp schema/contract-obligations.sexp
;; Round-trip losslessness: `convert_records.py --verify contract-obligations.jsonl contract-obligations.sexp`.

(obligation (id "OB-XLEN") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "XLEN = 64. The integer registers and the supported user address space are 64 bits.") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.1")) (parameters (param (name requirement_id) (value (str "REQ-D-XLEN"))) (param (name decision_id) (value (str "D-XLEN"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-XLEN") (required_checks "CHK-XLEN-POS") (required_checks "CHK-XLEN-NEG"))
(obligation (id "OB-WSUFFIX") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "The *W instructions ignore the upper 32 bits of their inputs, produce a 32-bit signed result, and sign-extend it to 64 bits — bits XLEN-1 through 31 are equal. Overflow is ignored.") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.2, §3.1.2.1, §3.1.2.2")) (parameters (param (name requirement_id) (value (str "REQ-D-WSUFFIX"))) (param (name decision_id) (value (str "D-WSUFFIX"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-WSUFFIX") (required_checks "CHK-WSUFFIX-POS") (required_checks "CHK-WSUFFIX-NEG"))
(obligation (id "OB-SHAMT") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "SLLI/SRLI/SRAI take a 6-bit shift amount from the I-immediate; SLL/SRL/SRA use only the low 6 bits of rs2. SLLIW/SRLIW/SRAIW take 5 bits, and SLLW/SRLW/SRAW use rs2[4:0].") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.2.1, §3.1.2.2")) (parameters (param (name requirement_id) (value (str "REQ-D-SHAMT"))) (param (name decision_id) (value (str "D-SHAMT"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-SHAMT") (required_checks "CHK-SHAMT-POS") (required_checks "CHK-SHAMT-NEG"))
(obligation (id "OB-SHIFTW-RESERVED") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "SLLIW, SRLIW and SRAIW encodings with imm[5] != 0 are RESERVED. They were previously defined to raise an illegal-instruction exception; this revision marks them reserved instead, and calls the change backwards-compatible.") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.2.1")) (parameters (param (name requirement_id) (value (str "REQ-D-SHIFTW-RESERVED"))) (param (name decision_id) (value (str "D-SHIFTW-RESERVED"))) (param (name source_semantics) (value (str "reserved")))) (dependencies "REQ-D-SHIFTW-RESERVED") (required_checks "CHK-SHIFTW-RESERVED-POS") (required_checks "CHK-SHIFTW-RESERVED-NEG"))
(obligation (id "OB-LUI-AUIPC") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "LUI places the 32-bit U-immediate in rd with the low 12 bits zeroed, sign-extended to 64 bits. AUIPC forms the same 32-bit offset, sign-extends it to 64 bits, and adds it to the address of the AUIPC instruction.") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.2.1")) (parameters (param (name requirement_id) (value (str "REQ-D-LUI-AUIPC"))) (param (name decision_id) (value (str "D-LUI-AUIPC"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-LUI-AUIPC") (required_checks "CHK-LUI-AUIPC-POS") (required_checks "CHK-LUI-AUIPC-NEG"))
(obligation (id "OB-LOAD-EXT") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "LW sign-extends its 32-bit result to 64 bits; LWU zero-extends it. LH/LB sign-extend and LHU/LBU zero-extend analogously. SD/SW/SH/SB store the low 64/32/16/8 bits of rs2.") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.3")) (parameters (param (name requirement_id) (value (str "REQ-D-LOAD-EXT"))) (param (name decision_id) (value (str "D-LOAD-EXT"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-LOAD-EXT") (required_checks "CHK-LOAD-EXT-POS") (required_checks "CHK-LOAD-EXT-NEG"))
(obligation (id "OB-LOAD-X0") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "A load with rd = x0 must still raise any exceptions and cause any other side effects, even though the loaded value is discarded.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (parameters (param (name requirement_id) (value (str "REQ-D-LOAD-X0"))) (param (name decision_id) (value (str "D-LOAD-X0"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-LOAD-X0") (required_checks "CHK-LOAD-X0-POS") (required_checks "CHK-LOAD-X0-NEG"))
(obligation (id "OB-JALR-LSB") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "JALR computes its target by adding the sign-extended 12-bit immediate to rs1 and then setting the least-significant bit of the result to zero.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.5.1")) (parameters (param (name requirement_id) (value (str "REQ-D-JALR-LSB"))) (param (name decision_id) (value (str "D-JALR-LSB"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-JALR-LSB") (required_checks "CHK-JALR-LSB-POS") (required_checks "CHK-JALR-LSB-NEG"))
(obligation (id "OB-NO-DELAY-SLOTS") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Control transfers have no architecturally visible delay slots.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.5")) (parameters (param (name requirement_id) (value (str "REQ-D-NO-DELAY-SLOTS"))) (param (name decision_id) (value (str "D-NO-DELAY-SLOTS"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-NO-DELAY-SLOTS") (required_checks "CHK-NO-DELAY-SLOTS-POS") (required_checks "CHK-NO-DELAY-SLOTS-NEG"))
(obligation (id "OB-IALIGN") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "IALIGN = 32, because no 16-bit-length extension is included. An instruction-address-misaligned exception is therefore raised on a taken branch or unconditional jump whose target is not 4-byte aligned.") (authority implementation-profile) (source_refs (source_id "RVI-RV32I") (locator "§1.1.5, §1.1.5.1, §1.1.5.2")) (parameters (param (name requirement_id) (value (str "REQ-D-IALIGN"))) (param (name decision_id) (value (str "D-IALIGN"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-IALIGN") (required_checks "CHK-IALIGN-POS") (required_checks "CHK-IALIGN-NEG"))
(obligation (id "OB-MISALIGN-REPORT") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "The instruction-address-misaligned exception is reported on the branch or jump, NOT on the target instruction. A branch that is not taken raises no such exception.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.5.2")) (parameters (param (name requirement_id) (value (str "REQ-D-MISALIGN-REPORT"))) (param (name decision_id) (value (str "D-MISALIGN-REPORT"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-MISALIGN-REPORT") (required_checks "CHK-MISALIGN-REPORT-POS") (required_checks "CHK-MISALIGN-REPORT-NEG"))
(obligation (id "OB-FETCH-FAULT-REPORT") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "An instruction access-fault on the TARGET of a jump or taken branch is reported on the target instruction, not on the jump or branch — the opposite reporting point from misalignment.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.5")) (parameters (param (name requirement_id) (value (str "REQ-D-FETCH-FAULT-REPORT"))) (param (name decision_id) (value (str "D-FETCH-FAULT-REPORT"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-FETCH-FAULT-REPORT") (required_checks "CHK-FETCH-FAULT-REPORT-POS") (required_checks "CHK-FETCH-FAULT-REPORT-NEG"))
(obligation (id "OB-ENDIAN") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Little-endian. The specification delegates this to the EEI; endianness in RISC-V is byte-address invariant.") (authority implementation-profile) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (parameters (param (name requirement_id) (value (str "REQ-D-ENDIAN"))) (param (name decision_id) (value (str "D-ENDIAN"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-ENDIAN") (required_checks "CHK-ENDIAN-POS") (required_checks "CHK-ENDIAN-NEG"))
(obligation (id "OB-MISALIGN-DATA") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Misaligned loads and stores are NOT handled invisibly. A misaligned access raises an address-misaligned exception, delivered as a CONTAINED trap reported to the harness. Access-fault is not substituted, because this profile declares no memory region with side effects.") (authority implementation-profile) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (parameters (param (name requirement_id) (value (str "REQ-D-MISALIGN-DATA"))) (param (name decision_id) (value (str "D-MISALIGN-DATA"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-MISALIGN-DATA") (required_checks "CHK-MISALIGN-DATA-POS") (required_checks "CHK-MISALIGN-DATA-NEG"))
(obligation (id "OB-RESERVED-DECODE") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Decoding a reserved instruction raises an illegal-instruction exception. The architecture declares this behaviour UNSPECIFIED and notes that platforms differ, so the model must record the outcome as a laboratory policy over an UNSPECIFIED case and must be able to report it as such.") (authority laboratory) (source_refs (source_id "RVI-RV32I") (locator "§1.1.5.2 (reserved-instruction note)")) (source_refs (source_id "RVI-INTRO") (locator "UNSPECIFIED Behaviors and Values")) (parameters (param (name requirement_id) (value (str "REQ-D-RESERVED-DECODE"))) (param (name decision_id) (value (str "D-RESERVED-DECODE"))) (param (name source_semantics) (value (str "unspecified")))) (dependencies "REQ-D-RESERVED-DECODE") (required_checks "CHK-RESERVED-DECODE-POS") (required_checks "CHK-RESERVED-DECODE-NEG"))
(obligation (id "OB-HINTS") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Every code point in the RV64I HINT table executes as a no-op that writes nothing to x0's architectural value; a HINT must not trap. This profile implements no HINT behaviour beyond that.") (authority architecture) (source_refs (source_id "RVI-RV64I") (locator "§3.1.4 Table 1")) (parameters (param (name requirement_id) (value (str "REQ-D-HINTS"))) (param (name decision_id) (value (str "D-HINTS"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-HINTS") (required_checks "CHK-HINTS-POS") (required_checks "CHK-HINTS-NEG"))
(obligation (id "OB-FENCE") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "FENCE is decoded and must not trap. With one hart, no external devices and an in-order model, it has no observable effect. FENCE.TSO (fm=1000, pred=RW, succ=RW) is accepted and treated as FENCE RW,RW, which the specification states is correct. The remaining fm, pred and succ configurations are reserved, and the architecture SPECIFIES their behavior: base implementations shall treat all such reserved configurations as FENCE instructions (with fm = 0000) — they decode and execute as an ordinary FENCE, which under this profile has no observable effect. They do NOT fall under D-RESERVED-DECODE, and the rs1 and rd fields are ignored for forward compatibility, as the same section directs.") (authority implementation-profile) (source_refs (source_id "RVI-RV32I") (locator "§1.1.7, Table 3 Fence mode encoding")) (parameters (param (name requirement_id) (value (str "REQ-D-FENCE"))) (param (name decision_id) (value (str "D-FENCE"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-FENCE") (required_checks "CHK-FENCE-POS") (required_checks "CHK-FENCE-NEG"))
(obligation (id "OB-ECALL-EBREAK") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "ECALL and EBREAK cause a precise REQUESTED trap to the execution environment. With no privileged modes in this profile there is no guest handler, so both are reported to the harness as a typed environment-trap outcome and execution stops unless the harness contract says otherwise.") (authority implementation-profile) (source_refs (source_id "RVI-RV32I") (locator "§1.1.8")) (source_refs (source_id "RVI-INTRO") (locator "Exceptions/Traps/Interrupts (Requested Trap)")) (parameters (param (name requirement_id) (value (str "REQ-D-ECALL-EBREAK"))) (param (name decision_id) (value (str "D-ECALL-EBREAK"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-ECALL-EBREAK") (required_checks "CHK-ECALL-EBREAK-POS") (required_checks "CHK-ECALL-EBREAK-NEG"))
(obligation (id "OB-ENTRY-STATE") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "At reset: pc = the declared entry address of the loaded image; x1..x31 = 0; x0 is architecturally 0 always. The base ISA does not define the initial contents of x1..x31 — the EEI does — so this is a harness declaration and guest programs may not assume any other environment provides it.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (parameters (param (name requirement_id) (value (str "REQ-D-ENTRY-STATE"))) (param (name decision_id) (value (str "D-ENTRY-STATE"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-ENTRY-STATE") (required_checks "CHK-ENTRY-STATE-POS") (required_checks "CHK-ENTRY-STATE-NEG"))
(obligation (id "OB-ADDRESS-SPACE") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "A 64-bit byte-addressed space in which only the regions declared by the harness memory map are legal. An access outside a declared region raises an access-fault exception. The specification delegates which portions are legal to the execution environment.") (authority implementation-profile) (source_refs (source_id "RVI-RV64I") (locator "§3.1.3")) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (parameters (param (name requirement_id) (value (str "REQ-D-ADDRESS-SPACE"))) (param (name decision_id) (value (str "D-ADDRESS-SPACE"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-ADDRESS-SPACE") (required_checks "CHK-ADDRESS-SPACE-POS") (required_checks "CHK-ADDRESS-SPACE-NEG"))
(obligation (id "OB-ADDR-WRAP") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "The address space is CIRCULAR: the byte at address 2^XLEN-1 is adjacent to the byte at address 0, and address computations done by the hardware ignore overflow and wrap modulo 2^XLEN.") (authority architecture) (source_refs (source_id "RVI-INTRO") (locator "Memory")) (parameters (param (name requirement_id) (value (str "REQ-D-ADDR-WRAP"))) (param (name decision_id) (value (str "D-ADDR-WRAP"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-ADDR-WRAP") (required_checks "CHK-ADDR-WRAP-POS") (required_checks "CHK-ADDR-WRAP-NEG"))
(obligation (id "OB-FETCH-IMPLICIT") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Every executed instruction entails an implicit memory read — the instruction fetch. Explicit reads and writes are made only by load and store instructions.") (authority architecture) (source_refs (source_id "RVI-INTRO") (locator "Memory")) (parameters (param (name requirement_id) (value (str "REQ-D-FETCH-IMPLICIT"))) (param (name decision_id) (value (str "D-FETCH-IMPLICIT"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-FETCH-IMPLICIT") (required_checks "CHK-FETCH-IMPLICIT-POS") (required_checks "CHK-FETCH-IMPLICIT-NEG"))
(obligation (id "OB-FETCH-MAP") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "The set of locations implicitly readable for instruction fetch is the same as the set explicitly readable by loads in this laboratory. The specification allows the two sets to differ and delegates the choice to the execution environment; this profile declares them identical so that a fetch fault and a load fault at the same address are comparable.") (authority implementation-profile) (source_refs (source_id "RVI-INTRO") (locator "Memory")) (parameters (param (name requirement_id) (value (str "REQ-D-FETCH-MAP"))) (param (name decision_id) (value (str "D-FETCH-MAP"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-FETCH-MAP") (required_checks "CHK-FETCH-MAP-POS") (required_checks "CHK-FETCH-MAP-NEG"))
(obligation (id "OB-CODE-VISIBILITY") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "The model re-reads memory for every instruction fetch, so a store that modifies a later-fetched instruction becomes visible immediately. This is a legal implementation choice but NOT an architectural guarantee: without the Zifencei extension (absent from this profile) the base ISA permits a hart to cache fetchable bytes and never re-read main memory, so a guest may not rely on this behaviour and a reference model that caches is not wrong.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "Memory (implicit reads and FENCE.I / Zifencei)")) (parameters (param (name requirement_id) (value (str "REQ-D-CODE-VISIBILITY"))) (param (name decision_id) (value (str "D-CODE-VISIBILITY"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-CODE-VISIBILITY") (required_checks "CHK-CODE-VISIBILITY-POS") (required_checks "CHK-CODE-VISIBILITY-NEG"))
(obligation (id "OB-MAIN-VS-IO") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "Every region this profile declares is MAIN MEMORY: reads and writes have no visible side effects. The profile declares no I/O region, which is why D-MISALIGN-DATA can raise address-misaligned rather than substituting access-fault. A reference whose default platform supplies I/O regions must be configured to remove them before it is a matched profile — see D-PLATFORM.") (authority implementation-profile) (source_refs (source_id "RVI-INTRO") (locator "Memory")) (parameters (param (name requirement_id) (value (str "REQ-D-MAIN-VS-IO"))) (param (name decision_id) (value (str "D-MAIN-VS-IO"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-MAIN-VS-IO") (required_checks "CHK-MAIN-VS-IO-POS") (required_checks "CHK-MAIN-VS-IO-NEG"))
(obligation (id "OB-PLATFORM") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "The laboratory platform declares exactly one region — the MainMemory region of the harness memory map — and NO devices: no core-local interruptor, no interrupt generator, and no machine software, timer or external interrupt source. A reference model is not matched to this profile until its platform is configured to the same shape, not merely its instruction set.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (parameters (param (name requirement_id) (value (str "REQ-D-PLATFORM"))) (param (name decision_id) (value (str "D-PLATFORM"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-PLATFORM") (required_checks "CHK-PLATFORM-POS") (required_checks "CHK-PLATFORM-NEG"))
(obligation (id "OB-ENV-ADDRESS-UNITS") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "Memory is addressed in 8-bit bytes and every address is a 64-bit value interpreted modulo 2^64. The harness supplies and reports addresses in these units and no other.") (authority implementation-profile) (source_refs (source_id "RVI-INTRO") (locator "Memory")) (source_refs (source_id "RVI-RV64I") (locator "§3.1.3")) (parameters (param (name address_unit_bits) (value (int 8))) (param (name address_width_bits) (value (int 64))) (param (name wraps_modulo) (value (str "2^64")))) (dependencies "OB-ADDR-WRAP") (required_checks "CHK-ENV-ADDRESS-UNITS-POS") (required_checks "CHK-ENV-ADDRESS-UNITS-NEG"))
(obligation (id "OB-ENV-ACCESS-WIDTHS") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "The harness honours exactly the access widths this profile's loads and stores request — 8, 16, 32 and 64 bits — and rejects any other width as a contract violation rather than servicing it.") (authority implementation-profile) (source_refs (source_id "RVI-RV64I") (locator "§3.1.3")) (parameters (param (name legal_access_widths_bits) (value (ints 8 16 32 64))) (param (name instruction_fetch_width_bits) (value (int 32)))) (dependencies "OB-LOAD-EXT") (required_checks "CHK-ENV-ACCESS-WIDTHS-POS") (required_checks "CHK-ENV-ACCESS-WIDTHS-NEG"))
(obligation (id "OB-ENV-VIRTUAL-TIME") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "No time source is reachable by a guest. This profile excludes Zicntr, Zihpm and all CSRs, so no counter is architecturally readable — AND the laboratory platform declares no core-local interruptor, so no memory-mapped time register is readable either. ⛔ Both halves are required: excluding the CSR instructions alone does NOT exclude reading time, because a CLINT exposes mtime as ordinary MMIO that a plain load reaches. The harness's retired-instruction count is not target-visible and may not justify any guest-observable behaviour.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (parameters (param (name time_source) (value (str "none"))) (param (name target_visible_counters) (value (ints))) (param (name csr_readable_time) (value (false))) (param (name mmio_readable_time) (value (false))) (param (name ordering_index) (value (str "harness retired-instruction count (not target-visible)")))) (dependencies "OB-PLATFORM") (required_checks "CHK-ENV-VIRTUAL-TIME-POS") (required_checks "CHK-ENV-VIRTUAL-TIME-NEG"))
(obligation (id "OB-ENV-EVENT-DELIVERY") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "The only events this profile delivers are synchronous exceptions and requested traps, raised at the instruction that caused them. No asynchronous interrupt is deliverable — because the laboratory platform declares no interrupt controller and no machine software, timer or external source, NOT because the instruction set lacks CSRs. A hart always runs in at least machine mode and its trap state exists whether or not Zicsr is present, so the absence must be a platform property to be real.") (authority implementation-profile) (source_refs (source_id "RVI-INTRO") (locator "Exceptions, Traps, and Interrupts")) (source_refs (source_id "RVI-RV32I") (locator "§1.1.8")) (parameters (param (name synchronous_exceptions) (value (true))) (param (name asynchronous_interrupts) (value (false))) (param (name interrupt_controller) (value (str "none"))) (param (name delivery_point) (value (str "the instruction raising the condition")))) (dependencies "OB-ECALL-EBREAK") (dependencies "OB-MISALIGN-REPORT") (dependencies "OB-PLATFORM") (required_checks "CHK-ENV-EVENT-DELIVERY-POS") (required_checks "CHK-ENV-EVENT-DELIVERY-NEG"))
(obligation (id "OB-ENV-ORDERING") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "Execution is sequential and deterministic: one hart, in-order, each instruction's effects complete before the next instruction's begin. This profile makes NO memory-ordering claim — RVWMO is out of scope until MC-MULTICORE — and a guest may not rely on this harness's sequential behaviour as an architectural guarantee.") (authority laboratory) (source_refs (source_id "RVI-RV32I") (locator "§1.1.7")) (parameters (param (name harts) (value (int 1))) (param (name execution_order) (value (str "sequential in-order"))) (param (name memory_model_claim) (value (str "none")))) (dependencies "OB-FENCE") (required_checks "CHK-ENV-ORDERING-POS") (required_checks "CHK-ENV-ORDERING-NEG"))
(obligation (id "OB-ENV-FETCH-SUPPLY") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "For every instruction fetch the harness supplies 32 bits from a declared executable region, or the specified failure. It performs no fetch that the model did not request, and no fetch has a side effect.") (authority implementation-profile) (source_refs (source_id "RVI-INTRO") (locator "Memory")) (parameters (param (name fetch_width_bits) (value (int 32))) (param (name extraneous_fetch_permitted) (value (false))) (param (name fetch_side_effects) (value (str "none")))) (dependencies "OB-FETCH-IMPLICIT") (dependencies "OB-FETCH-MAP") (required_checks "CHK-ENV-FETCH-SUPPLY-POS") (required_checks "CHK-ENV-FETCH-SUPPLY-NEG"))
(obligation (id "OB-ENV-RESET") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "The harness establishes the declared entry state before the first fetch: pc at the loaded image's entry address, x1..x31 zeroed, memory outside the loaded image unwritten. Only a cold reset is modelled; there is no warm reset and no retained state to order.") (authority laboratory) (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (parameters (param (name reset_kinds) (value (strs "cold"))) (param (name retained_state) (value (str "none")))) (dependencies "OB-ENTRY-STATE") (required_checks "CHK-ENV-RESET-POS") (required_checks "CHK-ENV-RESET-NEG"))
(obligation (id "OB-ENV-PARTIAL-PROGRESS") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction environment-assumption) (statement "Every instruction in this profile's scope completes or faults as a unit: there is no multi-step or restartable suboperation in RV64I base, so no partially committed effect can be observed. A fault therefore leaves the architectural state exactly as it was before the faulting instruction, except for the fault report itself.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (source_refs (source_id "RVI-INTRO") (locator "Exceptions, Traps, and Interrupts")) (parameters (param (name restartable_suboperations) (value (false))) (param (name partial_commit_possible) (value (false)))) (dependencies "OB-LOAD-X0") (required_checks "CHK-ENV-PARTIAL-PROGRESS-POS") (required_checks "CHK-ENV-PARTIAL-PROGRESS-NEG"))
(obligation (id "OB-ALU-REG") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "ADD and SUB add and subtract modulo 2^XLEN; overflow is ignored and the result wraps. SLT and SLTU are signed and unsigned comparisons respectively, producing 0 or 1. XOR, OR and AND are bitwise.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.4")) (parameters (param (name requirement_id) (value (str "REQ-D-ALU-REG"))) (param (name decision_id) (value (str "D-ALU-REG"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-ALU-REG") (required_checks "CHK-ALU-REG-POS") (required_checks "CHK-ALU-REG-NEG"))
(obligation (id "OB-ALU-IMM") (contract_id "rv64i-lab-env-v0") (contract_version "0") (profile_ids "rv64i-lab-v0") (direction cpu-guarantee) (statement "ADDI adds the sign-extended 12-bit immediate to rs1, wrapping modulo 2^XLEN; overflow is ignored. SLTI and SLTIU compare rs1 against the sign-extended immediate, signed and unsigned respectively — SLTIU still sign-extends the immediate first and then compares unsigned. XORI, ORI and ANDI are bitwise against the sign-extended immediate.") (authority architecture) (source_refs (source_id "RVI-RV32I") (locator "§1.1.4")) (parameters (param (name requirement_id) (value (str "REQ-D-ALU-IMM"))) (param (name decision_id) (value (str "D-ALU-IMM"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-ALU-IMM") (required_checks "CHK-ALU-IMM-POS") (required_checks "CHK-ALU-IMM-NEG"))
