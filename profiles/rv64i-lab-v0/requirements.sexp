;; requirements.sexp — the requirement catalogue, converted from requirements.jsonl by
;; scripts/convert_records.py (SOT-FORMAT.3). One record per form; validate with
;;   python3 scripts/check_sexp_schema.py requirements.sexp schema/requirements.sexp
;; Round-trip losslessness: `convert_records.py --verify requirements.jsonl requirements.sexp`.

(requirement (id "REQ-D-XLEN") (profile_ids "rv64i-lab-v0") (kind state) (statement "XLEN = 64. The integer registers and the supported user address space are 64 bits.") (source_refs (source_id "RVI-RV64I") (locator "§3.1.1")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk low) (obligation_ids "OB-XLEN"))
(requirement (id "REQ-D-WSUFFIX") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "The *W instructions ignore the upper 32 bits of their inputs, produce a 32-bit signed result, and sign-extend it to 64 bits — bits XLEN-1 through 31 are equal. Overflow is ignored.") (insns "addiw") (insns "slliw") (insns "srliw") (insns "sraiw") (insns "addw") (insns "subw") (insns "sllw") (insns "srlw") (insns "sraw") (source_refs (source_id "RVI-RV64I") (locator "§3.1.2, §3.1.2.1, §3.1.2.2")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk high) (obligation_ids "OB-WSUFFIX") (dependencies "REQ-D-XLEN"))
(requirement (id "REQ-D-SHAMT") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "SLLI/SRLI/SRAI take a 6-bit shift amount from the I-immediate; SLL/SRL/SRA use only the low 6 bits of rs2. SLLIW/SRLIW/SRAIW take 5 bits, and SLLW/SRLW/SRAW use rs2[4:0].") (insns "slli") (insns "srli") (insns "srai") (insns "sll") (insns "srl") (insns "sra") (insns "slliw") (insns "srliw") (insns "sraiw") (source_refs (source_id "RVI-RV64I") (locator "§3.1.2.1, §3.1.2.2")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk high) (obligation_ids "OB-SHAMT") (dependencies "REQ-D-XLEN"))
(requirement (id "REQ-D-SHIFTW-RESERVED") (profile_ids "rv64i-lab-v0") (kind decode) (statement "SLLIW, SRLIW and SRAIW encodings with imm[5] != 0 are RESERVED. They were previously defined to raise an illegal-instruction exception; this revision marks them reserved instead, and calls the change backwards-compatible.") (source_refs (source_id "RVI-RV64I") (locator "§3.1.2.1")) (applicability included) (research_status partial) (implementation_status planned) (source_semantics (category reserved) (detail "The encoding is RESERVED in this revision, having previously been defined to raise an illegal-instruction exception; the change is called backwards-compatible. OPEN: OQ-2 — whether each reference model treats imm[5]!=0 as RESERVED (this revision) or raises illegal-instruction (the previous text) is not yet enumerated per model.")) (risk critical) (obligation_ids "OB-SHIFTW-RESERVED") (dependencies "REQ-D-SHAMT"))
(requirement (id "REQ-D-LUI-AUIPC") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "LUI places the 32-bit U-immediate in rd with the low 12 bits zeroed, sign-extended to 64 bits. AUIPC forms the same 32-bit offset, sign-extends it to 64 bits, and adds it to the address of the AUIPC instruction.") (insns "lui") (insns "auipc") (source_refs (source_id "RVI-RV64I") (locator "§3.1.2.1")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk medium) (obligation_ids "OB-LUI-AUIPC") (dependencies "REQ-D-XLEN"))
(requirement (id "REQ-D-LOAD-EXT") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "LW sign-extends its 32-bit result to 64 bits; LWU zero-extends it. LH/LB sign-extend and LHU/LBU zero-extend analogously. SD/SW/SH/SB store the low 64/32/16/8 bits of rs2.") (insns "lb") (insns "lh") (insns "lw") (insns "lbu") (insns "lhu") (insns "lwu") (insns "ld") (insns "sb") (insns "sh") (insns "sw") (insns "sd") (source_refs (source_id "RVI-RV64I") (locator "§3.1.3")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk high) (obligation_ids "OB-LOAD-EXT") (dependencies "REQ-D-XLEN") (dependencies "REQ-D-ENDIAN"))
(requirement (id "REQ-D-LOAD-X0") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "A load with rd = x0 must still raise any exceptions and cause any other side effects, even though the loaded value is discarded.") (insns "lb") (insns "lh") (insns "lw") (insns "lbu") (insns "lhu") (insns "lwu") (insns "ld") (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk high) (obligation_ids "OB-LOAD-X0"))
(requirement (id "REQ-D-JALR-LSB") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "JALR computes its target by adding the sign-extended 12-bit immediate to rs1 and then setting the least-significant bit of the result to zero.") (insns "jalr") (source_refs (source_id "RVI-RV32I") (locator "§1.1.5.1")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk medium) (obligation_ids "OB-JALR-LSB"))
(requirement (id "REQ-D-NO-DELAY-SLOTS") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "Control transfers have no architecturally visible delay slots.") (insns "jal") (insns "jalr") (insns "beq") (insns "bne") (insns "blt") (insns "bge") (insns "bltu") (insns "bgeu") (source_refs (source_id "RVI-RV32I") (locator "§1.1.5")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk low) (obligation_ids "OB-NO-DELAY-SLOTS"))
(requirement (id "REQ-D-IALIGN") (profile_ids "rv64i-lab-v0") (kind event) (statement "IALIGN = 32, because no 16-bit-length extension is included. An instruction-address-misaligned exception is therefore raised on a taken branch or unconditional jump whose target is not 4-byte aligned.") (source_refs (source_id "RVI-RV32I") (locator "§1.1.5, §1.1.5.1, §1.1.5.2")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk high) (obligation_ids "OB-IALIGN"))
(requirement (id "REQ-D-MISALIGN-REPORT") (profile_ids "rv64i-lab-v0") (kind event) (statement "The instruction-address-misaligned exception is reported on the branch or jump, NOT on the target instruction. A branch that is not taken raises no such exception.") (source_refs (source_id "RVI-RV32I") (locator "§1.1.5.2")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk critical) (obligation_ids "OB-MISALIGN-REPORT") (dependencies "REQ-D-IALIGN"))
(requirement (id "REQ-D-FETCH-FAULT-REPORT") (profile_ids "rv64i-lab-v0") (kind event) (statement "An instruction access-fault on the TARGET of a jump or taken branch is reported on the target instruction, not on the jump or branch — the opposite reporting point from misalignment.") (source_refs (source_id "RVI-RV32I") (locator "§1.1.5")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk critical) (obligation_ids "OB-FETCH-FAULT-REPORT") (dependencies "REQ-D-ADDRESS-SPACE"))
(requirement (id "REQ-D-ENDIAN") (profile_ids "rv64i-lab-v0") (kind memory) (statement "Little-endian. The specification delegates this to the EEI; endianness in RISC-V is byte-address invariant.") (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk medium) (obligation_ids "OB-ENDIAN"))
(requirement (id "REQ-D-MISALIGN-DATA") (profile_ids "rv64i-lab-v0") (kind memory) (statement "Misaligned loads and stores are NOT handled invisibly. A misaligned access raises an address-misaligned exception, delivered as a CONTAINED trap reported to the harness. Access-fault is not substituted, because this profile declares no memory region with side effects.") (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk high) (obligation_ids "OB-MISALIGN-DATA") (dependencies "REQ-D-MAIN-VS-IO") (dependencies "REQ-D-PLATFORM"))
(requirement (id "REQ-D-RESERVED-DECODE") (profile_ids "rv64i-lab-v0") (kind decode) (statement "Decoding a reserved instruction raises an illegal-instruction exception. The architecture declares this behaviour UNSPECIFIED and notes that platforms differ, so the model must record the outcome as a laboratory policy over an UNSPECIFIED case and must be able to report it as such.") (source_refs (source_id "RVI-RV32I") (locator "§1.1.5.2 (reserved-instruction note)")) (source_refs (source_id "RVI-INTRO") (locator "UNSPECIFIED Behaviors and Values")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category unspecified) (detail "The specification declares the behaviour UNSPECIFIED and notes that platforms differ; this profile adopts a laboratory policy and the model must be able to report that the case WAS unspecified.")) (risk high) (obligation_ids "OB-RESERVED-DECODE") (dependencies "REQ-D-SHIFTW-RESERVED"))
(requirement (id "REQ-D-HINTS") (profile_ids "rv64i-lab-v0") (kind decode) (statement "Every code point in the RV64I HINT table executes as a no-op that writes nothing to x0's architectural value; a HINT must not trap. This profile implements no HINT behaviour beyond that.") (source_refs (source_id "RVI-RV64I") (locator "§3.1.4 Table 1")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk medium) (obligation_ids "OB-HINTS"))
(requirement (id "REQ-D-FENCE") (profile_ids "rv64i-lab-v0") (kind memory) (statement "FENCE is decoded and must not trap. With one hart, no external devices and an in-order model, it has no observable effect. FENCE.TSO (fm=1000, pred=RW, succ=RW) is accepted and treated as FENCE RW,RW, which the specification states is correct. Other fm values are reserved and fall under D-RESERVED-DECODE.") (insns "fence") (source_refs (source_id "RVI-RV32I") (locator "§1.1.7, Table 3 Fence mode encoding")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk medium) (obligation_ids "OB-FENCE"))
(requirement (id "REQ-D-ECALL-EBREAK") (profile_ids "rv64i-lab-v0") (kind event) (statement "ECALL and EBREAK cause a precise REQUESTED trap to the execution environment. With no privileged modes in this profile there is no guest handler, so both are reported to the harness as a typed environment-trap outcome and execution stops unless the harness contract says otherwise.") (insns "ecall") (insns "ebreak") (source_refs (source_id "RVI-RV32I") (locator "§1.1.8")) (source_refs (source_id "RVI-INTRO") (locator "Exceptions/Traps/Interrupts (Requested Trap)")) (applicability included) (research_status partial) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect. OPEN: OQ-5 — the value of pc after a requested trap is not defined by the base ISA without a privileged mode, and this harness has not declared it. Owner: P0-PROFILE.4.")) (risk high) (obligation_ids "OB-ECALL-EBREAK"))
(requirement (id "REQ-D-ENTRY-STATE") (profile_ids "rv64i-lab-v0") (kind state) (statement "At reset: pc = the declared entry address of the loaded image; x1..x31 = 0; x0 is architecturally 0 always. The base ISA does not define the initial contents of x1..x31 — the EEI does — so this is a harness declaration and guest programs may not assume any other environment provides it.") (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk medium) (obligation_ids "OB-ENTRY-STATE") (dependencies "REQ-D-XLEN"))
(requirement (id "REQ-D-ADDRESS-SPACE") (profile_ids "rv64i-lab-v0") (kind memory) (statement "A 64-bit byte-addressed space in which only the regions declared by the harness memory map are legal. An access outside a declared region raises an access-fault exception. The specification delegates which portions are legal to the execution environment.") (source_refs (source_id "RVI-RV64I") (locator "§3.1.3")) (source_refs (source_id "RVI-RV32I") (locator "§1.1.6")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk high) (obligation_ids "OB-ADDRESS-SPACE") (dependencies "REQ-D-ADDR-WRAP"))
(requirement (id "REQ-D-ADDR-WRAP") (profile_ids "rv64i-lab-v0") (kind memory) (statement "The address space is CIRCULAR: the byte at address 2^XLEN-1 is adjacent to the byte at address 0, and address computations done by the hardware ignore overflow and wrap modulo 2^XLEN.") (source_refs (source_id "RVI-INTRO") (locator "Memory")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk high) (obligation_ids "OB-ADDR-WRAP"))
(requirement (id "REQ-D-FETCH-IMPLICIT") (profile_ids "rv64i-lab-v0") (kind memory) (statement "Every executed instruction entails an implicit memory read — the instruction fetch. Explicit reads and writes are made only by load and store instructions.") (source_refs (source_id "RVI-INTRO") (locator "Memory")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk medium) (obligation_ids "OB-FETCH-IMPLICIT"))
(requirement (id "REQ-D-FETCH-MAP") (profile_ids "rv64i-lab-v0") (kind memory) (statement "The set of locations implicitly readable for instruction fetch is the same as the set explicitly readable by loads in this laboratory. The specification allows the two sets to differ and delegates the choice to the execution environment; this profile declares them identical so that a fetch fault and a load fault at the same address are comparable.") (source_refs (source_id "RVI-INTRO") (locator "Memory")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk medium) (obligation_ids "OB-FETCH-MAP") (dependencies "REQ-D-ADDRESS-SPACE") (dependencies "REQ-D-FETCH-IMPLICIT"))
(requirement (id "REQ-D-CODE-VISIBILITY") (profile_ids "rv64i-lab-v0") (kind memory) (statement "The model re-reads memory for every instruction fetch, so a store that modifies a later-fetched instruction becomes visible immediately. This is a legal implementation choice but NOT an architectural guarantee: without the Zifencei extension (absent from this profile) the base ISA permits a hart to cache fetchable bytes and never re-read main memory, so a guest may not rely on this behaviour and a reference model that caches is not wrong.") (source_refs (source_id "RVI-INTRO") (locator "Memory (implicit reads and FENCE.I / Zifencei)")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk high) (obligation_ids "OB-CODE-VISIBILITY") (dependencies "REQ-D-FETCH-IMPLICIT"))
(requirement (id "REQ-D-MAIN-VS-IO") (profile_ids "rv64i-lab-v0") (kind memory) (statement "Every region this profile declares is MAIN MEMORY: reads and writes have no visible side effects. The profile declares no I/O region, which is why D-MISALIGN-DATA can raise address-misaligned rather than substituting access-fault. A reference whose default platform supplies I/O regions must be configured to remove them before it is a matched profile — see D-PLATFORM.") (source_refs (source_id "RVI-INTRO") (locator "Memory")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk high) (obligation_ids "OB-MAIN-VS-IO"))
(requirement (id "REQ-D-PLATFORM") (profile_ids "rv64i-lab-v0") (kind environment) (statement "The laboratory platform declares exactly one region — the MainMemory region of the harness memory map — and NO devices: no core-local interruptor, no interrupt generator, and no machine software, timer or external interrupt source. A reference model is not matched to this profile until its platform is configured to the same shape, not merely its instruction set.") (source_refs (source_id "RVI-INTRO") (locator "RISC-V Software Execution Environments and Harts")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category implementation-defined) (detail "The specification explicitly delegates this to the execution environment; this profile chose it, and a reference that chose differently is a profile difference, not a defect.")) (risk critical) (obligation_ids "OB-PLATFORM") (dependencies "REQ-D-ADDRESS-SPACE") (dependencies "REQ-D-MAIN-VS-IO"))
(requirement (id "REQ-D-ALU-REG") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "ADD and SUB add and subtract modulo 2^XLEN; overflow is ignored and the result wraps. SLT and SLTU are signed and unsigned comparisons respectively, producing 0 or 1. XOR, OR and AND are bitwise.") (insns "add") (insns "sub") (insns "slt") (insns "sltu") (insns "xor") (insns "or") (insns "and") (source_refs (source_id "RVI-RV32I") (locator "§1.1.4")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk low) (obligation_ids "OB-ALU-REG") (dependencies "REQ-D-XLEN"))
(requirement (id "REQ-D-ALU-IMM") (profile_ids "rv64i-lab-v0") (kind instruction) (statement "ADDI adds the sign-extended 12-bit immediate to rs1, wrapping modulo 2^XLEN; overflow is ignored. SLTI and SLTIU compare rs1 against the sign-extended immediate, signed and unsigned respectively — SLTIU still sign-extends the immediate first and then compares unsigned. XORI, ORI and ANDI are bitwise against the sign-extended immediate.") (insns "addi") (insns "slti") (insns "sltiu") (insns "xori") (insns "ori") (insns "andi") (source_refs (source_id "RVI-RV32I") (locator "§1.1.4")) (applicability included) (research_status resolved) (implementation_status planned) (source_semantics (category defined) (detail "The specification states this outright; the model has no latitude.")) (risk low) (obligation_ids "OB-ALU-IMM") (dependencies "REQ-D-XLEN"))
