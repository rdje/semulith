;; dir-x0-writes.expected.sexp — the expected observations for `dir-x0-writes.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-x0-writes.expected.sexp schema/expectations.sexp

(comment "dir-x0-writes.expected.sexp — the expected observations for `dir-x0-writes.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). x0 as the destination from every producer kind the corpus had not pinned: the six" "load forms' success paths (only lw was pinned) and six *W forms (only addiw/addw/sllw were," "via the HINT table). The register observation is empty BY CONSTRUCTION — a write to x0 is" "architecturally discarded — so the proof of execution is the crossing census (the six loads DO" "cross the boundary, D-LOAD-X0) and the landing addi: a form that trapped would end the trace." " never_written x0 states the negative explicitly.")
(expectations (program "dir-x0-writes.s") (entry "0x80000000") (instructions 18) (never_written "x0") (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "pc + 0.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 96") (writes (write (reg "x1") (value "0x0000000080000060"))) (derivation "&cell.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "addi x2, x0, -1") (writes (write (reg "x2") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "sext(−1) = all-ones — the cell's content, so every lane reads a set bit.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "sd x2, 0, x1") (writes ) (derivation "cell <- 0xFFFFFFFFFFFFFFFF.") (source "RVI-RV64I §3.1.3")) (step (n 4) (insn "lb x0, x1, 0") (writes ) (derivation "D-LOAD-X0: the load HAPPENS (the census pins the crossing; a fault would still raise) — the value 0xFF…FF is discarded; x0 stands at 0.") (source "RVI-RV32I §1.1.6 (D-LOAD-X0)")) (step (n 5) (insn "lbu x0, x1, 0") (writes ) (derivation "Discarded; the access still happens.") (source "RVI-RV32I §1.1.6 (D-LOAD-X0)")) (step (n 6) (insn "lh x0, x1, 0") (writes ) (derivation "Discarded; the access still happens.") (source "RVI-RV32I §1.1.6 (D-LOAD-X0)")) (step (n 7) (insn "lhu x0, x1, 0") (writes ) (derivation "Discarded; the access still happens.") (source "RVI-RV32I §1.1.6 (D-LOAD-X0)")) (step (n 8) (insn "lwu x0, x1, 0") (writes ) (derivation "Discarded; the access still happens.") (source "RVI-RV64I §3.1.3; D-LOAD-X0")) (step (n 9) (insn "ld x0, x1, 0") (writes ) (derivation "Discarded; the access still happens.") (source "RVI-RV64I §3.1.3; D-LOAD-X0")) (step (n 10) (insn "addi x3, x0, 5") (writes (write (reg "x3") (value "0x0000000000000005"))) (derivation "The *W forms' operand.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "subw x0, x3, x3") (writes ) (derivation "subw 5−5 = 0 — computed, discarded; x0 stands at 0.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 12) (insn "srlw x0, x3, x3") (writes ) (derivation "srlw 5 >> 5 = 0 (the 5-bit register amount) — discarded.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 13) (insn "sraw x0, x3, x3") (writes ) (derivation "sraw 5 >> 5 arithmetic = 0 — discarded.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 14) (insn "slliw x0, x3, 1") (writes ) (derivation "slliw 5 << 1 = 10, sign-extended from bit 31 (clear) — discarded.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 15) (insn "srliw x0, x3, 1") (writes ) (derivation "srliw 5 >> 1 = 2 — discarded.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 16) (insn "sraiw x0, x3, 1") (writes ) (derivation "sraiw 5 >> 1 = 2 — discarded.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 17) (insn "addi x4, x0, 4") (writes (write (reg "x4") (value "0x0000000000000004"))) (derivation "The landing: every producer kind retired with x0 as its destination, and x0 held 0 throughout (x0 is hardwired — the architecture's own rule, state.sexp).") (source "RVI-RV32I §1.1.4")))
