;; scope-mem.expected.sexp — the expected observations for `scope-mem.s` (P2-SCALAR.1).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py scope-mem.expected.sexp schema/expectations.sexp

(comment "scope-mem.expected.sexp — the expected observations for `scope-mem.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The pattern P = 0x80FFF7F080FFF7F0 is stored little-endian, so the bytes at the base" "address upward are F0 F7 FF 80 F0 F7 FF 80 — every probe below reads a value whose top bit AT" "THE PROBED WIDTH is set, which is what makes the sign- versus zero-extension observable." "" "Steps 0–10 build the base and P from already-covered forms; steps 11–19 are the load" "observations; steps 20–28 are the store observations, each verified by a full LD read-back.")
(expectations (program "scope-mem.s") (entry "0x80000000") (instructions 29) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "Building the main-memory base arithmetically; LUI cannot produce a positive 0x8000_0000.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 at 64 bits is the base of the declared MainMemory region.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "lui x1, 0x80FFF") (writes (write (reg "x1") (value "0xFFFFFFFF80FFF000"))) (derivation "The U-immediate 0x80FFF occupies bits 31..12; bit 31 is set, so the value sign-extends to all ones in the upper half.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 3) (insn "addi x2, x0, 0x7F0") (writes (write (reg "x2") (value "0x00000000000007F0"))) (derivation "A small positive immediate, the low bits of the pattern word.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "or x1, x1, x2") (writes (write (reg "x1") (value "0xFFFFFFFF80FFF7F0"))) (derivation "0xFFFFFFFF80FFF000 | 0x7F0 = 0xFFFFFFFF80FFF7F0 — the pattern word, still sitting in the low 32 bits under a sign-extended upper half.") (source "RVI-RV32I §1.1.4 (OR is bitwise)")) (step (n 5) (insn "slli x1, x1, 32") (writes (write (reg "x1") (value "0x80FFF7F000000000"))) (derivation "Shifting left by 32 moves the pattern word into the upper half and discards the sign-extended ones entirely: P's high half.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT: a 6-bit shift amount)")) (step (n 6) (insn "lui x3, 0x80FFF") (writes (write (reg "x3") (value "0xFFFFFFFF80FFF000"))) (derivation "The same starting word, for P's low half.") (source "RVI-RV64I §3.1.2.1")) (step (n 7) (insn "or x3, x3, x2") (writes (write (reg "x3") (value "0xFFFFFFFF80FFF7F0"))) (derivation "The same pattern word as step 4.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "slli x3, x3, 32") (writes (write (reg "x3") (value "0x80FFF7F000000000"))) (derivation "Into the upper half, as step 5.") (source "RVI-RV64I §3.1.2.1")) (step (n 9) (insn "srli x3, x3, 32") (writes (write (reg "x3") (value "0x0000000080FFF7F0"))) (derivation "And logically back down: the upper half is now zero, which LUI's sign extension could never have produced directly — this is why P is built rather than loaded.") (source "RVI-RV64I §3.1.2.1")) (step (n 10) (insn "or x7, x1, x3") (writes (write (reg "x7") (value "0x80FFF7F080FFF7F0"))) (derivation "The halves combine: P = 0x80FFF7F080FFF7F0, whose little-endian byte sequence is F0 F7 FF 80 F0 F7 FF 80.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "sd x7, 1024, x10") (writes) (derivation "A store writes memory and no register — the empty writes table. The address base+1024 is naturally aligned and well clear of the code.") (source "RVI-RV64I §3.1.3 (SD stores the low 64 bits of rs2)")) (step (n 12) (insn "lb x11, x10, 1024") (writes (write (reg "x11") (value "0xFFFFFFFFFFFFFFF0"))) (derivation "The byte at base+1024 is 0xF0. LB SIGN-extends it: bit 7 is set, so the value becomes 0xFFFFFFFFFFFFFFF0.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT: LB sign-extends)")) (step (n 13) (insn "lbu x12, x10, 1025") (writes (write (reg "x12") (value "0x00000000000000F7"))) (derivation "The byte at base+1025 is 0xF7 — top bit set, exactly like step 12 — but LBU ZERO-extends, so the value stays 0xF7. The two steps read the same kind of byte and differ only in the extension rule.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT: LBU zero-extends)")) (step (n 14) (insn "lh x13, x10, 1026") (writes (write (reg "x13") (value "0xFFFFFFFFFFFF80FF"))) (derivation "The halfword at base+1026 is bytes FF 80, little-endian 0x80FF. LH sign-extends: bit 15 is set, giving 0xFFFFFFFFFFFF80FF.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT: LH sign-extends)")) (step (n 15) (insn "lhu x14, x10, 1026") (writes (write (reg "x14") (value "0x00000000000080FF"))) (derivation "The SAME halfword at the SAME address, zero-extended: 0x00000000000080FF. Steps 14 and 15 are the extension-rule pair at one address.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT: LHU zero-extends)")) (step (n 16) (insn "lw x15, x10, 1024") (writes (write (reg "x15") (value "0xFFFFFFFF80FFF7F0"))) (derivation "The word at base+1024 is 0x80FFF7F0. LW sign-extends its 32-bit result to 64 bits; bit 31 is set.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT: LW sign-extends)")) (step (n 17) (insn "lwu x16, x10, 1028") (writes (write (reg "x16") (value "0x0000000080FFF7F0"))) (derivation "The identical word in P's upper half, read by LWU — which exists only at RV64 and ZERO-extends: 0x0000000080FFF7F0.") (source "RVI-RV64I §3.1.3 (D-LOAD-EXT: LWU zero-extends, and exists only at RV64)")) (step (n 18) (insn "ld x17, x10, 1024") (writes (write (reg "x17") (value "0x80FFF7F080FFF7F0"))) (derivation "A full XLEN load needs no extension: P itself comes back.") (source "RVI-RV64I §3.1.3")) (step (n 19) (insn "lw x0, x10, 1024") (writes) (derivation "D-LOAD-X0: a load with rd = x0 still performs the access — the data crossing happens and any exception would still be raised — but the loaded value is discarded and x0's architectural value never changes, so the expectation is the empty writes table.") (source "RVI-RV32I §1.1.6 (D-LOAD-X0)")) (step (n 20) (insn "addi x4, x0, -1") (writes (write (reg "x4") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "The store value: all ones, so each store width below leaves a visible all-ones pattern of exactly that width.") (source "RVI-RV32I §1.1.4")) (step (n 21) (insn "sb x4, 1040, x10") (writes) (derivation "SB stores the low 8 bits of rs2 — one 0xFF byte at base+1040. A store writes no register.") (source "RVI-RV64I §3.1.3 (SB stores the low 8 bits of rs2)")) (step (n 22) (insn "ld x18, x10, 1040") (writes (write (reg "x18") (value "0x00000000000000FF"))) (derivation "The read-back proves the store's width: only the low byte changed, so the doubleword reads 0x00000000000000FF — not 0xFFFFFFFFFFFFFFFF.") (source "RVI-RV64I §3.1.3")) (step (n 23) (insn "sh x4, 1048, x10") (writes) (derivation "SH stores the low 16 bits of rs2 at base+1048.") (source "RVI-RV64I §3.1.3 (SH stores the low 16 bits of rs2)")) (step (n 24) (insn "ld x19, x10, 1048") (writes (write (reg "x19") (value "0x000000000000FFFF"))) (derivation "Read-back: exactly two bytes were written.") (source "RVI-RV64I §3.1.3")) (step (n 25) (insn "sw x4, 1056, x10") (writes) (derivation "SW stores the low 32 bits of rs2 at base+1056.") (source "RVI-RV64I §3.1.3 (SW stores the low 32 bits of rs2)")) (step (n 26) (insn "ld x20, x10, 1056") (writes (write (reg "x20") (value "0x00000000FFFFFFFF"))) (derivation "Read-back: exactly four bytes were written — the store did not touch the upper half of the doubleword.") (source "RVI-RV64I §3.1.3")) (step (n 27) (insn "sw x7, 1064, x10") (writes) (derivation "SW of P keeps only its low 32 bits, 0x80FFF7F0, at base+1064.") (source "RVI-RV64I §3.1.3")) (step (n 28) (insn "ld x21, x10, 1064") (writes (write (reg "x21") (value "0x0000000080FFF7F0"))) (derivation "Read-back: the stored word, in a zeroed doubleword. Note this equals step 17's LWU value by construction, not by any extension rule — LD performs no extension.") (source "RVI-RV64I §3.1.3")))
