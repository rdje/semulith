;; fault-ld-mis-d.expected.sexp — the expected observations for `fault-ld-mis-d.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-ld-mis-d.expected.sexp schema/expectations.sexp

(comment "fault-ld-mis-d.expected.sexp — the expected observations for `fault-ld-mis-d.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The alignment rule is PER ACCESS WIDTH: 0x80000404 passes a 4-byte test and fails the" "8-byte one. x1 is never written.")
(expectations (program "fault-ld-mis-d.s") (entry "0x80000000") (instructions 3) (never_written "x1") (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "Building the main-memory base arithmetically; LUI cannot produce a positive 0x80000000.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 at 64 bits is the base of the declared MainMemory region.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "ld x1, x10, 1028") (writes) (derivation "The effective address is 0x80000404 — 4-aligned but NOT 8-aligned, and the rule is the access's own width: the doubleword load raises address-misaligned as a contained trap, and x1 is never written. Measured on both references: cause 0x04, tval 0x0000000080000404.") (source "RVI-RV32I §1.1.6 (the effective address must be divisible by the size of the access) — decision D-MISALIGN-DATA")))
