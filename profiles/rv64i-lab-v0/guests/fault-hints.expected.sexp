;; fault-hints.expected.sexp — the expected observations for `fault-hints.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-hints.expected.sexp schema/expectations.sexp

(comment "fault-hints.expected.sexp — the expected observations for `fault-hints.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). D-HINTS: every code point executes as a no-op that writes nothing to x0's architectural" "value, and a HINT must not trap. The observation is CONTINUATION — each HINT step carries the" "empty writes table (a write to x0 is architecturally discarded) and the run reaches the landing" "addi; a HINT that trapped would end the trace. The semihosting markers are deliberately excluded" "(spike implements semihosting off a specific three-instruction sequence; a lone marker near a" "trap is a fragile probe).")
(expectations (program "fault-hints.s") (entry "0x80000000") (instructions 10) (step (n 0) (insn "addi x1, x0, 5") (writes (write (reg "x1") (value "0x0000000000000005"))) (derivation "The HINTs' operand, and liveness.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "lui x0, 0x7FFFF") (writes) (derivation "LUI with rd = x0 is a HINT code point: it executes as a no-op and must not trap. The 0x7FFFF immediate would produce 0x7FFFF000 sign-extended into an ordinary register — into x0 it is architecturally discarded, so the expectation is the empty writes table.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: LUI rd = x0); §1.1.1 (x0 hardwired)")) (step (n 2) (insn "auipc x0, 0x12345") (writes) (derivation "AUIPC with rd = x0 is a HINT code point: a no-op that must not trap.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: AUIPC rd = x0)")) (step (n 3) (insn "addi x0, x1, 1") (writes) (derivation "ADDI with rd = x0 and rs1 != x0 is a HINT code point: a no-op that must not trap.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: ADDI rd = x0, rs1 != x0)")) (step (n 4) (insn "addiw x0, x1, 2") (writes) (derivation "ADDIW with rd = x0 is a HINT code point (the RV64I additions expand the HINT space): a no-op that must not trap.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: ADDIW rd = x0)")) (step (n 5) (insn "addw x0, x1, x1") (writes) (derivation "ADDW with rd = x0 is a HINT code point: a no-op that must not trap.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: ADDW rd = x0)")) (step (n 6) (insn "sllw x0, x1, x1") (writes) (derivation "SLLW with rd = x0 is a HINT code point: a no-op that must not trap.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: SLLW rd = x0)")) (step (n 7) (insn "sub x0, x1, x1") (writes) (derivation "SUB with rd = x0 is a HINT code point: a no-op that must not trap.") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: SUB rd = x0)")) (step (n 8) (insn "add x0, x0, x2") (writes) (derivation "ADD with rd = rs1 = x0 and rs2 = x2 is the NTL.P1 code point: a HINT, executed as a no-op that must not trap (this profile implements no HINT behavior beyond that).") (source "RVI-RV64I §3.1.4 Table 1 (D-HINTS: the NTL.P1 code point)")) (step (n 9) (insn "addi x3, x0, 3") (writes (write (reg "x3") (value "0x0000000000000003"))) (derivation "The landing: the whole HINT table retired — a HINT that trapped would end the trace before this write.") (source "RVI-RV32I §1.1.4")))
