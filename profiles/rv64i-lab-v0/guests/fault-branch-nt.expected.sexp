;; fault-branch-nt.expected.sexp — the expected observations for `fault-branch-nt.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-branch-nt.expected.sexp schema/expectations.sexp

(comment "fault-branch-nt.expected.sexp — the expected observations for `fault-branch-nt.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The SUPPRESSED-EFFECT guest (SEM-06): six branches point at misaligned targets and" "none is taken, so nothing is raised and every fall-through write happens; one taken branch to an" "aligned target proves the branches were live. The run retires into the step budget (14 executed" "steps from 15 instructions — the taken branch skips one).")
(expectations (program "fault-branch-nt.s") (entry "0x80000000") (instructions 14) (never_written "x8") (step (n 0) (insn "addi x1, x0, 1") (writes (write (reg "x1") (value "0x0000000000000001"))) (derivation "The operand that makes every branch condition below false.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "beq x0, x1, 6") (writes) (derivation "0 != 1, so the branch is NOT taken — and no instruction-address-misaligned exception is generated for a conditional branch that is not taken, even though 0x80000004 + 6 = 0x8000000A is misaligned. A branch writes no register, so the expectation is the empty writes table.") (source "RVI-RV32I §1.1.5.2 (D-MISALIGN-REPORT: a branch that is not taken raises no such exception)")) (step (n 2) (insn "addi x2, x0, 2") (writes (write (reg "x2") (value "0x0000000000000002"))) (derivation "The fall-through write: continuation is the observation — had the branch trapped or transferred, x2 would never be written.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "bne x0, x0, 6") (writes) (derivation "0 == 0, not taken; the misaligned target raises nothing, exactly as step 1.") (source "RVI-RV32I §1.1.5.2")) (step (n 4) (insn "addi x3, x0, 3") (writes (write (reg "x3") (value "0x0000000000000003"))) (derivation "Continuation, as step 2.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "blt x1, x0, 6") (writes) (derivation "Signed: 1 is not below 0, not taken; the misaligned target raises nothing.") (source "RVI-RV32I §1.1.5.2 (BLT is the signed less-than)")) (step (n 6) (insn "addi x4, x0, 4") (writes (write (reg "x4") (value "0x0000000000000004"))) (derivation "Continuation, as step 2.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "bge x0, x1, 6") (writes) (derivation "Signed: 0 is not greater-or-equal 1, not taken; the misaligned target raises nothing.") (source "RVI-RV32I §1.1.5.2")) (step (n 8) (insn "addi x5, x0, 5") (writes (write (reg "x5") (value "0x0000000000000005"))) (derivation "Continuation, as step 2.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "bltu x1, x0, 10") (writes) (derivation "Unsigned: 1 is not below 0, not taken; the misaligned target (0x8000002A) raises nothing.") (source "RVI-RV32I §1.1.5.2 (BLTU is the unsigned less-than)")) (step (n 10) (insn "addi x6, x0, 6") (writes (write (reg "x6") (value "0x0000000000000006"))) (derivation "Continuation, as step 2.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "bgeu x0, x1, 10") (writes) (derivation "Unsigned: 0 is not greater-or-equal 1, not taken; the misaligned target raises nothing.") (source "RVI-RV32I §1.1.5.2")) (step (n 12) (insn "addi x7, x0, 7") (writes (write (reg "x7") (value "0x0000000000000007"))) (derivation "Continuation, as step 2.") (source "RVI-RV32I §1.1.4")) (step (n 13) (insn "beq x0, x0, 8") (writes) (derivation "0 == 0, so this branch IS taken — to 0x80000034 + 8 = 0x8000003C, which IS 4-byte aligned, so nothing is raised and the transfer happens. This is the liveness control: the branch machinery works, which is what makes the six not-taken suppressions meaningful. The skipped addi at 0x80000038 is the negative observation (never_written x8).") (source "RVI-RV32I §1.1.5.2; §1.1.5 (D-IALIGN: the aligned target raises nothing)")))
