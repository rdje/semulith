;; it-alias-bound.expected.sexp — the expected observations for `it-alias-bound.s` (P2-SCALAR.4).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py it-alias-bound.expected.sexp schema/expectations.sexp

(comment "it-alias-bound.expected.sexp — the expected observations for `it-alias-bound.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). Alias × boundary: every operator under test reads AND writes the same register at a" "domain edge — the old value is input and overwritten output in one step. Every result is a" "VISIBLE change (x9 is pre-written with 1 so the 0 result of the slt is observed; a 0 into an" "already-zero register would prove nothing — the P2-SCALAR.1 lesson).")
(expectations (program "it-alias-bound.s") (entry "0x80000000") (instructions 10) (step (n 0) (insn "addi x5, x0, -1") (writes (write (reg "x5") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "The immediate -1 sign-extends to all ones.") (source "RVI-RV32I §1.1.4 (D-ALU-IMM)")) (step (n 1) (insn "addw x5, x5, x5") (writes (write (reg "x5") (value "0xFFFFFFFFFFFFFFFE"))) (derivation "rd = rs1 = rs2 = -1: the low 32 bits add as 0xFFFFFFFF + 0xFFFFFFFF = 0x1FFFFFFFE, wrapping to 0xFFFFFFFE; the *W rule sign-extends from bit 31 (set), so x5 = 0xFFFFFFFFFFFFFFFE = -2. The self-alias samples the OLD x5 twice and overwrites it once.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX: overflow ignored, sign-extended from bit 31)")) (step (n 2) (insn "addi x6, x0, 65") (writes (write (reg "x6") (value "0x0000000000000041"))) (derivation "65 — the value AND, below, the shift amount: one register carries both.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "srl x6, x6, x6") (writes (write (reg "x6") (value "0x0000000000000020"))) (derivation "rd = rs1 = rs2 = 65: the shift amount is the LOW 6 BITS of rs2, 65 & 63 = 1, so 65 >> 1 = 32 — the boundary where a 65-amount only exists because the register read masks it down to the 6-bit domain.") (source "RVI-RV64I §3.1.2.2 (D-SHAMT: the low 6 bits of rs2)")) (step (n 4) (insn "addi x7, x0, 63") (writes (write (reg "x7") (value "0x000000000000003F"))) (derivation "63 — the top of the 6-bit shamt domain, as value and as amount.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "sll x7, x7, x7") (writes (write (reg "x7") (value "0x8000000000000000"))) (derivation "rd = rs1 = rs2 = 63: 63 << 63 discards all but bit 0 off the top, leaving 1 << 63 = 0x8000000000000000 — the shamt extreme on a self-aliased shift.") (source "RVI-RV64I §3.1.2.2 (D-SHAMT; SLL discards off the top)")) (step (n 6) (insn "addi x8, x0, -1") (writes (write (reg "x8") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "-1 — the signed boundary value for the compare and the subtract below.") (source "RVI-RV32I §1.1.4 (D-ALU-IMM)")) (step (n 7) (insn "addi x9, x0, 1") (writes (write (reg "x9") (value "0x0000000000000001"))) (derivation "Pre-written with 1 so the 0 result of the next step is a VISIBLE change — an empty observation would prove nothing.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "slt x9, x8, x8") (writes (write (reg "x9") (value "0x0000000000000000"))) (derivation "rs1 == rs2 == -1: the signed comparison (-1 < -1) is false, so x9 = 0 — the 1 -> 0 transition is the observation, at the -1 boundary with both operands the same register.") (source "RVI-RV32I §1.1.4 (SLT is the signed comparison)")) (step (n 9) (insn "sub x8, x8, x8") (writes (write (reg "x8") (value "0x0000000000000000"))) (derivation "rd = rs1 = rs2 = -1: (-1) - (-1) = 0 — the self-aliased subtract at the boundary; the -1 -> 0 transition is the observation.") (source "RVI-RV32I §1.1.4 (D-ALU-REG: overflow is ignored, the result wraps)")))
