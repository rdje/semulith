;; dir-chain.expected.sexp — the expected observations for `dir-chain.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-chain.expected.sexp schema/expectations.sexp

(comment "dir-chain.expected.sexp — the expected observations for `dir-chain.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The chain is the point: 16 serial links through varied producers (immediate," "register, both shift-amount forms, a store→load boundary crossing mid-chain, two *W forms, a" "closing unsigned compare), each consuming the previous link's result — a single wrong link" "changes every later value. Two steps carry empty writes: the ld returns the value the sd just" "committed (no change), and the andi reproduces it (60 & 62 = 60).")
(expectations (program "dir-chain.s") (entry "0x80000000") (instructions 19) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "pc + 0.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 96") (writes (write (reg "x1") (value "0x0000000080000060"))) (derivation "&cell — past the code.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "addi x6, x0, 2") (writes (write (reg "x6") (value "0x0000000000000002"))) (derivation "The register operand for the register-amount links.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "addi x7, x0, 100") (writes (write (reg "x7") (value "0x0000000000000064"))) (derivation "The closing compare's bound.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "addi x5, x0, 1") (writes (write (reg "x5") (value "0x0000000000000001"))) (derivation "Link 1: 1.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "slli x5, x5, 4") (writes (write (reg "x5") (value "0x0000000000000010"))) (derivation "Link 2: 1 << 4 = 16.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT)")) (step (n 6) (insn "addi x5, x5, 3") (writes (write (reg "x5") (value "0x0000000000000013"))) (derivation "Link 3: 16 + 3 = 19.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "sll x5, x5, x6") (writes (write (reg "x5") (value "0x000000000000004C"))) (derivation "Link 4: 19 << (x6's low 6 bits = 2) = 76.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT)")) (step (n 8) (insn "sd x5, 0, x1") (writes ) (derivation "Link 5: the chain crosses the boundary — cell <- 76. A store writes no register.") (source "RVI-RV64I §3.1.3")) (step (n 9) (insn "ld x5, 0, x1") (writes ) (derivation "Link 6: …and comes back — 76. x5 already holds 76, so the visible-change vocabulary records NOTHING (the load still crosses the boundary; the census pins it).") (source "RVI-RV64I §3.1.3; state.sexp")) (step (n 10) (insn "srai x5, x5, 1") (writes (write (reg "x5") (value "0x0000000000000026"))) (derivation "Link 7: 76 >>> 1 arithmetic = 38 (the sign bit is clear).") (source "RVI-RV64I §3.1.2.1 (D-SHAMT)")) (step (n 11) (insn "addw x5, x5, x6") (writes (write (reg "x5") (value "0x0000000000000028"))) (derivation "Link 8: the *W form — (38 + 2) wrapped to 32 bits and sign-extended = 40.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 12) (insn "xori x5, x5, 0xFF") (writes (write (reg "x5") (value "0x00000000000000D7"))) (derivation "Link 9: 40 ^ 255 = 215 (0x28 ^ 0xFF = 0xD7).") (source "RVI-RV32I §1.1.4")) (step (n 13) (insn "srli x5, x5, 2") (writes (write (reg "x5") (value "0x0000000000000035"))) (derivation "Link 10: 215 >> 2 logical = 53.") (source "RVI-RV64I §3.1.2.1 (D-SHAMT)")) (step (n 14) (insn "addiw x5, x5, 7") (writes (write (reg "x5") (value "0x000000000000003C"))) (derivation "Link 11: the *W immediate form — 53 + 7 = 60, sign-extended from bit 31 (clear).") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 15) (insn "andi x5, x5, 62") (writes ) (derivation "Link 12: 60 & 62 = 60 (0b0111100 & 0b0111110) — x5 already holds 60, so the visible-change vocabulary records nothing (state.sexp).") (source "RVI-RV32I §1.1.4")) (step (n 16) (insn "subw x5, x5, x6") (writes (write (reg "x5") (value "0x000000000000003A"))) (derivation "Link 13: 60 − 2 = 58 under the *W rule.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 17) (insn "sltu x5, x5, x7") (writes (write (reg "x5") (value "0x0000000000000001"))) (derivation "Link 14: 58 < 100 unsigned → 1.") (source "RVI-RV32I §1.1.4")) (step (n 18) (insn "addi x8, x0, 8") (writes (write (reg "x8") (value "0x0000000000000008"))) (derivation "The landing: all 16 links retired, each consuming the previous link's result.") (source "RVI-RV32I §1.1.4")))
