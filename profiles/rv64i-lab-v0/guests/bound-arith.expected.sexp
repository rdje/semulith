;; bound-arith.expected.sexp — the expected observations for `bound-arith.s` (P2-SCALAR.2).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py bound-arith.expected.sexp schema/expectations.sexp

(comment "bound-arith.expected.sexp — the expected observations for `bound-arith.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN." "`EVD-05` and `docs/EVIDENCE_AND_GATES.md` require it: an expected value copied out of a model's" "output tests that the model is self-consistent and nothing else. The `derivation` field on each" "step is the reasoning, and `source` is where in the pinned artifacts the rule is stated." "" "The wrap and immediate boundaries (D-ALU-REG, D-ALU-IMM, D-WSUFFIX, D-LUI-AUIPC," "D-ADDR-WRAP): INT64_MAX + 1 and INT64_MIN - 1 wrap on both the register and the" "immediate path; the 12-bit immediate extremes; the *W wraps with a garbage upper" "half that must contribute nothing; slt/sltu at the signed extremes; the" "U-immediate sign edges; auipc 0x80000 wraps modulo 2^64 to exactly 4*n.")
(expectations (program "bound-arith.s") (entry "0x80000000") (instructions 31) (step (n 0) (insn "addi x1, x0, -1") (writes (write (reg "x1") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "All ones — the raw material for INT64_MAX.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "srli x1, x1, 1") (writes (write (reg "x1") (value "0x7FFFFFFFFFFFFFFF"))) (derivation "0xFFFFFFFFFFFFFFFF >>> 1: INT64_MAX, the largest positive signed value.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "addi x2, x0, 1") (writes (write (reg "x2") (value "0x0000000000000001"))) (derivation "One — the raw material for INT64_MIN.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "slli x2, x2, 63") (writes (write (reg "x2") (value "0x8000000000000000"))) (derivation "1 << 63: INT64_MIN, the most negative signed value.") (source "RVI-RV64I §3.1.2.1")) (step (n 4) (insn "addi x4, x0, 1") (writes (write (reg "x4") (value "0x0000000000000001"))) (derivation "The unit increment for the wrap steps.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "add x3, x1, x4") (writes (write (reg "x3") (value "0x8000000000000000"))) (derivation "INT64_MAX + 1: the sum is 2^63, which wraps modulo 2^64 to 0x8000000000000000 — INT64_MIN. Overflow is IGNORED; there is no trap and no flag.") (source "RVI-RV32I §1.1.4 (D-ALU-REG: overflow is ignored, the result wraps)")) (step (n 6) (insn "sub x5, x2, x4") (writes (write (reg "x5") (value "0x7FFFFFFFFFFFFFFF"))) (derivation "INT64_MIN - 1 = -2^63 - 1 wraps to 0x7FFFFFFFFFFFFFFF — INT64_MAX. The other direction of the same wrap.") (source "RVI-RV32I §1.1.4 (D-ALU-REG)")) (step (n 7) (insn "add x6, x1, x1") (writes (write (reg "x6") (value "0xFFFFFFFFFFFFFFFE"))) (derivation "INT64_MAX + INT64_MAX = 2^64 - 2 wraps to 0xFFFFFFFFFFFFFFFE = -2. The largest double is the smallest even negative.") (source "RVI-RV32I §1.1.4 (D-ALU-REG)")) (step (n 8) (insn "addi x7, x2, -1") (writes (write (reg "x7") (value "0x7FFFFFFFFFFFFFFF"))) (derivation "The wrap through the IMMEDIATE path: INT64_MIN + (-1) wraps to INT64_MAX, exactly as the register path in step 6.") (source "RVI-RV32I §1.1.4 (D-ALU-IMM: the immediate sign-extends, then adds modulo 2^64)")) (step (n 9) (insn "addi x8, x0, -2048") (writes (write (reg "x8") (value "0xFFFFFFFFFFFFF800"))) (derivation "The most negative 12-bit immediate: -2048 sign-extends to 0xFFFFFFFFFFFFF800.") (source "RVI-RV32I §1.1.4 (the I-immediate is 12 bits, sign-extended)")) (step (n 10) (insn "addi x9, x0, 2047") (writes (write (reg "x9") (value "0x00000000000007FF"))) (derivation "The most positive 12-bit immediate: 2047.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "lui x10, 0xDEADB") (writes (write (reg "x10") (value "0xFFFFFFFFDEADB000"))) (derivation "0xDEADB << 12, sign-extended: 0xFFFFFFFFDEADB000 — deliberately odd upper bits, so a *W step that leaked them would be visible.") (source "RVI-RV64I §3.1.2.1")) (step (n 12) (insn "addi x10, x10, 0x7EF") (writes (write (reg "x10") (value "0xFFFFFFFFDEADB7EF"))) (derivation "Adds 0x7EF: 0xFFFFFFFFDEADB7EF.") (source "RVI-RV32I §1.1.4")) (step (n 13) (insn "slli x10, x10, 32") (writes (write (reg "x10") (value "0xDEADB7EF00000000"))) (derivation "Left 32: the garbage moves to the upper half, the low half clears.") (source "RVI-RV64I §3.1.2.1")) (step (n 14) (insn "addi x11, x0, -1") (writes (write (reg "x11") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "All ones.") (source "RVI-RV32I §1.1.4")) (step (n 15) (insn "srli x11, x11, 33") (writes (write (reg "x11") (value "0x000000007FFFFFFF"))) (derivation "0xFFFFFFFFFFFFFFFF >>> 33 = 0x000000007FFFFFFF — INT32_MAX, zero-filled above.") (source "RVI-RV64I §3.1.2.1")) (step (n 16) (insn "or x10, x10, x11") (writes (write (reg "x10") (value "0xDEADB7EF7FFFFFFF"))) (derivation "The operand: upper 32 bits garbage (0xDEADB7EF), low 32 bits exactly INT32_MAX.") (source "RVI-RV32I §1.1.4")) (step (n 17) (insn "addiw x12, x10, 1") (writes (write (reg "x12") (value "0xFFFFFFFF80000000"))) (derivation "D-WSUFFIX: only the low 32 bits add — 0x7FFFFFFF + 1 = 0x80000000 (the garbage upper half contributes NOTHING) — and the 32-bit result sign-extends from bit 31: 0xFFFFFFFF80000000.") (source "RVI-RV64I §3.1.2.1 (D-WSUFFIX: overflow ignored, sign-extended from bit 31)")) (step (n 18) (insn "addiw x13, x2, -1") (writes (write (reg "x13") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "The low 32 bits of INT64_MIN are 0; 0 + (-1) wraps to 0xFFFFFFFF in 32 bits, sign-extended to 0xFFFFFFFFFFFFFFFF.") (source "RVI-RV64I §3.1.2.1 (D-WSUFFIX)")) (step (n 19) (insn "addw x14, x10, x4") (writes (write (reg "x14") (value "0xFFFFFFFF80000000"))) (derivation "The register path: low32 0x7FFFFFFF + 1 = 0x80000000, sign-extended — the same answer as the addiw step, through ADDW.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 20) (insn "subw x15, x2, x4") (writes (write (reg "x15") (value "0xFFFFFFFFFFFFFFFF"))) (derivation "Low32 0 - 1 wraps to 0xFFFFFFFF, sign-extended to all ones.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 21) (insn "subw x16, x4, x10") (writes (write (reg "x16") (value "0xFFFFFFFF80000002"))) (derivation "Low32 1 - 0x7FFFFFFF = -0x7FFFFFFE, which is 0x80000002 in 32 bits — bit 31 set, so the extension fills the upper half: 0xFFFFFFFF80000002.") (source "RVI-RV64I §3.1.2.2 (D-WSUFFIX)")) (step (n 22) (insn "slt x17, x2, x1") (writes (write (reg "x17") (value "0x0000000000000001"))) (derivation "Signed: -2^63 < 2^63 - 1, so 1. The two most distant signed values.") (source "RVI-RV32I §1.1.4 (SLT is the signed comparison)")) (step (n 23) (insn "addi x18, x0, 1") (writes (write (reg "x18") (value "0x0000000000000001"))) (derivation "The pre-write: the next step's result is 0, observable only as this 1 going away.") (source "RVI-RV32I §1.1.4")) (step (n 24) (insn "sltu x18, x2, x1") (writes (write (reg "x18") (value "0x0000000000000000"))) (derivation "Unsigned, the same operands swap order: 0x8000000000000000 > 0x7FFFFFFFFFFFFFFF, so the answer is 0 — the 1→0 transition. Steps slt/sltu on one register pair are the signed/unsigned boundary.") (source "RVI-RV32I §1.1.4 (SLTU is the unsigned comparison)")) (step (n 25) (insn "sltu x19, x0, x2") (writes (write (reg "x19") (value "0x0000000000000001"))) (derivation "Zero compares below every nonzero value unsigned, including the sign-bit pattern: 1.") (source "RVI-RV32I §1.1.4")) (step (n 26) (insn "slti x20, x2, -2048") (writes (write (reg "x20") (value "0x0000000000000001"))) (derivation "The immediate -2048 sign-extends to 0xFFFFFFFFFFFFF800; INT64_MIN is still smaller: 1.") (source "RVI-RV32I §1.1.4 (SLTI compares against the sign-extended immediate)")) (step (n 27) (insn "sltiu x21, x0, -1") (writes (write (reg "x21") (value "0x0000000000000001"))) (derivation "SLTIU sign-extends the immediate FIRST — -1 becomes 0xFFFFFFFFFFFFFFFF — then compares unsigned: 0 is below everything. A zero-extending reader would compute 0 < 0xFFF, also 1 — the discrimination of this rule is scope-alu's step 17; here the boundary operand is x0 itself.") (source "RVI-RV32I §1.1.4 (D-ALU-IMM)")) (step (n 28) (insn "lui x22, 0x7FFFF") (writes (write (reg "x22") (value "0x000000007FFFF000"))) (derivation "0x7FFFF << 12 = 0x7FFFF000; bit 31 is clear, so the sign extension to 64 bits adds nothing. scope-alu's lui 0x80000 is the negative edge; this is its pair.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 29) (insn "auipc x23, 0x80000") (writes (write (reg "x23") (value "0x0000000000000074"))) (derivation "The AUIPC offset 0x80000000 sign-extends to 0xFFFFFFFF80000000; added to this instruction's address 0x80000000 + 4*29, the sum wraps modulo 2^64 to exactly 0x0000000000000074 — D-ADDR-WRAP inside D-LUI-AUIPC. A zero-extending AUIPC would answer 0x80000000 + 4*n + 0x80000000 instead.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC); RVI-INTRO, Memory (D-ADDR-WRAP)")) (step (n 30) (insn "auipc x24, 0x7FFFF") (writes (write (reg "x24") (value "0x00000000FFFFF078"))) (derivation "The positive edge: 0x7FFFF000 sign-extends to itself, so the result is this instruction's address plus it: 0x00000000FFFFF078.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")))
