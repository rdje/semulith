;; fault-st-mis-h.expected.sexp — the expected observations for `fault-st-mis-h.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-st-mis-h.expected.sexp schema/expectations.sexp

(comment "fault-st-mis-h.expected.sexp — the expected observations for `fault-st-mis-h.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The store half of the misalignment rule — and the SUPPRESSED EFFECT (SEM-06): the" "store is judged before the boundary is crossed, so no store request ever reaches the" "environment. The offline gate's crossing log proves the absence; a final-state check could not" "tell a suppressed store from a serviced one.")
(expectations (program "fault-st-mis-h.s") (entry "0x80000000") (instructions 4) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "Building the main-memory base arithmetically; LUI cannot produce a positive 0x80000000.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 at 64 bits is the base of the declared MainMemory region.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "addi x1, x0, 7") (writes (write (reg "x1") (value "0x0000000000000007"))) (derivation "The value that must never reach memory — materialized so a serviced store would be observable in the crossing log.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "sh x1, 1025, x10") (writes) (derivation "The effective address is 0x80000401 — odd, NOT 2-byte aligned. The store raises address-misaligned as a contained trap BEFORE any boundary request is formed: no store crossing exists, and a store writes no register, so the expectation is the empty writes table. Measured on both references: cause 0x06, tval 0x0000000080000401.") (source "RVI-RV32I §1.1.6 — decision D-MISALIGN-DATA (the misaligned access raises, it is not handled invisibly)")))
