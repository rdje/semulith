;; dir-chase.expected.sexp — the expected observations for `dir-chase.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-chase.expected.sexp schema/expectations.sexp

(comment "dir-chase.expected.sexp — the expected observations for `dir-chase.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The guest's point is the DEPENDENCE: a loaded value used as an address (the pointer" "chase) and as a jump target (the jump table) — the idiom the coverage census found nowhere in" "the corpus, the ACT4 suite, or the compiled guest. The data cells' addresses are derived from" "the auipc positions; each source line shows the arithmetic.")
(expectations (program "dir-chase.s") (entry "0x80000000") (instructions 17) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "AUIPC forms sext(imm20 << 12) + pc = 0x80000000.") (source "RVI-RV64I §3.1.2.1 (D-LUI-AUIPC)")) (step (n 1) (insn "addi x1, x1, 96") (writes (write (reg "x1") (value "0x0000000080000060"))) (derivation "0x80000000 + 96 = 0x80000060 — &cell0; the cells live past the code (which ends at entry+0x44).") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "addi x7, x0, 42") (writes (write (reg "x7") (value "0x000000000000002A"))) (derivation "The chase's payload value.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "sd x7, 16, x1") (writes ) (derivation "SD stores the low 64 bits at x1+16 = 0x80000070: cell2 <- 42. A store writes no register; the crossing is the census's pin.") (source "RVI-RV64I §3.1.3")) (step (n 4) (insn "auipc x2, 0") (writes (write (reg "x2") (value "0x0000000080000010"))) (derivation "pc of this instruction.") (source "RVI-RV64I §3.1.2.1")) (step (n 5) (insn "addi x2, x2, 96") (writes (write (reg "x2") (value "0x0000000080000070"))) (derivation "0x80000010 + 96 = 0x80000070 = &cell2 — the chase pointer's value.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "sd x2, 0, x1") (writes ) (derivation "cell0 <- &cell2: the pointer the chase will follow.") (source "RVI-RV64I §3.1.3")) (step (n 7) (insn "auipc x3, 0") (writes (write (reg "x3") (value "0x000000008000001C"))) (derivation "pc of this instruction.") (source "RVI-RV64I §3.1.2.1")) (step (n 8) (insn "addi x3, x3, 28") (writes (write (reg "x3") (value "0x0000000080000038"))) (derivation "0x8000001C + 28 = 0x80000038 — the stub's address (its word index 14 × 4).") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "sd x3, 8, x1") (writes ) (derivation "cell1 <- the stub's address: the jump-table entry.") (source "RVI-RV64I §3.1.3")) (step (n 10) (insn "ld x4, x1, 0") (writes (write (reg "x4") (value "0x0000000080000070"))) (derivation "The chase's first leg: x4 = cell0 = &cell2 — a LOADED value about to be used as an address.") (source "RVI-RV32I §1.1.6")) (step (n 11) (insn "ld x5, x4, 0") (writes (write (reg "x5") (value "0x000000000000002A"))) (derivation "The chase lands: x5 = *x4 = cell2 = 42. The load's address came from memory, not from immediate arithmetic.") (source "RVI-RV32I §1.1.6")) (step (n 12) (insn "ld x6, x1, 8") (writes (write (reg "x6") (value "0x0000000080000038"))) (derivation "The table read: x6 = cell1 = the stub's address.") (source "RVI-RV32I §1.1.6")) (step (n 13) (insn "jalr x0, x6, 0") (writes ) (derivation "JALR sets pc = (x6 + 0) with bit 0 cleared = 0x80000038 — control flow through a LOADED value. The link (pc+4) targets x0 and is architecturally discarded: no visible write.") (source "RVI-RV32I §1.1.5.1 (D-JALR-LSB)")) (step (n 14) (insn "addi x8, x0, 7") (writes (write (reg "x8") (value "0x0000000000000007"))) (derivation "The stub executes — reached ONLY through the table.") (source "RVI-RV32I §1.1.4")) (step (n 15) (insn "addi x9, x0, 9") (writes (write (reg "x9") (value "0x0000000000000009"))) (derivation "The stub's second word.") (source "RVI-RV32I §1.1.4")) (step (n 16) (insn "ebreak") (writes ) (derivation "The requested trap ends the run: cause 0x03, tval = the ebreak's own address 0x80000040 (the measured spelling on all three models).") (source "RVI-RV32I §1.1.8 — decision D-ECALL-EBREAK")))
