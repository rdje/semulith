;; fault-st-mis-d.expected.sexp — the expected observations for `fault-st-mis-d.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-st-mis-d.expected.sexp schema/expectations.sexp

(comment "fault-st-mis-d.expected.sexp — the expected observations for `fault-st-mis-d.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The 8-byte store at 4 mod 8: with fault-ld-mis-d this pins the width rule on both" "sides — 4-aligned is not 8-aligned. No store crossing (SEM-06).")
(expectations (program "fault-st-mis-d.s") (entry "0x80000000") (instructions 4) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "Building the main-memory base arithmetically; LUI cannot produce a positive 0x80000000.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 at 64 bits is the base of the declared MainMemory region.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "addi x1, x0, 7") (writes (write (reg "x1") (value "0x0000000000000007"))) (derivation "The value that must never reach memory.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "sd x1, 1028, x10") (writes) (derivation "The effective address is 0x80000404 — 4-aligned but NOT 8-aligned, and the rule is the access's own width. The store raises address-misaligned as a contained trap before any boundary request is formed: no store crossing, no register write. Measured on both references: cause 0x06, tval 0x0000000080000404.") (source "RVI-RV32I §1.1.6 — decision D-MISALIGN-DATA")))
