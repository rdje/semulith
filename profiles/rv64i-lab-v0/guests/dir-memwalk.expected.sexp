;; dir-memwalk.expected.sexp — the expected observations for `dir-memwalk.s` (P2-SCALAR.5, strand 3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py dir-memwalk.expected.sexp schema/expectations.sexp

(comment "dir-memwalk.expected.sexp — the expected observations for `dir-memwalk.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). The point is the LOOP WITH MEMORY TRAFFIC: a load AND a store in every iteration," "under a carried induction register — the memory walk no guest or suite row had pinned. The four" "copied values walk x5 in order (10, 20, 30, 40); both pointers advance by 8 per iteration; the" "countdown 4,3,2,1,0 ends the loop, and the closing ebreak is the measured trap shape.")
(expectations (program "dir-memwalk.s") (entry "0x80000000") (instructions 37) (step (n 0) (insn "auipc x1, 0") (writes (write (reg "x1") (value "0x0000000080000000"))) (derivation "pc + 0.") (source "RVI-RV64I §3.1.2.1")) (step (n 1) (insn "addi x1, x1, 96") (writes (write (reg "x1") (value "0x0000000080000060"))) (derivation "&src — past the code (which ends at entry+0x4C).") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "addi x2, x0, 10") (writes (write (reg "x2") (value "0x000000000000000A"))) (derivation "The first cell's value.") (source "RVI-RV32I §1.1.4")) (step (n 3) (insn "sd x2, 0, x1") (writes ) (derivation "src[0] <- 10. A store writes no register; the crossing is the census's pin.") (source "RVI-RV64I §3.1.3")) (step (n 4) (insn "addi x2, x0, 20") (writes (write (reg "x2") (value "0x0000000000000014"))) (derivation "20.") (source "RVI-RV32I §1.1.4")) (step (n 5) (insn "sd x2, 8, x1") (writes ) (derivation "src[1] <- 20.") (source "RVI-RV64I §3.1.3")) (step (n 6) (insn "addi x2, x0, 30") (writes (write (reg "x2") (value "0x000000000000001E"))) (derivation "30.") (source "RVI-RV32I §1.1.4")) (step (n 7) (insn "sd x2, 16, x1") (writes ) (derivation "src[2] <- 30.") (source "RVI-RV64I §3.1.3")) (step (n 8) (insn "addi x2, x0, 40") (writes (write (reg "x2") (value "0x0000000000000028"))) (derivation "40.") (source "RVI-RV32I §1.1.4")) (step (n 9) (insn "sd x2, 24, x1") (writes ) (derivation "src[3] <- 40.") (source "RVI-RV64I §3.1.3")) (step (n 10) (insn "addi x3, x0, 4") (writes (write (reg "x3") (value "0x0000000000000004"))) (derivation "The countdown: four iterations.") (source "RVI-RV32I §1.1.4")) (step (n 11) (insn "addi x4, x1, 64") (writes (write (reg "x4") (value "0x00000000800000A0"))) (derivation "&dst = &src + 64.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "ld x5, 0, x1   # iteration 0") (writes (write (reg "x5") (value "0x000000000000000A"))) (derivation "Iteration 0: the LOAD — x5 = src[0] = 10.") (source "RVI-RV32I §1.1.6")) (step (n 13) (insn "sd x5, 0, x4   # iteration 0") (writes ) (derivation "Iteration 0: the STORE in the same iteration — dst[0] <- 10.") (source "RVI-RV64I §3.1.3")) (step (n 14) (insn "addi x1, x1, 8   # iteration 0") (writes (write (reg "x1") (value "0x0000000080000068"))) (derivation "The walk advances the source pointer.") (source "RVI-RV32I §1.1.4")) (step (n 15) (insn "addi x4, x4, 8   # iteration 0") (writes (write (reg "x4") (value "0x00000000800000A8"))) (derivation "…and the destination pointer.") (source "RVI-RV32I §1.1.4")) (step (n 16) (insn "addi x3, x3, -1   # iteration 0") (writes (write (reg "x3") (value "0x0000000000000003"))) (derivation "The countdown decrements to 3.") (source "RVI-RV32I §1.1.4")) (step (n 17) (insn "bne x3, x0, loop   # iteration 0") (writes ) (derivation "x3 != 0 → TAKEN back to the loop head.") (source "RVI-RV32I §1.1.5")) (step (n 18) (insn "ld x5, 0, x1   # iteration 1") (writes (write (reg "x5") (value "0x0000000000000014"))) (derivation "Iteration 1: the LOAD — x5 = src[1] = 20.") (source "RVI-RV32I §1.1.6")) (step (n 19) (insn "sd x5, 0, x4   # iteration 1") (writes ) (derivation "Iteration 1: the STORE in the same iteration — dst[1] <- 20.") (source "RVI-RV64I §3.1.3")) (step (n 20) (insn "addi x1, x1, 8   # iteration 1") (writes (write (reg "x1") (value "0x0000000080000070"))) (derivation "The walk advances the source pointer.") (source "RVI-RV32I §1.1.4")) (step (n 21) (insn "addi x4, x4, 8   # iteration 1") (writes (write (reg "x4") (value "0x00000000800000B0"))) (derivation "…and the destination pointer.") (source "RVI-RV32I §1.1.4")) (step (n 22) (insn "addi x3, x3, -1   # iteration 1") (writes (write (reg "x3") (value "0x0000000000000002"))) (derivation "The countdown decrements to 2.") (source "RVI-RV32I §1.1.4")) (step (n 23) (insn "bne x3, x0, loop   # iteration 1") (writes ) (derivation "x3 != 0 → TAKEN back to the loop head.") (source "RVI-RV32I §1.1.5")) (step (n 24) (insn "ld x5, 0, x1   # iteration 2") (writes (write (reg "x5") (value "0x000000000000001E"))) (derivation "Iteration 2: the LOAD — x5 = src[2] = 30.") (source "RVI-RV32I §1.1.6")) (step (n 25) (insn "sd x5, 0, x4   # iteration 2") (writes ) (derivation "Iteration 2: the STORE in the same iteration — dst[2] <- 30.") (source "RVI-RV64I §3.1.3")) (step (n 26) (insn "addi x1, x1, 8   # iteration 2") (writes (write (reg "x1") (value "0x0000000080000078"))) (derivation "The walk advances the source pointer.") (source "RVI-RV32I §1.1.4")) (step (n 27) (insn "addi x4, x4, 8   # iteration 2") (writes (write (reg "x4") (value "0x00000000800000B8"))) (derivation "…and the destination pointer.") (source "RVI-RV32I §1.1.4")) (step (n 28) (insn "addi x3, x3, -1   # iteration 2") (writes (write (reg "x3") (value "0x0000000000000001"))) (derivation "The countdown decrements to 1.") (source "RVI-RV32I §1.1.4")) (step (n 29) (insn "bne x3, x0, loop   # iteration 2") (writes ) (derivation "x3 != 0 → TAKEN back to the loop head.") (source "RVI-RV32I §1.1.5")) (step (n 30) (insn "ld x5, 0, x1   # iteration 3") (writes (write (reg "x5") (value "0x0000000000000028"))) (derivation "Iteration 3: the LOAD — x5 = src[3] = 40.") (source "RVI-RV32I §1.1.6")) (step (n 31) (insn "sd x5, 0, x4   # iteration 3") (writes ) (derivation "Iteration 3: the STORE in the same iteration — dst[3] <- 40.") (source "RVI-RV64I §3.1.3")) (step (n 32) (insn "addi x1, x1, 8   # iteration 3") (writes (write (reg "x1") (value "0x0000000080000080"))) (derivation "The walk advances the source pointer.") (source "RVI-RV32I §1.1.4")) (step (n 33) (insn "addi x4, x4, 8   # iteration 3") (writes (write (reg "x4") (value "0x00000000800000C0"))) (derivation "…and the destination pointer.") (source "RVI-RV32I §1.1.4")) (step (n 34) (insn "addi x3, x3, -1   # iteration 3") (writes (write (reg "x3") (value "0x0000000000000000"))) (derivation "The countdown decrements to 0.") (source "RVI-RV32I §1.1.4")) (step (n 35) (insn "bne x3, x0, loop   # iteration 3") (writes ) (derivation "x3 == 0 → NOT taken; the loop ends.") (source "RVI-RV32I §1.1.5")) (step (n 36) (insn "ebreak") (writes ) (derivation "The copy completed: the requested trap — cause 0x03, tval = the ebreak's own address 0x80000048 (the measured spelling on all three models).") (source "RVI-RV32I §1.1.8 — decision D-ECALL-EBREAK")))
