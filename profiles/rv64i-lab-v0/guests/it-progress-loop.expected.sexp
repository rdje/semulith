;; it-progress-loop.expected.sexp — the expected observations for `it-progress-loop.s` (P2-SCALAR.4).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py it-progress-loop.expected.sexp schema/expectations.sexp

(comment "it-progress-loop.expected.sexp — the expected observations for `it-progress-loop.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). Progress × progress (with the x0-link alias): an unbounded counting loop under the" "budget contract. Every iteration's count is a VISIBLE write — partial progress is observed," "never asserted — and the jump's link targets x0, so the link write is architecturally discarded" "(x0 hardwired zero): the jal steps' empty writes tables are that observation. The program never" "stops on its own; the run ends when the step budget is spent (Stop::Budget), 13 executed steps" "from 3 instructions.")
(expectations (program "it-progress-loop.s") (entry "0x80000000") (instructions 13) (step (n 0) (insn "addi x1, x0, 1") (writes (write (reg "x1") (value "0x0000000000000001"))) (derivation "The counter starts at 1; 0 -> 1 is the first visible write.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "addi x1, x1, 1") (writes (write (reg "x1") (value "0x0000000000000002"))) (derivation "First pass of the loop body: 1 + 1 = 2.") (source "RVI-RV32I §1.1.4")) (step (n 2) (insn "jal x0, -4") (writes) (derivation "JAL transfers to pc + (-4) = the loop body's addi, and stores pc+4 into rd — but rd is x0, so the link write is architecturally discarded: the empty writes table IS the x0-link observation. Taken unconditionally, every time.") (source "RVI-RV32I §1.1.5.1; §1.1.1 (x0 hardwired)")) (step (n 3) (insn "addi x1, x1, 1") (writes (write (reg "x1") (value "0x0000000000000003"))) (derivation "Second pass — reached only because the jump transferred: progress through the loop is observable in the counter.") (source "RVI-RV32I §1.1.4")) (step (n 4) (insn "jal x0, -4") (writes) (derivation "The discarded link again — the loop's control transfer leaves no architectural trace but the counter.") (source "RVI-RV32I §1.1.5.1; §1.1.1 (x0 hardwired)")) (step (n 5) (insn "addi x1, x1, 1") (writes (write (reg "x1") (value "0x0000000000000004"))) (derivation "Third pass.") (source "RVI-RV32I §1.1.4")) (step (n 6) (insn "jal x0, -4") (writes) (derivation "As step 2.") (source "RVI-RV32I §1.1.5.1; §1.1.1 (x0 hardwired)")) (step (n 7) (insn "addi x1, x1, 1") (writes (write (reg "x1") (value "0x0000000000000005"))) (derivation "Fourth pass.") (source "RVI-RV32I §1.1.4")) (step (n 8) (insn "jal x0, -4") (writes) (derivation "As step 2.") (source "RVI-RV32I §1.1.5.1; §1.1.1 (x0 hardwired)")) (step (n 9) (insn "addi x1, x1, 1") (writes (write (reg "x1") (value "0x0000000000000006"))) (derivation "Fifth pass.") (source "RVI-RV32I §1.1.4")) (step (n 10) (insn "jal x0, -4") (writes) (derivation "As step 2.") (source "RVI-RV32I §1.1.5.1; §1.1.1 (x0 hardwired)")) (step (n 11) (insn "addi x1, x1, 1") (writes (write (reg "x1") (value "0x0000000000000007"))) (derivation "Sixth pass.") (source "RVI-RV32I §1.1.4")) (step (n 12) (insn "jal x0, -4") (writes) (derivation "The thirteenth step; the budget is now spent, and the run stops mid-loop (Stop::Budget) — the laboratory's contract with a non-terminating guest, observed not assumed.") (source "RVI-RV32I §1.1.5.1; §1.1.1 (x0 hardwired)")))
