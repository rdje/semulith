;; fault-ld-x0-mis.expected.sexp — the expected observations for `fault-ld-x0-mis.s` (P2-SCALAR.3).
;; Validate with:
;;   python3 scripts/check_sexp_schema.py fault-ld-x0-mis.expected.sexp schema/expectations.sexp

(comment "fault-ld-x0-mis.expected.sexp — the expected observations for `fault-ld-x0-mis.s`." "" "⛔ EVERY VALUE HERE WAS DERIVED FROM THE PINNED SPECIFICATION PROSE BEFORE THE PROGRAM WAS RUN" "(EVD-05). D-LOAD-X0 on the misaligned path: the discarded destination suppresses NOTHING —" "a model that skipped the access because rd is x0 would retire the step instead of trapping.")
(expectations (program "fault-ld-x0-mis.s") (entry "0x80000000") (instructions 3) (step (n 0) (insn "addi x10, x0, 1") (writes (write (reg "x10") (value "0x0000000000000001"))) (derivation "Building the main-memory base arithmetically; LUI cannot produce a positive 0x80000000.") (source "RVI-RV32I §1.1.4")) (step (n 1) (insn "slli x10, x10, 31") (writes (write (reg "x10") (value "0x0000000080000000"))) (derivation "1 << 31 at 64 bits is the base of the declared MainMemory region.") (source "RVI-RV64I §3.1.2.1")) (step (n 2) (insn "lw x0, x10, 1026") (writes) (derivation "The effective address is 0x80000402 — 2 mod 4, NOT 4-byte aligned. D-LOAD-X0: a load with rd = x0 must still raise any exceptions, even though the loaded value would be discarded — so the misaligned load into x0 raises address-misaligned exactly as if rd were an ordinary register, and no register is written (x0's writes are architecturally discarded regardless). Measured on both references: cause 0x04, tval 0x0000000080000402.") (source "RVI-RV32I §1.1.6 (D-LOAD-X0: loads with a destination of x0 must still raise any exceptions); D-MISALIGN-DATA")))
