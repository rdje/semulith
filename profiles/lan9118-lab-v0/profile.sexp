;; profile.sexp — the decision dossier for `lan9118-lab-v0` (P5-BOARD.10, 2026-10-02).
;; The second DEVICE unit dossier, inheriting the shape P5-BOARD.2 hardened
;; (decision_device-applicability-by-declared-vehicle): no processor-shaped fields, the
;; mmio_registers scope census, vehicle route device-model / comparison
;; register-expectations. Validate by hand:
;;   python3 scripts/check_sexp_schema.py profiles/lan9118-lab-v0/profile.sexp schema/profile.sexp
;; Every decision mirrors its requirement's statement EXACTLY (RECORD-SCHEMA rule 4), and
;; every obligation mirrors both (rule 9): one fact, three surfaces, one wording. The
;; mirrors were generated from requirements.sexp mechanically, so drift is impossible by
;; construction and refused by gate regardless.

(profile (id "lan9118-lab-v0") (version "0") (status "experimental") (chapter_version "LAN9118 datasheet DS00002266B") (spec_revision "DS00002266B")
  (comment "No architecture/base/harts/ilen/ialign: a NIC has no instruction set, no harts and no"
           "fetch width — forcing any of them would record a lie (the P3-BREADTH.5 xlen"
           "precedent, the .2 precedent for devices). chapter_version/spec_revision name the"
           "DOCUMENT's issue. EXPERIMENTAL: the unit inherits the board's and the processor's"
           "status; every claim reads as conditional on the CPU's acceptance trajectory.")
  (sources "MICROCHIP-LAN9118")
  (state (authority architecture) (source "DS00002266B chapter 5, §3.12/§3.13")
         (comment "No program_counter, no integer file, no CSRs in the processor sense — a"
                  "device has no instruction-execution state. The state census is the 24 direct"
                  "CSRs, the 12 indexed MAC CSRs, the 13 doubly-indexed PHY registers and the"
                  "four FIFOs, carried in state.sexp with the hidden-state census that earns"
                  "the 'and nothing else' claim."))
  (vehicle (route device-model) (comparison register-expectations) (authority laboratory)
           (source "P5-BOARD .10 design brief (docs/tasks/P5-BOARD.md, Decisions, 2026-10-02); decision_device-applicability-by-declared-vehicle — the evidence shape is datasheet-derived register-read expectations (expectations/), not per-step traces or checkpoints; instruction-shaped gates derive not-applicable from this declaration"))
  (scope (count_base 28) (count_total 28) (authority architecture) (source "DS00002266B Figure 5-1, Table 5-1")
    (comment "The WHOLE direct host-bus register surface, nothing excluded: count_base ="
             "count_total = 28 — the 4 FIFO port groups (RX data aliases 00h-1Ch, TX data"
             "aliases 20h-3Ch, RX status port 40h + PEEK 44h, TX status port 48h + PEEK 4Ch)"
             "and the 24 named CSRs at 50h-B4h. The RESERVED slots (60h, 94h, B8h-FCh) are"
             "absences covered by REQ-D-NIC-RESERVED, not scope members (the .2 precedent)."
             "The 12 MAC CSRs and 13 PHY registers are MMIO-reachable state carried in"
             "state.sexp — reached through the synchronizer and MII indirections, not direct"
             "map members. The dossier models ONE instance — the board's eth0 at"
             "0x1002_0000 (D-BOARD-MEMORY-MAP); the wire itself is the environment's"
             "(recorded-trace replay on RX, recording sink on TX, D-BOARD-NET-BACKEND).")
    (mmio_registers "rx_data_fifo_port")
    (mmio_registers "tx_data_fifo_port")
    (mmio_registers "rx_status_fifo_port")
    (mmio_registers "tx_status_fifo_port")
    (mmio_registers "id_rev")
    (mmio_registers "irq_cfg")
    (mmio_registers "int_sts")
    (mmio_registers "int_en")
    (mmio_registers "byte_test")
    (mmio_registers "fifo_int")
    (mmio_registers "rx_cfg")
    (mmio_registers "tx_cfg")
    (mmio_registers "hw_cfg")
    (mmio_registers "rx_dp_ctl")
    (mmio_registers "rx_fifo_inf")
    (mmio_registers "tx_fifo_inf")
    (mmio_registers "pmt_ctrl")
    (mmio_registers "gpio_cfg")
    (mmio_registers "gpt_cfg")
    (mmio_registers "gpt_cnt")
    (mmio_registers "word_swap")
    (mmio_registers "free_run")
    (mmio_registers "rx_drop")
    (mmio_registers "mac_csr_cmd")
    (mmio_registers "mac_csr_data")
    (mmio_registers "afc_cfg")
    (mmio_registers "e2p_cmd")
    (mmio_registers "e2p_data"))
  (decision (id "D-NIC-MAP") (authority architecture) (statement "The LAN9118 direct host-bus register map spans offsets 00h–FCh: the RX data FIFO port aliased at 00h–1Ch, the TX data FIFO port aliased at 20h–3Ch, the RX status FIFO port at 40h with its PEEK at 44h, the TX status FIFO port at 48h with its PEEK at 4Ch, twenty-four named control and status registers at 50h–B4h, and RESERVED slots at 60h, 94h and B8h–FCh; the board's 256-byte eth0 window spans exactly this map.") (source "LAN9118 DS00002266B §5, Figure 5-1, Table 5-1"))
  (decision (id "D-NIC-HBI") (authority architecture) (statement "The host bus interface is an SRAM-like asynchronous slave supporting programmed I/O transactions only — 32-bit and 16-bit bus transfers over internally 32-bit data paths, with no bus-master DMA. In 16-bit mode each DWORD transfer is two contiguous 16-bit accesses that begin and end on a DWORD address boundary, in either word order; a repeated access to the same word is disregarded on writes and reads back invalid (to be re-read) on reads.") (source "LAN9118 DS00002266B §1.10, §3.6, §3.6.1, §3.6.2"))
  (decision (id "D-NIC-RXDATA-PORT") (authority architecture) (statement "The RX data FIFO allows destructive reads only: every read pops the head DWORD. Its port is aliased in 8 DWORD locations (16 WORD locations in 16-bit mode) from offset 00h to 1Ch; the host may access any of the aliased locations since they all contain the same data and perform the same function.") (source "LAN9118 DS00002266B §5.2.1"))
  (decision (id "D-NIC-TXDATA-PORT") (authority architecture) (statement "The TX data FIFO port is write-only, aliased in 8 DWORD locations (16 WORD locations in 16-bit mode) from offset 20h to 3Ch; the host may write to any of the aliased locations since they all access the same TX data FIFO location and perform the same function. Per the WO access attribute, reads of the port always return 0.") (source "LAN9118 DS00002266B §5.2.2, §5.1"))
  (decision (id "D-NIC-STATUS-PORTS") (authority architecture) (statement "The RX and TX status FIFOs are each readable from two locations: the status FIFO port (RX at 40h, TX at 48h) performs a destructive read, popping the FIFO; the PEEK location (RX at 44h, TX at 4Ch) performs a non-destructive read of the top (oldest) location of the FIFO.") (source "LAN9118 DS00002266B §5.2.1, §5.2.2, Figure 5-1"))
  (decision (id "D-NIC-FIFO-SIZES") (authority architecture) (statement "The RX and TX data FIFOs and the RX status FIFO are configurable through HW_CFG's TX_FIF_SZ field out of a 16 KB SRAM: the TX status FIFO is fixed at 512 bytes (128 DWORDs) inside the TX allocation, the RX FIFO is the remainder (16384 minus the TX allocation), and the RX status FIFO is always 1/16 of the RX FIFO size, the rest being RX data. The valid TX_FIF_SZ settings are 2 through 14 (Table 5-3 — others are reserved), the default is 5 (TX data 4608 B, TX status 512 B, RX data 10560 B, RX status 704 B), TX data FIFO space includes both commands and payload, and the RX data FIFO is considered full 4 DWORDs before its configured length. The MIL adds a fixed 2 KB TX and 128 B RX FIFO, not visible to the host processor.") (source "LAN9118 DS00002266B §5.2, §5.3.9, §5.3.9.1, Table 5-3"))
  (decision (id "D-NIC-ID-REV") (authority architecture) (statement "ID_REV (offset 50h) is read-only: Chip ID 0118h in bits [31:16] and Chip Revision 0001h in bits [15:0] — the register reads 01180001h.") (source "LAN9118 DS00002266B §5.3.1"))
  (decision (id "D-NIC-BYTE-TEST") (authority architecture) (statement "BYTE_TEST (offset 64h) is a read-only byte-order test register reading 87654321h. A write of any data to BYTE_TEST while the LAN9118 is in a power-saving state (D1 or D2) returns it to the D0 state and resets PM_MODE to D0; as a read-only register, writes have no effect on its read value.") (source "LAN9118 DS00002266B §5.3.5, §3.10.2 (Notes 3-4/3-5), §5.1"))
  (decision (id "D-NIC-IRQ-CFG") (authority architecture) (statement "IRQ_CFG (offset 54h) configures and indicates the state of the IRQ signal: INT_DEAS (bits 31:24) sets an interrupt deassertion interval in multiples of 10 µs — writing zeros disables the interval, resets the interval counter and issues any pending interrupts; INT_DEAS_CLR (bit 14, SC) restarts the deassertion interval; INT_DEAS_STS (bit 13, RO) reports an active interval during which interrupts are not delivered to the IRQ pin; IRQ_INT (bit 12, RO) reports the internal IRQ line state, responding to the associated interrupts regardless of IRQ_EN and unaffected by INT_DEAS; IRQ_EN (bit 8) gates only the external IRQ signal and has no effect on any internal interrupt status bits; IRQ_POL (bit 4) selects the polarity and IRQ_TYPE (bit 0) the buffer type, both NASR. The deassertion interval does not apply to the PME interrupt. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.2"))
  (decision (id "D-NIC-INT-STS") (authority architecture) (statement "INT_STS (offset 58h) contains the current status of the generated interrupts — SW_INT (31), TXSTOP_INT (25), RXSTOP_INT (24), RXDFH_INT (23), TX_IOC (21), RXD_INT (20), GPT_INT (19), PHY_INT (18, read-only), PME_INT (17), TXSO (16), RWT (15), RXE (14), TXE (13), TDFO (10), TDFA (9), TSFF (8), TSFL (7), RXDF_INT (6), RSFF (4), RSFL (3) and GPIO2–GPIO0 (2:0) — as R/WC bits: writing a 1 acknowledges and clears the bit and writing a 0 has no effect. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.3"))
  (decision (id "D-NIC-INT-EN") (authority architecture) (statement "INT_EN (offset 5Ch) contains the interrupt masks for IRQ, one per INT_STS source at the same bit position: writing 1 enables the corresponding interrupt as a source for IRQ, and INT_STS bits still reflect the status of the interrupt source regardless of whether the source is enabled. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.4"))
  (decision (id "D-NIC-FIFO-INT") (authority architecture) (statement "FIFO_INT (offset 68h) configures the limits where the FIFO controllers generate system interrupts: TX Data Available Level (bits 31:24, in 64-byte blocks — TDFA is generated when TX data FIFO free space is greater than this value), TX Status Level (bits 23:16, in DWORDs — TSFL when TX status FIFO used space is greater), and RX Status Level (bits 7:0, in DWORDs — RSFL when RX status FIFO used space is greater). Reset value 48000000h.") (source "LAN9118 DS00002266B §5.3.6"))
  (decision (id "D-NIC-RX-CFG") (authority architecture) (statement "RX_CFG (offset 6Ch) controls the receive engine: RX End Alignment (bits 31:30) selects a 4-, 16- or 32-byte end alignment the LAN9118 pads the last transfer up to, the host removing the extra DWORDs (11b is reserved); RX_DMA_CNT (bits 27:16) counts down the DWORDs to transfer out of the RX data FIFO before RXD_INT asserts, overwritable before it reaches zero; RX_DUMP (bit 15, SC) clears the RX data and status FIFOs of all pending data — the receiver must be halted and the stop confirmed before a dump; RXDOFF (bits 12:8) shifts the start of valid RX data by 0–31 bytes, its two LSBs changeable only with the receiver halted and all data purged. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.7, Table 5-2, §3.13.1.2"))
  (decision (id "D-NIC-TX-CFG") (authority architecture) (statement "TX_CFG (offset 70h) controls the transmit functions: TXS_DUMP (bit 15, SC) clears the TX status FIFO of all pending status DWORDs and TXD_DUMP (bit 14, SC) clears the TX data FIFO of all pending data; TXSAO (bit 2) allows the transmitter to continue operation with a full TX status FIFO when set, and suspends transmission on a full TX status FIFO when clear; TX_ON (bit 1) enables the transmitter — any data in the TX FIFO will be sent — and is cleared automatically when STOP_TX is set and the transmitter has halted; STOP_TX (bit 0, SC) finishes the current frame and then stops the transmitter, clearing itself when stopped, with all writes to it ignored while high. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.8, §3.12.8"))
  (decision (id "D-NIC-HW-CFG") (authority architecture) (statement "HW_CFG (offset 74h) controls the hardware configuration and must be written only with the transmitter and receiver stopped: MBO (bit 20) must be set to 1 for normal device operation; TX_FIF_SZ (bits 19:16) selects the TX FIFO allocation in 1 KB units (valid settings 2–14); bit 2 (RO) reports the D32/nD16 strap — set for 32-bit operation, clear for 16-bit; SRST_TO (bit 1, RO) reports that a soft reset timed out because the internal PHY was not operational; SRST (bit 0, SC) generates a software-initiated reset — a full reset of the MAC CSRs, the SCSRs except NASR bits, and the TXE/RXE errors — which will time out if the internal PHY is not in the operational state. Reset value 00050000h, with bit 2 carrying the strap value.") (source "LAN9118 DS00002266B §5.3.9, §5.3.9.1"))
  (decision (id "D-NIC-RX-DP-CTRL") (authority architecture) (statement "RX_DP_CTL (offset 78h) bit 31 (RX_FFWD) fast-forwards the RX data FIFO to the start of the next frame: the bit remains high until the fast-forward completes, no reads may be issued to the RX data FIFO while it is high (other registers and the other three FIFOs remain accessible), the discarded packet must occupy at least 4 DWORDs — shorter packets are read out and discarded with standard PIO reads — and the RX status FIFO is not fast-forwarded. The receiver does not have to be stopped to fast-forward. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.10, §3.13.1.1"))
  (decision (id "D-NIC-FIFO-INF") (authority architecture) (statement "RX_FIFO_INF (offset 7Ch, RO) reports RXSUSED (bits 23:16, RX status FIFO used space in DWORDs) and RXDUSED (bits 15:0, RX data FIFO used space in bytes, each receive frame counted with its length rounded up to the nearest DWORD); TX_FIFO_INF (offset 80h, RO) reports TXSUSED (bits 23:16, TX status FIFO used space in DWORDs) and TDFREE (bits 15:0, TX data FIFO free space in bytes) — the application should never write more data than TDFREE reports available. Reset values 00000000h and 00001200h: the INF counters' resets pin every FIFO empty at reset (TDFREE = 4608 is the default allocation's whole TX data FIFO).") (source "LAN9118 DS00002266B §5.3.11, §5.3.12"))
  (decision (id "D-NIC-PMT-CTRL") (authority architecture) (statement "PMT_CTRL (offset 84h) controls the power management features and is readable in every power management mode: READY (bit 0, RO) indicates the LAN9118 is stabilized and fully alive — with the exception of HW_CFG and PMT_CTRL, read access to any internal resource is forbidden while READY is clear, and all writes except the wake-up write to BYTE_TEST are forbidden until READY sets; PM_MODE (bits 13:12) selects D0 normal operation, D1 (wake-up frame and magic packet detection enabled) or D2 (energy detect), 11b reserved; PHY_RST (bit 10, SC) resets the PHY with the internal logic holding the reset for a minimum of 100 µs, writes ignored while high; WOL_EN (9) and ED_EN (8) enable the wake-on-LAN and energy-detect events; PME_TYPE (6) and PME_POL (2) are NASR; WUPS (bits 5:4, R/WC) reports the wake-up cause and clears only in D0 with all event sources cleared; PME_IND (3) selects a 50 ms pulsed versus continuous PME signal; PME_EN (1) enables the external PME signal only. Reset value 00000000h, with READY reading 0 until the reset or power-up completes.") (source "LAN9118 DS00002266B §5.3.13, §3.10.2"))
  (decision (id "D-NIC-FIRST-READ") (authority architecture) (statement "The LAN9118 must always be read at least once after power-up, reset, or upon return from a power-saving state, otherwise write operations will not function.") (source "LAN9118 DS00002266B §3.10.2 Note 3-4; §5.3.9 note; §5.3.13 note"))
  (decision (id "D-NIC-GPIO-CFG") (authority architecture) (statement "GPIO_CFG (offset 88h) configures the GPIO and LED functions: LEDx_EN (bits 30:28) set the associated pin as an LED output versus a GPIO signal; GPIO_INT_POL (bits 26:24) select whether a high or low level on the corresponding GPIO pin sets the GPIOx_INT status bit, the input active for greater than 40 ns to be recognized; EEPR_EN (bits 22:20) mux the EEDIO and EECLK pins between EEPROM, GPO3/GPO4 and internal MII signal functions (Table 5-4) and must not change while an EEPROM read or write cycle is in progress; GPIOBUFn (bits 18:16) select push/pull versus open-drain; GPDIRn (bits 10:8) select output versus input; GPODn (bits 4:3) carry the GPO3/GPO4 output values and GPIODn (bits 2:0) the GPIO0–2 values, reads of which reflect the current state of the corresponding pin. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.14, Table 5-4"))
  (decision (id "D-NIC-GPT") (authority architecture) (statement "GPT_CFG (offset 8Ch) holds TIMER_EN (bit 29) and the 16-bit GPT_LOAD pre-load (bits 15:0); GPT_CNT (offset 90h, RO) reflects the current value of the GP timer. The GP timer's resolution is 100 µs: writing TIMER_EN 1 loads GPT_LOAD into GPT_CNT and counts down; at 0000h the counter wraps to FFFFh, sets the GPT_INT status bit — a sticky R/WC bit — and asserts IRQ if GPT_INT_EN is set, and continues counting; on a reset, or on the TIMER_EN 1-to-0 transition, GPT_LOAD presets to FFFFh and GPT_CNT initializes to FFFFh. Reset values 0000FFFFh for both registers.") (source "LAN9118 DS00002266B §5.3.15, §5.3.16, §3.8"))
  (decision (id "D-NIC-FREE-RUN") (authority architecture) (statement "FREE_RUN (offset 9Ch, RO) reflects the value of a free-running 32-bit counter clocked by the 25 MHz reference: at reset the counter starts at zero and increments every 25 MHz cycle, rolls over at the maximum count, runs regardless of the power management states D0, D1 or D2, can take up to 160 ns to clear after a reset event, and in 16-bit mode latches the count value on the first read.") (source "LAN9118 DS00002266B §5.3.18"))
  (decision (id "D-NIC-WORD-SWAP") (authority architecture) (statement "WORD_SWAP (offset 98h, R/W, NASR) controls how words from the host data bus map to the CSRs and data FIFOs, significant only in 16-bit mode: any value other than FFFFFFFFh maps words with address bit A[1]=1 to the high order words and A[1]=0 to the low order words, and FFFFFFFFh reverses the mapping; in 32-bit mode D[31:16] always maps to the high order word and D[15:0] to the low order word. The LAN9118 always sends the low order word of the TX data FIFO to the network first and receives the low order word first. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.17, §3.7, Table 3-7"))
  (decision (id "D-NIC-RX-DROP") (authority architecture) (statement "RX_DROP (offset A0h) indicates the number of receive frames dropped: RX_DFC increments every time a receive frame is dropped, is cleared on any read of the register (RC), and issues the RXDFH_INT interrupt when the counter passes through its halfway point (7FFFFFFFh to 80000000h). Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.19"))
  (decision (id "D-NIC-MAC-SYNC") (authority architecture) (statement "The MAC CSRs are accessed indirectly through MAC_CSR_CMD (offset A4h) and MAC_CSR_DATA (offset A8h): writing CSR Busy (bit 31) with R/nW (bit 30) selecting read versus write and the 8-bit CSR Address (bits 7:0) performs the operation on the selected MAC CSR; Busy remains set until the operation is complete — on a read, valid data is then in MAC_CSR_DATA — and MAC_CSR_CMD and MAC_CSR_DATA must not be modified until Busy clears. Reset value 00000000h for both registers.") (source "LAN9118 DS00002266B §5.3.20, §5.3.21"))
  (decision (id "D-NIC-AFC-CFG") (authority architecture) (statement "AFC_CFG (offset ACh) configures the mechanism controlling automatic and software-initiated transmission of pause frames and back pressure: AFC_HI (bits 23:16, multiples of 64 bytes) is the RX data FIFO level that triggers flow control; AFC_LO (bits 15:8, multiples of 64 bytes) is the level at which a zero-pause-time frame is sent after a pause — when automatic flow control is enabled AFC_LO must always be less than AFC_HI; BACK_DUR (bits 7:4) sets the back-pressure duration per Table 5-5; FCMULT, FCBRD, FCADD and FCANY (bits 3:0) select the received frame classes that trigger back pressure or a pause frame, FCANY overriding bits 3:1. The LAN9118 will not transmit pause frames or assert back pressure if the transmitter is disabled. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.3.22, Table 5-5"))
  (decision (id "D-NIC-E2P") (authority architecture) (statement "E2P_CMD (offset B0h) and E2P_DATA (offset B4h) control the serial EEPROM: setting EPC Busy (bit 31) executes the EPC command field (bits 30:28 — READ, EWDS, EWEN, WRITE, WRAL, ERASE, ERAL, RELOAD) at the byte-aligned EPC Address (bits 7:0); Busy remains set until the operation completes — read data is then valid in E2P_DATA (bits 7:0) — and neither register may be modified until it clears; EPC Time-out (bit 9, R/WC) sets when an operation has no EEPROM response within 30 ms; MAC Address Loaded (bit 8, RO) reports a successful MAC address load after power-up or a RELOAD. EPC Busy reads high immediately following power-up or reset until the EEPROM controller finishes reading or attempting to read the MAC address. The EEPROM device powers up in the erase/write-disabled state. Reset value 00000000h (E2P_DATA 00h in its data byte).") (source "LAN9118 DS00002266B §5.3.23, §5.3.24, §3.9.2"))
  (decision (id "D-NIC-EEPROM-AUTOLOAD") (authority architecture) (statement "On power-up, hard reset or soft reset the EEPROM controller attempts to read the first EEPROM byte (address 00h): if A5h is read, an external serial EEPROM is assumed present and the next six bytes program the 48-bit MAC address (EEPROM 01h→ADDRL[7:0], 02h→ADDRL[15:8], 03h→ADDRL[23:16], 04h→ADDRL[31:24], 05h→ADDRH[7:0], 06h→ADDRH[15:8] — the order of reception on Ethernet), then MAC Address Loaded sets; if A5h is not read, the controller ends initialization and programming ADDRL/ADDRH is the host LAN driver's responsibility. After a POR, nRESET or SRST the application must verify EPC Busy has cleared before accessing the EEPROM, changing the GPIO/EEPROM pin functions, or modifying ADDRH/ADDRL.") (source "LAN9118 DS00002266B §3.9.1, Table 5-7, §3.11 Note 3-12"))
  (decision (id "D-NIC-MAC-CR") (authority architecture) (statement "MAC_CR (MAC CSR index 1) establishes the RX and TX operation modes and the address and packet filtering: RXALL (31), RCVOWN (23 — disable reception of frames when MII TX_EN is asserted; reset when full duplex), LOOPBK (21 — internal loopback through the MII, up to 10 s to change with transmitter and receiver stopped and disabled), FDPX (20 — full duplex, heartbeat check disabled), MCPAS (19), PRMS (18), INVFILT (17 — perfect filtering only), PASSBAD (16 — runts and collided frames included), HO (15 — imperfect hash filtering for physical and multicast), HPFILT (13 — hash versus perfect multicast filtering), LCOLL (12), BCAST (11 — disable broadcast reception), DISRTY (10 — one attempt versus 16), PADSTR (8 — strip pad and FCS when the length field is under 46 bytes), BOLMT (7:6 — back-off limit), DFCHK (5 — abort after deferring over 24288 bit times), TXEN (3) and RXEN (2). Reset value 00040000h.") (source "LAN9118 DS00002266B §5.4.1"))
  (decision (id "D-NIC-MAC-ADDR") (authority architecture) (statement "ADDRH (MAC CSR index 2) and ADDRL (index 3) hold the 48-bit physical address — ADDRH bits 15:0 are address bits 47:32, ADDRL bits 31:0 — optionally loaded from the EEPROM at power-on and writable by the host after the initialization process has completed; the content is undefined until loaded from the EEPROM, with Table 5-6 listing defaults 0000FFFFh and FFFFFFFFh.") (source "LAN9118 DS00002266B §5.4.2, §5.4.3, Table 5-6, Table 5-7"))
  (decision (id "D-NIC-HASH") (authority architecture) (statement "HASHH (MAC CSR index 4) and HASHL (index 5) form the 64-bit multicast hash table used for group address filtering: a hash of the incoming frame's destination address indexes the table — the most significant hash bit selects the high or low register and the other five bits select the bit within the register — and a 1 accepts the multicast frame; if MCPAS is set, all multicast frames are accepted regardless of the hash values. Reset value 00000000h for both.") (source "LAN9118 DS00002266B §5.4.4, §5.4.5"))
  (decision (id "D-NIC-MII") (authority architecture) (statement "MII_ACC (MAC CSR index 6) and MII_DATA (index 7) run management cycles to the PHY: the PHY Address field (bits 15:11) must be set to 00001b for every access, MIIRINDA (bits 10:6) selects the PHY register, MIIWnR (bit 1) selects a write versus a read, and MIIBZY (bit 0) starts the access and must be polled to 0 before the registers are written again — MII_DATA must be kept valid until the MAC clears MIIBZY on a write and is invalid until MIIBZY clears on a read. Reset value 00000000h for both.") (source "LAN9118 DS00002266B §5.4.6, §5.4.7"))
  (decision (id "D-NIC-FLOW") (authority architecture) (statement "FLOW (MAC CSR index 8) controls the generation and reception of control (pause command) frames: FCPT (bits 31:16) is the value used in the PAUSE TIME field of a transmitted control frame and must be initialized before full-duplex automatic flow control is enabled; FCPASS (bit 2) sets the Packet Filter bit in the receive packet status for a valid received pause frame; FCEN (bit 1) enables the receive portion of the flow control block — pause decoding in full duplex, the backpressure function in half duplex; FCBSY (bit 0) indicates a pause frame or back pressure is being transmitted, must read 0 before the register is written, and applications always write it 0. Reset value 00000000h.") (source "LAN9118 DS00002266B §5.4.8"))
  (decision (id "D-NIC-VLAN") (authority architecture) (statement "VLAN1 (MAC CSR index 9) and VLAN2 (index A) hold the VLAN tag identifiers compared with the 13th and 14th bytes of incoming frames for VLAN1/VLAN2 detection — set to 8100h if used — and for VLAN frames the legal frame length is increased from 1518 to 1522 bytes. Reset value 00000000h for both.") (source "LAN9118 DS00002266B §5.4.9, §5.4.10"))
  (decision (id "D-NIC-WAKE") (authority architecture) (statement "WUFF (MAC CSR index B) is write-only and configures the wake-up frame filter through an internal pointer: after power-on reset, hardware reset or soft reset, the MAC loads the first value written to the first filter DWORD (filter 0 byte mask), the second to the second DWORD, and so on through all eight, after which the internal pointer wraps to the first entry. WUCSR (index C) carries GUE (bit 9 — wake on a global unicast frame), WUFR (bit 6 — a valid remote wake-up frame was received), MPR (bit 5 — a valid Magic Packet was received), WUEN (bit 2 — wake-up frame detection enabled) and MPEN (bit 1 — Magic Packet wake-up enabled). Reset value 00000000h (WUCSR).") (source "LAN9118 DS00002266B §5.4.11, §5.4.12"))
  (decision (id "D-NIC-PHY-MAP") (authority architecture) (statement "The PHY registers are not memory mapped: they are 16-bit registers accessed indirectly through the MAC's MII_ACC and MII_DATA registers at PHY address 00001b — index 0 Basic Control, 1 Basic Status, 2 PHY Identifier 1, 3 PHY Identifier 2, 4 Auto-Negotiation Advertisement, 5 Auto-Negotiation Link Partner Ability, 6 Auto-Negotiation Expansion, 17 Mode Control/Status, 18 Special Modes, 27 Special Control/Status Indications, 29 Interrupt Source, 30 Interrupt Mask and 31 PHY Special Control/Status.") (source "LAN9118 DS00002266B §5.5, Table 5-8"))
  (decision (id "D-NIC-PHY-ID") (authority architecture) (statement "PHY Identifier 1 (index 2) reads 0007h — the 3rd through 18th bits of the OUI; PHY Identifier 2 (index 3) reads C0D1h in bits 15:10 — OUI bits 19 through 24 — with the six-bit model number (bits 9:4) and four-bit revision number (bits 3:0) given no values in the datasheet.") (source "LAN9118 DS00002266B §5.5.3, §5.5.4"))
  (decision (id "D-NIC-PHY-BASIC") (authority architecture) (statement "PHY register 0 (Basic Control) carries the self-clearing Reset (bit 15), Loopback (14), Speed Select (13) and Duplex Mode (8) — ignored when Auto-Negotiation Enable (12) is set, the defaults of bits 13 and 12 determined by the SPEED_SEL strap — Power Down (11), Restart Auto-Negotiate (9, self-clearing) and Collision Test (7). PHY register 1 (Basic Status) reads the fixed ability bits 100Base-TX full and half duplex, 10Base-T full and half duplex, Auto-Negotiate Ability and Extended Capabilities (all 1) with 100Base-T4 fixed 0, plus Auto-Negotiate Complete (5), Remote Fault (4, latch-high), Link Status (2, latch-low — 1 is link up) and Jabber Detect (1, latch-high).") (source "LAN9118 DS00002266B §5.5.1, §5.5.2, Note 5-1, Table 2-2"))
  (decision (id "D-NIC-PHY-EXT") (authority architecture) (statement "The remaining PHY registers: index 4 advertises the pause and technology abilities (100Base-TX fixed able, selector field 00001b, the 10 Mbps and full-duplex advertisement bits strap-determined); index 5 reports the link partner's ability and never a next page; index 6 carries the auto-negotiation expansion flags (parallel detection fault latch-high); index 17 carries EDPWRDOWN and the ENERGYON energy-detect indication (reset to 1 by hardware reset, unaffected by software reset); index 18 carries the PHY MODE selection and the PHYAD address (00001b), both NASR; index 27 carries the 10M receive-PLL lock control and the 10Base-T polarity indication; indices 29 and 30 carry the eight PHY interrupt source flags (latch-high) and their masks; index 31 carries the auto-negotiation-done indication and the HCDSPEED speed indication, its default determined by the default Ethernet settings.") (source "LAN9118 DS00002266B §5.5.5–§5.5.13, Table 5-9, Notes 5-3/5-4"))
  (decision (id "D-NIC-TX-CMD") (authority architecture) (statement "Each buffer queued for transmission begins with two command DWORDs in the TX data FIFO: TX command 'A' carries Interrupt on Completion (bit 31), Buffer End Alignment (25:24 — 4-, 16- or 32-byte, 11b reserved), Data Start Offset (20:16, 0–31 bytes), First Segment (13), Last Segment (12) and Buffer Size in bytes (10:0 — excluding the buffer-end alignment padding and the data start offset); TX command 'B' carries the 16-bit Packet Tag (31:16), Add CRC Disable (13), Disable Ethernet Frame Padding (12) and Packet Length in bytes (10:0 — the whole packet, excluding offset and padding). Both command words are required for every buffer of a packet, TX command 'B' must be identical for every buffer of a given packet, and every Packet Length field must equal the actual number of bytes in the packet — a violation asserts TXE.") (source "LAN9118 DS00002266B §3.12, §3.12.2, Table 3-11, Table 3-12"))
  (decision (id "D-NIC-TX-STATUS") (authority architecture) (statement "Upon completion of a packet's transmission, irrespective of success or failure, one TX status DWORD is written to the TX status FIFO: Packet Tag echo (bits 31:16), Error Status (15 — the logical OR of bits 11, 10, 9, 8, 2 and 1), Loss of Carrier (11), No Carrier (10), Late Collision (9), Excessive Collisions (8), Collision Count (6:3 — not valid when Excessive Collisions is set), Excessive Deferral (2) and Deferred (0). Data transmission is suspended if the TX status FIFO becomes full and resumes when the host reads status; with TXSAO set the transmitter continues, an overrun generates no TXE, TXSUSED stays at zero and the host is responsible for re-synchronizing TX status.") (source "LAN9118 DS00002266B §3.12.4"))
  (decision (id "D-NIC-TX-FIFO-USAGE") (authority architecture) (statement "The actual TX data FIFO space consumed by a buffer: TX command 'A' is stored for every buffer; TX command 'B' is stored only when the First Segment bit is set; DWORD-long data added as the Data Start Offset or as end padding is removed before the data is written to the FIFO, sub-DWORD remainders are kept; the payload is written. Fragmentation rules: each buffer can start and end on any arbitrary byte alignment, the first and final buffers of a packet can be any length, middle buffers are at least 4 bytes, and a packet's total consumption in the TX FIFO (MIL) must be limited to no more than 2036 bytes — the 86-fragment worst case.") (source "LAN9118 DS00002266B §3.12.5, §3.12.3.1, §3.12.3.2"))
  (decision (id "D-NIC-TX-ERRORS") (authority architecture) (statement "TXE (INT_STS bit 13) asserts when the actual packet length count does not match the Packet Length field of the TX command, when TX command 'B' words differ between buffers of a packet, on host overrun of the TX data FIFO, or on overrun of the TX status FIFO (unless TXSAO is enabled); the transmitter continues operation after TXE.") (source "LAN9118 DS00002266B §3.12.7"))
  (decision (id "D-NIC-RX-STATUS") (authority architecture) (statement "The RX status word, one per received frame in the RX status FIFO: Filtering Fail (bit 30 — the frame failed address filtering), Packet Length in bytes (29:16), Error Status (15 — the internal logical OR of bits 11, 7, 6 and 1), Broadcast Frame (13), Length Error (12), Runt Frame (11 — passed to the host only when PASSBAD is set), Multicast Frame (10), Frame Too Long (7 — over the 1518-byte maximum, an indication only, reception is not truncated), Collision Seen (6 — a late collision), Frame Type (5 — set for an Ethernet-type frame, never for runts under 14 bytes), Receive Watchdog time-out (4 — a frame greater than 2048 through 2560 bytes), MII Error (3), Dribbling Bit (2 — with its validity conditions), and CRC Error (1 — not valid for runt frames, late collisions or watchdog time-outs).") (source "LAN9118 DS00002266B §3.13.3"))
  (decision (id "D-NIC-RX-ERRORS") (authority architecture) (statement "RXE (INT_STS bit 14) asserts on a host underrun of the RX data FIFO, a host underrun of the RX status FIFO, or an overrun of the RX status FIFO; the receiver continues operation after RXE, but if an underrun condition occurs a soft reset is required to regain host synchronization. The host must never read more data than what is available in the FIFOs.") (source "LAN9118 DS00002266B §3.13.5, §3.13"))
  (decision (id "D-NIC-RESETS") (authority architecture) (statement "The LAN9118 has five reset sources (Table 3-10): power-on reset (the internal reset asserts for approximately 22 ms; READY reads 0 until the POR completes), the nRESET hardware input, soft reset (HW_CFG SRST — a full reset of the MAC CSRs and of the SCSRs except NASR bits, also clearing TXE/RXE, self-clearing when complete, completing only with the internal PHY operational), PHY reset via PMT_CTRL PHY_RST (the internal logic holds the PHY reset for a minimum of 100 µs, the bit self-clearing), and PHY reset via PHY register 0 bit 15 (self-clearing). POR and nRESET reset every circuit group Table 3-10 lists, including latching the configuration straps and the EEPROM MAC-address reload; SRST also triggers the EEPROM presence check. After any PHY reset the application must wait for the PHY's Link Status bit before transmitting or receiving; after a POR, nRESET or SRST it must verify EPC Busy has cleared before EEPROM, GPIO-function or MAC-address changes.") (source "LAN9118 DS00002266B §3.11, Table 3-10, §3.11.1–§3.11.5, §5.3.13, Notes 3-11/3-12"))
  (decision (id "D-NIC-RESERVED") (authority architecture) (statement "Unless otherwise stated, reserved bit fields must be written with zeros to ensure future compatibility, and the value of reserved bits is not supported on a read; the RESERVED register locations (offsets 60h, 94h and B8h–FCh) return a random value when read, must not be modified by system software, and writes to them may cause system failure.") (source "LAN9118 DS00002266B §5.1, Table 5-1"))
  (decision (id "D-NIC-WIDTH") (authority architecture) (statement "The effect of a host access that is neither a 32-bit transfer nor a §3.6-conformant pair of 16-bit transfers — a byte access, or a 16-bit access breaking the DWORD-boundary pairing rules — is not specified: the datasheet defines 32-bit and 16-bit bus transfers only and states no error or truncation behaviour for any other shape.") (source "LAN9118 DS00002266B §1.10, §3.6 (the silence measured against the two defined widths)"))
  (decision (id "D-NIC-STRAP-RESETS") (authority architecture) (statement "The reset values of HW_CFG bit 2 (the D32/nD16 strap — set is 32-bit operation), PHY register 0 bits 13 and 12 (Speed Select, Auto-Negotiation Enable), PHY register 4 bits 8, 7, 6 and 5 (the technology advertisement) and PHY register 31 bits 4:2 (the HCDSPEED speed indication's default) are determined by the configuration straps — D32/nD16 strapped on EEDIO, SPEED_SEL on pin 74 (Table 2-2: strap 0 is 10 Mbps half-duplex with auto-negotiation disabled; strap 1 is 100 Mbps half-duplex with auto-negotiation enabled) — not by the datasheet; the strap values are the board's composition choice, owned by P5-BOARD.4's composition verdict.") (source "LAN9118 DS00002266B §5.3.9 bit 2, §5.5.1 Note 5-1, §5.5.5 Note 5-3, §5.5.13 Note 5-4, §3.6, Table 2-2"))
  (decision (id "D-NIC-TIME-SOURCES") (authority laboratory) (statement "FREE_RUN (a 25 MHz free-running 32-bit counter readable at offset 9Ch, running in every power state), GPT_CNT (a 100 µs-resolution timer count readable at offset 90h) and IRQ_CFG's INT_DEAS (a 10 µs-granularity deassertion interval with an MMIO-visible status bit) are guest-readable time sources; rv64i-lab-env-v0 v0 excludes every guest-reachable time source — no CSR counter and no memory-mapped one (OB-ENV-VIRTUAL-TIME) — so the model must not wire these counters to wall-clock time, and the harness's retired-instruction count must never become target-visible through them; their MMIO-visible values are frozen or otherwise guest-deterministic, the exact disposition being P5-BOARD.4's composition verdict.") (source "LAN9118 DS00002266B §5.3.18, §5.3.16, §5.3.2 (the tension measured against rv64i-lab-env-v0 v0 OB-ENV-VIRTUAL-TIME)"))
  (decision (id "D-NIC-PHY-LINK") (authority laboratory) (statement "The PHY's link and auto-negotiation state — Basic Status bit 2 (Link Status, latch-low), bit 5 (Auto-Negotiate Complete), register 31's HCDSPEED, register 17's ENERGYON — is wire-domain state, and Note 3-11 makes it load-bearing: after any PHY reset the application must wait for Link Status before transmitting or receiving. On netboard-lab-v0 the wire is the recorded-trace replay backend (D-BOARD-NET-BACKEND), so the values a guest reads are the deterministic replay's declared link scene — never a live host link — the exact scene being P5-BOARD.4's composition verdict.") (source "LAN9118 DS00002266B §5.5.2, §5.5.13, §5.5.8, §3.11 Note 3-11 (the wire-domain nature measured against D-BOARD-NET-BACKEND)"))
  (decision (id "D-NIC-GPIO-PINS") (authority laboratory) (statement "GPIO_CFG's GPIODn reads reflect the current state of the corresponding GPIO/LED pins, and EEPR_EN can mux the internal MII signals TX_EN, RX_DV, TX_CLK and RX_CLK onto pins (Table 5-4); netboard-lab-v0 wires no GPIO, LED or EEPROM pins, so every pin-readable value is the composition's declared tie-off — never a live host signal — owned by P5-BOARD.4's composition verdict.") (source "LAN9118 DS00002266B §5.3.14, Table 5-4 (the pin-domain nature measured against board.sexp's absences)"))
)
