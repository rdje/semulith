;; contract-obligations.sexp — the CPU/environment contract obligation catalogue for
;; `dsp56300-lab-v0` (P3-BREADTH.6 slice 1). Seven cpu-guarantee mirrors of the profile's
;; decisions (MIRROR: the statement is the requirement's, verbatim) plus six
;; environment-assumptions carrying the laboratory's half of the contract.
;; Validate with
;;   python3 scripts/check_sexp_schema.py profiles/dsp56300-lab-v0/contract-obligations.sexp schema/contract-obligations.sexp

(obligation (id "OB-SUBSET-V0") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "Subset v0 is non-parallel moves (including the A2/B2 extension readout), the immediate/register data-ALU core, signed mpy/mac, nop/jmp/jsr/rts, do/enddo/rep, and linear addressing only; every exclusion is named with its reason in the selection record.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§13 (the instruction set the subset is drawn from)")) (parameters (param (name requirement_id) (value (str "REQ-D-SUBSET-V0"))) (param (name decision_id) (value (str "D-SUBSET-V0"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-SUBSET-V0") (required_checks "CHK-SUBSET-V0-POS") (required_checks "CHK-SUBSET-V0-NEG"))
(obligation (id "OB-ACC-READOUT") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "A2/B2 read as the sign-extended extension byte; A1/B1 read RAW — the shifter/limiter sits on the whole-accumulator read path only (measured: the alu guest stores $FE00FF from A1 with L clear; the FM's limiting prose over-applies to the A1/B1 path).") (authority architecture) (source_refs (source_id "DSP56300FM") (locator "§3.4.1.2")) (parameters (param (name requirement_id) (value (str "REQ-D-ACC-READOUT"))) (param (name decision_id) (value (str "D-ACC-READOUT"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-ACC-READOUT") (required_checks "CHK-ACC-READOUT-POS") (required_checks "CHK-ACC-READOUT-NEG"))
(obligation (id "OB-SHORTIMM-ACC") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "A short immediate moved to a whole accumulator sign-extends the 8-bit signed fraction through the extension byte — the FM's 'the remaining bits are zeroed' (13-113) does NOT hold for A2 (measured: move #$80,a leaves A2=$FF).") (authority architecture) (source_refs (source_id "DSP56300FM") (locator "§3.4.1.3 / 13-113")) (parameters (param (name requirement_id) (value (str "REQ-D-SHORTIMM-ACC"))) (param (name decision_id) (value (str "D-SHORTIMM-ACC"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-SHORTIMM-ACC") (required_checks "CHK-SHORTIMM-ACC-POS") (required_checks "CHK-SHORTIMM-ACC-NEG"))
(obligation (id "OB-RTS-PC-ONLY") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "RTS restores PC only (SSH → PC; SP − 1 → SP); SR is NOT pulled — that is RTI's shape (13-167).") (authority architecture) (source_refs (source_id "DSP56300FM") (locator "13-167, 13-168")) (parameters (param (name requirement_id) (value (str "REQ-D-RTS-PC-ONLY"))) (param (name decision_id) (value (str "D-RTS-PC-ONLY"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-RTS-PC-ONLY") (required_checks "CHK-RTS-PC-ONLY-POS") (required_checks "CHK-RTS-PC-ONLY-NEG"))
(obligation (id "OB-SBIT-LOCUS") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "The sticky S bit sets only on whole-accumulator reads to the XDB/YDB bus; subset v0 decodes no such read, so S never leaves reset (measured: an ASR of a negative accumulator does not set it).") (authority architecture) (source_refs (source_id "DSP56300FM") (locator "Table 5-1")) (parameters (param (name requirement_id) (value (str "REQ-D-SBIT-LOCUS"))) (param (name decision_id) (value (str "D-SBIT-LOCUS"))) (param (name source_semantics) (value (str "defined")))) (dependencies "REQ-D-SBIT-LOCUS") (required_checks "CHK-SBIT-LOCUS-POS") (required_checks "CHK-SBIT-LOCUS-NEG"))
(obligation (id "OB-COMPARISON") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "The comparison surface is checkpoint-level canonical end-state equality against the pinned reference's difftest dump: registers, deviation-encoded X/Y windows, 15 stack slots; steps compared, cyc never (timing is informational upstream).") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§3, §5 (the architectural state the dump captures); the surface itself is references.sexp's trace_granularity")) (parameters (param (name requirement_id) (value (str "REQ-D-COMPARISON"))) (param (name decision_id) (value (str "D-COMPARISON"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-COMPARISON") (required_checks "CHK-COMPARISON-POS") (required_checks "CHK-COMPARISON-NEG"))
(obligation (id "OB-RESET-STATE") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction cpu-guarantee) (statement "Reset: SR $C00300 (CP=11, I1=I0=1, CCR clear), OMR $000300, LA and all M registers $FFFFFF, everything else zero; pc is set by the runner from the case's load base.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "Table 5-1 and §3/§5 reset states")) (parameters (param (name requirement_id) (value (str "REQ-D-RESET-STATE"))) (param (name decision_id) (value (str "D-RESET-STATE"))) (param (name source_semantics) (value (str "implementation-defined")))) (dependencies "REQ-D-RESET-STATE") (required_checks "CHK-RESET-STATE-POS") (required_checks "CHK-RESET-STATE-NEG"))
(obligation (id "OB-ENV-VIRTUAL-TIME") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction environment-assumption) (statement "No time source is reachable by a guest in subset v0: the profile decodes no counter or timer read, and `cyc` in the canonical dump is informational base-table data that is NEVER compared (the comparison decision names the exclusion). The harness's step budget is not target-visible and may not justify any guest-observable behaviour.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§5 (the state a guest can observe); the cyc exclusion is the comparison contract's")) (parameters (param (name time_source) (value (str "none"))) (param (name cyc_compared) (value (false))) (param (name target_visible_counters) (value (ints)))) (dependencies "OB-COMPARISON") (required_checks "CHK-ENV-VIRTUAL-TIME-POS") (required_checks "CHK-ENV-VIRTUAL-TIME-NEG"))
(obligation (id "OB-ENV-ORDERING") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction environment-assumption) (statement "Execution is sequential and deterministic: one core, scalar issue, each instruction's effects complete before the next instruction's begin — the F6 state census measured the pending-writes window ABSENT for scalar issue. This profile makes NO memory-ordering claim, and a guest may not rely on this harness's sequential behaviour as an architectural guarantee.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§5 (the execution model the subset assumes)")) (parameters (param (name harts) (value (int 1))) (param (name execution_order) (value (str "sequential scalar issue"))) (param (name memory_model_claim) (value (str "none")))) (dependencies "OB-SUBSET-V0") (required_checks "CHK-ENV-ORDERING-POS") (required_checks "CHK-ENV-ORDERING-NEG"))
(obligation (id "OB-ENV-RESET") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction environment-assumption) (statement "The harness establishes the declared reset state before the first fetch (D-RESET-STATE's values), with pc at the case's load base and memory outside the loaded image seeded to the case's fill. Only a cold reset is modelled; there is no warm reset and no retained state to order.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "Table 5-1 and §3/§5 reset states")) (parameters (param (name reset_kinds) (value (strs "cold"))) (param (name retained_state) (value (str "none")))) (dependencies "OB-RESET-STATE") (required_checks "CHK-ENV-RESET-POS") (required_checks "CHK-ENV-RESET-NEG"))
(obligation (id "OB-ENV-FETCH-SUPPLY") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction environment-assumption) (statement "For every instruction fetch the harness supplies one 24-bit word from P space at pc. It performs no fetch that the model did not request, and no fetch has a side effect.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§3.1 (the 24-bit program word)")) (parameters (param (name fetch_width_bits) (value (int 24))) (param (name fetch_space) (value (str "P"))) (param (name extraneous_fetch_permitted) (value (false))) (param (name fetch_side_effects) (value (str "none")))) (dependencies "OB-ENV-ORDERING") (required_checks "CHK-ENV-FETCH-SUPPLY-POS") (required_checks "CHK-ENV-FETCH-SUPPLY-NEG"))
(obligation (id "OB-ENV-EVENT-DELIVERY") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction environment-assumption) (statement "Subset v0 delivers no asynchronous events: interrupts and traps are excluded by name in the subset decision, so the only stops are the model's typed ModelStop outcomes at the instruction that caused them. No interrupt controller, timer or external source exists in this laboratory platform.") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§13 (the interrupt forms the subset excludes)")) (parameters (param (name synchronous_exceptions) (value (false))) (param (name asynchronous_interrupts) (value (false))) (param (name interrupt_controller) (value (str "none"))) (param (name stop_surface) (value (str "typed ModelStop outcomes")))) (dependencies "OB-SUBSET-V0") (required_checks "CHK-ENV-EVENT-DELIVERY-POS") (required_checks "CHK-ENV-EVENT-DELIVERY-NEG"))
(obligation (id "OB-ENV-PARTIAL-PROGRESS") (contract_id "dsp56300-lab-env-v0") (contract_version "0") (profile_ids "dsp56300-lab-v0") (direction environment-assumption) (statement "Every instruction in subset v0 completes or stops as a unit: scalar issue commits all of an instruction's effects before the next begins, and a typed stop leaves the architectural state exactly as the last completed instruction left it — no partially committed effect can be observed (the F6 census measured no hidden working state beyond the declared LC).") (authority laboratory) (source_refs (source_id "DSP56300FM") (locator "§13 (the instruction forms the subset admits)")) (parameters (param (name restartable_suboperations) (value (false))) (param (name partial_commit_possible) (value (false)))) (dependencies "OB-ENV-ORDERING") (required_checks "CHK-ENV-PARTIAL-PROGRESS-POS") (required_checks "CHK-ENV-PARTIAL-PROGRESS-NEG"))
