;; state.sexp — architectural-state document, converted from state.json by
;; scripts/convert_dossier.py (SOT-FORMAT.4). One document form; validate with
;;   python3 scripts/check_sexp_schema.py state.sexp schema/state.sexp
;; Round-trip: `python3 scripts/convert_dossier.py verify state.json state.sexp` — data-equal, comment census exact.

(state (profile_id "rv64i-lab-v0") (xlen 64) (note "Architectural state only. ABI register names are a SOFTWARE CALLING CONVENTION, not architecture; only the three the ISA chapter itself names are recorded, and the rest are an open question rather than an assumption. See docs/INFORMATION_CATALOG.md §6, 'Instruction semantics versus ABI'.") (integer_registers (count 32) (width_bits 64) (ids "x0..x31") (authority architecture) (source "RVI-RV32I §1.1.1; RVI-RV64I §3.1.1") (x0 (hardwired_zero true) (authority architecture) (source "RVI-RV32I §1.1.1") (statement "Register x0 is hardwired with all bits equal to 0. A write to it is discarded; a read of it yields 0.")) (named_by_the_isa_chapter (named-register (reg "x1") (role "return address for a call") (authority software-convention) (source "RVI-RV32I §1.1.1"))) (named_by_the_isa_chapter (named-register (reg "x5") (role "alternate link register") (authority software-convention) (source "RVI-RV32I §1.1.1"))) (named_by_the_isa_chapter (named-register (reg "x2") (role "stack pointer") (authority software-convention) (source "RVI-RV32I §1.1.1"))) (reset (value "0 for x1..x31") (authority laboratory) (source "RVI-INTRO, RISC-V Software Execution Environments and Harts") (statement "The unprivileged specification does not define the initial contents of x1..x31 — the EEI defines the initial state of the program. Measured: 'reset' appears 0 times in the RV32I chapter and 0 times in the RV64I chapter. This zeroing is therefore a harness declaration, and a guest program may not assume any other environment provides it."))) (special_registers (register (id "pc") (width_bits 64) (holds "the address of the current instruction") (authority architecture) (source "RVI-RV32I §1.1.1") (reset "the declared entry address of the loaded image") (reset_authority laboratory))) (hidden_state_census (question "Is there any state, not listed above, that can influence a future supported observation? (SEM-08, catalog C02)") (answer "No — for this profile, and only because of what it excludes.") (candidates (checked (candidate "CSRs") (present false) (why "Zicsr is not in this profile; profile.toml declares csrs = []"))) (candidates (checked (candidate "reservation set (LR/SC)") (present false) (why "the A extension is not in this profile"))) (candidates (checked (candidate "floating-point registers and fcsr") (present false) (why "F and D are not in this profile"))) (candidates (checked (candidate "vector state (vtype, vl, vstart)") (present false) (why "V is not in this profile"))) (candidates (checked (candidate "privilege mode and trap state") (present false) (why "no privilege modes are modelled; ECALL/EBREAK are requested traps to the harness"))) (candidates (checked (candidate "instruction-fetch cache state") (present false) (why "the model re-reads memory on every fetch (D-CODE-VISIBILITY). A caching implementation WOULD have hidden state here, and would still be architecturally legal without Zifencei — which is why this is recorded as a laboratory choice, not an absence of the possibility"))) (candidates (checked (candidate "pending or partially committed effects") (present false) (why "every instruction in this scope completes or faults as a unit; no multi-step or restartable suboperation exists in RV64I base"))) (consequence "A profile with no hidden state is why this is a good first experiment: snapshot and replay reduce to the register file, pc and memory, so P1-LAB.10 can demonstrate replay honestly rather than approximately. Every extension added later reopens this census.")) (memory_spaces (space (id "prog") (word_bits 64) (authority laboratory) (source "synth24 fixture (DSP-REVIEW.6) — synthetic, no real processor"))) (memory_spaces (space (id "data") (word_bits 64) (authority laboratory) (source "synth24 fixture (DSP-REVIEW.6) — synthetic, no real processor"))))

