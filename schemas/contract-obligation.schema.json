{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semulith:planning:v0.2:contract-obligation",
  "title": "Semulith CPU/environment obligation starter",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "direction": {
      "enum": [
        "environment-assumption",
        "cpu-guarantee"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "enum": [
        "architecture",
        "implementation-profile",
        "platform",
        "laboratory"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "locator"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "contract_id",
    "contract_version",
    "profile_ids",
    "direction",
    "statement",
    "authority",
    "source_refs",
    "parameters",
    "dependencies",
    "required_checks"
  ],
  "additionalProperties": false
}
